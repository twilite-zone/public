        "content": {
          "kind": "html",
          "value": "<div style='position:relative;width:1460px;height:690px;background:#ffffff;color:#0f172a;overflow:hidden'><div style='position:absolute;left:40px;top:30px;width:1380px;border-top:3px solid #0f172a'></div><div style='position:absolute;left:40px;top:42px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#6d28d9'>Twilite Zone · The Commons</div><div style='position:absolute;left:40px;top:70px;width:1380px;border-top:1px solid #0f172a'></div><div style='position:absolute;left:40px;top:96px;font:500 72px/74px Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.025em'>The Commons</div><div style='position:absolute;left:40px;top:188px;width:900px;font:italic 400 22px/30px Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#475569'>Shared work from other people: public spaces you can walk into.</div><div style='position:absolute;left:40px;top:290px;width:1380px;border-top:3px solid #6d28d9'></div><div style='position:absolute;left:40px;top:312px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#6d28d9'>Public spaces</div><div style='position:absolute;left:40px;top:338px;width:170px;font:400 14px/20px system-ui;color:#475569'>Each opens someone’s own library.</div><div style='position:absolute;left:650px;top:314px;width:360px;height:240px;box-sizing:border-box;border:2px dashed #64748b;border-radius:12px;background:#f8fafc;display:flex;align-items:center;justify-content:center;font:400 16px/22px system-ui;color:#475569'>Room for the next</div><div style='position:absolute;left:1060px;top:314px;width:360px;height:240px;box-sizing:border-box;border:2px dashed #64748b;border-radius:12px;background:#f8fafc;display:flex;align-items:center;justify-content:center;font:400 16px/22px system-ui;color:#475569'>Room for the next</div><div style='position:absolute;left:40px;top:580px;width:1380px;border-top:1px solid #0f172a'></div><div style='position:absolute;left:40px;top:602px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>Be listed</div><div style='position:absolute;left:240px;top:598px;width:900px;font:400 17px/24px system-ui;color:#475569'>[How a public space comes to be listed here.]</div></div>"
