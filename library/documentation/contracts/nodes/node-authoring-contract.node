    {
      "id": "node-authoring-contract-skill",
      "type": "skill",
      "label": "Contract",
      "position": {
        "x": -80,
        "y": 330
      },
      "width": 420,
      "height": 260,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Node Authoring Contract",
        "body": "Defines the product-level law for separating declaration-owned identity, ordinary properties, node-owned editors, appearance controls, advanced payload, and diagnostics so Twilite stays truthful as primitives and classes evolve.",
        "category": "contracts",
        "authority": "normative",
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/skill.node-class.node"
      }
    },
    {
      "id": "node-authoring-contract-scope",
      "type": "scope",
      "label": "Scope",
      "position": {
        "x": 400,
        "y": 330
      },
      "width": 420,
      "height": 260,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Where This Applies",
        "body": "Applies whenever Twilite presents node concerns to authors, especially in the properties panel, node-owned editors, appearance systems, advanced authoring controls, and diagnostics surfaces.",
        "conditions": [
          "Properties panel work",
          "Node-owned editor design",
          "Primitive and class reporting",
          "Appearance and diagnostics boundaries"
        ],
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/scope.node-class.node"
      }
    },
    {
      "id": "node-authoring-contract-input",
      "type": "input",
      "label": "Input",
      "position": {
        "x": 880,
        "y": 330
      },
      "width": 420,
      "height": 250,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Reads",
        "body": "Read declaration authority, primitive or class identity, ordinary authored data, explicit behavior-bearing fields, appearance overrides, advanced payload, and diagnostic provenance before deciding where a control belongs.",
        "required": true,
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/input.node-class.node"
      }
    },
    {
      "id": "node-authoring-contract-output",
      "type": "output",
      "label": "Output",
      "position": {
        "x": 1360,
        "y": 330
      },
      "width": 420,
      "height": 250,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Writes",
        "body": "Produce authoring surfaces that are small, truthful, declaration-aware, and type-sensitive. Prefer node-owned editors for rich workflows and keep diagnostics from masquerading as ordinary properties.",
        "reversible": true,
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/output.node-class.node"
      }
    },
    {
      "id": "node-authoring-contract-rule-semantic-type",
      "type": "rule",
      "label": "Rule",
      "position": {
        "x": -80,
        "y": 690
      },
      "width": 420,
      "height": 260,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Semantic Identity Over Consumer Form",
        "body": "A node's meaning comes from its declared primitive or class identity, not from the consumer or renderer form currently presenting it. Surfaces like `node.web.icon` or host affordances like `port` do not replace semantic identity.",
        "severity": "must",
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/rule.node-class.node"
      }
    },
    {
      "id": "node-authoring-contract-rule-identity-order",
      "type": "rule",
      "label": "Rule",
      "position": {
        "x": 400,
        "y": 690
      },
      "width": 420,
      "height": 260,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Type Before Behavior",
        "body": "Ordinary properties should surface primitive or class identity before specialized behavior. Name remains prominent, but it does not replace the node's semantic primary field or declaration-owned identity.",
        "severity": "must",
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/rule.node-class.node"
      }
    },
    {
      "id": "node-authoring-contract-rule-appearance",
      "type": "rule",
      "label": "Rule",
      "position": {
        "x": 880,
        "y": 690
      },
      "width": 420,
      "height": 260,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Appearance Is Authored Customization",
        "body": "Appearance is explicit authoring, not baseline identity. Graph-wide defaults should not be edited through instance appearance controls, and rich styling workflows may belong outside ordinary properties.",
        "severity": "should",
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/rule.node-class.node"
      }
    },
    {
      "id": "node-authoring-contract-guardrail-catchall",
      "type": "guardrail",
      "label": "Guardrail",
      "position": {
        "x": 1360,
        "y": 690
      },
      "width": 420,
      "height": 260,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Do Not Turn Properties Into A Catch-All Editor",
        "body": "Do not keep adding controls to ordinary properties when the node's real meaning needs a dedicated workflow. Prefer node-owned editors over stuffing specialized editing into one crowded panel.",
        "hardStop": true,
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/guardrail.node-class.node"
      }
    },
    {
      "id": "node-authoring-contract-guardrail-viewtype",
      "type": "guardrail",
      "label": "Guardrail",
      "position": {
        "x": 1360,
        "y": 990
      },
      "width": 420,
      "height": 250,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Do Not Report Consumer Surfaces As Semantic Types",
        "body": "Do not report renderer surfaces or host affordances as the node's semantic type in author-facing UI. If semantic identity is missing, surface that truthfully instead of inventing a fallback ontology.",
        "hardStop": true,
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/guardrail.node-class.node"
      }
    },
    {
      "id": "node-authoring-contract-failure",
      "type": "failure-mode",
      "label": "Failure Mode",
      "position": {
        "x": 400,
        "y": 1010
      },
      "width": 420,
      "height": 260,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Vocabulary Outruns Standards",
        "body": "When schema and runtime capabilities outpace authoring standards, the UI starts exposing implementation vocabulary as if it were product meaning. The result is crowded properties, weak diagnostics boundaries, and confused authorship.",
        "response": "warn",
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/failure-mode.node-class.node"
      }
    },
    {
      "id": "node-authoring-contract-procedure",
      "type": "procedure",
      "label": "Procedure",
      "position": {
        "x": -80,
        "y": 1010
      },
      "width": 420,
      "height": 260,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Apply This Contract In UI Work",
        "body": "Use this order: resolve declaration authority, identify primitive or class identity, separate structural identity from node-owned meaning, place ordinary content and behavior first, demote appearance, collapse advanced controls, and keep diagnostics explicit.",
        "steps": [
          "Resolve declaration authority",
          "Identify primitive or class identity",
          "Separate structural identity from node-owned meaning",
          "Place ordinary content and behavior first",
          "Demote appearance to explicit authoring",
          "Collapse advanced controls",
          "Keep diagnostics named and bounded"
        ],
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/procedure.node-class.node"
      }
    }
  ],
