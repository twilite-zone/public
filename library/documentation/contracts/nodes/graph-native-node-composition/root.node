          },
          "baseLevel": "detail"
        },
        "eyebrow": "TWILITE ZONE · CONTRACT",
        "title": "Graph-Native Node Composition Contract",
        "subtitle": "This is the current write-new authoring model for graph-backed Twilite nodes. Older graphs remain readable, but new mutations use the roles and relationships below.",
        "identity": {
          "graphId": "node-composition"
