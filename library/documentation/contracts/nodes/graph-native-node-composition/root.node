    {
      "id": "node-composition-section-6",
      "type": "page-section",
      "label": "Relationship authority",
      "position": {
        "x": 380,
        "y": 80
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Relationship authority",
        "body": "Relationships define meaning:\n\n- `surface`\n- `next-face`\n- `ground`\n- `exposes-port`\n- `invokes`\n- `imports` and `exports`\n\nEdges store their kind in `type`, class graph in `data.classRef`, and endpoints in `sourcePort` and `targetPort`. `sourceHandle` and `targetHandle` are runtime compatibility copies and are not written.",
        "identity": {
          "graphId": "node-composition"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
