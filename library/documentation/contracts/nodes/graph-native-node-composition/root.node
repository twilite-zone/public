    {
      "id": "node-composition-section-4",
      "type": "page-section",
      "label": "Face and content contract",
      "position": {
        "x": 380,
        "y": -280
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Face and content contract",
        "body": "A face may own `data.content` directly or point to a content node through an authored relationship. A content node stores material like this:\n\n```json\n{\n  \"type\": \"content\",\n  \"data\": {\n    \"content\": {\n      \"kind\": \"markdown\",\n      \"value\": \"# Authored material\"\n    }\n  }\n}\n```\n\nUse `kind` values such as `markdown`, `html`, `svg`, `text`, `json`, or `image`. Do not add `renderShape` hints or create format-specific Markdown/SVG node types; `content.kind` is authoritative.",
        "identity": {
          "graphId": "node-composition"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
