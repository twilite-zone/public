    {
      "id": "node-composition-section-7",
      "type": "page-section",
      "label": "Agent checklist",
      "position": {
        "x": -180,
        "y": 440
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Agent checklist",
        "body": "Before calling a graph or template current:\n\n1. Start from one root with real identity, intent, and root payloads.\n2. Supply at least one Surface edge to a face; end each Surface in a glyph.\n3. Add ground only when the graph has an authored inside frame.\n4. Give faces owned content or an explicit content relationship.\n5. Add named ports and imports/exports only when the graph needs those interfaces.\n6. Validate edge endpoints, save/reload behavior, navigation, and semantic zoom.\n7. Preserve legacy fields only for reading; write the current model.",
        "identity": {
          "graphId": "node-composition"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
        {
