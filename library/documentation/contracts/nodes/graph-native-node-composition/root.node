    {
      "id": "node-composition-section-1",
      "type": "page-section",
      "label": "Structural roles",
      "position": {
        "x": -180,
        "y": -640
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Structural roles",
        "body": "- A `root` is the one node a graph begins from. It owns graph identity, intent, authority, Surfaces, and the implicit root Port.\n- A `port` is an additional named connection endpoint. Its `label` is its authored public name.\n- A `face` is a renderable presentation in a Surface. Faces are ordered from richest to smallest by `next-face` edges.\n- A `content` node owns durable material through `data.content.kind` and `data.content.value`.\n- A `glyph` node defines symbolic identity at the end of a Surface chain. It is not a face.\n- A `ground` edge points from the root to the graph's authored inside frame. Document graphs may omit it.\n- A `portal` consumes an exposed Port or follows a declared Surface in another graph.\n- An `import` or `export` is one end of a Bridge. A Bridge is the workspace connection, not a stored bridge node.",
        "identity": {
          "graphId": "node-composition"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
