    {
      "id": "node-composition-section-5",
      "type": "page-section",
      "label": "Port and Bridge contract",
      "position": {
        "x": -180,
        "y": 80
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Port and Bridge contract",
        "body": "A Port exposes a typed capability or named Surface at a node boundary. Edges connect to semantic ports, never directly to UI handles. Handles are optional visual affordances and are not stored endpoints.\n\nA named Port becomes externally connectable only through an `exposes-port` edge from the root. A Portal consumes that exposed Surface. Cross-graph authority uses `import` and `export` nodes plus a Bridge; do not create a `bridge` node.",
        "identity": {
          "graphId": "node-composition"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
