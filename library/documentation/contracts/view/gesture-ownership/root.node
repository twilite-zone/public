    {
      "id": "gesture-ownership-section-2",
      "type": "page-section",
      "label": "Who owns a press",
      "position": {
        "x": 380,
        "y": -640
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Who owns a press",
        "body": "The first of these that applies owns it:\n\n1. A resize handle resizes.\n2. A connection handle (a Port's handle) starts a connection.\n3. A control (a button, an input, a select, anything a surface declares as a control) is activated.\n4. A Portal or a link navigates.\n5. Editable content is edited.\n6. A scroll region scrolls.\n7. An edge is selected.\n8. An embedded frame keeps the press, unless its surface says it is canvas-first, when the press goes to the canvas.\n9. A node's body drags the node. If the node is pinned, the press goes to the canvas and pans the view.\n10. A workspace tile is selected.\n11. Empty canvas pans the view.\n\nSelecting is a deliberate act, never a side effect of dragging.",
        "identity": {
          "graphId": "gesture-ownership"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
