    {
      "id": "gesture-ownership-section-5",
      "type": "page-section",
      "label": "What a node's content answers",
      "position": {
        "x": -180,
        "y": 80
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "What a node's content answers",
        "body": "A node's content is its face. A click on it is a click on the node, and brings you a step closer to it (the navigation scheme's node ladder). The content answers on its own in two cases only: what was pressed is something a person operates (a link, a button, a field), or you are inside the node.",
        "identity": {
          "graphId": "gesture-ownership"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
