    {
      "id": "gesture-ownership-section-6",
      "type": "page-section",
      "label": "Zoom chooses views, not rules",
      "position": {
        "x": 380,
        "y": 80
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Zoom chooses views, not rules",
        "body": "Glyph, icon, summary, detail and the other bands choose what is drawn. They do not change who owns a gesture. Each surface says whether it is content-first, where the controls, links, scrolling and editing it declares answer, or canvas-first, where every other press is the canvas's.",
        "identity": {
          "graphId": "gesture-ownership"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
