    {
      "id": "gesture-ownership-section-4",
      "type": "page-section",
      "label": "Pinned nodes",
      "position": {
        "x": 380,
        "y": -280
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Pinned nodes",
        "body": "Pinning changes only who owns a press on a node's body. A press on the body of a pinned node pans the canvas, even where that body holds or scrolls content. Nothing about a pinned node is dead: its controls, links, fields, scrollbars and frames still answer, and it is moved by its title bar, where its buttons are still buttons.",
        "identity": {
          "graphId": "gesture-ownership"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
