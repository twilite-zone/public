    {
      "id": "gesture-ownership-section-3",
      "type": "page-section",
      "label": "The wheel",
      "position": {
        "x": -180,
        "y": -280
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "The wheel",
        "body": "A scroll region owns the wheel while it can scroll in the direction asked. Once it cannot, the wheel goes back to the canvas and zooms. An embedded frame owns the wheel unless its surface is canvas-first.",
