    {
      "id": "gesture-ownership-section-7",
      "type": "page-section",
      "label": "A renderer must not patch the rule",
      "position": {
        "x": -180,
        "y": 440
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "A renderer must not patch the rule",
        "body": "The law has failed when a renderer repairs itself with a private `stopPropagation`, `pointer-events` or frame exception that changes how another surface behaves. A press that is classified wrongly is fixed in the shared classification (`classifyGestureTarget`), not hidden in the renderer that noticed it.",
        "identity": {
          "graphId": "gesture-ownership"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
