    {
      "id": "gesture-contract-title",
      "type": "title",
      "label": "Gesture Ownership Contract",
      "position": {"x": -560, "y": -260},
      "width": 900,
      "height": 300,
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Gesture Ownership Contract",
        "subtitle": "Classify the target once. Give each gesture one owner. Presentation may change with zoom; interaction law does not.",
        "intent": "headline",
        "status": "draft",
        "definitionKey": "title",
        "_classBinding": {"key": "title", "sourceRef": "github://twilite-zone/public/library/classes/nodes/template-structure/title.node-class.node"}
      }
    },
    {
      "id": "gesture-contract-type",
      "type": "type-definition",
      "label": "Interaction Contract",
      "position": {"x": 400, "y": -260},
      "width": 440,
      "height": 300,
      "visible": true,
      "showLabel": false,
      "data": {
        "name": "Gesture Ownership Contract",
        "key": "gesture-ownership-contract",
        "meaning": "A normative precedence law that assigns each pointer, wheel, touch, and activation gesture to exactly one graph owner.",
        "description": "Used by native nodes, authored HTML, class-backed views, portals, scripts, and cooperative embedded surfaces.",
        "category": "contract",
        "status": "draft",
        "definitionKey": "type-definition",
        "_classBinding": {"key": "type-definition", "sourceRef": "github://twilite-zone/public/library/classes/nodes/type-definition/type-definition.node-class.node"}
      }
    },
    {
      "id": "gesture-contract-scope",
      "type": "scope",
      "label": "One Law Across Every Renderer",
      "position": {"x": -1040, "y": 180},
      "width": 440,
      "height": 320,
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "One Law Across Every Renderer",
        "body": "The host classifies the effective target before a renderer acts. Mouse, pointer, touch, keyboard activation, and wheel input use the same ownership vocabulary. Native nodes, authored HTML, portals, scripts, and same-origin frames adapt to this law instead of inventing local propagation policy.",
        "conditions": ["A gesture begins on a graph surface", "A semantic view changes", "Content crosses a renderer or iframe boundary"],
        "definitionKey": "scope",
        "_classBinding": {"key": "scope", "sourceRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/scope.node-class.node"}
      }
    },
    {
      "id": "gesture-contract-precedence",
      "type": "rule",
      "label": "Ownership Precedence",
      "position": {"x": -520, "y": 180},
      "width": 500,
      "height": 360,
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Ownership Precedence",
        "body": "Resolve the first applicable owner: (1) resize handles resize; (2) buttons, links, inputs, editable content, and declared controls activate or edit; (3) an eligible scroll region scrolls; (4) a pinned node background pans the canvas; (5) an unpinned node background drags the node; (6) empty canvas pans. Selection is explicit and never an accidental by-product of dragging.",
        "severity": "critical",
        "definitionKey": "rule",
        "_classBinding": {"key": "rule", "sourceRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/rule.node-class.node"}
      }
    },
    {
      "id": "gesture-contract-wheel",
      "type": "rule",
      "label": "Wheel And Pin Law",
      "position": {"x": 60, "y": 180},
      "width": 480,
      "height": 360,
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Wheel And Pin Law",
        "body": "A scrollable content region owns wheel input while it can scroll in the requested direction. Otherwise the wheel returns to canvas zoom. Pinning changes movement ownership only: a pinned node cannot move, its inert background becomes canvas pan, and its declared controls, links, scrolling, resizing, and editing remain available.",
        "severity": "critical",
        "definitionKey": "rule",
        "_classBinding": {"key": "rule", "sourceRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/rule.node-class.node"}
      }
    },
    {
      "id": "gesture-contract-zoom",
      "type": "rule",
      "label": "Semantic Zoom Selects Views, Not Mouse Rules",
      "position": {"x": 620, "y": 180},
      "width": 500,
      "height": 360,
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Semantic Zoom Selects Views, Not Mouse Rules",
        "body": "Glyph, icon, summary, card, detail, and editor bands choose representation. They do not define event propagation. Each rendered surface declares canvas-first or content-first behavior. Canvas-first keeps inert pixels navigational; content-first enables only the controls, scroll regions, links, and editing behaviors actually declared by that surface. Threshold hysteresis prevents ownership flicker.",
        "severity": "high",
        "definitionKey": "rule",
        "_classBinding": {"key": "rule", "sourceRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/rule.node-class.node"}
      }
    },
    {
      "id": "gesture-contract-frame",
      "type": "guardrail",
      "label": "Embedded Surfaces Must Cooperate Explicitly",
      "position": {"x": -780, "y": 660},
      "width": 500,
      "height": 340,
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Embedded Surfaces Must Cooperate Explicitly",
        "body": "A same-origin authored frame may relay normalized target classification and gesture intent to the host. A cross-origin frame is a content-first boundary unless it implements an explicit cooperative protocol. A bridge may authorize capability use, but it does not silently erase browser isolation or grant arbitrary event execution.",
        "hardStop": true,
        "definitionKey": "guardrail",
        "_classBinding": {"key": "guardrail", "sourceRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/guardrail.node-class.node"}
      }
    },
    {
      "id": "gesture-contract-antipattern",
      "type": "failure-mode",
      "label": "Renderer-Local Event Patches",
      "position": {"x": -200, "y": 660},
      "width": 500,
      "height": 340,
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Renderer-Local Event Patches",
        "body": "The contract has failed when a renderer repairs itself with isolated stopPropagation, pointer-events, edit-button, or iframe exceptions that change another surface's behavior. Missing classification must be fixed in the shared target vocabulary or adapter, not hidden in the leaf renderer.",
        "response": "block",
        "definitionKey": "failure-mode",
        "_classBinding": {"key": "failure-mode", "sourceRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/failure-mode.node-class.node"}
      }
    },
    {
      "id": "gesture-contract-procedure",
      "type": "procedure",
      "label": "Arbitrate Before Dispatch",
      "position": {"x": 380, "y": 660},
      "width": 500,
      "height": 340,
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Arbitrate Before Dispatch",
        "body": "Normalize the event, find its effective target across native and cooperative embedded boundaries, classify target kind and surface mode, select one owner by precedence, dispatch one semantic action, then record the decision for diagnostics. Renderers expose targets and execute assigned actions; they do not negotiate ownership independently.",
        "steps": ["Normalize", "Resolve effective target", "Classify", "Apply precedence", "Dispatch", "Trace"],
        "definitionKey": "procedure",
        "_classBinding": {"key": "procedure", "sourceRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/procedure.node-class.node"}
      }
    },
    {
      "id": "gesture-contract-acceptance",
      "type": "acceptance-criteria",
      "label": "People Collection Proof",
      "position": {"x": 960, "y": 660},
      "width": 520,
      "height": 360,
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "People Collection Proof",
        "body": "At desktop and mobile browsing sizes: a pinned collection-surface background pans without selecting text; wheel zoom remains reachable; controller buttons page members; inputs and Apply Size work; internal scroll regions scroll; portal and member navigation activate; resize handles resize; Edit remains available; unpinned nodes drag; saved pins survive reload; and changing semantic bands does not flicker or change these rules.",
        "status": "pending",
        "definitionKey": "acceptance-criteria",
        "_classBinding": {"key": "acceptance-criteria", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/acceptance-criteria.node-class.node"}
      }
    }
  ],
