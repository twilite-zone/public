    {"id": "gesture-edge-precedence-procedure", "type": "procedure", "source": "gesture-contract-precedence", "target": "gesture-contract-procedure", "sourcePort": "bottom", "targetPort": "top", "label": "implement with", "style": {"curved": true}},
