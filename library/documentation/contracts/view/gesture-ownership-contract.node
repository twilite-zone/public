          "reason": "auto-layout"
        }
      }
    },
    {
      "id": "gesture-contract-zoom",
      "type": "rule",
      "label": "Semantic Zoom Selects Views, Not Mouse Rules",
      "root": false,
      "position": {
        "x": 250,
        "y": 20
      },
      "width": 500,
      "height": 360,
      "ports": [
