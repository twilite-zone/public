          "version": 1,
          "state": "auto-placed",
          "source": "layout",
          "updatedAt": 1786379641762,
          "reason": "auto-layout"
        }
      }
    },
    {
      "id": "gesture-contract-precedence",
      "type": "rule",
      "label": "Ownership Precedence",
      "root": false,
      "position": {
        "x": -970,
        "y": 20
      },
      "width": 500,
      "height": 360,
      "ports": [
        {
