        {
          "id": "left",
          "label": "left",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Ownership Precedence",
        "body": "Resolve the first applicable owner: (1) resize handles resize; (2) buttons, links, inputs, editable content, and declared controls activate or edit; (3) an eligible scroll region scrolls; (4) a pinned node background pans the canvas; (5) an unpinned node background drags the node; (6) empty canvas pans. Selection is explicit and never an accidental by-product of dragging.",
        "severity": "critical",
        "definitionKey": "rule",
        "_classBinding": {
          "key": "rule",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/rule.node-class.node"
        },
        "identity": {
          "graphId": "gesture-contract-declaration"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "layout",
          "updatedAt": 1786379641762,
          "reason": "auto-layout"
        }
      }
    },
    {
      "id": "gesture-contract-wheel",
      "type": "rule",
      "label": "Wheel And Pin Law",
      "root": false,
      "position": {
        "x": -350,
        "y": 20
      },
      "width": 480,
      "height": 360,
      "ports": [
