          "source": "layout",
          "updatedAt": 1786379641762,
          "reason": "auto-layout"
        }
      }
    },
    {
      "id": "gesture-contract-frame",
      "type": "guardrail",
      "label": "Embedded Surfaces Must Cooperate Explicitly",
      "root": false,
      "position": {
        "x": 870,
