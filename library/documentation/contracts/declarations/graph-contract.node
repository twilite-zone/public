      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "graph-contract",
          "portId": "root",
          "name": "Graph Contract"
        },
        "title": "Graph Contract",
        "purpose": "Define the invariant executable core that makes a Twilite graph addressable, interpretable, and mechanically valid.",
        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "label": "Graph Contract"
        },
        "payload": "node.web.summary",
        "intent": "node",
