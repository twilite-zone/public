    {
      "id": "graph-validity-section-5",
      "type": "page-section",
      "label": "A warning when loading, an error in strict mode",
      "position": {
        "x": -180,
        "y": 80
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "A warning when loading, an error in strict mode",
        "body": "- No root (`ROOT_MISSING`). Also a warning in draft mode.\n- A node of a class when the graph does not import that class or a template that hands it on (`CLASS_WITHOUT_IMPORT`).\n- An import or export with no `ref`, or an import of a class with no key (`BRIDGE_REF_MISSING`, `BRIDGE_CLASS_KEY_MISSING`).\n- An edge to a node or port that is not there, or missing a required port (`NODE_NOT_FOUND`, `HANDLE_NOT_FOUND`, `PORT_REQUIRED`).\n- An edge that breaks its class's rule about what may connect (`EDGE_CLASS_ILLEGAL_CONNECTION`).\n- A port whose endpoint or mode is invalid (`PORT_ENDPOINT_INVALID`, `PORT_MODE_INVALID`, `PORT_BRIDGE_MODE_DEPRECATED`).\n- An expansion that does not say which root node it is (`EXPANSION_BRIDGE_NODE_ID_REQUIRED`), and a template node whose id collides with its class (`TEMPLATE_NODE_ID_COLLIDES_WITH_CLASS`).",
        "identity": {
          "graphId": "graph-validity"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
