    {
      "id": "graph-validity-masthead",
      "type": "page-masthead",
      "label": "What makes a graph valid",
      "position": {
        "x": -180,
        "y": -1000
      },
      "width": 520,
      "height": 260,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Abc"
          },
          "baseLevel": "detail"
        },
        "eyebrow": "TWILITE ZONE · CONTRACT",
        "title": "What makes a graph valid",
        "subtitle": "",
        "identity": {
