    {
      "id": "graph-validity-section-3",
      "type": "page-section",
      "label": "Loading is more forgiving than strict checking",
      "position": {
        "x": -180,
        "y": -280
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Loading is more forgiving than strict checking",
        "body": "The validator has two modes. Loading tolerates faults, so that an old file still opens and can be repaired: a fault that is an error in the strict mode is a warning on load.\n\nThe strict mode is used when a piece is extracted from a graph or expanded into one. Saving and reloading use the tolerant mode, so a save refuses only what \"What saving requires\" names, not every fault below.",
        "identity": {
          "graphId": "graph-validity"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
