    {
      "id": "graph-validity-section-4",
      "type": "page-section",
      "label": "Always an error",
      "position": {
        "x": 380,
        "y": -280
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Always an error",
        "body": "- A route pin used as a real endpoint, a missing pin, one owned by another edge, one shared by two edges, or one its own edge does not use (`ROUTE_PIN_*`).\n- Forbidden metadata in an edge's route (`FORBIDDEN_ROUTE_METADATA`).\n- More than one ground on a root or a Port (`GROUND_MULTIPLE`).\n- A boundary chain that is branched, disconnected or unclosed (`MEMBRANE_CHAIN_INCOMPLETE`).",
        "identity": {
          "graphId": "graph-validity"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
