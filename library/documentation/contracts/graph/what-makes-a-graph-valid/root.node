    {
      "id": "graph-validity-section-6",
      "type": "page-section",
      "label": "Always a warning",
      "position": {
        "x": 380,
        "y": 80
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Always a warning",
        "body": "- More than one root in a file, where the first is used (`ROOT_MULTIPLE`).\n- A Port with more connections than it takes (`PORT_OVER_CAPACITY`).\n- Port sides, render shapes and payloads that do not agree.\n- Script nodes with no script.\n- A root whose own relationships are incomplete (`ROOT_RELATIONSHIP_MISSING`).\n- Surface chains that are malformed: a cycle, a branch, a Glyph that is not last, no Glyph, a duplicate id, a default naming no Surface (`SURFACE_*`).",
        "identity": {
          "graphId": "graph-validity"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
