    {
      "id": "graph-validity-section-2",
      "type": "page-section",
      "label": "What saving requires",
      "position": {
        "x": 380,
        "y": -640
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "What saving requires",
        "body": "The root carries `identity.graphId`, `identity.name`, `identity.version`, `identity.description`, `intent.kind`, `intent.scope` and `root.kind`.\n\nAll five ways to save check this, a workspace save included, and refuse with a message that says what is missing, for example \"Save blocked: The root's identity.name is required\". Nothing else about the contents is required to save.\n\nA page opened with `?draft=1` only turns off the \"Not saveable yet\" notice. The save check still applies.",
        "identity": {
          "graphId": "graph-validity"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "ports": [
