    {
      "id": "graph-validity-section-8",
      "type": "page-section",
      "label": "Templates and validity",
      "position": {
        "x": 380,
        "y": 440
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Templates and validity",
        "body": "A template is a graph with extra authoring intent. It is never the test of whether another file is a valid graph.\n\nThe order is: first base validity, then only the capabilities the graph claims, then template guidance for new work. Standards protect execution, and templates encourage expression.",
        "identity": {
          "graphId": "graph-validity"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
