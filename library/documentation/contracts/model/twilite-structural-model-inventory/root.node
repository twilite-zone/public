          "position": {
            "side": "top",
            "offset": 0.2
          }
        }
      ],
      "outputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any",
          "position": {
            "side": "top",
            "offset": 0.2
          }
        }
      ],
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "side": "top",
          "offset": 0.2,
          "position": {
            "side": "top",
            "offset": 0.2
          }
        }
