    },
    {
      "id": "structural-model-section-3",
      "type": "page-section",
      "label": "Ports, Portals, Bridges, and edges",
      "position": {
        "x": -180,
        "y": -280
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Ports, Portals, Bridges, and edges",
        "body": "- A Port exposes a typed capability or named Surface at a node boundary. Handles are draggable UI representations of Ports; edges connect to semantic ports.\n- A Portal consumes or follows an exposed Port and never creates an ordinary node merely because it was followed.\n- An authored edge belongs to one graph document and connects nodes through explicit Port ids. Edge kind is stored in `type`; class graph in `data.classRef`.\n- Export and import nodes are Bridge ends. A Bridge is the workspace connection and is not authored as a `bridge` node.\n- Workspace navigation policy (`navigate`, `expand`, `open alongside`) is independent of security classification.",
        "identity": {
          "graphId": "structural-model"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
