      "label": "Node rendering",
      "position": {
        "x": 380,
        "y": -640
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Node rendering",
        "body": "- Nodes render through ordered `face` nodes. Durable material belongs to `content`; a face may own `data.content` directly or point to a content node.\n- The `root` is the implicit root Port. New graphs do not add a second root Port node.\n- A `surface` edge starts each Surface chain. `next-face` edges order faces from richest to smallest, and the chain ends in a `glyph`.\n- A graph may expose sparse faces. Missing smaller bands use the nearest authored face; do not create Detail, Summary, and Icon faces merely to fill bands.\n- A `ground` edge anchors entry, focus, and authored interface geometry when the graph has an inside frame. A document graph may omit ground.\n- Focus affects interaction and camera scope. It does not silently change semantic identity or rewrite the graph.",
        "identity": {
          "graphId": "structural-model"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any",
          "position": {
            "side": "top",
            "offset": 0.2
          }
        }
      ],
      "outputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any",
          "position": {
            "side": "top",
            "offset": 0.2
          }
        }
      ],
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "side": "top",
          "offset": 0.2,
          "position": {
