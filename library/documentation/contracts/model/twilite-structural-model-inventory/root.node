    {
      "id": "structural-model-section-6",
      "type": "page-section",
      "label": "Rewrite rule",
      "position": {
        "x": 380,
        "y": 80
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Rewrite rule",
        "body": "Do not bulk-normalize graphs by shape alone. For each graph:\n\n1. preserve `graphId`, `nodeId`, durable address, and semantic type;\n2. identify its root, Surfaces, faces, glyphs, exposed Ports, Portals, Bridges, and typed edges;\n3. separate graph extent from presentation geometry;\n4. migrate only rules marked settled above;\n5. defer render-size and lane rewrites until their provisional contracts are ratified;\n6. validate save/reload, navigation, semantic zoom, and edge endpoint integrity.",
        "identity": {
          "graphId": "structural-model"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
