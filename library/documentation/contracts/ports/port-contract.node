      "data": {
        "title": "Host Owns Authority",
        "body": "The host port instance declares authority. New ports default to `navigate`. Higher capability is never inferred from the target graph, the existence of a view, or renderer heuristics. Effective authority may stay the same or decrease across boundaries unless an explicit re-grant exists.",
        "severity": "high",
        "identity": {
          "graphId": "port-contract-declaration"
        },
        "classRef": "https://twilite.zone/library/classes/nodes/skill-contract/rule.node-class.node"
