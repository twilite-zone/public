        "y": -60
      },
      "width": 360,
      "height": 240,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Scope",
        "body": "Use this contract when rendering bridge nodes, exposing create or runtime affordances, showing bridge diagnostics, or deciding what authority UI belongs on a focused-graph bridge surface.",
        "conditions": [
          "A bridge node is rendered on the focused graph.",
          "The UI needs to show bridge identity, grants, scope, or target reference.",
          "The renderer decides whether a create or runtime affordance should appear.",
          "A bridge is invalid, downgraded, or missing icon or grant data."
        ],
        "description": "Bridge scope is local to the focused graph. Bridges are not semantic-zoom content and are not part of normal browser presentation.",
        "classRef": "github://twilite-zone/public/library/classes/nodes/skill-contract/scope.node-class.node"
      }
    },
