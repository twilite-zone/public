        "description": "Explicit authority array stored at `bridge.grants`.",
        "required": "true",
        "value": "[\"create\", \"runtime\", \"view\", \"mutate\"]",
        "rule": "Missing grants mean missing authority.",
        "name": "Grants",
        "valueType": "text"
