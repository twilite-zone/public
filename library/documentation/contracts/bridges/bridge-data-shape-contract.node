        "rule": "New bridge nodes should store a single canonical object at `data.bridge` containing `ref`, `resourceKind`, `scope`, and `grants`.",
        "severity": "error",
        "status": "active",
        "description": "Legacy mirrors may exist, but the canonical bridge object is the source of truth.",
