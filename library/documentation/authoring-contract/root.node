    {
      "id": "authoring-contract-contract",
      "type": "page-section",
      "label": "Contract",
      "position": {
        "x": -180,
        "y": -280
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Contract",
        "body": "A switch states: its name; its scope (node, edge, handle or graph); the path it is written at; its value type, default and the values it takes; its effect; the modes it applies in (edit, browse); whether a Properties panel control exists; where it is written down in code; its status; and the policy that governs it or overrides it.\n\nThe script API is generic (`updateNode`, `updateView`, `createNode`, `applyDeltas`). Any switch can be written by a Method that declares the effect which allows it. The contract says what can be written and where; the API says how.",
        "identity": {
          "graphId": "authoring-contract"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
