        "identity": {
          "graphId": "authoring-contract",
          "nodeId": "authoring-contract",
          "name": "Authoring contract",
          "version": "0.1.0",
          "description": "Everything that can be set on a node, an edge, a handle or a graph, described once: what each switch is, where it is written, and the decisions the app makes for it."
        },
        "intent": {
          "kind": "specification",
          "scope": "authoring"
        },
        "glyph": {
          "kind": "icon",
          "name": "Tune"
        },
        "name": "Authoring contract",
        "document": {
