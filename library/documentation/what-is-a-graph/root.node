      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "An edge is a relationship",
        "body": "An edge connects two nodes and says how they relate: this task belongs to that goal, this question blocks that task. The relationship is written down, so nobody has to work it out by rereading.",
