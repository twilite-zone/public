    {
      "id": "what-is-a-graph-section-4",
      "type": "page-section",
      "label": "A graph is kept as one file",
      "position": {
        "x": 380,
        "y": -280
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "A graph is kept as one file",
        "body": "A `.node` file is plain text with its own address. It says what is in the graph, what it is called, and how it should look. Because it is plain text, Twilite can open it, and so can ChatGPT or Gemini. That is why your AI can write one and you can read it.\n\nSeen from outside, a graph is itself a node, so one graph can sit inside another.",
        "identity": {
          "graphId": "what-is-a-graph"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
