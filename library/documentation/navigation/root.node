    {
      "id": "navigation-removes",
      "type": "page-section",
      "label": "What this removes",
      "position": {
        "x": 380,
        "y": 440
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "What this removes",
        "body": "Things graphs or people do today that the scheme makes unnecessary.\n\n- The “way back” Portal beside every scene. Back, the trail and the trunks do that job.\n- The choice between “open” and “open alongside”. Going through always opens beside.\n- Different behaviour for a Portal, a link and a card. They are one thing: a way through.",
        "identity": {
          "graphId": "navigation-scheme"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
