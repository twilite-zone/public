    {
      "id": "navigation-editing",
      "type": "page-section",
      "label": "When editing",
      "position": {
        "x": -180,
        "y": 440
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "When editing",
        "body": "Editing adds to this; it does not change it. The first two steps are the same: the camera comes to a thing, then it takes focus. The third step is where editing differs: going into a node means editing it, not reading it.\n\nSo in edit mode a Portal is not gone through by clicking it a third time. That keeps a click from ever leaving the graph you are working on by surprise. A double-click is deliberate, so it goes through a Portal in either mode.",
        "identity": {
          "graphId": "navigation-scheme"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
