          "name": "Navigation",
          "version": "0.1.0",
          "description": "One scheme for moving around the workspace, a graph, and what a graph holds: what a click does to each kind of thing, at each distance."
        },
        "intent": {
          "kind": "specification",
          "scope": "navigation"
        },
        "glyph": {
          "kind": "icon",
          "name": "Explore"
        },
        "name": "Navigation",
        "document": {
