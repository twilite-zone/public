    {
      "id": "navigation-idea",
      "type": "page-section",
      "label": "The idea",
      "position": {
        "x": -180,
        "y": -640
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "The idea",
        "body": "Everything in Twilite is seen at some distance. Far away a graph is a mark; nearer, a card; nearer still, a place with things in it. The same is true of a node inside a graph.\n\nSo one rule can cover all of it. **A click on a thing brings you one step closer to that thing.** Stepping out takes you one step back. Nothing else is needed to move around, and nothing has to be learned twice.",
        "identity": {
          "graphId": "navigation-scheme"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
