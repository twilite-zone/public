      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Settings"
          },
          "baseLevel": "detail"
        },
        "title": "Keys and modifiers",
        "rows": [
          {
            "label": "Ctrl or ⌘ + click",
            "value": "Selects one more, or takes one away, as in a file explorer. Never travels. On a link in a page’s text it opens the graph beside this one and leaves you where you are."
          },
          {
            "label": "Shift + click",
            "value": "Selects a run, as in a file explorer. Never travels."
          },
          {
            "label": "Middle click",
            "value": "Opens it in a new browser tab."
          },
          {
            "label": "Double-click",
            "value": "The end of the line. It does the last step for that thing at once, from any distance: a Portal is gone through, even when it is only an icon or a mark; a node is entered; a graph’s tile is entered."
          },
          {
            "label": "→ and ←",
            "value": "Walk: to the next node along the edge leaving the one in focus, and back again. Where there is more than one way on, the edges are offered by name."
          },
          {
            "label": "Enter",
            "value": "The same as a click on the thing in focus: one step closer."
          },
          {
            "label": "Escape",
            "value": "Step out."
          }
        ],
