    {
      "id": "navigation-single",
      "type": "page-section",
      "label": "Without the workspace",
      "position": {
        "x": 380,
        "y": -280
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "Without the workspace",
        "body": "An account without the workspace has one graph open at a time, as a web browser has one page. The outermost distance, the workspace, is not there: a graph is never seen from outside, so it has no tile, no border and nothing beside it.\n\nThe five rules hold, with one difference. Going through a Portal or a link puts you in the other graph completely, in place of the one you were in. Nothing is lost by it: Back returns you to the graph you left, at the end of the connection you came through.\n\nStepping out stops one level sooner. From a node it returns you to the graph; from the graph there is nowhere further out to go.",
        "identity": {
          "graphId": "navigation-scheme"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
