        "semanticLevel": "summary",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:#f6faf9;border:.9cqw solid #0f766e;display:flex;align-items:center;gap:6cqw;color:#1f2937;overflow:hidden'><div style='flex:0 0 24cqw'><svg viewBox='0 0 64 64' style='width:100%;height:100%;display:block' aria-hidden='true'><g fill='none' stroke='#0f766e' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'><path d='M16 58V8'/><path d='M16 10H48L40 22L48 34H16'/></g></svg></div><div style='min-width:0;flex:1'><div style='font:700 3.2cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#0f766e'>Plan</div><div style='font:700 8.2cqw/1.12 Georgia,Iowan Old Style,Palatino Linotype,serif;margin:2cqw 0 1.2cqw;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>Name the aim</div><div style='font:600 3.6cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#334155'>2 phases · 3 steps</div><div style='margin-top:2cqw;font:700 3.8cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>1 of 3 steps done</div><div style='margin-top:1.4cqw;font:600 3.2cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>1 milestone · 1 risk</div><div style='margin-top:2cqw;display:inline-block;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:700 3cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase'>1 to check</div></div></div></div>"
        },
        "memo": "The Summary: the plan as a card. The Method writes it too.",
