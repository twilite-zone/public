          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "memo": "The one export of this template: the Method that derives a plan's views and glyph from its cards, and the Aim, Phase, Step, Milestone, Risk and Constraint classes it hands on.",
        "identity": {
          "graphId": "plan-declaration"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1793397964948,
          "reason": "node-drag"
        },
        "bridge": {
          "ref": "tlz://twilite.zone/library/templates/plan/root.node",
          "resourceKind": "graph",
          "scope": "focused-graph",
          "grants": [
            "read",
