        },
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:clamp(18px,6.09cqw,41px);background:#ffffff;border-radius:0;border:1px solid #cbd5e1;border-top:1.5cqw solid #6d28d9;font-family:system-ui;color:#0f172a;overflow:auto'><div style='font-weight:800;font-size:clamp(8px,2.61cqw,17px);font-family:system-ui;letter-spacing:2px;color:#6d28d9;text-transform:uppercase;margin-bottom:10px'>Page Masthead</div><p style='margin:0 0 12px;max-width:52ch;font-weight:400;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;font-family:system-ui;color:#0f172a'>A page's one headline block, always first. Its optional <strong>eyebrow</strong> becomes a small kicker above the title; its <strong>title</strong> becomes the big heading; its optional <strong>subtitle</strong> becomes the line beneath it.</p><p style='margin:0;max-width:52ch;font-weight:400;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;font-family:system-ui;color:#0f172a'>A page has at most one masthead, and it always renders first.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
