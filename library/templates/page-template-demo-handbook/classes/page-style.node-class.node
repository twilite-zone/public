    {
      "id": "page-style-detail-view",
      "type": "face",
      "label": "Detail",
      "position": {
        "x": 0,
        "y": -420
      },
      "width": 460,
      "height": 280,
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.detail"
        },
        "identity": {
          "graphId": "page-style-class",
          "nodeId": "page-style-detail-view"
        },
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:clamp(18px,6cqw,41px);background:#ffffff;border-radius:16px;border:1px solid #e2e8f0;font-family:system-ui;color:#0f172a;overflow:auto'><div style='font-weight:800;font-size:clamp(8px,2.61cqw,17px);letter-spacing:2px;color:#7c3aed;text-transform:uppercase;margin-bottom:10px'>Page Style</div><p style='margin:0 0 12px;max-width:52ch;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;color:#334155'>How a page looks, in one place. <strong>Paper</strong>, <strong>ink</strong>, <strong>muted</strong>, <strong>accent</strong> and <strong>line</strong> are colours; <strong>heading</strong> and <strong>body</strong> pick a typeface (serif, slab, sans, display or mono); <strong>layout</strong> is <em>article</em>, <em>poster</em>, <em>handbook</em>, <em>slides</em>, <em>timeline</em> or <em>catalog</em>.</p><p style='margin:0;max-width:52ch;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;color:#334155'>Leave a field empty to keep the Page Template's own. A page has at most one Page Style, and it paints nothing itself.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791496022567,
          "reason": "node-drag"
        }
      }
    },
