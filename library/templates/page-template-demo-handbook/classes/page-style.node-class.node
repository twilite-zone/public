        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:clamp(13px,5.56cqw,29px);background:#ffffff;border-radius:16px;border:1px solid #e2e8f0;overflow:auto;font-family:system-ui;color:#0f172a'><div style='font-weight:800;font-size:clamp(8px,3.33cqw,17px);letter-spacing:.18em;color:#7c3aed;margin-bottom:12px'>PAGE STYLE</div><div style='font-weight:850;font-size:clamp(17px,7.22cqw,38px);line-height:1.2;margin-bottom:10px'>{{data.layout || \"article\"}}</div><div style='display:flex;gap:8px'><span style='display:inline-block;width:1.4em;height:1.4em;border-radius:4px;border:1px solid rgba(0,0,0,.2);background:{{data.paper || \"#ffffff\"}};vertical-align:middle'></span><span style='display:inline-block;width:1.4em;height:1.4em;border-radius:4px;border:1px solid rgba(0,0,0,.2);background:{{data.ink || \"#0f172a\"}};vertical-align:middle'></span><span style='display:inline-block;width:1.4em;height:1.4em;border-radius:4px;border:1px solid rgba(0,0,0,.2);background:{{data.accent || \"#6d28d9\"}};vertical-align:middle'></span><span style='display:inline-block;width:1.4em;height:1.4em;border-radius:4px;border:1px solid rgba(0,0,0,.2);background:{{data.line || \"#cbd5e1\"}};vertical-align:middle'></span></div></div>"
        },
