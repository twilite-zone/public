        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:4.4cqw;background:#101B29;color:#F0F7FF;border:1px solid #397D8E;border-radius:10px;display:flex;flex-direction:column;overflow:hidden;font-family:system-ui'><div style='font:800 2.5cqw/1.2 system-ui;letter-spacing:.12em;color:#72F0E5;border-bottom:1px solid #397D8E;padding-bottom:1.3cqw'>AGENT DEFINITION · DRAFT</div><div style='display:flex;gap:3cqw;align-items:center;margin-top:2cqw;'><div style='flex:1;min-width:0;font:850 7.2cqw/1.03 system-ui;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>Name the agent</div><div style='width:20cqw;flex:none'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Agent Profile'><rect x='3' y='3' width='114' height='114' rx='12' fill='#112B3C' stroke='#397D8E' stroke-width='2'/><g color='#72F0E5'><circle cx='60' cy='52' r='22' fill='none' stroke='currentColor' stroke-width='5'/><path d='M60 30V15M38 52H22M82 52h16M43 67 29 83M77 67l14 16M29 98h62' stroke='currentColor' stroke-width='5' stroke-linecap='round'/><circle cx='60' cy='52' r='6' fill='currentColor'/></g></svg></div></div><div style='flex:1;min-height:0;margin-top:2cqw;overflow:hidden;color:#DCE8F2;font:500 3.4cqw/1.35 system-ui'>Describe the agent&#39;s continuing responsibilities.<div style='display:flex;gap:1.2cqw;margin:2cqw 0'><div style='flex:1;min-width:0;border:1px solid #32546C;border-radius:6px;padding:1.5cqw'><div style='color:#FFD08A;font:800 5cqw/1.1 system-ui'>1</div><div style='font:600 2.1cqw/1.15 system-ui;color:#B6CBE7'>contracts</div></div><div style='flex:1;min-width:0;border:1px solid #32546C;border-radius:6px;padding:1.5cqw'><div style='color:#D5BCFF;font:800 5cqw/1.1 system-ui'>1</div><div style='font:600 2.1cqw/1.15 system-ui;color:#B6CBE7'>instruc