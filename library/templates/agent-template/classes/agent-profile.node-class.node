          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:4.5cqw;background:#112B3C;color:#F0F7FF;border:1px solid #397D8E;border-radius:10px;display:flex;flex-direction:column;overflow:auto;font-family:system-ui'><div style='font:800 3.7cqw/1.2 system-ui;letter-spacing:.12em;color:#72F0E5;border-bottom:1px solid #397D8E;padding-bottom:1.4cqw'>AGENT PROFILE</div><div style='display:flex;align-items:center;gap:3cqw;margin:2cqw 0;'><div style='flex:1;min-width:0;font:800 6.5cqw/1.07 system-ui;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>{{data.title || label}}</div><div style='width:21cqw;flex:none'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Agent Profile'><rect x='3' y='3' width='114' height='114' rx='12' fill='#112B3C' stroke='#397D8E' stroke-width='2'/><g color='#72F0E5'><circle cx='60' cy='52' r='22' fill='none' stroke='currentColor' stroke-width='5'/><path d='M60 30V15M38 52H22M82 52h16M43 67 29 83M77 67l14 16M29 98h62' stroke='currentColor' stroke-width='5' stroke-linecap='round'/><circle cx='60' cy='52' r='6' fill='currentColor'/></g></svg></div></div><div style='margin:1.6cqw 0;'><div style='font:800 3cqw/1.15 system-ui;color:#72F0E5;text-transform:uppercase;letter-spacing:.08em'>Role</div><div style='font:500 3.4cqw/1.32 system-ui;color:#DCE8F2;white-space:pre-line;overflow-wrap:anywhere'>{{data.role}}</div></div><div style='margin:1.6cqw 0;'><div style='font:800 3cqw/1.15 system-ui;color:#72F0E5;text-transform:uppercase;letter-spacing:.08em'>Accountable owner</div><div style='font:500 3.4cqw/1.32 system-ui;color:#DCE8F2;white-space:pre-line;overflow-wrap:anywhere'>{{data.owner}}</div></div><div style='margin:1.6cqw 0;'><div style='font:800 3cqw/1.15 system-ui;color:#72F0E5;text-transform:uppercase;letter