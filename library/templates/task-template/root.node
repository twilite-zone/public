          "nodeId": "task-template",
          "name": "Task Template",
          "version": "1.0.0",
          "description": "A task is a graph with one goal, its work items and its open questions. Its views are derived from them, so its status is readable without opening it.",
          "updatedAt": "2026-10-19T16:00:00.000Z"
        },
