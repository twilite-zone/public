    {
      "id": "task-template-landing",
      "type": "content",
      "label": "Public Arrival Template",
      "position": {
        "x": 560,
        "y": -420
      },
      "width": 633.5114535153646,
      "height": 270.2697209374306,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "task-template"
        },
        "content": {
          "kind": "markdown",
          "value": "# Task Template\n\nA task is a graph with one **goal**, its **work items** and its **open questions**.\n\nThe Detail, Summary and Glyph are not written by hand: the Method reads the graph and writes them, so the status is on every one of them. The views share one 3:2 shape, measured from their own width, and the glyph is the status.\n\nChange a work item's status and the views follow."
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791502752029,
          "reason": "node-drag"
        }
      }
    },
    {
      "id": "task-template-derive-method",
      "type": "method",
      "label": "Derive the task views",
      "position": {
        "x": 200,
        "y": 1300
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the task views",
        "parameters": [],
        "source": "// Derives the task's views from the task itself: nothing is typed into a summary.\n// It reads the goal, the work items (task) and the open questions, works out one status, and writes the Detail and Summary\n// views and the Glyph. It writes only those four, which its declared effects say.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\n\n// One status vocabulary, used at every size. `mark` is the Icon's symbol, `glyph` a Material icon name.\nconst STATUS = {\n  todo: { label: 'To do', mark: '○', glyph: 'RadioButtonUnchecked', ink: '#475569', tint: '#f1f5f9', line: '#cbd5e1' },\n  'in-progress': { label: 'In progress', mark: '▶', glyph: 'PlayCircleOutline', ink: '#1d4ed8', tint: '#eff6ff', line: '#bfdbfe' },\n  blocked: { label: 'Blocked', mark: '■', glyph: 'Block', ink: '#b91c1c', tint: '#fef2f2', line: '#fecaca' },\n  waiting: { label: 'Waiting', mark: '…', glyph: 'HourglassEmpty', ink: '#b45309', tint: '#fffbeb', line: '#fde68a' },\n  done: { label: 'Done', mark: '✓', glyph: 'CheckCircle', ink: '#15803d', tint: '#f0fdf4', line: '#bbf7d0' },\n  cancelled: { label: 'Cancelled', mark: '×', glyph: 'Cancel', ink: '#64748b', tint: '#f8fafc', line: '#e2e8f0' }\n};\nconst statusOf = (value) => (STATUS[clean(value)] ? clean(value) : 'todo');\nconst finished = (status) => status === 'done' || status === 'cancelled';\n\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst byId = new Map(nodes.map((node) => [node.id, node]));\nconst of = (type) => edges.filter((edge) => clean(edge.type) === type);\nconst titleOf = (node) => clean(node?.data?.title || node?.label);\n\n// The relationships say more than the status fields do. A decision that resolves a question answers it; something waiting on a\n// thing that is not resolved is blocked, whatever its own status field says; precedes puts work in order; contains says what is the goal's.\nconst resolvedByDecision = new Set(of('resolves').map((edge) => edge.target));\nconst isResolved = (node) => {\n  if (!node) return true;\n  const own = clean(node.data?.status);\n  if (clean(node.type) === 'open-question') return own === 'answered' || resolvedByDecision.has(node.id);\n  if (clean(node.type) === 'decision') return ['decided', 'accepted', 'done'].includes(own);\n  return own === 'done' || own === 'cancelled';\n};\nconst blockersOf = (node) => of('blocked-by').filter((edge) => edge.source === node.id).map((edge) => byId.get(edge.target)).filter((target) => target && !isResolved(target));\n// Work is blocked when its own status says so, or when something it is blocked by is not yet resolved.\nconst stateOf = (node) => {\n  const own = statusOf(node.data?.status);\n  return !finished(own) && blockersOf(node).length ? 'blocked' : own;\n};\nconst reasonOf = (node) => clean(node.data?.blockedReason) || (blockersOf(node)[0] ? `Waiting on ${titleOf(blockersOf(node)[0])}` : '');\n\nconst goal = nodes.find((node) => clean(node.type) === 'goal');\n// What the goal contains, however deep; with no contains edges, every task.\nconst contained = new Set();\nconst gather = (id) => { for (const edge of of('contains').filter((e) => e.source === id)) if (!contained.has(edge.target)) { contained.add(edge.target); gather(edge.target); } };\nif (goal) gather(goal.id);\nconst tasks = nodes.filter((node) => clean(node.type) === 'task');\nconst bound = of('contains').length ? tasks.filter((node) => contained.has(node.id)) : tasks;\n// In order: work that comes after other work (precedes) follows it.\nconst depthOf = (node, seen = new Set()) => {\n  if (seen.has(node.id)) return 0;\n  seen.add(node.id);\n  const before = of('precedes').filter((edge) => edge.target === node.id).map((edge) => byId.get(edge.source)).filter(Boolean);\n  return before.length ? 1 + Math.max(...before.map((one) => depthOf(one, new Set(seen)))) : 0;\n};\nconst items = bound.map((node, index) => ({ node, index, depth: depthOf(node) })).sort((x, y) => x.depth - y.depth || x.index - y.index).map(({ node }) => node);\nconst questions = nodes.filter((node) => clean(node.type) === 'open-question');\nconst open = questions.filter((node) => !isResolved(node));\nconst counted = items.filter((node) => stateOf(node) !== 'cancelled');\nconst doneCount = counted.filter((node) => stateOf(node) === 'done').length;\nconst total = counted.length;\n\n// One status for the whole task.\nconst goalStatus = statusOf(goal?.data?.status);\nlet status;\nif (finished(goalStatus)) status = goalStatus;\nelse if (items.some((node) => stateOf(node) === 'blocked')) status = 'blocked';\nelse if (total && doneCount === total) status = 'done';\nelse if (items.some((node) => stateOf(node) === 'in-progress') || doneCount > 0) status = 'in-progress';\nelse if (items.some((node) => stateOf(node) === 'waiting')) status = 'waiting';\nelse status = 'todo';\nconst look = STATUS[status];\n\n// What happens next, or what is in the way.\nconst blocker = items.find((node) => stateOf(node) === 'blocked');\nconst readyToStart = (node) => of('precedes').filter((edge) => edge.target === node.id).every((edge) => isResolved(byId.get(edge.source)));\nconst live = items.find((node) => stateOf(node) === 'in-progress') || items.find((node) => stateOf(node) === 'todo' && readyToStart(node)) || items.find((node) => stateOf(node) === 'todo');\nconst next = status === 'blocked'\n  ? reasonOf(blocker) || `${titleOf(blocker)} is blocked`\n  : status === 'done' || status === 'cancelled' ? '' : titleOf(live);\nconst title = titleOf(goal) || 'Untitled task';\nconst owner = clean(goal?.data?.owner);\nconst percent = total ? Math.round((doneCount / total) * 100) : 0;\nconst asked = open.length ? `${open.length} open question${open.length === 1 ? '' : 's'}` : 'No open questions';\n\nconst FONT = 'system-ui,-apple-system,Segoe UI,sans-serif';\nconst frame = (inner, extra = '') => `<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;min-height:100%;overflow:hidden;font-family:${FONT};${extra}'>${inner}</div>`;\nconst chip = (state, size = 3.6) => {\n  const s = STATUS[state];\n  return `<span style='display:inline-block;padding:.3cqw 2.4cqw;border-radius:2.4cqw;background:${s.tint};color:${s.ink};border:1px solid ${s.line};font-weight:600;font-size:${size}cqw;line-height:1.4'>${esc(s.label)}</span>`;\n};\nconst bar = `<div style='height:1.8cqw;border-radius:1cqw;background:#e2e8f0;overflow:hidden'><div style='width:${percent}%;height:100%;background:${look.ink}'></div></div>`;\n\nconst summary = frame(\n  `<div style='display:flex;justify-content:space-between;align-items:center'>${chip(status)}<span style='font-size:3.6cqw;color:#64748b'>${doneCount} of ${total}</span></div>`\n  + `<div style='font-weight:600;font-size:5.6cqw;line-height:1.2;color:#0f172a'>${esc(title)}</div>${bar}`\n  + (next ? `<div style='font-size:3.8cqw;line-height:1.3;color:${status === 'blocked' ? '#b91c1c' : '#334155'}'>${status === 'blocked' ? '' : 'Next: '}${esc(next)}</div>` : '')\n  + `<div style='margin-top:auto;display:flex;justify-content:space-between;font-size:3.4cqw;color:${open.length ? '#b45309' : '#64748b'}'><span>${esc(asked)}</span><span>${esc(owner)}</span></div>`,\n  `padding:5cqw 6cqw;border-radius:5cqw;background:#ffffff;border:1px solid ${status === 'blocked' ? look.line : '#e2e8f0'};display:flex;flex-direction:column;gap:2.6cqw`\n);\n\n\n// The Detail: a page for the task. A header, what needs the owner, three lanes of work, and what done means.\nconst card = (node) => {\n  const state = stateOf(node);\n  const s = STATUS[state];\n  const edge = state === 'blocked' ? `border:1px solid ${s.line};background:${s.tint}` : state === 'in-progress' ? `border:1px solid ${s.line}` : 'border:1px solid #e2e8f0';\n  return `<div style='${edge};border-radius:2cqw;padding:1.6cqw 2.4cqw;background:#ffffff;font-size:3.5cqw;line-height:1.25;color:${finished(state) ? '#64748b' : '#0f172a'}${state === 'cancelled' ? ';text-decoration:line-through' : ''}'>${esc(node.data?.title || node.label)}</div>`;\n};\nconst lane = (name, list, tone = '#64748b') => `<div style='background:#f8fafc;border-radius:2.6cqw;padding:2cqw;display:flex;flex-direction:column;gap:1.6cqw;min-width:0'><div style='font-size:3cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:${tone}'>${name}${list.length ? ` · ${list.length}` : ''}</div>${list.map(card).join('')}</div>`;\nconst inState = (...states) => items.filter((node) => states.includes(stateOf(node)));\nconst wanted = [\n  ...items.filter((node) => stateOf(node) === 'blocked').map((node) => ({ mark: '■', text: `${clean(node.data?.title || node.label)}: ${reasonOf(node) || 'blocked'}` })),\n  ...open.map((node) => ({ mark: '?', text: clean(node.data?.title || node.label) }))\n];\nconst needs = wanted.length\n  ? `<div style='border:1px solid #fecaca;background:#fef2f2;color:#b91c1c;border-radius:2.6cqw;padding:2cqw 2.8cqw;display:flex;flex-direction:column;gap:.8cqw;font-size:3.4cqw;line-height:1.3'><div style='font-weight:600'>Needs you</div>${wanted.map((w) => `<div style='display:flex;gap:2cqw'><span>${w.mark}</span><span>${esc(w.text)}</span></div>`).join('')}</div>`\n  : '';\nconst criteria = (Array.isArray(goal?.data?.successMetrics) ? goal.data.successMetrics : [])\n  .map((metric) => `<span style='white-space:nowrap'>${status === 'done' ? '✓' : '○'} ${esc(metric)}</span>`).join('');\nconst ring = `<div style='width:9.5cqw;height:9.5cqw;border-radius:50%;background:conic-gradient(${look.ink} 0 ${percent}%,#e2e8f0 0);display:flex;align-items:center;justify-content:center;flex:none'><div style='width:7.2cqw;height:7.2cqw;border-radius:50%;background:#ffffff;display:flex;align-items:center;justify-content:center;font-size:2.7cqw;font-weight:600;color:#0f172a'>${doneCount}/${total}</div></div>`;\nconst detail = frame(\n  `<div style='display:flex;align-items:center;gap:3cqw'>${ring}<div style='flex:1;min-width:0'><div style='font-weight:600;font-size:4.6cqw;line-height:1.2;color:#0f172a'>${esc(title)}</div><div style='font-size:3.2cqw;color:#64748b'>${esc(owner)}</div></div>${chip(status, 3.2)}</div>`\n  + needs\n  + `<div style='display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2cqw;flex:1;min-height:0;overflow:auto'>${lane('Next', inState('todo', 'waiting'))}${lane('Doing', inState('in-progress', 'blocked'), '#1d4ed8')}${lane('Done', inState('done', 'cancelled'), '#15803d')}</div>`\n  + (criteria ? `<div style='display:flex;flex-wrap:wrap;gap:1cqw 3cqw;font-size:3cqw;color:#64748b'><span style='font-weight:600'>Done when</span>${criteria}</div>` : ''),\n  'padding:3.4cqw 4cqw;border-radius:5cqw;background:#ffffff;border:1px solid #e2e8f0;display:flex;flex-direction:column;gap:2.4cqw'\n);\n\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary]]) {\n  const face = faceFor(level);\n  if (face) await api.updateView(face.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'icon', name: look.glyph, color: look.ink } } });\nreturn { status, done: doneCount, total, open: open.length, next };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "task-template-detail",
              "task-template-summary",
              "task-template-glyph"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "task-template-declaration"
        }
      }
    },
