    {
      "id": "task-template-bridge-open-question",
      "type": "import",
      "label": "Open Question Class",
      "position": {
        "x": -716,
        "y": 384
      },
      "width": 320,
      "height": 140,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
