        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;min-height:100%;overflow:hidden;font-family:system-ui,-apple-system,Segoe UI,sans-serif;padding:3.4cqw 4cqw;border-radius:5cqw;background:#ffffff;border:1px solid #e2e8f0;display:flex;flex-direction:column;gap:2.4cqw'><div style='display:flex;align-items:center;gap:3cqw'><div style='width:9.5cqw;height:9.5cqw;border-radius:50%;background:conic-gradient(#1d4ed8 0 33%,#e2e8f0 0);display:flex;align-items:center;justify-content:center;flex:none'><div style='width:7.2cqw;height:7.2cqw;border-radius:50%;background:#ffffff;display:flex;align-items:center;justify-content:center;font-size:2.7cqw;font-weight:600;color:#0f172a'>1/3</div></div><div style='flex:1;min-width:0'><div style='font-weight:600;font-size:4.6cqw;line-height:1.2;color:#0f172a'>Name the goal</div><div style='font-size:3.2cqw;color:#64748b'>Owner</div></div><span style='display:inline-block;padding:.3cqw 2.4cqw;border-radius:2.4cqw;background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;font-weight:600;font-size:3.2cqw;line-height:1.4'>In progress</span></div><div style='border:1px solid #fecaca;background:#fef2f2;color:#b91c1c;border-radius:2.6cqw;padding:2cqw 2.8cqw;display:flex;flex-direction:column;gap:.8cqw;font-size:3.4cqw;line-height:1.3'><div style='font-weight:600'>Needs you</div><div style='display:flex;gap:2cqw'><span>?</span><span>What is not yet decided?</span></div></div><div style='display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2cqw;flex:1;min-height:0;overflow:auto'><div style='background:#f8fafc;border-radius:2.6cqw;padding:2cqw;display:flex;flex-direction:column;gap:1.6cqw;min-width:0'><div style='font-size:3cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#64748b'>Next · 1</div><div style='border:1px solid #e2e8f0;border-radius:2cqw;padding:1.6cqw 2.4cqw;background:#ffffff;font-size:3.5cqw;line-height:1.25;color:#0f172a'>Start the third work item</div></div><div style='background:#f8fafc;border-radius:2.6cqw;padding:2cqw;display:flex;flex-direction:column;gap:1.6cqw;min-width:0'><div style='font-size:3cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#1d4ed8'>Doing · 1</div><div style='border:1px solid #bfdbfe;border-radius:2cqw;padding:1.6cqw 2.4cqw;background:#ffffff;font-size:3.5cqw;line-height:1.25;color:#0f172a'>Work on the second work item</div></div><div style='background:#f8fafc;border-radius:2.6cqw;padding:2cqw;display:flex;flex-direction:column;gap:1.6cqw;min-width:0'><div style='font-size:3cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#15803d'>Done · 1</div><div style='border:1px solid #e2e8f0;border-radius:2cqw;padding:1.6cqw 2.4cqw;background:#ffffff;font-size:3.5cqw;line-height:1.25;color:#64748b'>Finish the first work item</div></div></div><div style='display:flex;flex-wrap:wrap;gap:1cqw 3cqw;font-size:3cqw;color:#64748b'><span style='font-weight:600'>Done when</span><span style='white-space:nowrap'>○ The first thing that must be true.</span><span style='white-space:nowrap'>○ The second thing that must be true.</span></div></div>"
        },
