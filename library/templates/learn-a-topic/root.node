    {
      "id": "learn-a-topic-derive-method",
      "type": "method",
      "label": "Derive the study guide views",
      "position": {
        "x": 190,
        "y": 1233
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the study guide views",
        "parameters": [],
        "source": "// Derives a study guide's views from its cards: nothing is typed into a view.\n// It reads the Topic, its Concepts (each with how well it is known: not yet, shaky or solid), the order they are to be learned in (a `prepares` edge runs from a prerequisite to the concept that needs it),\n// the Resources that explain each concept (`explained-by`) and the Gaps still open about it (`has-gap`). It writes the Detail (a study guide, in learning order), the Summary (a card with a progress bar), the\n// Icon (a lightbulb) and the Glyph, and only those, which its declared effects say. It counts how many concepts are in each state and says where to start: the first concept in the order that is not yet solid\n// and whose prerequisites all are. It gives no score and no grade. Anything a card marks `check` (\"I am not sure this is right\") is gathered in a notice at the top of the page and on the card.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst SERIF = 'Georgia,Iowan Old Style,Palatino Linotype,serif'; const SANS = 'Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'; const MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst SKY = '#0369a1'; const INK = '#1f2937'; const PAPER = '#f8fbfd'; const MUTED = '#64748b'; const AMBER = '#b45309'; const GREEN = '#15803d'; const ROSE = '#be185d'; const OLIVE = '#4d7c0f'; const ORANGE = '#c2410c'; const GREY = '#94a3b8';\n\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst ofType = (type) => nodes.filter((node) => clean(node.type) === type);\nconst byId = (id) => nodes.find((node) => node.id === id);\nconst nameOf = (node) => clean(node?.data?.title || node?.label) || 'Untitled';\nconst topic = ofType('topic')[0] || null;\nconst concepts = ofType('concept');\nconst edgesOf = (type) => edges.filter((e) => clean(e.type) === type);\n\nconst stateOf = (concept) => { const value = clean(concept.data?.confidence).toLowerCase(); return value === 'solid' || value === 'shaky' ? value : 'unknown'; };\nconst STATE = { solid: { label: 'Solid', colour: GREEN }, shaky: { label: 'Shaky', colour: AMBER }, unknown: { label: 'Not yet', colour: GREY } };\n\n// the order to learn in: each concept after the ones that prepare it, ties in the order the cards were written\nconst prereqs = new Map(concepts.map((c) => [c.id, []]));\nfor (const e of edgesOf('prepares')) if (prereqs.has(e.target) && prereqs.has(e.source) && e.source !== e.target) prereqs.get(e.target).push(e.source);\nconst order = []; const placed = new Set();\nfor (let pass = 0; pass < concepts.length + 1 && order.length < concepts.length; pass += 1) {\n  for (const c of concepts) if (!placed.has(c.id) && prereqs.get(c.id).every((p) => placed.has(p))) { order.push(c); placed.add(c.id); }\n}\nfor (const c of concepts) if (!placed.has(c.id)) order.push(c); // a loop of prerequisites: keep the rest in the order written\n\nconst resourcesOf = (c) => edgesOf('explained-by').filter((e) => e.source === c.id).map((e) => byId(e.target)).filter((n) => n && clean(n.type) === 'resource');\nconst gapsOf = (c) => edgesOf('has-gap').filter((e) => e.source === c.id).map((e) => byId(e.target)).filter((n) => n && clean(n.type) === 'gap');\nconst next = order.find((c) => stateOf(c) !== 'solid' && prereqs.get(c.id).every((p) => stateOf(byId(p)) === 'solid')) || null;\nconst count = (state) => concepts.filter((c) => stateOf(c) === state).length;\nconst solid = count('solid'); const shaky = count('shaky'); const unknown = count('unknown');\nconst allGaps = order.flatMap((c) => gapsOf(c).map((gap) => ({ concept: c, gap })));\nconst flagged = [topic, ...concepts, ...ofType('resource'), ...ofType('gap')].filter((node) => node && node.data?.check === true);\nconst name = topic ? nameOf(topic) : 'Name the topic';\nconst lead = clean(topic?.data?.body);\nconst startLine = !concepts.length ? 'Add the first concept' : (next ? `Start with ${nameOf(next)}` : (solid === concepts.length ? 'Every concept is solid' : 'Every concept in reach is solid'));\n\nconst flag = (node) => (node?.data?.check === true ? `<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span>` : '');\nconst heading = (text) => `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${SKY};margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(3,105,161,.35)'>${text}</div>`;\nconst para = (text) => (clean(text) ? `<div style='font:400 1.7cqw/1.55 ${SERIF};color:#334155;margin-top:.4cqw'>${esc(text)}</div>` : '');\nconst chip = (state) => `<span style='display:inline-block;margin-left:1.2cqw;padding:.2cqw 1.2cqw;border-radius:9cqw;font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;${state === 'solid' ? `background:${GREEN};color:#fff` : `background:#fff;color:${STATE[state].colour};border:1px solid ${STATE[state].colour}`}'>${STATE[state].label}</span>`;\nconst bar = (height, radius) => {\n  const total = concepts.length || 1;\n  const seg = (n, colour) => (n ? `<div style='flex:${n} 0 0;background:${colour}'></div>` : '');\n  return `<div style='display:flex;height:${height};border-radius:${radius};overflow:hidden;background:#e2e8f0'>${seg(solid, GREEN)}${seg(shaky, '#f59e0b')}${seg(unknown, '#cbd5e1')}${concepts.length ? '' : `<div style='flex:${total} 0 0'></div>`}</div>`;\n};\n\nconst conceptBlock = (c, index) => {\n  const needs = prereqs.get(c.id).map(byId).filter(Boolean);\n  const resources = resourcesOf(c); const gaps = gapsOf(c);\n  return `<div style='display:flex;gap:2.4cqw;margin-bottom:2.4cqw'><div style='flex:0 0 5cqw;font:800 2.4cqw/1.2 ${SERIF};color:${c === next ? SKY : '#94a3b8'}'>${index + 1}</div><div style='min-width:0;flex:1;padding:1.6cqw 2cqw;border-radius:1.2cqw;background:#fff;border:${c === next ? `.3cqw solid ${SKY}` : '1px solid #e2e8f0'}'>`\n    + `<div style='font:700 2.1cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(c))}${chip(stateOf(c))}${c === next ? `<span style='margin-left:1.4cqw;color:${SKY};font:800 1.2cqw/1 ${SANS};letter-spacing:.1em;text-transform:uppercase'>start here</span>` : ''}${flag(c)}</div>`\n    + (needs.length ? `<div style='font:italic 1.5cqw/1.5 ${SERIF};color:${MUTED};margin-top:.4cqw'>needs ${needs.map((n) => esc(nameOf(n))).join(', ')}</div>` : '')\n    + para(c.data?.body)\n    + resources.map((r) => `<div style='margin-top:.8cqw;font:400 1.6cqw/1.5 ${SERIF};color:#334155'><span style='color:${OLIVE};font:800 1.2cqw/1 ${SANS};letter-spacing:.08em;text-transform:uppercase'>${esc(clean(r.data?.kind) || 'resource')}</span> <b style='font-weight:700;color:${INK}'>${esc(nameOf(r))}</b>${clean(r.data?.where) ? ` · ${esc(r.data.where)}` : ''}${flag(r)}</div>`).join('')\n    + gaps.map((g) => `<div style='margin-top:.8cqw;font:italic 1.6cqw/1.5 ${SERIF};color:${ORANGE}'>? ${esc(nameOf(g))}${flag(g)}</div>`).join('')\n    + `</div></div>`;\n};\n\nconst notice = flagged.length\n  ? `<div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:1.2cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:600 1.5cqw/1.5 ${SANS}'>${flagged.length} ${flagged.length === 1 ? 'thing' : 'things'} to check: ${flagged.map((node) => esc(nameOf(node))).join(', ')}</div>`\n  : '';\n\nconst detail = `<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:${PAPER};font-family:${SERIF};color:${INK}'>`\n  + `<div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'>`\n  + `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.3em;text-transform:uppercase;color:${ROSE}'>Study guide</div>`\n  + `<div style='font:700 5.4cqw/1.1 ${SERIF};margin:1.4cqw 0 .8cqw;color:${INK}'>${esc(name)}</div>`\n  + (lead ? `<div style='font:400 2.1cqw/1.5 ${SERIF};color:#334155;margin-top:1.6cqw;max-width:62cqw'>${esc(lead)}</div>` : '')\n  + `<div style='margin-top:2.6cqw;max-width:62cqw'>${bar('1.6cqw', '9cqw')}<div style='margin-top:1cqw;font:600 1.5cqw/1.4 ${SANS};color:${MUTED}'><span style='color:${GREEN}'>${solid} solid</span> · <span style='color:${AMBER}'>${shaky} shaky</span> · ${unknown} not yet · ${concepts.length} ${concepts.length === 1 ? 'concept' : 'concepts'}</div></div>`\n  + `<div style='margin-top:2.2cqw;font:700 2cqw/1.4 ${SERIF};color:${SKY}'>${esc(startLine)}</div>`\n  + notice\n  + (concepts.length ? heading('In the order to learn them') + order.map(conceptBlock).join('') : '')\n  + (allGaps.length ? heading('Still puzzling') + allGaps.map(({ concept, gap }) => `<div style='margin-bottom:1.6cqw'><div style='font:700 1.8cqw/1.3 ${SERIF};color:${ORANGE}'>${esc(nameOf(gap))}<span style='font:italic 1.5cqw/1.3 ${SERIF};color:${MUTED}'> · in ${esc(nameOf(concept))}</span>${flag(gap)}</div>${para(gap.data?.body)}</div>`).join('') : '')\n  + `</div></div>`;\n\nconst bulb = (size, colour) => `<svg viewBox='0 0 64 64' style='width:${size};height:${size};display:block' aria-hidden='true'><g fill='none' stroke='${colour}' stroke-width='4.5' stroke-linecap='round' stroke-linejoin='round'><path d='M22 42c-5-4-8-9-8-15a18 18 0 0 1 36 0c0 6-3 11-8 15-2 2-3 4-3 7H25c0-3-1-5-3-7z'/><path d='M26 56h12'/><path d='M28 49h8'/></g></svg>`;\nconst summary = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:${PAPER};border:.9cqw solid ${SKY};display:flex;align-items:center;gap:6cqw;color:${INK};overflow:hidden'>`\n  + `<div style='flex:0 0 24cqw'>${bulb('100%', ROSE)}</div><div style='min-width:0;flex:1'>`\n  + `<div style='font:700 3.2cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${ROSE}'>Study guide</div>`\n  + `<div style='font:700 8.2cqw/1.12 ${SERIF};margin:2cqw 0 1.6cqw;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${esc(name)}</div>`\n  + bar('3cqw', '9cqw')\n  + `<div style='margin-top:1.6cqw;font:600 3.6cqw/1.3 ${SANS};color:#334155'>${solid} of ${concepts.length} ${concepts.length === 1 ? 'concept' : 'concepts'} solid</div>`\n  + `<div style='margin-top:1.6cqw;font:700 3.8cqw/1.3 ${SANS};color:${SKY}'>${esc(startLine)}</div>`\n  + (flagged.length ? `<div style='margin-top:2cqw;display:inline-block;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:700 3cqw/1.3 ${SANS};letter-spacing:.06em;text-transform:uppercase'>${flagged.length} to check</div>` : '')\n  + `</div></div></div>`;\n\nconst icon = `<div style='container-type:inline-size;width:100%;height:100%;display:flex;align-items:center;justify-content:center'><div style='box-sizing:border-box;height:100%;max-width:100%;aspect-ratio:1/1;border-radius:50%;background:#fdf2f8;border:4cqmin solid ${ROSE};display:flex;align-items:center;justify-content:center'>${bulb('62%', ROSE)}</div></div>`;\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary], ['icon', icon]]) {\n  const target = faceFor(level);\n  if (target) await api.updateView(target.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'icon', name: 'Lightbulb', color: ROSE } } });\nreturn { name, concepts: concepts.length, solid, shaky, unknown, next: next ? nameOf(next) : null, gaps: allGaps.length, toCheck: flagged.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "learn-a-topic-detail",
              "learn-a-topic-summary",
              "learn-a-topic-icon",
              "learn-a-topic-glyph"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "learn-a-topic-declaration"
        }
      }
    },
