        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:#f8fbfd;border:.9cqw solid #0369a1;display:flex;align-items:center;gap:6cqw;color:#1f2937;overflow:hidden'><div style='flex:0 0 24cqw'><svg viewBox='0 0 64 64' style='width:100%;height:100%;display:block' aria-hidden='true'><g fill='none' stroke='#be185d' stroke-width='4.5' stroke-linecap='round' stroke-linejoin='round'><path d='M22 42c-5-4-8-9-8-15a18 18 0 0 1 36 0c0 6-3 11-8 15-2 2-3 4-3 7H25c0-3-1-5-3-7z'/><path d='M26 56h12'/><path d='M28 49h8'/></g></svg></div><div style='min-width:0;flex:1'><div style='font:700 3.2cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#be185d'>Study guide</div><div style='font:700 8.2cqw/1.12 Georgia,Iowan Old Style,Palatino Linotype,serif;margin:2cqw 0 1.6cqw;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>Name the topic</div><div style='display:flex;height:3cqw;border-radius:9cqw;overflow:hidden;background:#e2e8f0'><div style='flex:1 0 0;background:#15803d'></div><div style='flex:1 0 0;background:#f59e0b'></div></div><div style='margin-top:1.6cqw;font:600 3.6cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#334155'>1 of 2 concepts solid</div><div style='margin-top:1.6cqw;font:700 3.8cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#0369a1'>Start with A concept built on it</div><div style='margin-top:2cqw;display:inline-block;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:700 3cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase'>1 to check</div></div></div></div>"
        },
