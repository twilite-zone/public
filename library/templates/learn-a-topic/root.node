    {
      "id": "learn-a-topic-derive-method",
      "type": "method",
      "label": "Derive the study guide views",
      "position": {
        "x": 190,
        "y": 1233
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the study guide views",
        "parameters": [],
        "source": "// Derives a study guide's views from its cards: nothing is typed into a view.\n// It reads the Topic, its Concepts (each with how well it is known: not yet, shaky or solid), the order they are to be learned in (a `prepares` edge runs from a prerequisite to the concept that needs it),\n// the Resources that explain each concept (`explained-by`) and the Gaps still open about it (`has-gap`). It writes the Detail (a study guide, in learning order), the Summary (a card with a progress bar), the\n// Icon (a lightbulb) and the Glyph, and only those, which its declared effects say. It counts how many concepts are in each state and says where to start: the first concept in the order that is not yet solid\n// and whose prerequisites all are. It gives no score and no grade. Anything a card marks `check` (\"I am not sure this is right\") is gathered in a notice at the top of the page and on the card.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst SERIF = 'Inter,system-ui,Segoe UI,sans-serif'; const SANS = 'Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'; const MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst SKY = '#6653A3'; const INK = '#31265B'; const PAPER = '#F4F0FB'; const MUTED = '#64748b'; const AMBER = '#b45309'; const GREEN = '#15803d'; const ROSE = '#6653A3'; const OLIVE = '#4d7c0f'; const ORANGE = '#c2410c'; const GREY = '#94a3b8';\n\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst ofType = (type) => nodes.filter((node) => clean(node.type) === type);\nconst byId = (id) => nodes.find((node) => node.id === id);\nconst nameOf = (node) => clean(node?.data?.title || node?.label) || 'Untitled';\nconst topic = ofType('topic')[0] || null;\nconst concepts = ofType('concept');\nconst edgesOf = (type) => edges.filter((e) => clean(e.type) === type);\n\nconst stateOf = (concept) => { const value = clean(concept.data?.confidence).toLowerCase(); return value === 'solid' || value === 'shaky' ? value : 'unknown'; };\nconst STATE = { solid: { label: 'Solid', colour: GREEN }, shaky: { label: 'Shaky', colour: AMBER }, unknown: { label: 'Not yet', colour: GREY } };\n\n// the order to learn in: each concept after the ones that prepare it, ties in the order the cards were written\nconst prereqs = new Map(concepts.map((c) => [c.id, []]));\nfor (const e of edgesOf('prepares')) if (prereqs.has(e.target) && prereqs.has(e.source) && e.source !== e.target) prereqs.get(e.target).push(e.source);\nconst order = []; const placed = new Set();\nfor (let pass = 0; pass < concepts.length + 1 && order.length < concepts.length; pass += 1) {\n  for (const c of concepts) if (!placed.has(c.id) && prereqs.get(c.id).every((p) => placed.has(p))) { order.push(c); placed.add(c.id); }\n}\nfor (const c of concepts) if (!placed.has(c.id)) order.push(c); // a loop of prerequisites: keep the rest in the order written\n\nconst resourcesOf = (c) => edgesOf('explained-by').filter((e) => e.source === c.id).map((e) => byId(e.target)).filter((n) => n && clean(n.type) === 'resource');\nconst gapsOf = (c) => edgesOf('has-gap').filter((e) => e.source === c.id).map((e) => byId(e.target)).filter((n) => n && clean(n.type) === 'gap');\nconst next = order.find((c) => stateOf(c) !== 'solid' && prereqs.get(c.id).every((p) => stateOf(byId(p)) === 'solid')) || null;\nconst count = (state) => concepts.filter((c) => stateOf(c) === state).length;\nconst solid = count('solid'); const shaky = count('shaky'); const unknown = count('unknown');\nconst allGaps = order.flatMap((c) => gapsOf(c).map((gap) => ({ concept: c, gap })));\nconst flagged = [topic, ...concepts, ...ofType('resource'), ...ofType('gap')].filter((node) => node && node.data?.check === true);\nconst name = topic ? nameOf(topic) : 'Name the topic';\nconst lead = clean(topic?.data?.body);\nconst startLine = !concepts.length ? 'Add the first concept' : (next ? `Start with ${nameOf(next)}` : (solid === concepts.length ? 'Every concept is solid' : 'Every concept in reach is solid'));\n\nconst flag = (node) => (node?.data?.check === true ? `<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span>` : '');\nconst heading = (text) => `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${SKY};margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(3,105,161,.35)'>${text}</div>`;\nconst para = (text) => (clean(text) ? `<div style='font:400 1.7cqw/1.55 ${SERIF};color:#334155;margin-top:.4cqw'>${esc(text)}</div>` : '');\nconst chip = (state) => `<span style='display:inline-block;margin-left:1.2cqw;padding:.2cqw 1.2cqw;border-radius:9cqw;font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;${state === 'solid' ? `background:${GREEN};color:#fff` : `background:#fff;color:${STATE[state].colour};border:1px solid ${STATE[state].colour}`}'>${STATE[state].label}</span>`;\nconst bar = (height, radius) => {\n  const total = concepts.length || 1;\n  const seg = (n, colour) => (n ? `<div style='flex:${n} 0 0;background:${colour}'></div>` : '');\n  return `<div style='display:flex;height:${height};border-radius:${radius};overflow:hidden;background:#e2e8f0'>${seg(solid, GREEN)}${seg(shaky, '#f59e0b')}${seg(unknown, '#cbd5e1')}${concepts.length ? '' : `<div style='flex:${total} 0 0'></div>`}</div>`;\n};\n\nconst conceptBlock = (c, index) => {\n  const needs = prereqs.get(c.id).map(byId).filter(Boolean);\n  const resources = resourcesOf(c); const gaps = gapsOf(c);\n  return `<div style='display:flex;gap:2.4cqw;margin-bottom:2.4cqw'><div style='flex:0 0 5cqw;font:800 2.4cqw/1.2 ${SERIF};color:${c === next ? SKY : '#94a3b8'}'>${index + 1}</div><div style='min-width:0;flex:1;padding:1.6cqw 2cqw;border-radius:1.2cqw;background:#fff;border:${c === next ? `.3cqw solid ${SKY}` : '1px solid #e2e8f0'}'>`\n    + `<div style='font:700 2.1cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(c))}${chip(stateOf(c))}${c === next ? `<span style='margin-left:1.4cqw;color:${SKY};font:800 1.2cqw/1 ${SANS};letter-spacing:.1em;text-transform:uppercase'>start here</span>` : ''}${flag(c)}</div>`\n    + (needs.length ? `<div style='font:italic 1.5cqw/1.5 ${SERIF};color:${MUTED};margin-top:.4cqw'>needs ${needs.map((n) => esc(nameOf(n))).join(', ')}</div>` : '')\n    + para(c.data?.body)\n    + resources.map((r) => `<div style='margin-top:.8cqw;font:400 1.6cqw/1.5 ${SERIF};color:#334155'><span style='color:${OLIVE};font:800 1.2cqw/1 ${SANS};letter-spacing:.08em;text-transform:uppercase'>${esc(clean(r.data?.kind) || 'resource')}</span> <b style='font-weight:700;color:${INK}'>${esc(nameOf(r))}</b>${clean(r.data?.where) ? ` · ${esc(r.data.where)}` : ''}${flag(r)}</div>`).join('')\n    + gaps.map((g) => `<div style='margin-top:.8cqw;font:italic 1.6cqw/1.5 ${SERIF};color:${ORANGE}'>? ${esc(nameOf(g))}${flag(g)}</div>`).join('')\n    + `</div></div>`;\n};\n\nconst notice = flagged.length\n  ? `<div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:1.2cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:600 1.5cqw/1.5 ${SANS}'>${flagged.length} ${flagged.length === 1 ? 'thing' : 'things'} to check: ${flagged.map((node) => esc(nameOf(node))).join(', ')}</div>`\n  : '';\n\nconst detail = `<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:${PAPER};font-family:${SERIF};color:${INK};box-sizing:border-box;border:.6cqw solid #C6B9E4;border-bottom:1.5cqw solid ${SKY};border-radius:3cqw'>`\n  + `<div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'>`\n  + `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.3em;text-transform:uppercase;color:${ROSE}'>Study guide</div>`\n  + `<div style='font:700 5.4cqw/1.1 ${SERIF};margin:1.4cqw 0 .8cqw;color:${INK}'>${esc(name)}</div>`\n  + (lead ? `<div style='font:400 2.1cqw/1.5 ${SERIF};color:#334155;margin-top:1.6cqw;max-width:62cqw'>${esc(lead)}</div>` : '')\n  + `<div style='margin-top:2.6cqw;max-width:62cqw'>${bar('1.6cqw', '9cqw')}<div style='margin-top:1cqw;font:600 1.5cqw/1.4 ${SANS};color:${MUTED}'><span style='color:${GREEN}'>${solid} solid</span> · <span style='color:${AMBER}'>${shaky} shaky</span> · ${unknown} not yet · ${concepts.length} ${concepts.length === 1 ? 'concept' : 'concepts'}</div></div>`\n  + `<div style='margin-top:2.2cqw;font:700 2cqw/1.4 ${SERIF};color:${SKY}'>${esc(startLine)}</div>`\n  + notice\n  + (concepts.length ? heading('In the order to learn them') + order.map(conceptBlock).join('') : '')\n  + (allGaps.length ? heading('Still puzzling') + allGaps.map(({ concept, gap }) => `<div style='margin-bottom:1.6cqw'><div style='font:700 1.8cqw/1.3 ${SERIF};color:${ORANGE}'>${esc(nameOf(gap))}<span style='font:italic 1.5cqw/1.3 ${SERIF};color:${MUTED}'> · in ${esc(nameOf(concept))}</span>${flag(gap)}</div>${para(gap.data?.body)}</div>`).join('') : '')\n  + `</div></div>`;\n\nconst bulb = (size, colour) => `<svg viewBox='0 0 64 64' style='width:${size};height:${size};display:block' aria-hidden='true'><g fill='none' stroke='${colour}' stroke-width='4.5' stroke-linecap='round' stroke-linejoin='round'><path d='M22 42c-5-4-8-9-8-15a18 18 0 0 1 36 0c0 6-3 11-8 15-2 2-3 4-3 7H25c0-3-1-5-3-7z'/><path d='M26 56h12'/><path d='M28 49h8'/></g></svg>`;\n// The Summary is seen small, so it is the kind with its mark, the name, and two lines of facts: everything 6cqw or more and bold (scripts/library/auditSummaryType.mjs measures this).\n// The kind, the name and the mark never shrink; the facts give way when the tile is short. A name past 12 characters is set smaller, but never under 9cqw, and is cut at two lines.\nconst nameChars = [...String(name)].length;\nconst nameSize = nameChars <= 12 ? 14 : nameChars <= 24 ? 11 : 9;\nconst fact = (text, colour = '#334155') => `<div style='font:700 6.5cqw/1.2 ${SANS};color:${colour}'>${text}</div>`;\nconst pill = (text) => `<div style='align-self:flex-start;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:700 6cqw/1.3 ${SANS};letter-spacing:.04em;text-transform:uppercase'>${text}</div>`;\nconst summary = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:6cqw;border-radius:5cqw;background:${PAPER};border:.7cqw solid #C6B9E4;border-bottom:1.7cqw solid ${SKY};display:flex;flex-direction:column;gap:2.5cqw;color:${INK};overflow:hidden'>`\n  + `<div style='flex:none;display:flex;align-items:center;justify-content:space-between;gap:3cqw'><div style='font:700 6cqw/1.1 ${MONO};letter-spacing:.14em;text-transform:uppercase;color:${ROSE}'>Study guide</div><div style='flex:none;width:11cqw;height:11cqw'>${bulb('100%', ROSE)}</div></div>`\n  + `<div style='flex:none;font:700 ${nameSize}cqw/1.1 ${SERIF};display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'>${esc(name)}</div>`\n  + `<div style='flex:1 1 0;min-height:0;overflow:hidden;display:flex;flex-direction:column;gap:1.5cqw'>`\n  + bar('4cqw', '9cqw')\n  + fact(`${solid} of ${concepts.length} ${concepts.length === 1 ? 'concept' : 'concepts'} solid`)\n  + fact(esc(startLine), SKY)\n  + (flagged.length ? pill(`${flagged.length} to check`) : '')\n  + `</div></div></div>`;\n\nconst icon = `<div style='container-type:inline-size;width:100%;height:100%'><div style='height:100%;box-sizing:border-box;background:#E9E3F8;border:.7cqw solid #C6B9E4;border-bottom:1.7cqw solid #31265B;border-radius:4cqw;padding:4cqw;display:flex;align-items:center;gap:3cqw;color:#31265B'><div style='width:38cqw;flex:none'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120' width='100%' height='100%'><circle cx='60' cy='63' r='56' fill='#31265B'/><circle cx='60' cy='59' r='54' fill='#C6B9E4'/><circle cx='60' cy='59' r='47' fill='#6653A3'/><circle cx='60' cy='59' r='43' fill='none' stroke='#fff' stroke-opacity='.4' stroke-width='2'/><path d='M60 22l9 26 27 1-21 17 8 27-23-16-23 16 8-27-21-17 27-1Z' fill='#fff'/></svg></div><div style='font:850 8cqw/1.08 system-ui;overflow-wrap:anywhere'>${esc(name)}</div></div></div>`;\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary], ['icon', icon]]) {\n  const target = faceFor(level);\n  if (target) await api.updateView(target.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: {\"kind\":\"svg\",\"color\":\"#6653A3\",\"value\":\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><path d='M60 22l9 26 27 1-21 17 8 27-23-16-23 16 8-27-21-17 27-1Z' fill='#fff'/></svg>\"} } });\nreturn { name, concepts: concepts.length, solid, shaky, unknown, next: next ? nameOf(next) : null, gaps: allGaps.length, toCheck: flagged.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "learn-a-topic-detail",
              "learn-a-topic-summary",
              "learn-a-topic-icon",
              "learn-a-topic-glyph"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "learn-a-topic-declaration"
        }
      }
    },
