    {
      "id": "learn-a-topic-environment",
      "type": "face",
      "label": "Observatory · Study environment",
      "position": {
        "x": -500,
        "y": -1387
      },
      "width": 400,
      "height": 240,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "learn-a-topic-declaration"
        },
