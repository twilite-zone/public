        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "learn-a-topic-declaration"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.environment",
          "fit": "window",
          "stage": {
            "left": 13.5,
            "right": 3.5,
            "top": 22,
            "bottom": 8
          }
        },
        "content": {
