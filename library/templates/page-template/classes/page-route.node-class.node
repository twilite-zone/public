        "content": {
          "kind": "html",
          "value": "<a href='{{data.destinationRef}}' style='display:block;width:100%;height:100%;text-decoration:none;color:inherit'><div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:20px 22px;border-radius:16px;background:{{eq(data.prominence, \"secondary\", \"#f8fafc\", \"#ede9fe\")}};border:1px solid {{eq(data.prominence, \"secondary\", \"#e2e8f0\", \"#c4b5fd\")}};overflow:auto'><h2 style='margin:0 0 8px;font-weight:800;font-size:clamp(13px,5.56cqw,29px);line-height:1.2;font-family:system-ui;color:#0f172a'>{{data.title || label || \"Where to next\"}}</h2><p style='margin:0 0 12px;font-weight:400;font-size:clamp(9px,3.89cqw,20px);line-height:1.55;font-family:system-ui;color:#475569'>{{data.body}}</p><span style='font-weight:700;font-size:clamp(8px,3.61cqw,19px);line-height:1;font-family:system-ui;color:#6d28d9'>{{data.destinationLabel || \"Open\"}} →</span></div></a>"
        },
