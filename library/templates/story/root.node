    {
      "id": "story-derive-method",
      "type": "method",
      "label": "Derive the story views",
      "position": {
        "x": -50,
        "y": 1233
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the story views",
        "parameters": [],
        "source": "// Derives a story's views from its cards: nothing is typed into a view.\n// It reads the Story (the card of that type: title and premise), its Characters, Places, Scenes and Threads, and the edges between them: `precedes` (the order of the scenes), `appears-in` (a character to a\n// scene they are in), `set-in` (a scene to the place it happens in) and `weaves` (a thread to a scene it runs through; the label says what the scene does for it). It writes the Detail (the story as an\n// outline, scene by scene, with the cast, the places and the threads) and the Summary (a card), and the Glyph, and only those, which its declared effects say. It counts what there is and what is still open\n// and shows the counts; it never scores a story, and it never decides a story is finished. Anything a card marks `check` (\"I am not sure this is right\") is gathered in a notice at the top and on the card.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst SERIF = 'Newsreader,Iowan Old Style,Palatino Linotype,Georgia,serif'; const SANS = 'Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'; const MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst VIOLET = '#57456B'; const INK = '#302838'; const PAPER = '#F2EBDD'; const MUTED = '#64748b'; const AMBER = '#92400e'; const GOLD = '#9A692C'; const ROSE = '#984D4B'; const CYAN = '#436D63'; const INDIGO = '#50698B';\n\nconst nodes = await api.getNodes();\n// A graph that borrows this Method from its template declares its own writes. The newer surfaces (the Icon and, where the template did not write one before, the\n// environment) are written only where that declaration names them, so an older graph keeps what it has and is not refused.\nconst declaredHere = (target) => Boolean(target) && nodes.some((method) => method.type === 'method' && (method.data?.effects || []).some((effect) => effect.kind === 'update-node' && (!effect.targets || effect.targets.includes(target.id))));\nconst edges = await api.getEdges();\nconst ofType = (type) => nodes.filter((node) => clean(node.type) === type);\nconst byId = (id) => nodes.find((node) => node.id === id);\nconst nameOf = (node) => clean(node?.data?.title || node?.label) || 'Untitled';\nconst edgesOf = (type) => edges.filter((e) => clean(e.type) === type);\n\n// a list in the order its `precedes` edges give; whatever they do not reach follows, in the order it came\nconst inOrder = (items) => {\n  const ids = new Set(items.map((item) => item.id));\n  const next = new Map(); const hasPrevious = new Set();\n  for (const e of edgesOf('precedes')) if (ids.has(e.source) && ids.has(e.target) && !next.has(e.source)) { next.set(e.source, e.target); hasPrevious.add(e.target); }\n  const out = []; const seen = new Set();\n  for (const head of items.filter((item) => !hasPrevious.has(item.id))) {\n    let current = head;\n    while (current && !seen.has(current.id)) { out.push(current); seen.add(current.id); current = byId(next.get(current.id)); }\n  }\n  for (const item of items) if (!seen.has(item.id)) out.push(item);\n  return out;\n};\nconst sourcesOf = (to, type, kind) => edgesOf(type).filter((e) => e.target === to.id).map((e) => ({ node: byId(e.source), label: clean(e.label) })).filter((r) => r.node && (!kind || clean(r.node.type) === kind));\nconst targetsOf = (from, type, kind) => edgesOf(type).filter((e) => e.source === from.id).map((e) => ({ node: byId(e.target), label: clean(e.label) })).filter((r) => r.node && (!kind || clean(r.node.type) === kind));\n\nconst story = ofType('story')[0] || null;\nconst characters = ofType('character');\nconst places = ofType('place');\nconst scenes = inOrder(ofType('scene'));\nconst threads = ofType('thread');\nconst flagged = [story, ...characters, ...places, ...scenes, ...threads].filter((node) => node && node.data?.check === true);\nconst openThreads = threads.filter((t) => t.data?.resolved !== true);\nconst status = clean(story?.data?.status) || 'idea';\nconst name = story ? nameOf(story) : 'Name the story';\nconst premise = clean(story?.data?.body);\nconst plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;\nconst STATUS = { idea: 'Idea', drafting: 'Drafting', revising: 'Revising', done: 'Done' };\nconst standing = STATUS[status] || 'Idea';\n\nconst flag = (node) => (node?.data?.check === true ? `<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span>` : '');\nconst heading = (text) => `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${VIOLET};margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(87,69,107,.35)'>${text}</div>`;\nconst para = (text, size = 2.5) => (clean(text) ? `<div style='font:400 ${size}cqw/1.55 ${SERIF};color:#334155;margin-top:.4cqw'>${esc(text)}</div>` : '');\nconst chip = (text, colour, solid = false) => `<span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;${solid ? `background:${colour};color:#fff` : `background:#fff;color:${colour};border:1px solid ${colour}`}'>${text}</span>`;\nconst stageChip = (scene) => ({ revised: chip('Revised', INDIGO, true), drafted: chip('Drafted', INDIGO) }[clean(scene.data?.stage)] || chip('Idea', MUTED));\n\nconst scenesOf = (node, type) => scenes.filter((scene) => (type === 'appears-in' ? sourcesOf(scene, 'appears-in', 'character') : sourcesOf(scene, 'weaves', 'thread')).some((r) => r.node.id === node.id));\nconst placeOf = (scene) => targetsOf(scene, 'set-in', 'place')[0]?.node || null;\nconst scenesAt = (place) => scenes.filter((scene) => placeOf(scene)?.id === place.id);\n\nconst characterBlock = (c) => `<div style='margin-bottom:1.8cqw'><div style='font:700 2.8cqw/1.2 ${SERIF};color:${INK}'>${esc(nameOf(c))}${flag(c)}<span style='margin-left:1.4cqw;font:600 1.3cqw/1 ${SANS};color:${MUTED}'>in ${plural(scenesOf(c, 'appears-in').length, 'scene', 'scenes')}</span></div>${clean(c.data?.want) ? `<div style='font:italic 1.6cqw/1.5 ${SERIF};color:${ROSE};margin-top:.3cqw'>Wants: ${esc(c.data.want)}</div>` : ''}${para(c.data?.body)}</div>`;\nconst placeBlock = (p) => `<div style='margin-bottom:1.6cqw'><div style='font:700 1.8cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(p))}${flag(p)}<span style='margin-left:1.4cqw;font:600 1.3cqw/1 ${SANS};color:${MUTED}'>${plural(scenesAt(p).length, 'scene', 'scenes')}</span></div>${para(p.data?.body)}</div>`;\nconst sceneBlock = (scene, index) => {\n  const cast = sourcesOf(scene, 'appears-in', 'character').map((r) => nameOf(r.node));\n  const woven = sourcesOf(scene, 'weaves', 'thread');\n  const place = placeOf(scene);\n  return `<div style='margin-bottom:2.6cqw;padding:2.2cqw 2.6cqw;border-radius:0;background:#FBF7ED;border:1px solid #e2e8f0'>`\n    + `<div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 3cqw/1.2 ${SERIF};color:${INK}'><span style='color:${INDIGO};font:700 1.4cqw/1 ${MONO};letter-spacing:.14em;margin-right:1.4cqw'>SCENE ${index + 1}</span>${esc(nameOf(scene))}${flag(scene)}</div><div style='flex:0 0 auto'>${stageChip(scene)}</div></div>`\n    + (place || cast.length ? `<div style='font:600 1.4cqw/1.6 ${SANS};color:${MUTED};margin-top:.6cqw'>${place ? `<span style='color:${CYAN}'>${esc(nameOf(place))}</span>` : ''}${place && cast.length ? ' · ' : ''}${cast.length ? `<span style='color:${ROSE}'>${cast.map(esc).join(', ')}</span>` : ''}</div>` : '')\n    + para(scene.data?.body)\n    + woven.map((r) => `<div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 ${SERIF};color:${GOLD}'>Carries <b style='font-style:normal'>${esc(nameOf(r.node))}</b>${r.label ? ` · ${esc(r.label)}` : ''}</div>`).join('')\n    + `</div>`;\n};\nconst threadBlock = (t) => `<div style='margin-bottom:2cqw;padding:1.8cqw 2.2cqw;border-radius:0;background:#FBF7ED;border:1px solid #fde68a'>`\n  + `<div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.8cqw/1.2 ${SERIF};color:${INK}'>${esc(nameOf(t))}${flag(t)}</div><div style='flex:0 0 auto'>${t.data?.resolved === true ? chip('Resolved', GOLD, true) : chip('Open', GOLD)}</div></div>`\n  + `<div style='font:600 1.4cqw/1.5 ${SANS};color:${MUTED};margin-top:.6cqw'>${scenesOf(t, 'weaves').length ? `Runs through: ${scenesOf(t, 'weaves').map((s) => esc(nameOf(s))).join(', ')}` : 'Not yet in any scene'}</div>`\n  + para(t.data?.body)\n  + `</div>`;\n\nconst notice = flagged.length\n  ? `<div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:0;background:#FBF7EDbeb;border:1px solid #fde68a;color:${AMBER};font:600 1.5cqw/1.5 ${SANS}'>${plural(flagged.length, 'thing', 'things')} to check: ${flagged.map((node) => esc(nameOf(node))).join(', ')}</div>`\n  : '';\n\nconst detail = `<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:${PAPER};font-family:${SERIF};color:${INK}'>`\n  + `<div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'>`\n  + `<div style='border-top:1.2cqw solid ${VIOLET};border-bottom:.15cqw solid ${INK};padding:1.3cqw 0;font:800 2cqw/1.2 ${SANS};letter-spacing:.18em;text-transform:uppercase;color:${VIOLET}'>Story ${status === 'done' ? chip('Done', VIOLET, true) : chip(esc(standing), VIOLET)}</div>`\n  + `<div style='font:850 8.4cqw/1 ${SERIF};letter-spacing:-.045em;margin:4cqw 0 1.5cqw;color:${INK}'>${esc(name)}</div>`\n  + (premise ? `<div style='font:italic 2.1cqw/1.5 ${SERIF};color:#334155;margin-top:2cqw;max-width:62cqw'>${esc(premise)}</div>` : '')\n  + `<div style='margin-top:1.6cqw;font:600 1.6cqw/1.4 ${SANS};color:${MUTED}'>${plural(scenes.length, 'scene', 'scenes')} · ${plural(characters.length, 'character', 'characters')} · ${plural(places.length, 'place', 'places')} · ${plural(threads.length, 'thread', 'threads')}${threads.length ? ` (${openThreads.length} open)` : ''}</div>`\n  + notice\n  + (characters.length ? heading('The cast') + characters.map(characterBlock).join('') : '')\n  + (places.length ? heading('The places') + places.map(placeBlock).join('') : '')\n  + (scenes.length ? heading('The scenes, in order') + scenes.map(sceneBlock).join('') : '')\n  + (threads.length ? heading('The threads') + threads.map(threadBlock).join('') : '')\n  + `</div></div>`;\n\nconst bookSvg = (size, colour) => `<svg viewBox='0 0 64 64' style='width:${size};height:${size};display:block' aria-hidden='true'><g fill='none' stroke='${colour}' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'><path d='M32 14C26 10 16 9 8 11V50C16 48 26 49 32 53'/><path d='M32 14C38 10 48 9 56 11V50C48 48 38 49 32 53'/><path d='M32 14V53'/></g></svg>`;\nconst counts = `${plural(scenes.length, 'scene', 'scenes')} · ${plural(characters.length, 'character', 'characters')}`;\n// The Summary is seen small, so it is the kind with its mark, the name, and two lines of facts: everything 6cqw or more and bold (scripts/library/auditSummaryType.mjs measures this).\n// The kind, the name and the mark never shrink; the facts give way when the tile is short. A name past 12 characters is set smaller, but never under 9cqw, and is cut at two lines.\nconst nameChars = [...String(name)].length;\nconst nameSize = nameChars <= 12 ? 14 : nameChars <= 24 ? 11 : 9;\nconst fact = (text, colour = '#334155') => `<div style='font:700 6.5cqw/1.2 ${SANS};color:${colour}'>${text}</div>`;\nconst pill = (text) => `<div style='align-self:flex-start;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:700 6cqw/1.3 ${SANS};letter-spacing:.04em;text-transform:uppercase'>${text}</div>`;\nconst summary = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:6cqw;border-radius:0;background:${PAPER};border:1px solid #C8BFB0;border-top:1.5cqw solid ${VIOLET};display:flex;flex-direction:column;gap:2.5cqw;color:${INK};overflow:hidden'>`\n  + `<div style='flex:none;display:flex;align-items:center;justify-content:space-between;gap:3cqw'><div style='font:700 6cqw/1.1 ${MONO};letter-spacing:.14em;text-transform:uppercase;color:${VIOLET}'>Story</div><div style='flex:none;width:11cqw;height:11cqw'>${bookSvg('100%', VIOLET)}</div></div>`\n  + `<div style='flex:none;font:700 ${nameSize}cqw/1.1 ${SERIF};display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'>${esc(name)}</div>`\n  + `<div style='flex:1 1 0;min-height:0;overflow:hidden;display:flex;flex-direction:column;gap:1.5cqw'>`\n  + fact(counts)\n  + fact(esc(standing), status === 'done' ? VIOLET : MUTED)\n  + (flagged.length ? pill(`${flagged.length} to check`) : '')\n  + `</div></div></div>`;\n\nconst icon = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:4.5cqw;background:#F2EBDD;color:#302838;display:flex;flex-direction:column;overflow:hidden;font-family:system-ui'><div style='border-top:1.2cqw solid #57456B;border-bottom:1px solid #302838;padding:1cqw 0;font:800 4cqw/1.2 system-ui;letter-spacing:.14em;text-transform:uppercase'>story</div><div style='display:flex;flex:1;min-height:0;align-items:center;gap:3cqw'><div style='flex:1;min-width:0;font:850 8cqw/1.05 Georgia,serif;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${esc(name)}</div><div style='width:30cqw;flex:none'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120' width='100%' height='100%'><rect width='120' height='120' fill='#57456B'/><path d='M60 30Q40 17 14 23v70q26-6 46 7 20-13 46-7V23Q80 17 60 30Z' fill='none' stroke='#fff' stroke-width='6'/><path d='M60 30v70M25 43l22 3M25 56l22 3M73 46l22-3M73 59l22-3' stroke='#fff' stroke-width='4'/></svg></div></div><div style='border-top:1px solid #302838;padding-top:1cqw;display:flex;justify-content:space-between;gap:1cqw;font:750 4.2cqw/1.2 system-ui;color:#57456B'><span style='overflow:hidden;text-overflow:ellipsis;white-space:nowrap'>${counts} · ${esc(standing)}</span></div></div></div>`;\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary], ['icon', icon]]) {\n  const target = faceFor(level);\n  if (target && (level !== 'icon' || declaredHere(target))) await api.updateView(target.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: {\"kind\":\"svg\",\"color\":\"#57456B\",\"value\":\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120' width='100%' height='100%'><rect width='120' height='120' fill='#57456B'/><path d='M60 30Q40 17 14 23v70q26-6 46 7 20-13 46-7V23Q80 17 60 30Z' fill='none' stroke='#fff' stroke-width='6'/><path d='M60 30v70M25 43l22 3M25 56l22 3M73 46l22-3M73 59l22-3' stroke='#fff' stroke-width='4'/></svg>\"} } });\nreturn { name, scenes: scenes.length, characters: characters.length, places: places.length, threads: threads.length, openThreads: openThreads.length, toCheck: flagged.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "story-detail",
              "story-summary",
              "story-glyph",
              "story-icon"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "story-declaration"
        }
      }
    },
