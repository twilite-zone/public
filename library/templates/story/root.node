        },
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "scroll": "page"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:#faf8ff;font-family:Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.3em;text-transform:uppercase;color:#6d28d9'>Story <span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#6d28d9;border:1px solid #6d28d9'>Idea</span></div><div style='font:700 5.2cqw/1.12 Georgia,Iowan Old Style,Palatino Linotype,serif;margin:1.4cqw 0 .8cqw;color:#1f2937'>Name the story</div><div style='font:italic 2.1cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:2cqw;max-width:62cqw'>Who wants what, and what stands in the way.</div><div style='margin-top:1.6cqw;font:600 1.6cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>3 scenes · 2 characters · 2 places · 1 thread (1 open)</div><div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:1.2cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:600 1.5cqw/1.5 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'>1 thing to check: Someone else</div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#6d28d9;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'>The cast</div><div style='margin-bottom:1.8cqw'><div style='font:700 1.9cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Someone in the story<span style='margin-left:1.4cqw;font:600 1.3cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>in 2 scenes</span></div><div style='font:italic 1.6cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#be123c;margin-top:.3cqw'>Wants: What they want in this story</div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>What they are like, and what the reader should know.</div></div><div style='margin-bottom:1.8cqw'><div style='font:700 1.9cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Someone else<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span><span style='margin-left:1.4cqw;font:600 1.3cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>in 2 scenes</span></div><div style='font:italic 1.6cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#be123c;margin-top:.3cqw'>Wants: What drives them</div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>A character who gets in the way, or helps.</div></div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#6d28d9;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'>The places</div><div style='margin-bottom:1.6cqw'><div style='font:700 1.8cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Where it begins<span style='margin-left:1.4cqw;font:600 1.3cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>2 scenes</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>What it looks and feels like.</div></div><div style='margin-bottom:1.6cqw'><div style='font:700 1.8cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Where it ends<span style='margin-left:1.4cqw;font:600 1.3cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>1 scene</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Somewhere that matters to how it ends.</div></div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#6d28d9;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'>The scenes, in order</div><div style='margin-bottom:2.6cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><span style='color:#4338ca;font:700 1.4cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;margin-right:1.4cqw'>SCENE 1</span>The opening scene</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#4338ca;border:1px solid #4338ca'>Drafted</span></div></div><div style='font:600 1.4cqw/1.6 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:.6cqw'><span style='color:#0e7490'>Where it begins</span> · <span style='color:#be123c'>Someone in the story</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>What changes here, and why it comes first.</div><div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#b45309'>Carries <b style='font-style:normal'>Something the reader waits for</b> · it is raised</div></div><div style='margin-bottom:2.6cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><span style='color:#4338ca;font:700 1.4cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;margin-right:1.4cqw'>SCENE 2</span>The turn</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#64748b;border:1px solid #64748b'>Idea</span></div></div><div style='font:600 1.4cqw/1.6 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:.6cqw'><span style='color:#0e7490'>Where it begins</span> · <span style='color:#be123c'>Someone in the story, Someone else</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Where things stop going the way they were.</div><div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#b45309'>Carries <b style='font-style:normal'>Something the reader waits for</b> · it turns</div></div><div style='margin-bottom:2.6cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><span style='color:#4338ca;font:700 1.4cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;margin-right:1.4cqw'>SCENE 3</span>The ending</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#64748b;border:1px solid #64748b'>Idea</span></div></div><div style='font:600 1.4cqw/1.6 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:.6cqw'><span style='color:#0e7490'>Where it ends</span> · <span style='color:#be123c'>Someone else</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>How it lands. A scene you are unsure of is marked to check.</div></div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#6d28d9;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'>The threads</div><div style='margin-bottom:2cqw;padding:1.8cqw 2.2cqw;border-radius:1.2cqw;background:#fff;border:1px solid #fde68a'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 1.9cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Something the reader waits for</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#b45309;border:1px solid #b45309'>Open</span></div></div><div style='font:600 1.4cqw/1.5 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:.6cqw'>Runs through: The opening scene, The turn</div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>What this thread asks of the reader, and what settling it would mean.</div></div></div></div>"
        },
