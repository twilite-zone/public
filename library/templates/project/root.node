          "angle": 180,
          "portId": "invokes"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the project views",
        "parameters": [],
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "project-template-detail",
              "project-template-summary",
              "project-template-glyph",
              "project-template-declaration",
              "project-template-project",
              "project-template-environment",
              "project-template-icon"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "project-template-declaration"
        },
        "source": "// Derives the project's views from what it holds and says about itself: nothing is typed into a summary. A project is a Collection of shelves\n// (each shelf a graph it contains through a portal) plus what it is for, its status, where it stands now, who leads it, where it lives and where to start.\n// A member is a graph the collection holds, and nothing in the collection graph is one unless it was made one. There are two ways:\n//   - a Portal the collection contains (a `contains` edge from its members port);\n//   - a graph in its own folder, when it says so (data.includeFolder), for an address the host can list (github://).\n// The members are the union, without repeats. The member graphs are read through api.readGraph, which returns what the app has already\n// loaded to open them. The Method writes the Detail, the Summary and the Glyph, the size of the Detail and Summary (the Detail stretches\n// with its rows, up to a square), the window that holds them, and a line on the collection saying where its members come from.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst INK = '#2254b6';\nconst MAX_READ = 100;\n\nconst nodes = await api.getNodes();\n// The window takes the Detail's shape, holds every node, and its stage (measured, like the stage numbers, in hundredths of the window's width) holds the cards seen when browsing.\nconst fitWindow = ({ shape, stage, cards, all, pad }) => {\n  const box = (list) => ({ l: Math.min(...list.map((n) => n.position.x)), t: Math.min(...list.map((n) => n.position.y)), r: Math.max(...list.map((n) => n.position.x + n.width)), b: Math.max(...list.map((n) => n.position.y + n.height)) });\n  const A = box(all);\n  const C = box(cards.length ? cards : all);\n  const across = 100 - stage.left - stage.right;\n  const down = 100 * shape - stage.top - stage.bottom;\n  const clamp = (value, low, high) => Math.min(high, Math.max(low, value));\n  let w = Math.ceil(Math.max((C.r - C.l + 2 * pad) * 100 / across, (C.b - C.t + 2 * pad) * 100 / down, A.r - A.l, (A.b - A.t) / shape));\n  for (let tries = 0; ; tries += 1) {\n    const h = Math.round(w * shape);\n    const xLow = Math.ceil(Math.max(A.r - w, C.r + pad - w * (100 - stage.right) / 100));\n    const xHigh = Math.floor(Math.min(A.l, C.l - pad - w * stage.left / 100));\n    const yLow = Math.ceil(Math.max(A.b - h, C.b + pad - (h - w * stage.bottom / 100)));\n    const yHigh = Math.floor(Math.min(A.t, C.t - pad - w * stage.top / 100));\n    if ((xLow <= xHigh && yLow <= yHigh) || tries > 800) {\n      return { x: clamp(Math.round((C.l + C.r - w) / 2), xLow, xHigh), y: clamp(Math.round((C.t + C.b) / 2 - w * (stage.top + down / 2) / 100), yLow, yHigh), width: w, height: h };\n    }\n    w = Math.ceil(w * 1.01) + 1;\n  }\n};\n// A graph that borrows this Method from its template declares its own writes. The newer surfaces (the Icon and, where the template did not write one before, the\n// environment) are written only where that declaration names them, so an older graph keeps what it has and is not refused.\nconst declaredHere = (target) => Boolean(target) && nodes.some((method) => method.type === 'method' && (method.data?.effects || []).some((effect) => effect.kind === 'update-node' && (!effect.targets || effect.targets.includes(target.id))));\nconst edges = await api.getEdges();\nconst byId = new Map(nodes.map((node) => [node.id, node]));\nconst root = nodes.find((node) => clean(node.type) === 'root');\nconst collection = nodes.find((node) => clean(node.type) === 'project');\nconst title = clean(collection?.data?.title || collection?.label) || 'Collection';\nconst sort = ['name', 'kind'].includes(clean(collection?.data?.sort)) ? clean(collection.data.sort) : 'order';\n\nconst keyOf = (address) => clean(address).replace(/#.*$/, '').replace(/^https?:\\/\\/twilite\\.zone\\//i, 'tlz://twilite.zone/');\n\n// The portals the collection contains, in the order of their edges.\nconst portals = edges\n  .filter((edge) => clean(edge.type) === 'contains' && collection && edge.source === collection.id)\n  .map((edge) => byId.get(edge.target))\n  .filter((node) => node && clean(node.type) === 'portal');\nconst refOf = (portal) => clean(portal.data?.target?.ref || portal.data?.sourceRef || portal.data?.ref);\n\n// The folder: the graphs one level below the folder this collection's own root sits in, for a collection the host can list.\nconst includeFolder = collection?.data?.includeFolder === true;\nlet folderAddresses = [];\nlet folderNote = '';\nif (includeFolder) {\n  const own = clean(root?.data?.document?.url);\n  const where = /^github:\\/\\/([^/]+)\\/([^/]+)\\/(?:(.*)\\/)?[^/]+$/.exec(own);\n  if (!where) {\n    folderNote = /^(tlz|https?):/i.test(own) ? 'a published site cannot list its folders' : 'this graph has no github:// address to list';\n  } else {\n    const [, owner, repository, directory = ''] = where;\n    try {\n      const entries = await api.listRepositoryDirectory({ repo: `${owner}/${repository}`, path: directory, branch: 'main' });\n      folderAddresses = entries.filter((entry) => clean(entry.type) === 'dir' && clean(entry.name))\n        .sort((a, b) => clean(a.name).localeCompare(clean(b.name)))\n        .map((entry) => `github://${owner}/${repository}/${[directory, clean(entry.name)].filter(Boolean).join('/')}/root.node`);\n    } catch (error) { folderNote = `the folder could not be listed (${clean(error?.message) || 'no reason given'})`; }\n  }\n}\n\n// The union, without repeats: the portals in their order, then the folder.\nconst entries = [];\nconst seen = new Set();\nconst add = (address, from, portal = null) => {\n  const key = keyOf(address) || `portal:${portal?.id}`;\n  if (seen.has(key)) return;\n  seen.add(key);\n  entries.push({ address, from, portal });\n};\nportals.forEach((portal) => add(refOf(portal), 'portal', portal));\nfolderAddresses.forEach((address) => add(address, 'folder'));\n\nconst kindWords = (kind) => { const words = clean(kind).replace(/-/g, ' '); return words ? words[0].toUpperCase() + words.slice(1) : 'Graph'; };\nconst slugOf = (address) => { const parts = clean(address).replace(/#.*$/, '').split('/').filter(Boolean); const last = parts[parts.length - 1] || ''; return /\\.node$/.test(last) && parts.length > 1 ? parts[parts.length - 2] : last; };\n\n// What a tile says about a member comes from the member itself: its name, its description (or its kind when it has none) and the\n// colour of its own glyph. Only the first MAX_READ are read, so a large folder does not read every graph in it; the rest show their\n// folder's name. A graph found in the folder that cannot be read is not a graph, and is left out.\n// A member's own Summary view: the face of its Surface chain whose level is summary, when it holds plain html (no template syntax, no scripts).\nconst summaryOf = (graph, rootNode) => {\n  const links = Array.isArray(graph.edges) ? graph.edges : [];\n  const faceById = new Map(graph.nodes.filter((node) => clean(node.type) === 'face').map((node) => [node.id, node]));\n  const chain = [];\n  let at = faceById.get(links.find((edge) => clean(edge.type) === 'surface' && edge.source === rootNode.id)?.target);\n  while (at && chain.length < 8 && !chain.includes(at)) { chain.push(at); at = faceById.get(links.find((edge) => clean(edge.type) === 'next-face' && edge.source === at.id)?.target); }\n  const face = chain.find((node) => clean(node.data?.semanticLevel) === 'summary');\n  const html = face?.data?.content?.kind === 'html' ? String(face.data.content.value || '') : '';\n  return html && !/\\{\\{|<script/i.test(html) ? html : '';\n};\nconst factsOf = async (entry, index) => {\n  let graph = null;\n  if (entry.address && index < MAX_READ) { try { graph = await api.readGraph(entry.address); } catch (error) { graph = null; } }\n  const found = Array.isArray(graph?.nodes);\n  const items = found ? graph.nodes : [];\n  const rootNode = items.find((node) => clean(node.type) === 'root');\n  const glyph = items.find((node) => clean(node.type) === 'glyph')?.data?.glyph;\n  const name = clean(rootNode?.data?.identity?.name) || clean(entry.portal?.label) || slugOf(entry.address) || entry.address;\n  const kind = kindWords(rootNode?.data?.intent?.kind);\n  // How many graphs the shelf holds: the portals its own collection contains.\n  const holder = items.find((node) => ['collection', 'repo', 'project'].includes(clean(node.type)));\n  const graphs = holder ? (found ? graph.edges || [] : []).filter((edge) => clean(edge.type) === 'contains' && edge.source === holder.id && items.some((node) => node.id === edge.target && clean(node.type) === 'portal')).length : 0;\n  const lift = found && rootNode ? summaryOf(graph, rootNode) : '';\n  return { lift, ref: entry.address, from: entry.from, dropped: entry.from === 'folder' && index < MAX_READ && !found, name, kind, graphs,\n    description: clean(rootNode?.data?.identity?.description) || kind, tint: /^#[0-9a-f]{6}$/i.test(clean(glyph?.color)) ? clean(glyph.color) : INK };\n};\nlet members = (await Promise.all(entries.map(factsOf))).filter((member) => !member.dropped);\nif (sort === 'name') members = [...members].sort((a, b) => a.name.localeCompare(b.name));\nif (sort === 'kind') members = [...members].sort((a, b) => a.kind.localeCompare(b.kind) || a.name.localeCompare(b.name));\nconst count = members.length;\nconst countText = `${count} ${count === 1 ? 'graph' : 'graphs'}`;\n\n// Where the members come from, for the collection's editor to show.\nconst fromFolder = members.filter((member) => member.from === 'folder').length;\nconst sources = [\n  portals.length ? `${portals.length} portal${portals.length === 1 ? '' : 's'}` : '',\n  includeFolder && !folderNote ? `${fromFolder} in the folder` : '',\n  `${count} member${count === 1 ? '' : 's'}`\n].filter(Boolean).join(' · ');\nconst problems = [folderNote ? `folder: ${folderNote}` : ''].filter(Boolean);\nconst sourcesLine = problems.length ? `${sources} (${problems.join('; ')})` : sources;\nif (collection && clean(collection.data?.sourcesSummary) !== sourcesLine) await api.updateNode(collection.id, { data: { ...collection.data, sourcesSummary: sourcesLine } });\n\n// The facts about the library itself: where it lives, what it is for, who it is for, and where to start.\nconst data = collection?.data || {};\nconst STATUS = { idea: ['Idea', '#7c3aed'], active: ['Active', '#15803d'], paused: ['Paused', '#b45309'], done: ['Done', '#475569'] };\nconst statusKey = Object.keys(STATUS).includes(clean(data.status)) ? clean(data.status) : 'active';\nconst [statusText, statusTint] = STATUS[statusKey];\nconst standing = clean(data.standing);\nconst lead = clean(data.lead);\nconst where = clean(data.lives);\nconst startPortal = nodes.find((node) => clean(node.type) === 'portal' && clean(node.data?.role) === 'start-here');\nconst startRef = refOf(startPortal) || clean(data.startHere) || clean(members[0]?.ref);\nconst totalGraphs = members.reduce((sum, member) => sum + (member.graphs || 0), 0);\nconst shelfText = `${count} ${count === 1 ? 'shelf' : 'shelves'}`;\nconst graphsText = `${totalGraphs} ${totalGraphs === 1 ? 'graph' : 'graphs'}`;\n\n// The Detail is 100cqw wide. It starts at the regular 3:2 and stretches with its rows up to a square; beyond that the shelves scroll.\nconst TILE = 14.5; const GAP = 1.4; const MIN_TILE = 26.2; const PAD = 4; const HEAD = 44;\nconst columns = Math.max(2, Math.floor((100 - 2 * PAD + GAP) / (MIN_TILE + GAP)));\nconst rows = Math.ceil(count / columns);\nconst need = 2 * PAD + HEAD + (rows ? rows * (TILE + GAP) : 22);\nconst ratio = Math.min(1, Math.max(0.76, (need + 6) / 100));\nconst DETAIL_WIDTH = 660; const SUMMARY_WIDTH = 480;\nconst MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\n\nconst frame = (inner, style) => `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;font-family:system-ui,-apple-system,Segoe UI,sans-serif;${style}'>${inner}</div></div>`;\nconst tile = (member) => `<a href='${esc(member.ref)}' style='display:flex;gap:2.2cqw;align-items:flex-start;box-sizing:border-box;min-height:${TILE}cqw;padding:1.3cqw 1.7cqw;border:1px solid #e2e8f0;border-radius:1.2cqw;background:#ffffff;border-left:.65cqw solid ${member.tint};text-decoration:none;color:inherit;min-width:0;overflow:hidden'>`\n  + `<span style='flex:none;width:6.2cqw;height:6.2cqw;border-radius:1.6cqw;background:${member.tint}22;color:${member.tint};display:flex;align-items:center;justify-content:center;font-weight:600;font-size:3cqw'>${esc(member.name.slice(0, 1).toUpperCase())}</span>`\n  + `<span style='min-width:0'><span style='display:block;font-weight:800;font-size:3.3cqw;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#0f172a'>${esc(member.name)}</span>`\n  + `<span style='display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:2.5cqw;line-height:1.25;color:#475569'>${esc(member.description)}</span>`\n  + `<span style='display:block;margin-top:.3cqw;font-size:2.5cqw;font-weight:600;color:${INK}'>${member.graphs} ${member.graphs === 1 ? 'graph' : 'graphs'}</span></span></a>`;\nconst body = count\n  ? `<div style='display:grid;grid-template-columns:repeat(auto-fill,minmax(${MIN_TILE}cqw,1fr));gap:${GAP}cqw;align-content:start'>${members.map(tile).join('')}</div>`\n  : `<div style='display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.4cqw;min-height:22cqw;border:1px dashed #cbd5e1;border-radius:2.4cqw;color:#64748b;font-size:2.8cqw;text-align:center;padding:2cqw'><span style='font-weight:600;color:#0f172a'>No shelves yet</span><span>A shelf is a collection this project contains. Add a portal to one and connect it.</span></div>`;\nconst start = startRef ? `<a href='${esc(startRef)}' style='align-self:flex-start;margin-top:.4cqw;padding:1.1cqw 2.8cqw;border-radius:6cqw;background:${INK};color:#ffffff;font-size:2.8cqw;font-weight:600;text-decoration:none'>Start here →</a>` : '';\nconst detail = frame(\n  `<div style='display:block'><div style='float:right;width:19cqw;height:19cqw;margin:0 0 1cqw 3cqw;background:#17357f;padding:1cqw;box-sizing:border-box'><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 128\" preserveAspectRatio=\"xMidYMid meet\"><path d=\"M12 96 60 69 110 96 62 123Z\" fill=\"#102859\"/><path d=\"M24 43 64 20 102 42 62 65Z\" fill=\"#a9c9ff\"/><path d=\"M24 43 62 65V108L24 86Z\" fill=\"#4276d5\"/><path d=\"M62 65 102 42V85L62 108Z\" fill=\"#214a9c\"/><path d=\"M35 60 49 68V83L35 75Z M72 72 89 62V77L72 87Z\" fill=\"#ffcf82\"/><path d=\"M64 20V2\" stroke=\"#f4f0e6\" stroke-width=\"3\"/><path d=\"M65 2 91 9 65 16Z\" fill=\"#ffc66f\"/></svg></div><div style='display:flex;flex-direction:column;gap:1.1cqw'><div style='font-size:2.4cqw;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:${INK}'>Project</div>`\n  + `<div style='font-weight:850;font-size:6.4cqw;letter-spacing:-.04em;line-height:1.2;color:#0f172a'>${esc(title)}</div>`\n  + `<div style='display:flex;gap:1.6cqw;align-items:center;font-size:2.4cqw;color:#64748b'><span style='padding:.4cqw 1.8cqw;border-radius:6cqw;background:${statusTint}1a;border:1px solid ${statusTint}55;color:${statusTint};font-weight:800'>${esc(statusText)}</span>${lead ? `<span>Lead: ${esc(lead)}</span>` : ''}</div>`\n  + (where ? `<div style='font-size:2.5cqw;font-family:${MONO};color:${INK}'>${esc(where)}</div>` : '')\n  + (clean(data.body) ? `<div style='font-size:2.9cqw;line-height:1.4;color:#334155'>${esc(data.body)}</div>` : '')\n  + (standing ? `<div style='background:#dce7ff;border-left:.8cqw solid #2254b6;padding:1.4cqw 2cqw;display:flex;gap:1.5cqw;align-items:baseline;line-height:1.3'><span style='flex:none;font:800 2.5cqw/1.3 system-ui;color:#17357f;letter-spacing:.04em'>NOW</span><span style='font-size:3cqw;font-weight:650;color:#121a33;overflow-wrap:anywhere'>${esc(standing)}</span></div>` : '')\n  + `${start}</div></div>`\n  + `<div style='font-size:2.4cqw;font-weight:800;letter-spacing:.09em;color:#17357f'>PROJECT SHELVES · ${esc(shelfText)}</div>` + `<div style='flex:1;min-height:0;overflow:auto;padding-bottom:1.5cqw'>${body}</div>`,\n  `padding:${PAD}cqw;border-radius:1cqw;background:#edf3fc;border-top:1.2cqw solid ${INK};display:flex;flex-direction:column;gap:2cqw`\n);\n// The shelf: the shelves' own Summary views at one fixed size, in a row that scrolls. Its scrollbar is the plank, and it is visible: the app lets the\n// wheel and a press scroll only what has a scrollbar under the pointer, so a shelf with none could not be scrolled at all. Each stands in a box that is its own container, so what it\n// draws in its own units is drawn at the size of its box. A click on a shelf goes to it. A shelf with no Summary of its own is a plain card.\n// The Summary is read from far away, so it is a few big words and not a picture of the members: the kind of thing it is, its name, one line of facts, and the members' names as chips that open them.\n// Nothing here is under 6cqw and all of it is bold (scripts/library/auditSummaryType.mjs measures this). The title and the facts never shrink; the chips give way when the tile is short.\nconst MAX_CHIPS = 5;\nconst chipStyle = (tint) => `box-sizing:border-box;max-width:100%;padding:1.2cqw 3cqw;border-radius:9cqw;background:${tint}1a;border:.5cqw solid ${tint}66;color:#0f172a;font:700 6cqw/1.25 system-ui,-apple-system,Segoe UI,sans-serif;text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis`;\nconst chip = (member) => `<a href='${esc(member.ref)}' title='${esc(member.name)}' aria-label='${esc(member.name)}' style='${chipStyle(member.tint)}'>${esc(member.name)}</a>`;\nconst over = count > MAX_CHIPS;\nconst moreChip = over ? `<span style='padding:1.2cqw 3cqw;font:700 6cqw/1.25 system-ui,sans-serif;color:#475569;white-space:nowrap'>+${count - (MAX_CHIPS - 1)} more</span>` : '';\nconst chips = count ? members.slice(0, over ? MAX_CHIPS - 1 : count).map(chip).join('') + moreChip : `<span style='font:700 6cqw/1.3 system-ui,sans-serif;color:#475569'>No shelves yet. Add a collection with a portal.</span>`;\nconst titleChars = [...String(title)].length;\nconst titleSize = titleChars <= 11 ? 15 : titleChars <= 16 ? 11 : 8.5;\nconst summary = frame(\n  `<div style='flex:none;font:700 6cqw/1.1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;text-transform:uppercase;color:${INK}'>Project</div>`\n  + `<div style='flex:none;font:850 ${titleSize}cqw/1.02 system-ui,-apple-system,Segoe UI,sans-serif;letter-spacing:-.01em;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${esc(title)}</div>`\n  + `<div style='flex:none;font:700 6.5cqw/1.2 system-ui,sans-serif;color:#334155'>${statusText} · ${graphsText}</div>`\n  + `<div style='flex:1 1 0;min-height:0;overflow:hidden;display:flex;flex-wrap:wrap;gap:2cqw;align-content:flex-start'>${chips}</div>`,\n  `padding:4cqw;border-radius:1cqw;background:#edf3fc;border:.8cqw solid ${INK};display:flex;flex-direction:column;gap:3cqw;overflow:hidden`\n);\n\nconst icon = `<div style=\"container-type:inline-size;width:100%;height:100%\"><div style=\"box-sizing:border-box;height:100%;background:#2254b6;color:white;display:flex;flex-direction:column;padding:3cqw 4cqw;font-family:system-ui;overflow:hidden\"><div style=\"flex:1;min-height:0;display:flex;align-items:center;justify-content:center\"><div style=\"width:37cqw;height:100%;max-height:37cqw\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 128\" preserveAspectRatio=\"xMidYMid meet\"><path d=\"M10 38 60 9 110 38 60 67Z\" fill=\"#fff\"/><path d=\"M10 45 53 70V111L10 86Z\" fill=\"#d8e6ff\"/><path d=\"M67 70 110 45V86L67 111Z\" fill=\"#fff\"/></svg></div></div><div style=\"background:#142c62;padding:2.5cqw 3cqw;margin:0 -4cqw -3cqw\"><div style=\"font:800 3.8cqw/1.1 system-ui;color:#d8e6ff;letter-spacing:.12em\">PROJECT</div><div style=\"font:850 10cqw/1.03 system-ui;letter-spacing:-.04em;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden\">${esc(title)}</div></div></div></div>`;\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nconst detailFace = faceFor('detail');\nconst summaryFace = faceFor('summary');\nconst iconFace = faceFor('icon');\n// With an Icon under it the Summary has to be well under the Detail's width, or the Detail takes over before the Summary is ever shown. A graph without one keeps the wider Summary.\nconst ICON_WIDTH = 180;\nconst summaryWidth = declaredHere(iconFace) ? 360 : SUMMARY_WIDTH;\nconst size = (face, width) => ({ width, height: Math.round(width * ratio) });\nif (detailFace) {\n  await api.updateView(detailFace.id, { content: { kind: 'html', value: detail }, view: { ...(detailFace.data?.view || {}), scroll: 'page' } });\n  await api.updateNode(detailFace.id, size(detailFace, DETAIL_WIDTH));\n}\nif (summaryFace) {\n  await api.updateView(summaryFace.id, { content: { kind: 'html', value: summary } });\n  await api.updateNode(summaryFace.id, size(summaryFace, summaryWidth));\n}\nif (declaredHere(iconFace)) {\n  await api.updateView(iconFace.id, { content: { kind: 'html', value: icon } });\n  await api.updateNode(iconFace.id, size(iconFace, ICON_WIDTH));\n}\nif (glyph) await api.updateNode(glyph.id,{data:{...glyph.data,glyph:{\"kind\":\"svg\",\"value\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"8 6 104 108\\\"><path d=\\\"M10 38 60 9 110 38 60 67Z M10 45 53 70V111L10 86Z M67 70 110 45V86L67 111Z\\\" fill=\\\"#fff\\\"/></svg>\",\"color\":\"#8ebaff\"}}});\n\n// The environment is the Poster page: the library's name set large, where it lives, a stage the graph stands on, and the routes along the foot. The window is\n// the page's own shape, sized so that the stage holds the nodes you see when browsing, with those nodes centred on it. The nodes that are only there to edit\n// sit in the band above the stage, under the headline, and are hidden when browsing. The environment takes no pointer, so a click on one of its routes reaches the\n// canvas behind it, which follows the link (followEnvironmentLink in the app); the shelves are also opened through their portals on the stage.\nconst EDITOR_ONLY = new Set(['root', 'face', 'glyph', 'import', 'export', 'method', 'script']);\nconst shown = nodes.filter((node) => node.position && node.visible !== false && !EDITOR_ONLY.has(clean(node.type)));\nconst envFace = faces.find((node) => clean(node.data?.view?.payload) === 'node.web.environment');\nif (root && shown.length) {\n  const left = Math.min(...shown.map((node) => node.position.x)); const top = Math.min(...shown.map((node) => node.position.y));\n  const right = Math.max(...shown.map((node) => node.position.x + node.width)); const bottom = Math.max(...shown.map((node) => node.position.y + node.height));\n  const STAGE_X = 4; const STAGE_W = 92; const STAGE_Y = 25.8; const FOOT = 8.9; const STAGE_H = 100 * ratio - STAGE_Y - FOOT; const PAD = 80;\n  const sized = nodes.filter((node) => node.position).map((node) => (node === detailFace ? { ...node, ...size(node, DETAIL_WIDTH) } : node === summaryFace ? { ...node, ...size(node, summaryWidth) } : node === iconFace && declaredHere(iconFace) ? { ...node, ...size(node, ICON_WIDTH) } : node));\n  const { x: x0, y: y0, width: w, height: h } = fitWindow({ shape: ratio, stage: { left: STAGE_X, right: 100 - STAGE_X - STAGE_W, top: STAGE_Y, bottom: FOOT }, cards: shown, all: sized, pad: PAD });\n  if (envFace) {\n    const GOLD = '#ffc66f'; const PAPER = '#17357f'; const LINE = '#6088d2';\n    const lineAt = (percent, width) => `color-mix(in srgb,${LINE} ${percent}%,transparent) ${width}cqw,transparent ${width}cqw`;\n    const grid = `linear-gradient(${lineAt(26, 0.12)}),linear-gradient(90deg,${lineAt(26, 0.12)}),linear-gradient(${lineAt(12, 0.08)}),linear-gradient(90deg,${lineAt(12, 0.08)})`;\n    const headSize = title.length <= 9 ? 10.5 : title.length <= 14 ? 8.4 : title.length <= 20 ? 6.6 : 5.2;\n    const subTop = Math.min(17.1,6.4 + headSize * 0.9 + 1.4);\n    const line = clean(data.body) || 'Why it exists, how it is going, and everything gathered around it.';\n    const label = (route) => `<a href='${esc(route.ref)}' style='color:inherit;text-decoration:none'>${esc(route.text)} →</a>`;\n    const routes = [startRef ? { text: 'Start here', ref: startRef } : null, ...members.slice(0, 4).map((member) => ({ text: member.name, ref: member.ref }))].filter((route) => route && clean(route.ref));\n    const page = `<div style='container-type:inline-size;width:100%;height:100%'><div style='position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background-color:${PAPER};background-image:${grid};background-size:10cqw 10cqw,10cqw 10cqw,2cqw 2cqw,2cqw 2cqw;font-family:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#ffffff'>`\n      + `<div style='position:absolute;right:4cqw;top:3cqw;width:17cqw;height:20cqw'><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 128\" preserveAspectRatio=\"xMidYMid meet\"><path d=\"M12 96 60 69 110 96 62 123Z\" fill=\"#102859\"/><path d=\"M24 43 64 20 102 42 62 65Z\" fill=\"#a9c9ff\"/><path d=\"M24 43 62 65V108L24 86Z\" fill=\"#4276d5\"/><path d=\"M62 65 102 42V85L62 108Z\" fill=\"#214a9c\"/><path d=\"M35 60 49 68V83L35 75Z M72 72 89 62V77L72 87Z\" fill=\"#ffcf82\"/><path d=\"M64 20V2\" stroke=\"#f4f0e6\" stroke-width=\"3\"/><path d=\"M65 2 91 9 65 16Z\" fill=\"#ffc66f\"/></svg></div>`\n      + `<div style='position:absolute;left:4cqw;top:3.6cqw;font:800 1.5cqw/1.2 Inter,system-ui,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:${GOLD}'>Project</div>`\n      + `<div style='position:absolute;left:4cqw;right:24cqw;top:6.4cqw;font:800 ${headSize}cqw/.9 system-ui,sans-serif;letter-spacing:-.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${esc(title)}</div>`\n      + `<div style='position:absolute;left:4cqw;right:24cqw;top:${subTop}cqw;font:400 2.5cqw/1.3 Inter,system-ui,sans-serif;color:#e6efff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${esc(line)}</div>`\n      + `<div style='position:absolute;left:4cqw;right:24cqw;top:${STAGE_Y - 5.8}cqw;height:4.4cqw;box-sizing:border-box;display:flex;align-items:center;gap:1.4cqw;padding:.6cqw 1.4cqw;background:#102859;border-left:.45cqw solid ${GOLD};color:#e6efff;font:700 1.9cqw/1.1 system-ui;overflow:hidden'><span style='flex:none;color:${GOLD};text-transform:uppercase'>${esc(statusText)}</span><span style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${standing ? `Now: ${esc(standing)}` : where ? esc(where) : esc(shelfText)}</span></div>`\n      + `<div style='position:absolute;left:${STAGE_X}cqw;top:${STAGE_Y}cqw;width:${STAGE_W}cqw;height:${STAGE_H}cqw;box-sizing:border-box;border-radius:2cqw;background:#1d438f;border:.3cqw solid #729be6'></div>`\n      + `<div style='position:absolute;left:4cqw;right:4cqw;bottom:3.4cqw;display:flex;gap:3cqw;font:700 1.9cqw/1.2 Inter,system-ui,sans-serif;color:${GOLD};white-space:nowrap;overflow:hidden'>${routes.map(label).join('')}</div>`\n      + `</div></div>`;\n    await api.updateView(envFace.id, { content: { kind: 'html', value: page }, view: { ...(envFace.data?.view || {}), fit: 'window', stage:{left:STAGE_X,right:100-STAGE_X-STAGE_W,top:STAGE_Y,bottom:FOOT} } });\n  }\n  await api.updateNode(root.id, { data: { ...root.data, membrane: { ...(root.data?.membrane || {}), bounds: { x: x0, y: y0, width: w, height: h } } } });\n}\nreturn { shelves: count, graphs: totalGraphs, columns, rows, ratio: Math.round(ratio * 1000) / 1000 };\n"
      }
    },
