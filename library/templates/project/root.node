    {
      "id": "project-template-landing",
      "type": "content",
      "label": "Collection Template landing",
      "position": {
        "x": -213,
        "y": -355
      },
      "width": 633.5114535153646,
      "height": 270.2697209374306,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
