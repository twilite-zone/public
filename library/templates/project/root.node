    {
      "id": "project-template-derive-method",
      "type": "method",
      "label": "Derive the library views",
      "position": {
        "x": -590,
        "y": -625
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
