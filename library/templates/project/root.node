dth:thin;scrollbar-color:#64748b #cbd5e1'><div style='position:relative;flex:none;width:39.6cqw;height:26.4cqw;scroll-snap-align:start'><div style='container-type:inline-size;width:100%;height:100%'><div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:#f7f9fc;border:.9cqw solid #1e40af;display:flex;align-items:center;gap:6cqw;color:#1f2937;overflow:hidden'><div style='flex:0 0 24cqw'><svg viewBox='0 0 64 64' style='width:100%;height:100%;display:block' aria-hidden='true'><g fill='none' stroke='#1e40af' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'><path d='M32 56V36'/><path d='M32 36L14 16'/><path d='M32 36L50 16'/><path d='M14 28V16H26'/><path d='M38 16H50V28'/></g></svg></div><div style='min-width:0;flex:1'><div style='font:700 3.2cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#1e40af'>Decision</div><div style='font:700 8.2cqw/1.12 Georgia,Iowan Old Style,Palatino Linotype,serif;margin:2cqw 0 1.2cqw;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>Name the decision</div><div style='font:600 3.6cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#334155'>2 options · 2 criteria</div><div style='margin-top:2cqw;font:700 3.8cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>Still open</div><div style='margin-top:2cqw;display:inline-block;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:700 3cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase'>1 to check</div></div></div></div></div><a href='tlz://twilite.zone/library/templates/decision/root.node' title='Decision' aria-label='Decision' style='position:absolute;inset:0'></a></div></div></div></div></div></div><a href='tlz://twilite.zone/library/templates/project/shelves/decisions/root.node' title='Decisions' aria-label='Decisions' style='position:absolute;inset:0'></a></div><div style='position:relative;flex:none;width:39.6cqw;height:26.4cqw;scroll-snap-align:start'><div style='container-type:inline-size;width:100%;height:100%'><div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;font-family:system-ui,-apple-system,Segoe UI,sans-serif;padding:5cqw;border-radius:4cqw;background:#ffffff;border:1px solid #e2e8f0;display:flex;flex-direction:column;gap:2cqw;overflow:hidden'><div style='display:flex;justify-content:space-between;align-items:flex-end;gap:2cqw'><div style='min-width:0'><div style='font-size:2.8cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#6d28d9'>Collection</div><div style='font-weight:600;font-size:5.4cqw;line-height:1.2;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Tasks</div></div><div style='font-size:3.4cqw;color:#475569;white-space:nowrap'>0 graphs</div></div><div style='margin-top:auto;display:flex;align-items:center;justify-content:center;height:26.4cqw;border:1px dashed #cbd5e1;border-radius:3cqw;color:#64748b;font-size:3.6cqw'>Nothing here yet. Add a graph with a portal.</div></div></div></div><a href='tlz://twilite.zone/library/templates/project/shelves/notes/root.node' title='Notes' aria-label='Notes' style='position:absolute;inset:0'></a></div></div><div style='position:absolute;right:0;top:0;bottom:12px;width:6cqw;pointer-events:none;background:linear-gradient(270deg,#ffffff,rgba(255,255,255,0))'></div></div></div></div>"
        },
