        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;font-family:system-ui,-apple-system,Segoe UI,sans-serif;padding:4cqw;border-radius:1cqw;background:#edf3fc;border-top:1.2cqw solid #2254b6;display:flex;flex-direction:column;gap:2cqw'><div style='display:block'><div style='float:right;width:19cqw;height:19cqw;margin:0 0 1cqw 3cqw;background:#17357f;padding:1cqw;box-sizing:border-box'><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 128\" preserveAspectRatio=\"xMidYMid meet\"><path d=\"M12 96 60 69 110 96 62 123Z\" fill=\"#102859\"/><path d=\"M24 43 64 20 102 42 62 65Z\" fill=\"#a9c9ff\"/><path d=\"M24 43 62 65V108L24 86Z\" fill=\"#4276d5\"/><path d=\"M62 65 102 42V85L62 108Z\" fill=\"#214a9c\"/><path d=\"M35 60 49 68V83L35 75Z M72 72 89 62V77L72 87Z\" fill=\"#ffcf82\"/><path d=\"M64 20V2\" stroke=\"#f4f0e6\" stroke-width=\"3\"/><path d=\"M65 2 91 9 65 16Z\" fill=\"#ffc66f\"/></svg></div><div style='display:flex;flex-direction:column;gap:1.1cqw'><div style='font-size:2.4cqw;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#2254b6'>Project</div><div style='font-weight:850;font-size:6.4cqw;letter-spacing:-.04em;line-height:1.2;color:#0f172a'>Name this project</div><div style='display:flex;gap:1.6cqw;align-items:center;font-size:2.4cqw;color:#64748b'><span style='padding:.4cqw 1.8cqw;border-radius:6cqw;background:#15803d1a;border:1px solid #15803d55;color:#15803d;font-weight:800'>Active</span></div><div style='font-size:2.9cqw;line-height:1.4;color:#334155'>Why this project exists, in a sentence.</div><div style='background:#dce7ff;border-left:.8cqw solid #2254b6;padding:1.4cqw 2cqw;display:flex;gap:1.5cqw;align-items:baseline;line-height:1.3'><span style='flex:none;font:800 2.5cqw/1.3 system-ui;color:#17357f;letter-spacing:.04em'>NOW</span><span style='font-size:3cqw;font-weight:650;color:#121a33;overflow-wrap:anywhere'>The next step, in a line.</span></div><a href='tlz://twilite.zone/library/templates/project/shelves/ideas/root.node' style='align-self:flex-start;margin-top:.4cqw;padding:1.1cqw 2.8cqw;border-radius:6cqw;background:#2254b6;color:#ffffff;font-size:2.8cqw;font-weight:600;text-decoration:none'>Start here →</a></div></div><div style='font-size:2.4cqw;font-weight:800;letter-spacing:.09em;color:#17357f'>PROJECT SHELVES · 5 shelves</div><div style='flex:1;min-height:0;overflow:auto;padding-bottom:1.5cqw'><div style='display:grid;grid-template-columns:repeat(auto-fill,minmax(26.2cqw,1fr));gap:1.4cqw;align-content:start'><a href='tlz://twilite.zone/library/templates/project/shelves/ideas/root.node' style='display:flex;gap:2.2cqw;align-items:flex-start;box-sizing:border-box;min-height:14.5cqw;padding:1.3cqw 1.7cqw;border:1px solid #e2e8f0;border-radius:1.2cqw;background:#ffffff;border-left:.65cqw solid #7543a4;text-decoration:none;color:inherit;min-width:0;overflow:hidden'><span style='flex:none;width:6.2cqw;height:6.2cqw;border-radius:1.6cqw;background:#7543a422;color:#7543a4;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:3cqw'>I</span><span style='min-width:0'><span style='display:block;font-weight:800;font-size:3.3cqw;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#0f172a'>Ideas</span><span style='display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:2.5cqw;line-height:1.25;color:#475569'>The thinking behind it.</span><span style='display:block;margin-top:.3cqw;font-size:2.5cqw;font-weight:600;color:#2254b6'>1 graph</span></span></a><a href='tlz://twilite.zone/library/templates/project/shelves/plans/root.node' style='display:flex;gap:2.2cqw;align-items:flex-start;box-sizing:border-box;min-height:14.5cqw;padding:1.3cqw 1.7cqw;border:1px solid #e2e8f0;border-radius:1.2cqw;background:#ffffff;border-left:.65cqw solid #7543a4;text-decoration:none;color:inherit;min-width:0;overflow:hidden'><span style='flex:none;width:6.2cqw;height:6.2cqw;border-radius:1.6cqw;background:#7543a422;color:#7543a4;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:3cqw'>P</span><span style='min-width:0'><span style='display:block;font-weight:800;font-size:3.3cqw;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#0f172a'>Plans</span><span style='display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:2.5cqw;line-height:1.25;color:#475569'>How it gets done. A project can have several.</span><span style='display:block;margin-top:.3cqw;font-size:2.5cqw;font-weight:600;color:#2254b6'>1 graph</span></span></a><a href='tlz://twilite.zone/library/templates/project/shelves/tasks/root.node' style='display:flex;gap:2.2cqw;align-items:flex-start;box-sizing:border-box;min-height:14.5cqw;padding:1.3cqw 1.7cqw;border:1px solid #e2e8f0;border-radius:1.2cqw;background:#ffffff;border-left:.65cqw solid #7543a4;text-decoration:none;color:inherit;min-width:0;overflow:hidden'><span style='flex:none;width:6.2cqw;height:6.2cqw;border-radius:1.6cqw;background:#7543a422;color:#7543a4;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:3cqw'>T</span><span style='min-width:0'><span style='display:block;font-weight:800;font-size:3.3cqw;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#0f172a'>Tasks</span><span style='display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:2.5cqw;line-height:1.25;color:#475569'>The work, one graph to a task.</span><span style='display:block;margin-top:.3cqw;font-size:2.5cqw;font-weight:600;color:#2254b6'>1 graph</span></span></a><a href='tlz://twilite.zone/library/templates/project/shelves/decisions/root.node' style='display:flex;gap:2.2cqw;align-items:flex-start;box-sizing:border-box;min-height:14.5cqw;padding:1.3cqw 1.7cqw;border:1px solid #e2e8f0;border-radius:1.2cqw;background:#ffffff;border-left:.65cqw solid #7543a4;text-decoration:none;color:inherit;min-width:0;overflow:hidden'><span style='flex:none;width:6.2cqw;height:6.2cqw;border-radius:1.6cqw;background:#7543a422;color:#7543a4;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:3cqw'>D</span><span style='min-width:0'><span style='display:block;font-weight:800;font-size:3.3cqw;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#0f172a'>Decisions</span><span style='display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:2.5cqw;line-height:1.25;color:#475569'>What was settled, and why.</span><span style='display:block;margin-top:.3cqw;font-size:2.5cqw;font-weight:600;color:#2254b6'>1 graph</span></span></a><a href='tlz://twilite.zone/library/templates/project/shelves/notes/root.node' style='display:flex;gap:2.2cqw;align-items:flex-start;box-sizing:border-box;min-height:14.5cqw;padding:1.3cqw 1.7cqw;border:1px solid #e2e8f0;border-radius:1.2cqw;background:#ffffff;border-left:.65cqw solid #7543a4;text-decoration:none;color:inherit;min-width:0;overflow:hidden'><span style='flex:none;width:6.2cqw;height:6.2cqw;border-radius:1.6cqw;background:#7543a422;color:#7543a4;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:3cqw'>N</span><span style='min-width:0'><span style='display:block;font-weight:800;font-size:3.3cqw;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#0f172a'>Notes</span><span style='display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:2.5cqw;line-height:1.25;color:#475569'>Loose writing that is not any of the above yet.</span><span style='display:block;margin-top:.3cqw;font-size:2.5cqw;font-weight:600;color:#2254b6'>0 graphs</span></span></a></div></div></div></div>"
