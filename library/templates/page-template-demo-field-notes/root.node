      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "page-template"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "scroll": "page"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='--paper:#f6efe2;--ink:#3b2a1a;--muted:color-mix(in srgb,#3b2a1a 62%,#f6efe2);--accent:#b4532a;--line:#d9c9a8;--body:color-mix(in srgb,#3b2a1a 88%,#f6efe2);--tint:color-mix(in srgb,#b4532a 7%,#f6efe2);--tint-strong:color-mix(in srgb,#b4532a 14%,#f6efe2);--tint-line:color-mix(in srgb,#b4532a 28%,#f6efe2);--soft:color-mix(in srgb,#d9c9a8 60%,#f6efe2);--code-bg:color-mix(in srgb,#3b2a1a 6%,#f6efe2);--serif:Rockwell,Roboto Slab,Zilla Slab,Georgia,serif;--body-font:Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;--sans:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;width:100%;height:100%;overflow:auto;box-sizing:border-box;container-type:inline-size;background:var(--paper);font-family:var(--serif);color:var(--ink)'><div style='box-sizing:border-box;max-width:900px;margin:0 auto;padding:0 clamp(20px,5cqw,40px) 64px'><div style='padding-top:32px'><header data-role='masthead'><div style='padding:10px 0;border-top:3px solid var(--ink);border-bottom:1px solid var(--ink);font:800 12px/16px var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--accent)'>FIELD NOTES / NO. 4</div><h1 style='margin:40px 0 0;font:500 clamp(40px,9.5cqw,72px)/.98 var(--serif);letter-spacing:-.025em;text-wrap:balance;color:var(--ink)'>Page title</h1><p style='margin:18px 0 0;max-width:36ch;font:italic 400 clamp(20px,3.6cqw,26px)/1.35 var(--serif);color:var(--muted)'>Warm paper, ink brown and one rust accent: the same pieces, another look.</p></header></div><div style='padding-top:40px'><div style='display:flex;flex-wrap:wrap;align-items:stretch;gap:28px 32px'><div style='flex:1 1 190px;min-width:0'><a data-role='route' data-appearance='portal' href='tlz://twilite.zone/gallery/root.node' style='height:100%;box-sizing:border-box;display:flex;flex-direction:column;gap:4px;padding:12px 16px;background:var(--tint);border:2px solid var(--accent);border-radius:10px;text-decoration:none;color:var(--ink)'><span style='font:800 11px/14px var(--sans);letter-spacing:.14em;color:var(--accent)'>OPEN</span><h2 style='margin:0;font:500 22px/26px var(--serif);letter-spacing:-.01em;color:var(--ink)'>A way on</h2><span style='font:400 13px/18px var(--sans);color:var(--muted)'>One short line about where this leads.</span></a></div><div style='flex:1 1 190px;min-width:0'><a data-role='route' data-appearance='portal' href='tlz://twilite.zone/tutorial/root.node' style='height:100%;box-sizing:border-box;display:flex;flex-direction:column;gap:4px;padding:12px 16px;background:var(--tint);border:2px solid var(--accent);border-radius:10px;text-decoration:none;color:var(--ink)'><span style='font:800 11px/14px var(--sans);letter-spacing:.14em;color:var(--accent)'>OPEN</span><h2 style='margin:0;font:500 22px/26px var(--serif);letter-spacing:-.01em;color:var(--ink)'>Another way on</h2><span style='font:400 13px/18px var(--sans);color:var(--muted)'>Routes that follow one another share a row.</span></a></div><div style='flex:1 1 190px;min-width:0'><section data-role='route' data-prominence='secondary' style='height:100%;box-sizing:border-box;display:flex;flex-direction:column;padding-top:14px;border-top:1px solid var(--ink)'><h2 style='margin:0 0 8px;font:500 22px/1.1 var(--serif);letter-spacing:-.01em;color:var(--ink)'>A plain route</h2><p style='margin:0 0 10px;font:400 14px/1.55 var(--sans);color:var(--muted)'>A route left plain is a heading, a line, and a link.</p><a data-role='route-link' href='tlz://twilite.zone/root.node' style='margin-top:auto;font:700 13px/20px var(--sans);text-decoration:none;color:var(--muted)'>Go there →</a></section></div></div></div><div style='padding-top:48px'><div style='display:flex;flex-wrap:wrap;align-items:flex-start;gap:32px 40px'><div style='flex:999 1 380px;min-width:0'><section data-role='section'><h2 style='margin:0 0 14px;font:800 12px/16px var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--accent)'>Section heading</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'><span style='float:left;padding:6px 10px 0 0;font:500 68px/54px var(--serif);color:var(--ink)'>W</span>rite the section here. A section is a heading and a body; the body takes paragraphs, bullet lists, sub-headings, bold, inline code and links.</p><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>Everything you see on this page is a separate piece you can change on its own.</p><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>Use this template when the content is prose. A page graph is a document: its pieces are hidden when browsing, and a Method assembles them into the page the graph lands on. Text decides its own length, so nothing can be placed on a page; where a page needs a way out, it carries a link in the text. A graph whose content is places and connections needs no template: it is a scene already.</p></section></div><div style='flex:1 1 220px;min-width:0'><section data-role='settings' style='padding-top:10px;border-top:3px solid var(--ink)'><h2 style='margin:0 0 14px;font:800 12px/16px var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--ink)'>About this page</h2><dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid var(--line)'><dt style='padding:9px 0 9px;border-top:1px solid var(--line);font:400 13px/20px var(--sans);color:var(--muted)'>Order</dt><dd style='margin:0;padding:9px 0;border-top:1px solid var(--line);text-align:right;font:600 14px/20px var(--sans);color:var(--ink);overflow-wrap:anywhere'>Graph order</dd><dt style='grid-column:1/-1;padding:9px 0 0px;border-top:1px solid var(--line);font:400 13px/20px var(--sans);color:var(--muted)'>Roles in use</dt><dd style='grid-column:1/-1;margin:0;padding:2px 0 9px;font:600 14px/20px var(--sans);color:var(--ink);overflow-wrap:anywhere'>Masthead, route, section, settings</dd><dt style='grid-column:1/-1;padding:9px 0 0px;border-top:1px solid var(--line);font:400 13px/20px var(--sans);color:var(--muted)'>Kept current by</dt><dd style='grid-column:1/-1;margin:0;padding:2px 0 9px;font:600 14px/20px var(--sans);color:var(--ink);overflow-wrap:anywhere'>One Method, called by a Handler for each role and one for the graph structure</dd></dl></section></div></div></div></div></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791502661082,
          "reason": "node-drag"
        },
        "memo": "",
        "link": ""
      }
    },
