          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='--paper:#f6efe2;--ink:#3b2a1a;--muted:color-mix(in srgb,#3b2a1a 62%,#f6efe2);--accent:#b4532a;--line:#d9c9a8;--body:color-mix(in srgb,#3b2a1a 88%,#f6efe2);--tint:color-mix(in srgb,#b4532a 7%,#f6efe2);--tint-strong:color-mix(in srgb,#b4532a 14%,#f6efe2);--tint-line:color-mix(in srgb,#b4532a 28%,#f6efe2);--soft:color-mix(in srgb,#d9c9a8 60%,#f6efe2);--code-bg:color-mix(in srgb,#3b2a1a 6%,#f6efe2);--serif:Rockwell,Roboto Slab,Zilla Slab,Georgia,serif;--body-font:Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;--sans:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;box-sizing:border-box;width:100%;height:100%;min-height:100%;padding:clamp(0.5px,7.33cqw,33px) clamp(0.5px,8.00cqw,36px);border-radius:min(18px,6cqw);background:var(--paper);border:1px solid var(--soft);color:var(--ink);overflow:hidden;display:flex;flex-direction:column'><div style='margin-bottom:clamp(0.5px,3.33cqw,15px);font-weight:800;font-size:clamp(0.5px,3.67cqw,17px);line-height:1.3;font-family:var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--accent)'>FIELD NOTES / NO. 4</div><div style='font-weight:500;font-size:clamp(0.5px,10.67cqw,48px);line-height:1;font-family:var(--serif);letter-spacing:-.02em'>Page title</div><div style='margin-top:clamp(0.5px,3.33cqw,15px);font-weight:600;font-size:clamp(0.5px,4.33cqw,20px);line-height:1.4;font-family:var(--sans);color:var(--accent)'>A way on · Another way on · A plain route</div><div style='margin-top:auto;padding-top:clamp(0.5px,2.67cqw,12px);font-weight:400;font-size:clamp(0.5px,4.00cqw,18px);line-height:1.3;font-family:var(--sans);color:var(--muted)'>6 pieces</div></div></div>"
