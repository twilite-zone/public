      "visible": false,
      "showLabel": false,
      "data": {
        "identity": {
          "graphId": "page-template"
        },
        "title": "About this page",
        "rows": [
          {
            "label": "Order",
            "value": "Graph order"
          },
          {
            "label": "Roles in use",
            "value": "Masthead, route, section, settings"
          },
          {
            "label": "Kept current by",
            "value": "One Method, called by a Handler for each role and one for the graph structure"
          }
        ],
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Settings"
          }
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template-demo-field-notes/classes/page-settings.node-class.node"
      },
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ]
    },
    {
      "id": "assemble-page-method",
      "type": "method",
      "label": "Assemble the page",
      "position": {
        "x": 1120,
        "y": -270
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Assemble the page",
        "parameters": [],
        "source": "// Assembles the page from its pieces and writes it into the views the Declaration exposes: the Detail (one page, in the regular 3:2 shape),\n// the Summary (the same shape, smaller) and the Glyph. It also writes their sizes and the window, which is the Detail's shape and holds\n// everything the graph has. The root announces graph.changed and one invokes edge leads here, so the stored page is always current.\nconst ROLES = ['page-masthead', 'page-route', 'page-section', 'page-settings'];\n\nconst clean = (value) => String(value ?? '').trim();\nconst escapeHtml = (value) => clean(value)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\n// Rows are { label, value } pairs, or \"label: value\" lines.\nconst settingRows = (rows) => (Array.isArray(rows) ? rows : []).map((row) => {\n  if (row && typeof row === 'object') return [clean(row.label), clean(row.value)];\n  const text = clean(row);\n  const cut = text.indexOf(':');\n  return cut < 0 ? [text, ''] : [clean(text.slice(0, cut)), clean(text.slice(cut + 1))];\n}).filter(([name, value]) => name || value);\nconst roleOf = (node) => clean(node?.type);\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\n\n\n// --- The look, which a page may choose ---------------------------------------------------------\n// A page-style piece, when the page has one, sets the palette and the type and picks the layout (article or poster).\n// Everything below paints with these names (var(--ink) and so on), set once on the root of each view, so a look is\n// one place and a view can be drawn on any ground. With no page-style piece the page looks as it always has.\nconst ROLES_STYLE = 'page-style';\nconst LAYOUT_NAMES = ['article', 'poster', 'handbook', 'slides', 'timeline', 'catalog'];\nconst FONTS = {\n  serif: 'Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif',\n  slab: 'Rockwell,Roboto Slab,Zilla Slab,Georgia,serif',\n  sans: 'Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif',\n  display: 'Archivo Black,Impact,Haettenschweiler,Arial Black,sans-serif',\n  mono: 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace'\n};\nconst DEFAULT_LOOK = { paper: '#ffffff', ink: '#0f172a', muted: '#475569', accent: '#6d28d9', line: '#cbd5e1', heading: 'serif', body: 'serif', sans: 'sans', mono: 'mono', layout: 'article' };\nconst styleData = nodes.find((node) => roleOf(node) === ROLES_STYLE)?.data || {};\n// Only a plain colour (#hex, rgb(), hsl(), a name) or a font key we know is let through: the value ends up inside a style attribute.\nconst colour = (value, fallback) => (/^(#[0-9a-f]{3,8}|(rgb|hsl)a?\\([0-9.,%\\s/]+\\)|[a-z]{3,20})$/i.test(clean(value)) ? clean(value) : fallback);\nconst font = (value, fallback) => (FONTS[clean(value).toLowerCase()] ? clean(value).toLowerCase() : fallback);\nconst look = {\n  paper: colour(styleData.paper, DEFAULT_LOOK.paper), ink: colour(styleData.ink, DEFAULT_LOOK.ink), muted: colour(styleData.muted, DEFAULT_LOOK.muted),\n  accent: colour(styleData.accent, DEFAULT_LOOK.accent), line: colour(styleData.line, DEFAULT_LOOK.line),\n  heading: font(styleData.heading, DEFAULT_LOOK.heading), body: font(styleData.body, DEFAULT_LOOK.body), mono: DEFAULT_LOOK.mono,\n  layout: LAYOUT_NAMES.includes(clean(styleData.layout).toLowerCase()) ? clean(styleData.layout).toLowerCase() : 'article'\n};\n// The page's own tints come from its colours unless it is the default look, which keeps the exact values it always had.\nconst own = ['paper', 'ink', 'accent', 'line'].some((key) => clean(styleData[key]));\nconst mix = (a, b, percent) => `color-mix(in srgb,${a} ${percent}%,${b})`;\nconst themeVars = () => [\n  ['paper', look.paper], ['ink', look.ink], ['muted', own && !clean(styleData.muted) ? mix(look.ink, look.paper, 62) : look.muted], ['accent', look.accent], ['line', look.line],\n  ['body', own ? mix(look.ink, look.paper, 88) : '#1e293b'],\n  ['tint', own ? mix(look.accent, look.paper, 7) : '#f5f3ff'],\n  ['tint-strong', own ? mix(look.accent, look.paper, 14) : '#ede9fe'],\n  ['tint-line', own ? mix(look.accent, look.paper, 28) : '#ddd6fe'],\n  ['soft', own ? mix(look.line, look.paper, 60) : '#e2e8f0'],\n  ['code-bg', own ? mix(look.ink, look.paper, 6) : '#f1f5f9'],\n  ['serif', FONTS[look.heading]], ['body-font', FONTS[look.body]], ['sans', FONTS[DEFAULT_LOOK.sans]], ['mono', FONTS.mono]\n].map(([name, value]) => `--${name}:${value}`).join(';');\n\n// --- How the page looks ------------------------------------------------------------------------\n// The page reads as an article. Inline styles only, attributes in single quotes, font names unquoted, and\n// every fluid size taken from the view's own width (cqw), because a View may be drawn at any size.\nconst SERIF = 'var(--serif)';\nconst ACCENT = 'var(--accent)';\nconst KICKER = 'font:800 12px/16px var(--sans);letter-spacing:.18em;text-transform:uppercase';\n// Escapes without trimming, for the rest of a paragraph after its first letter has been lifted out.\nconst escapeText = (value) => String(value ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst kicker = (text, color = ACCENT) => `<h2 style='margin:0 0 14px;${KICKER};color:${color}'>${escapeHtml(text)}</h2>`;\n// Body text. Paragraphs, bullet lists (one level of nesting), fenced code blocks and sub-headings, with `code` and\n// **bold** and [links](address) inside a line. Everything authored is escaped first; only these few marks become markup. The first\n// paragraph of the page's first section opens with a drop cap, when the section starts with a letter.\nconst MONO = 'var(--mono)';\nconst inlineText = (value) => escapeText(value)\n  .replace(/`([^`]+)`/g, (_, code) => `<code style='padding:1px 4px;border-radius:3px;background:var(--code-bg);font:400 .84em ${MONO};overflow-wrap:anywhere'>${code}</code>`)\n  .replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>')\n  // A link written as [words](address) becomes a link, when the address is one Twilite or the web can open.\n  .replace(/\\[([^\\]]+)\\]\\(((?:tlz|https|github):\\/\\/[^\\s)]+)\\)/g, (_, words, address) => `<a href='${address}' style='color:${ACCENT};text-decoration:underline'>${words}</a>`);\nconst bodyBlocks = (value) => {\n  const lines = String(value ?? '').replace(/\\r\\n/g, '\\n').split('\\n');\n  const blocks = [];\n  let paragraph = [];\n  let afterBlank = true;\n  const flush = () => { if (paragraph.length) blocks.push({ kind: 'p', text: paragraph.join('\\n') }); paragraph = []; };\n  for (let index = 0; index < lines.length; index += 1) {\n    const line = lines[index];\n    if (/^```/.test(line.trim())) {\n      flush();\n      const code = [];\n      index += 1;\n      while (index < lines.length && !/^```/.test(lines[index].trim())) { code.push(lines[index]); index += 1; }\n      blocks.push({ kind: 'code', text: code.join('\\n') });\n      afterBlank = true;\n      continue;\n    }\n    if (!line.trim()) { flush(); afterBlank = true; continue; }\n    const heading = /^#{2,4} +(.+)$/.exec(line.trim());\n    if (heading) { flush(); blocks.push({ kind: 'h', text: heading[1] }); afterBlank = true; continue; }\n    const item = /^(\\s*)[-*] +(.*)$/.exec(line);\n    const last = blocks[blocks.length - 1];\n    if (item) {\n      flush();\n      const list = last?.kind === 'list' && !afterBlank ? last : null;\n      const entry = { text: item[2], children: [] };\n      if (list && item[1].length >= 2 && list.items.length) list.items[list.items.length - 1].children.push(entry);\n      else if (list) list.items.push(entry);\n      else blocks.push({ kind: 'list', items: [entry] });\n      afterBlank = false;\n      continue;\n    }\n    // A line that follows a list item without a blank line between continues that item.\n    if (last?.kind === 'list' && !afterBlank && !paragraph.length) {\n      const owner = last.items[last.items.length - 1];\n      const target = owner.children.length ? owner.children[owner.children.length - 1] : owner;\n      target.text += ` ${line.trim()}`;\n      continue;\n    }\n    paragraph.push(line.trim());\n    afterBlank = false;\n  }\n  flush();\n  return blocks;\n};\nconst listMarkup = (items, nested) => `<ul style='margin:${nested ? '6px 0 0' : '0 0 14px'};padding-left:22px;${nested ? '' : `max-width:60ch;font:400 18px/1.55 var(--body-font);color:var(--body)`}'>`\n  + items.map((item) => `<li style='margin:0 0 6px'>${inlineText(item.text)}${item.children.length ? listMarkup(item.children, true) : ''}</li>`).join('')\n  + `</ul>`;\nconst bodyText = (value, dropCap) => bodyBlocks(value).map((block, index) => {\n  if (block.kind === 'code') return `<pre style='margin:0 0 16px;padding:14px 16px;overflow-x:auto;white-space:pre;background:var(--code-bg);border-left:3px solid ${ACCENT};font:400 13px/1.55 ${MONO};color:var(--ink)'>${escapeText(block.text)}</pre>`;\n  if (block.kind === 'h') return `<h3 style='margin:22px 0 8px;font:700 15px/20px var(--sans);color:var(--ink)'>${inlineText(block.text)}</h3>`;\n  if (block.kind === 'list') return listMarkup(block.items, false);\n  const cap = dropCap && index === 0 && /^[A-Za-z]/.test(block.text);\n  return `<p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>`\n    + (cap ? `<span style='float:left;padding:6px 10px 0 0;font:500 68px/54px ${SERIF};color:var(--ink)'>${block.text[0]}</span>` : '')\n    + `${inlineText(cap ? block.text.slice(1) : block.text).replace(/\\n/g, '<br>')}</p>`;\n}).join('');\n\n// --- One renderer per role: what that piece contributes ------------------------------------------\nconst RENDER = {\n  // The eyebrow is the nameplate, the title the headline, the subtitle the standfirst.\n  'page-masthead': (data) => `<header data-role='masthead'>`\n    + `<div style='padding:${clean(data.eyebrow) ? '10px 0' : '0'};border-top:3px solid var(--ink);${clean(data.eyebrow) ? 'border-bottom:1px solid var(--ink);' : ''}${KICKER};color:${ACCENT}'>${escapeHtml(data.eyebrow)}</div>`\n    + `<h1 style='margin:40px 0 0;font:500 clamp(40px,9.5cqw,72px)/.98 ${SERIF};letter-spacing:-.025em;text-wrap:balance;color:var(--ink)'>${escapeHtml(data.title)}</h1>`\n    + (clean(data.subtitle) ? `<p style='margin:18px 0 0;max-width:36ch;font:italic 400 clamp(20px,3.6cqw,26px)/1.35 ${SERIF};color:var(--muted)'>${escapeHtml(data.subtitle)}</p>` : '')\n    + `</header>`,\n  // A teaser: a rule, a title, a line or two, and where it leads. A primary route is drawn heavier.\n  'page-route': (data) => {\n    // Drawn as a Portal-style card when the route asks for it: a bordered card, the whole of which is the link.\n    if (clean(data.appearance).toLowerCase() === 'portal') {\n      const ref = /^(tlz|https|github):\\/\\//.test(clean(data.destinationRef)) ? clean(data.destinationRef) : '';\n      const tag = ref ? 'a' : 'div';\n      return `<${tag} data-role='route' data-appearance='portal'${ref ? ` href='${escapeHtml(ref)}'` : ''} style='height:100%;box-sizing:border-box;display:flex;flex-direction:column;gap:4px;padding:12px 16px;background:var(--tint);border:2px solid ${ACCENT};border-radius:10px;text-decoration:none;color:var(--ink)'>`\n        + `<span style='font:800 11px/14px var(--sans);letter-spacing:.14em;color:${ACCENT}'>${escapeHtml(clean(data.destinationLabel) || 'Open').toUpperCase()}</span>`\n        + `<h2 style='margin:0;font:500 22px/26px ${SERIF};letter-spacing:-.01em;color:var(--ink)'>${escapeHtml(data.title)}</h2>`\n        + (clean(data.body) ? `<span style='font:400 13px/18px var(--sans);color:var(--muted)'>${escapeHtml(data.body)}</span>` : '')\n        + `</${tag}>`;\n    }\n    const primary = clean(data.prominence).toLowerCase() !== 'secondary';\n    return `<section data-role='route' data-prominence='${primary ? 'primary' : 'secondary'}' style='height:100%;box-sizing:border-box;display:flex;flex-direction:column;`\n      + `${primary ? `padding-top:12px;border-top:3px solid ${ACCENT}` : 'padding-top:14px;border-top:1px solid var(--ink)'}'>`\n      + `<h2 style='margin:0 0 8px;font:500 ${primary ? 26 : 22}px/1.1 ${SERIF};letter-spacing:-.01em;color:var(--ink)'>${escapeHtml(data.title)}</h2>`\n      + (clean(data.body) ? `<p style='margin:0 0 10px;font:400 14px/1.55 var(--sans);color:var(--muted)'>${escapeHtml(data.body)}</p>` : '')\n      // Where it leads is a link to the route's destination, when it names one Twilite or the web can open.\n      + (/^(tlz|https|github):\\/\\//.test(clean(data.destinationRef))\n        ? `<a data-role='route-link' href='${escapeHtml(clean(data.destinationRef))}' style='margin-top:auto;font:700 13px/20px var(--sans);text-decoration:none;color:${primary ? ACCENT : 'var(--muted)'}'>${escapeHtml(data.destinationLabel || 'Open')} →</a></section>`\n        : `<div style='margin-top:auto;font:700 13px/20px var(--sans);color:${primary ? ACCENT : 'var(--muted)'}'>${escapeHtml(data.destinationLabel || 'Open')} →</div></section>`);\n  },\n  // A ruled list. A short value sits beside its name; a long one runs underneath at the full width of the list.\n  'page-settings': (data) => `<section data-role='settings' style='padding-top:10px;border-top:3px solid var(--ink)'>`\n    + kicker(data.title || 'Settings', 'var(--ink)')\n    + `<dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid var(--line)'>`\n    + settingRows(data.rows).map(([name, value]) => {\n      const wide = value.length > 24;\n      const span = wide ? 'grid-column:1/-1;' : '';\n      return `<dt style='${span}padding:9px 0 ${wide ? 0 : 9}px;border-top:1px solid var(--line);font:400 13px/20px var(--sans);color:var(--muted)'>${escapeHtml(name)}</dt>`\n        + `<dd style='${span}margin:0;padding:${wide ? '2px 0 9px' : '9px 0;border-top:1px solid var(--line);text-align:right'};font:600 14px/20px var(--sans);color:var(--ink);overflow-wrap:anywhere'>${escapeHtml(value)}</dd>`;\n    }).join('')\n    + `</dl></section>`,\n  'page-section': (data, { dropCap }) => `<section data-role='section'>${kicker(data.title)}${bodyText(data.body, dropCap)}</section>`\n};\n\n\n// --- The poster: a headline over one large stage ---------------------------------------------------\n// For a graph that is a scene. The stage is left open on purpose: the poster is the page, drawn across the graph behind its nodes, and\n// the graph's own nodes sit on the stage. Sections are not stacked here; each becomes a small note under the stage.\nconst stackPoster = (pieces) => {\n  const masthead = pieces.find((piece) => piece.role === 'page-masthead')?.data || {};\n  const routes = pieces.filter((piece) => piece.role === 'page-route').map((piece) => piece.data);\n  const notes = pieces.filter((piece) => piece.role === 'page-section').map((piece) => piece.data);\n  const label = (text, color) => `<div style='font:800 clamp(10px,1.3cqw,15px)/1.2 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:${color}'>${escapeHtml(text)}</div>`;\n  return `<div style='${themeVars()};width:100%;height:100%;overflow:auto;box-sizing:border-box;container-type:inline-size;background:var(--paper);color:var(--ink);font-family:var(--sans);display:flex;flex-direction:column;gap:clamp(14px,2.4cqw,32px);padding:clamp(20px,4cqw,56px)'>`\n    + `<header data-role='masthead'>`\n    + (clean(masthead.eyebrow) ? label(masthead.eyebrow, 'var(--accent)') : '')\n    + `<h1 style='margin:${clean(masthead.eyebrow) ? 'clamp(8px,1.4cqw,18px)' : '0'} 0 0;font:800 clamp(44px,10.5cqw,150px)/.9 var(--serif);letter-spacing:-.03em;text-wrap:balance;color:var(--ink)'>${escapeHtml(masthead.title)}</h1>`\n    + (clean(masthead.subtitle) ? `<p style='margin:clamp(10px,1.6cqw,22px) 0 0;max-width:38ch;font:400 clamp(16px,2.6cqw,34px)/1.3 var(--body-font);color:var(--muted)'>${escapeHtml(masthead.subtitle)}</p>` : '')\n    + `</header>`\n    + `<div data-role='stage' style='flex:1 1 auto;min-height:46%;box-sizing:border-box;border-radius:clamp(12px,1.8cqw,28px);background:var(--tint);border:2px solid var(--tint-line)'></div>`\n    + (routes.length || notes.length ? `<footer style='display:flex;flex-wrap:wrap;gap:clamp(12px,2cqw,28px) clamp(20px,3cqw,44px);align-items:flex-start'>`\n      + routes.map((data) => {\n        const ref = /^(tlz|https|github):\\/\\//.test(clean(data.destinationRef)) ? clean(data.destinationRef) : '';\n        const words = escapeHtml(data.title) + ' →';\n        return `<div data-role='route' style='flex:0 1 auto;font:700 clamp(13px,1.8cqw,22px)/1.2 var(--sans)'>${ref ? `<a href='${escapeHtml(ref)}' style='color:var(--accent);text-decoration:none'>${words}</a>` : `<span style='color:var(--accent)'>${words}</span>`}</div>`;\n      }).join('')\n      + notes.map((data) => `<div data-role='section' style='flex:1 1 200px;max-width:42ch'>${label(data.title, 'var(--muted)')}<p style='margin:6px 0 0;font:400 clamp(13px,1.6cqw,19px)/1.5 var(--body-font);color:var(--body)'>${inlineText(String(data.body ?? '').split('\\n')[0])}</p></div>`).join('')\n      + `</footer>` : '')\n    + `</div>`;\n};\n\n// --- The three views --------------------------------------------------------------------------\n// The pieces stay in graph order. Three things sit side by side when the view is wide enough and stack when it\n// is not: routes that follow one another, and a settings list next to the section it comes before or after,\n// which is set as that section's sidebar. Everything else takes the full width. A role with no pieces\n// contributes nothing.\nconst stackPage = (pieces) => {\n  const firstSection = pieces.find((piece) => piece.role === 'page-section');\n  const render = (piece) => RENDER[piece.role](piece.data, { dropCap: piece === firstSection });\n  const text = (piece) => `<div style='flex:999 1 380px;min-width:0'>${render(piece)}</div>`;\n  const side = (piece) => `<div style='flex:1 1 220px;min-width:0'>${render(piece)}</div>`;\n  const row = (inner, gap, reverse) => `<div style='display:flex;flex-wrap:wrap;${reverse ? 'flex-direction:row-reverse;' : ''}align-items:${reverse === undefined ? 'stretch' : 'flex-start'};gap:${gap}'>${inner}</div>`;\n  const blocks = [];\n  for (let index = 0; index < pieces.length; index += 1) {\n    const piece = pieces[index];\n    const next = pieces[index + 1];\n    if (piece.role === 'page-route') {\n      const routes = [piece];\n      while (pieces[index + 1]?.role === 'page-route') { index += 1; routes.push(pieces[index]); }\n      blocks.push([40, row(routes.map((route) => `<div style='flex:1 1 190px;min-width:0'>${render(route)}</div>`).join(''), '28px 32px')]);\n    } else if (piece.role === 'page-section' && next?.role === 'page-settings') {\n      index += 1;\n      blocks.push([48, row(text(piece) + side(next), '32px 40px', false)]);\n    } else if (piece.role === 'page-settings' && next?.role === 'page-section') {\n      index += 1;\n      blocks.push([48, row(side(piece) + text(next), '32px 40px', true)]);\n    } else blocks.push([piece.role === 'page-masthead' ? 32 : 48, render(piece)]);\n  }\n  return `<div style='${themeVars()};width:100%;height:100%;overflow:auto;box-sizing:border-box;container-type:inline-size;background:var(--paper);font-family:${SERIF};color:var(--ink)'>`\n    + `<div style='box-sizing:border-box;max-width:900px;margin:0 auto;padding:0 clamp(20px,5cqw,40px) 64px'>`\n    + blocks.map(([gap, inner]) => `<div style='padding-top:${gap}px'>${inner}</div>`).join('')\n    + `</div></div>`;\n};\n// A size drawn for one width that follows the width the view is actually shown at.\nconst fluid = (px, base) => `clamp(0.5px,${(px / base * 100).toFixed(2)}cqw,${Math.round(px * 1.5)}px)`;\nconst stackSummary = (pieces) => {\n  const masthead = pieces.find((piece) => piece.role === 'page-masthead')?.data || {};\n  const routes = pieces.filter((piece) => piece.role === 'page-route').map((piece) => clean(piece.data.title)).filter(Boolean);\n  const s = (px) => fluid(px, 300);\n  return `<div style='container-type:inline-size;width:100%;height:100%'><div style='${themeVars()};box-sizing:border-box;width:100%;height:100%;min-height:100%;padding:${s(22)} ${s(24)};border-radius:min(18px,6cqw);background:var(--paper);border:1px solid var(--soft);color:var(--ink);overflow:hidden;display:flex;flex-direction:column'>`\n    + (clean(masthead.eyebrow) ? `<div style='margin-bottom:${s(10)};font-weight:800;font-size:${s(11)};line-height:1.3;font-family:var(--sans);letter-spacing:.18em;text-transform:uppercase;color:${ACCENT}'>${escapeHtml(masthead.eyebrow)}</div>` : '')\n    + `<div style='font-weight:500;font-size:${s(32)};line-height:1;font-family:${SERIF};letter-spacing:-.02em'>${escapeHtml(masthead.title || 'Untitled page')}</div>`\n    + (routes.length ? `<div style='margin-top:${s(10)};font-weight:600;font-size:${s(13)};line-height:1.4;font-family:var(--sans);color:${ACCENT}'>${routes.map(escapeHtml).join(' · ')}</div>` : '')\n    + `<div style='margin-top:auto;padding-top:${s(8)};font-weight:400;font-size:${s(12)};line-height:1.3;font-family:var(--sans);color:var(--muted)'>${pieces.length} piece${pieces.length === 1 ? '' : 's'}</div></div></div>`;\n};\n// --- Other kinds of document ------------------------------------------------------------------------\n// The same pieces, built another way. Each takes the pieces in graph order and returns one view's markup; the Page Style's\n// layout picks which. The masthead, the sections (a title, an optional kicker, a body), the routes and the settings keep their\n// meaning in all of them: only what each becomes on the page changes.\nconst shell = (inner, pad) => `<div style='${themeVars()};width:100%;height:100%;overflow:auto;box-sizing:border-box;container-type:inline-size;background:var(--paper);color:var(--ink);font-family:var(--body-font);padding:${pad || 'clamp(20px,4cqw,48px)'}'>${inner}</div>`;\nconst partsOf = (pieces) => ({\n  masthead: pieces.find((piece) => piece.role === 'page-masthead')?.data || {},\n  sections: pieces.filter((piece) => piece.role === 'page-section').map((piece) => piece.data),\n  routes: pieces.filter((piece) => piece.role === 'page-route').map((piece) => piece.data),\n  settings: pieces.filter((piece) => piece.role === 'page-settings').map((piece) => piece.data)\n});\nconst routeAddress = (data) => (/^(tlz|https|github):\\/\\//.test(clean(data.destinationRef)) ? clean(data.destinationRef) : '');\nconst eyebrow = (text) => (clean(text) ? `<div style='font:800 clamp(10px,1.5cqw,13px)/1.3 var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--accent)'>${escapeHtml(text)}</div>` : '');\nconst settingsBox = (data) => RENDER['page-settings'](data);\nconst routeLinks = (routes, heading) => (routes.length\n  ? `<nav data-role='routes' style='display:flex;flex-wrap:wrap;gap:12px 28px;padding-top:14px;border-top:1px solid var(--line)'>${heading ? `<span style='font:800 11px/20px var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--muted)'>${escapeHtml(heading)}</span>` : ''}`\n    + routes.map((data) => {\n      const ref = routeAddress(data);\n      const words = `${escapeHtml(data.title)} →`;\n      return ref ? `<a data-role='route-link' href='${escapeHtml(ref)}' style='font:700 14px/20px var(--sans);color:var(--accent);text-decoration:none'>${words}</a>` : `<span style='font:700 14px/20px var(--sans);color:var(--accent)'>${words}</span>`;\n    }).join('') + `</nav>` : '');\n\n// Handbook: the headline and a contents list down the left, the sections one after another beside them.\nconst stackHandbook = (pieces) => {\n  const { masthead, sections, routes, settings } = partsOf(pieces);\n  const rail = `<aside data-role='contents' style='flex:1 1 210px;min-width:0;align-self:flex-start'>`\n    + eyebrow(masthead.eyebrow)\n    + `<h1 style='margin:10px 0 0;font:700 clamp(26px,4.4cqw,40px)/1.05 var(--serif);letter-spacing:-.015em;color:var(--ink)'>${escapeHtml(masthead.title)}</h1>`\n    + (clean(masthead.subtitle) ? `<p style='margin:10px 0 0;font:400 14px/1.5 var(--sans);color:var(--muted)'>${escapeHtml(masthead.subtitle)}</p>` : '')\n    + `<ol style='margin:22px 0 0;padding:0;list-style:none;border-top:1px solid var(--line)'>`\n    + sections.map((data, index) => `<li style='display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--line);font:600 14px/1.3 var(--sans);color:var(--ink)'><span style='color:var(--accent);min-width:1.6em'>${String(index + 1).padStart(2, '0')}</span>${escapeHtml(data.title)}</li>`).join('')\n    + `</ol>${settings.map((data) => `<div style='margin-top:26px'>${settingsBox(data)}</div>`).join('')}</aside>`;\n  const body = `<main style='flex:3 1 380px;min-width:0'>`\n    + sections.map((data, index) => `<section data-role='section' style='padding:${index ? '34px' : '0'} 0 0;${index ? 'margin-top:34px;border-top:1px solid var(--line)' : ''}'>`\n      + `<div style='font:800 12px/16px var(--sans);letter-spacing:.18em;color:var(--accent)'>${String(index + 1).padStart(2, '0')}${clean(data.kicker) ? ` · ${escapeHtml(data.kicker).toUpperCase()}` : ''}</div>`\n      + `<h2 style='margin:8px 0 14px;font:700 clamp(22px,3.2cqw,30px)/1.15 var(--serif);letter-spacing:-.01em;color:var(--ink)'>${escapeHtml(data.title)}</h2>${bodyText(data.body, false)}</section>`).join('')\n    + (routes.length ? `<div style='margin-top:40px'>${routeLinks(routes, 'Next')}</div>` : '') + `</main>`;\n  return shell(`<div style='display:flex;flex-wrap:wrap;gap:36px clamp(28px,5cqw,64px);max-width:1100px;margin:0 auto'>${rail}${body}</div>`);\n};\n\n// Slides: the headline is the first card; each section is a card of its own, one idea each; the routes close it.\nconst stackSlides = (pieces) => {\n  const { masthead, sections, routes, settings } = partsOf(pieces);\n  const card = (inner, filled) => `<section data-role='slide' style='box-sizing:border-box;width:100%;aspect-ratio:16/9;min-height:clamp(220px,40cqw,520px);padding:clamp(18px,4cqw,52px);border-radius:clamp(12px,1.8cqw,22px);overflow:visible;display:flex;flex-direction:column;justify-content:center;`\n    + (filled ? 'background:var(--accent);color:var(--paper)' : 'background:var(--tint);border:1px solid var(--tint-line)') + `'>${inner}</section>`;\n  const cards = [card(`<div style='font:800 clamp(10px,1.6cqw,14px)/1.3 var(--sans);letter-spacing:.2em;text-transform:uppercase;opacity:.85'>${escapeHtml(masthead.eyebrow)}</div>`\n    + `<h1 style='margin:12px 0 0;font:800 clamp(34px,7.5cqw,92px)/.98 var(--serif);letter-spacing:-.025em;text-wrap:balance'>${escapeHtml(masthead.title)}</h1>`\n    + (clean(masthead.subtitle) ? `<p style='margin:16px 0 0;max-width:34ch;font:400 clamp(16px,2.6cqw,32px)/1.3 var(--body-font);opacity:.9'>${escapeHtml(masthead.subtitle)}</p>` : ''), true)];\n  sections.forEach((data, index) => cards.push(card(\n    `<div style='font:800 clamp(10px,1.5cqw,13px)/1.3 var(--sans);letter-spacing:.18em;color:var(--accent)'>${index + 1} / ${sections.length}${clean(data.kicker) ? ` · ${escapeHtml(data.kicker).toUpperCase()}` : ''}</div>`\n    + `<h2 style='margin:8px 0 12px;font:700 clamp(24px,4.6cqw,56px)/1.05 var(--serif);letter-spacing:-.02em;color:var(--ink)'>${escapeHtml(data.title)}</h2>${bodyText(data.body, false)}`)));\n  if (settings.length) cards.push(card(settings.map(settingsBox).join('')));\n  if (routes.length) cards.push(card(`<div style='font:800 clamp(10px,1.5cqw,13px)/1.3 var(--sans);letter-spacing:.18em;color:var(--accent)'>NEXT</div>${routes.map((data) => `<div style='margin-top:14px;font:700 clamp(18px,3cqw,34px)/1.2 var(--serif)'>${routeAddress(data) ? `<a href='${escapeHtml(routeAddress(data))}' style='color:var(--ink);text-decoration:none'>${escapeHtml(data.title)} →</a>` : `${escapeHtml(data.title)} →`}</div>`).join('')}`));\n  return shell(`<div style='display:flex;flex-direction:column;gap:clamp(14px,2.4cqw,28px);max-width:1100px;margin:0 auto'>${cards.join('')}</div>`);\n};\n\n// Timeline: the entries run down a rail, newest or oldest as the graph orders them. A section's kicker is its date or label.\nconst stackTimeline = (pieces) => {\n  const { masthead, sections, routes, settings } = partsOf(pieces);\n  const entries = sections.map((data) => `<section data-role='entry' style='position:relative;padding:0 0 clamp(22px,3.4cqw,40px) clamp(22px,3.6cqw,44px)'>`\n    + `<span style='position:absolute;left:-7px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--paper)'></span>`\n    + `<div style='font:800 12px/16px var(--mono);letter-spacing:.08em;color:var(--accent)'>${escapeHtml(clean(data.kicker) || '')}</div>`\n    + `<h2 style='margin:4px 0 8px;font:700 clamp(20px,2.8cqw,28px)/1.2 var(--serif);color:var(--ink)'>${escapeHtml(data.title)}</h2>${bodyText(data.body, false)}</section>`).join('');\n  return shell(`<div style='max-width:820px;margin:0 auto'>`\n    + `<header>${eyebrow(masthead.eyebrow)}<h1 style='margin:10px 0 0;font:700 clamp(32px,6cqw,60px)/1 var(--serif);letter-spacing:-.02em'>${escapeHtml(masthead.title)}</h1>`\n    + (clean(masthead.subtitle) ? `<p style='margin:12px 0 0;max-width:46ch;font:italic 400 clamp(17px,2.4cqw,22px)/1.4 var(--body-font);color:var(--muted)'>${escapeHtml(masthead.subtitle)}</p>` : '') + `</header>`\n    + (settings.length ? `<div style='margin-top:28px;max-width:420px'>${settings.map(settingsBox).join('')}</div>` : '')\n    + `<div style='margin:clamp(28px,4cqw,48px) 0 0 7px;border-left:2px solid var(--line)'>${entries}</div>${routeLinks(routes, 'Continue')}</div>`);\n};\n\n// Catalog: a front door. The routes are the page: a grid of cards, each the whole of a link; the sections introduce them.\nconst stackCatalog = (pieces) => {\n  const { masthead, sections, routes, settings } = partsOf(pieces);\n  const cards = routes.map((data) => {\n    const ref = routeAddress(data);\n    const tag = ref ? 'a' : 'div';\n    return `<${tag} data-role='route'${ref ? ` href='${escapeHtml(ref)}'` : ''} style='box-sizing:border-box;display:flex;flex-direction:column;gap:8px;min-height:clamp(120px,16cqw,190px);padding:clamp(14px,2cqw,22px);background:var(--tint);border:1px solid var(--tint-line);border-top:4px solid var(--accent);border-radius:10px;text-decoration:none;color:var(--ink)'>`\n      + `<span style='font:800 11px/14px var(--sans);letter-spacing:.14em;color:var(--accent)'>${escapeHtml(clean(data.destinationLabel) || 'Open').toUpperCase()}</span>`\n      + `<h2 style='margin:0;font:700 clamp(18px,2.4cqw,24px)/1.15 var(--serif);color:var(--ink)'>${escapeHtml(data.title)}</h2>`\n      + (clean(data.body) ? `<span style='margin-top:auto;font:400 14px/1.45 var(--sans);color:var(--muted)'>${escapeHtml(data.body)}</span>` : '') + `</${tag}>`;\n  }).join('');\n  return shell(`<div style='max-width:1100px;margin:0 auto'><header>${eyebrow(masthead.eyebrow)}<h1 style='margin:10px 0 0;font:700 clamp(32px,6.5cqw,64px)/1 var(--serif);letter-spacing:-.02em'>${escapeHtml(masthead.title)}</h1>`\n    + (clean(masthead.subtitle) ? `<p style='margin:12px 0 0;max-width:50ch;font:400 clamp(16px,2.2cqw,21px)/1.4 var(--body-font);color:var(--muted)'>${escapeHtml(masthead.subtitle)}</p>` : '') + `</header>`\n    + `<div data-role='grid' style='display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr));gap:clamp(12px,1.8cqw,22px);margin-top:clamp(24px,4cqw,44px)'>${cards}</div>`\n    + (sections.length || settings.length ? `<div style='display:flex;flex-wrap:wrap;gap:30px 48px;margin-top:clamp(28px,4.4cqw,56px);padding-top:22px;border-top:1px solid var(--line)'>`\n      + sections.map((data) => `<div style='flex:2 1 320px;min-width:0'>${RENDER['page-section'](data, { dropCap: false })}</div>`).join('')\n      + settings.map((data) => `<div style='flex:1 1 220px;min-width:0'>${settingsBox(data)}</div>`).join('') + `</div>` : '') + `</div>`);\n};\nconst LAYOUTS = { article: stackPage, poster: stackPoster, handbook: stackHandbook, slides: stackSlides, timeline: stackTimeline, catalog: stackCatalog };\n\n// --- Run --------------------------------------------------------------------------------------\nconst pieces = nodes.filter((node) => ROLES.includes(roleOf(node)))\n  .map((node) => ({ role: roleOf(node), data: node.data || {} }));\n\nconst declaration = nodes.find((node) => node?.type === 'root');\n// The exposed views are reached by walking the Declaration's own Surface chain: surfaces to the first face, then next-face links.\nconst chainNext = (fromId) => edges.find((edge) => edge.source === fromId\n  && clean(edge.type) === 'next-face')?.target;\nconst surfaceEdge = edges.find((edge) => edge.source === declaration?.id\n  && clean(edge.type) === 'surface');\nconst detailId = surfaceEdge?.target || '';\nconst summaryId = detailId ? chainNext(detailId) || '' : '';\nconst byId = new Map(nodes.map((node) => [node.id, node]));\nconst detailFace = byId.get(detailId);\nconst summaryFace = byId.get(summaryId);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nconst page = LAYOUTS[look.layout] || stackPage;\n\n// The Detail defines the graph's shape: the regular 3:2 card, drawn as one page that scrolls. The Summary and the window take it.\nconst RATIO = 2 / 3;\nconst DETAIL_WIDTH = 760;\nconst SUMMARY_WIDTH = 300;\nconst sizeOf = (width) => ({ width, height: Math.round(width * RATIO) });\n// A graph made from the template declares what its own Method may write. What it does not declare is left as it is.\nconst attempt = async (write) => { try { await write(); } catch (error) { /* not declared by this graph */ } };\n\nconst updated = [];\nif (detailFace) {\n  await api.updateView(detailFace.id, { content: { kind: 'html', value: page(pieces) }, view: { ...(detailFace.data?.view || {}), scroll: 'page' } });\n  await attempt(() => api.updateNode(detailFace.id, sizeOf(DETAIL_WIDTH)));\n  updated.push(detailFace.id);\n}\nif (summaryFace) {\n  await api.updateView(summaryFace.id, { content: { kind: 'html', value: stackSummary(pieces) } });\n  await attempt(() => api.updateNode(summaryFace.id, sizeOf(SUMMARY_WIDTH)));\n  updated.push(summaryFace.id);\n}\n// The Glyph is the page's mark: the first letter of its title, in its accent.\nconst title = clean(pieces.find((piece) => piece.role === 'page-masthead')?.data.title) || 'Page';\nconst mark = /^#[0-9a-f]{3,8}$/i.test(look.accent) ? look.accent : '#6d28d9';\nif (glyph) await attempt(() => api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'symbol', value: title.charAt(0).toUpperCase(), color: mark } } }));\n\n// The window is the Detail's shape and holds everything the graph has.\nif (declaration) {\n  const placed = nodes.filter((node) => node.position).map((node) => (node === detailFace ? { ...node, ...sizeOf(DETAIL_WIDTH) } : node === summaryFace ? { ...node, ...sizeOf(SUMMARY_WIDTH) } : node));\n  const pad = 80;\n  let x0 = Math.min(...placed.map((node) => node.position.x)) - pad;\n  let y0 = Math.min(...placed.map((node) => node.position.y)) - pad;\n  let w = Math.max(...placed.map((node) => node.position.x + node.width)) + pad - x0;\n  let h = Math.max(...placed.map((node) => node.position.y + node.height)) + pad - y0;\n  if (w / h < 1 / RATIO) { const next = Math.round(h / RATIO); x0 -= Math.round((next - w) / 2); w = next; } else { const next = Math.round(w * RATIO); y0 -= Math.round((next - h) / 2); h = next; }\n  await attempt(() => api.updateNode(declaration.id, { data: { ...declaration.data, membrane: { ...(declaration.data?.membrane || {}), bounds: { x: Math.round(x0), y: Math.round(y0), width: Math.round(w), height: Math.round(h) } } } }));\n}\nreturn { updated, pieces: pieces.length, layout: look.layout };\n",
        "effects": [
