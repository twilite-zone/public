        "identity": {
          "graphId": "page-section-class",
          "nodeId": "page-section-detail-view"
        },
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:clamp(18px,6.09cqw,41px);background:#ffffff;border-radius:16px;border:1px solid #e2e8f0;font-family:system-ui;color:#0f172a;overflow:auto'><div style='font-weight:800;font-size:clamp(8px,2.61cqw,17px);font-family:system-ui;letter-spacing:2px;color:#7c3aed;text-transform:uppercase;margin-bottom:10px'>Page Section</div><p style='margin:0 0 12px;max-width:52ch;font-weight:400;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;font-family:system-ui;color:#334155'>A titled block of prose. Its <strong>title</strong> becomes a heading; its <strong>body</strong> renders as the paragraph (or paragraphs, split on a blank line) below it.</p><p style='margin:0;max-width:52ch;font-weight:400;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;font-family:system-ui;color:#334155'>A page is simply its pieces in graph order -- this one renders wherever it sits among the others. Nothing here is decided by this view; edit the piece to change what it says.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
