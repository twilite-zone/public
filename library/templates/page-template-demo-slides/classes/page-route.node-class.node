            "fields": [
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "variant": "heading",
                "placeholder": "Where to next"
              },
              {
                "key": "body",
                "label": "Body",
                "type": "textarea",
                "path": "data.body",
                "variant": "body",
                "rows": 3,
                "placeholder": "One short line about this destination."
              },
              {
                "key": "destinationRef",
                "label": "Destination (the address this route leads to)",
                "type": "text",
                "path": "data.destinationRef",
                "variant": "body",
                "placeholder": "tlz://twilite.zone/..."
              },
              {
                "key": "destinationLabel",
