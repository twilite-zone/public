        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='height:100%;box-sizing:border-box;padding:4.5cqw;background:#fff8e6;color:#1c1917;display:flex;flex-direction:column;overflow:hidden'><div style='border-top:1.2cqw solid #e11d48;border-bottom:1px solid #f5d9a6;padding:1.2cqw 0;font:800 4.6cqw/1.2 system-ui;letter-spacing:.14em;text-transform:uppercase;color:#e11d48'>route</div><div style='display:flex;align-items:center;gap:3cqw;flex:1;min-height:0'><div style='flex:1;min-width:0;font:850 9cqw/1.03 Georgia,serif;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>{{data.title || label}}</div><div style='width:30cqw;flex:none'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120' width='100%' height='100%' role='img' aria-label='route mark'><rect width='120' height='120' fill='#e11d48'/><g color='#fff8e6'><path d='M22 60h76M70 32l28 28-28 28' stroke='currentColor' stroke-width='8' fill='none'/></g></svg></div></div><div style='border-top:1px solid #f5d9a6;padding-top:1cqw;font:750 4cqw/1.2 system-ui;color:#e11d48'>{{data.destinationLabel || \"Open\"}} →</div></div></div>"
        },
        "_placement": {
          "version": 1,
