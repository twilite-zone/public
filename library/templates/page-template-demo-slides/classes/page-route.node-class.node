      },
      "width": 460,
      "height": 280,
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.detail"
        },
        "identity": {
          "graphId": "page-route-class",
          "nodeId": "page-route-detail-view"
        },
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:clamp(18px,6.09cqw,41px);background:#fff8e6;border-radius:0;border:1px solid #f5d9a6;border-top:1.5cqw solid #e11d48;font-family:system-ui;color:#1c1917;overflow:auto'><div style='font-weight:800;font-size:clamp(8px,2.61cqw,17px);font-family:system-ui;letter-spacing:2px;color:#e11d48;text-transform:uppercase;margin-bottom:10px'>Page Route</div><p style='margin:0 0 12px;max-width:52ch;font-weight:400;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;font-family:system-ui;color:#1c1917'>A single destination card: a <strong>title</strong>, an optional one-line <strong>body</strong>, and a label for where it points. Several can sit side by side on the page.</p><p style='margin:0;max-width:52ch;font-weight:400;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;font-family:system-ui;color:#1c1917'><strong>Prominence</strong> decides its weight: primary routes stand out in violet; secondary routes sit quieter in slate.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791496022567,
          "reason": "node-drag"
        }
      }
    },
    {
      "id": "page-route-summary-view",
      "type": "face",
      "label": "Summary",
      "position": {
        "x": 0,
        "y": -80
      },
      "width": 360,
      "height": 219,
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.summary"
        },
        "identity": {
          "graphId": "page-route-class",
          "nodeId": "page-route-summary-view"
        },
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:20px 22px;border-radius:0;background:{{eq(data.prominence, \"secondary\", \"#fff8e6\", \"color-mix(in srgb,#e11d48 11%,#fff8e6)\")}};border:1px solid {{eq(data.prominence, \"secondary\", \"#f5d9a6\", \"#f5d9a6\")}};overflow:auto'><h2 style='margin:0 0 8px;font-weight:800;font-size:7cqw;line-height:1.2;font-family:system-ui;color:#1c1917'>{{data.title || label || \"Where to next\"}}</h2><p style='margin:0 0 12px;font-weight:400;font-size:clamp(9px,3.89cqw,20px);line-height:1.55;font-family:system-ui;color:#57534e'>{{data.body}}</p><span style='font-weight:700;font-size:clamp(8px,3.61cqw,19px);line-height:1;font-family:system-ui;color:#e11d48'>{{data.destinationLabel || \"Open\"}} →</span></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791496022567,
          "reason": "node-drag"
        }
      }
    },
