                "type": "text",
                "path": "data.destinationLabel",
                "variant": "body",
                "placeholder": "Open"
              },
              {
                "key": "prominence",
                "label": "Prominence (primary or secondary)",
                "type": "text",
                "path": "data.prominence",
                "variant": "body",
                "placeholder": "primary"
              },
              {
                "key": "appearance",
                "label": "Appearance (leave empty for a plain route, or \"portal\" for a card)",
                "type": "text",
                "path": "data.appearance",
                "variant": "body",
                "placeholder": "portal"
              }
            ]
          }
        },
        "_placement": {
          "version": 1,
