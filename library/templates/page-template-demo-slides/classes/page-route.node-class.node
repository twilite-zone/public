        "identity": {
          "graphId": "page-route-class",
          "nodeId": "page-route-detail-view"
        },
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:clamp(18px,6.09cqw,41px);background:#ffffff;border-radius:16px;border:1px solid #e2e8f0;font-family:system-ui;color:#0f172a;overflow:auto'><div style='font-weight:800;font-size:clamp(8px,2.61cqw,17px);font-family:system-ui;letter-spacing:2px;color:#7c3aed;text-transform:uppercase;margin-bottom:10px'>Page Route</div><p style='margin:0 0 12px;max-width:52ch;font-weight:400;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;font-family:system-ui;color:#334155'>A single destination card: a <strong>title</strong>, an optional one-line <strong>body</strong>, and a label for where it points. Several can sit side by side on the page.</p><p style='margin:0;max-width:52ch;font-weight:400;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;font-family:system-ui;color:#334155'><strong>Prominence</strong> decides its weight: primary routes stand out in violet; secondary routes sit quieter in slate.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791496022567,
          "reason": "node-drag"
        }
