        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "decision"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "scroll": "page"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:#f7f9fc;font-family:Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.3em;text-transform:uppercase;color:#1e40af'>Decision <span style='display:inline-block;padding:.3cqw 1.4cqw;border-radius:9cqw;font:700 1.3cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#1e40af;border:1px solid #1e40af'>Open</span></div><div style='font:700 5.2cqw/1.12 Georgia,Iowan Old Style,Palatino Linotype,serif;margin:1.4cqw 0 .8cqw;color:#1f2937'>Name the decision</div><div style='font:400 2.1cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:2cqw;max-width:62cqw'>What is being decided, and why it needs deciding now.</div><div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:1.2cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:600 1.5cqw/1.5 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'>1 thing to check: What matters too</div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#1e40af;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(30,64,175,.35)'>Worth knowing</div><div style='margin-bottom:1.6cqw'><div style='font:700 1.8cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Something worth knowing</div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>A fact or worry that bears on the choice but is not one of the things that matter in it.</div></div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#1e40af;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(30,64,175,.35)'>What matters</div><div style='margin-bottom:1.8cqw'><div style='font:700 1.8cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>What matters most <span style='letter-spacing:.12em;color:#7e22ce;font-size:1.5cqw' title='high'>●●●<span style='opacity:.25'></span></span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Why this counts, and what good looks like.</div></div><div style='margin-bottom:1.8cqw'><div style='font:700 1.8cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>What matters too <span style='letter-spacing:.12em;color:#7e22ce;font-size:1.5cqw' title='medium'>●●<span style='opacity:.25'>●</span></span><span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Something else that counts, less than the first.</div></div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#1e40af;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(30,64,175,.35)'>The options</div><div style='margin-bottom:2.6cqw;padding:2cqw 2.4cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>One way to go</div><div style='flex:0 0 auto;font:600 1.4cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;white-space:nowrap'><span style='color:#15803d'>1 for</span> · <span style='color:#b91c1c'>0 against</span></div></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>What taking this option means.</div><div style='display:flex;gap:1.2cqw;align-items:baseline;margin-top:.7cqw'><span style='color:#15803d;font:800 1.7cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'>+</span><span style='font:400 1.6cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155'><b style='font-weight:700;color:#1f2937'>What matters most</b> <span style='letter-spacing:.12em;color:#15803d;font-size:1.5cqw' title='high'>●●●<span style='opacity:.25'></span></span> · does well on it</span></div></div><div style='margin-bottom:2.6cqw;padding:2cqw 2.4cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Another way to go</div><div style='flex:0 0 auto;font:600 1.4cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;white-space:nowrap'><span style='color:#15803d'>1 for</span> · <span style='color:#b91c1c'>1 against</span></div></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>What taking this one means. A fact you are not sure of is marked to check.</div><div style='display:flex;gap:1.2cqw;align-items:baseline;margin-top:.7cqw'><span style='color:#15803d;font:800 1.7cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'>+</span><span style='font:400 1.6cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155'><b style='font-weight:700;color:#1f2937'>What matters too</b> <span style='letter-spacing:.12em;color:#15803d;font-size:1.5cqw' title='medium'>●●<span style='opacity:.25'>●</span></span> · does well on it<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span></span></div><div style='display:flex;gap:1.2cqw;align-items:baseline;margin-top:.7cqw'><span style='color:#b91c1c;font:800 1.7cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'>−</span><span style='font:400 1.6cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155'><b style='font-weight:700;color:#1f2937'>What matters most</b> <span style='letter-spacing:.12em;color:#b91c1c;font-size:1.5cqw' title='high'>●●●<span style='opacity:.25'></span></span> · falls short on it</span></div></div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#1e40af;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(30,64,175,.35)'>Where this landed</div><div style='font:italic 1.9cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#64748b'>Still open: no option has been chosen.</div></div></div>"
        },
        "memo": "The Detail: the decision as a short memo, written from the cards. The Method writes it, so edit the cards and not this.",
        "link": "",
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1793398054115,
          "reason": "node-drag"
        }
      }
