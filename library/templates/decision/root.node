    {
      "id": "decision-detail",
      "type": "face",
      "label": "Decision memo",
      "position": {
        "x": -1100,
        "y": 1233
      },
      "width": 450,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
