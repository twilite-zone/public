    {
      "id": "node-class-template-landing",
      "type": "content",
      "label": "Node class page",
      "position": {
        "x": 480,
        "y": 0
      },
      "width": 760,
      "height": 760,
      "ports": [],
      "handles": [],
      "visible": true,
      "showLabel": false,
      "data": {
        "identity": {
          "graphId": "node-class-template-declaration"
        },
        "content": {
          "kind": "html",
          "value": "<div style='min-height:100%;box-sizing:border-box;container-type:inline-size;background:#ffffff;font-family:Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#0f172a'><div style='box-sizing:border-box;max-width:900px;margin:0 auto;padding:32px clamp(20px,5cqw,40px) 64px'><div style='padding:10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a;font:800 12px/16px system-ui;letter-spacing:.18em;color:#0f766e'>NODE CLASS · example-note</div><header style='padding:40px 0 32px'><h1 style='margin:0;font:500 clamp(40px,9.5cqw,72px)/.98 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.025em;text-wrap:balance;color:#0f172a'>Example Note</h1><p style='margin:18px 0 0;max-width:38ch;font:italic 400 clamp(20px,3.6cqw,26px)/1.35 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#475569'>A short note with a title, a body and a status. This is a specimen: change it, or start a new class from this template.</p></header><figure style='margin:0'><h2 style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f766e'>Specimen</h2><div style='display:flex;flex-wrap:wrap;justify-content:center;align-items:flex-start;gap:24px;padding:28px 12px;border-radius:6px;background:#eef2f6'><div style='max-width:100%'><div style='width:420px;max-width:100%;height:260px'><div style='width:100%;height:100%;box-sizing:border-box;padding:24px;border-radius:22px;background:#ffffff;border:1px solid #e2e8f0;font-family:system-ui;color:#0f172a;overflow:hidden'><div style='font:800 24px/1.2 system-ui;margin-bottom:12px'>A title</div><div style='margin-bottom:10px'><div style='font:700 11px/1.4 system-ui;letter-spacing:.06em;text-transform:uppercase;color:#64748b'>Body</div><div style='font:400 15px/1.5 system-ui;color:#334155'>What the note says.</div></div><div style='margin-bottom:10px'><div style='font:700 11px/1.4 system-ui;letter-spacing:.06em;text-transform:uppercase;color:#64748b'>Status</div><div style='font:400 15px/1.5 system-ui;color:#334155'>open</div></div></div></div><div style='margin-top:10px;font:700 11px/16px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#475569'>Detail · 420 by 260</div></div><div><div style='width:214.2857142857143px;height:142.85714285714286px'><div style='width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:#ffffff;border:1px solid #e2e8f0;font-family:system-ui;color:#0f172a;overflow:hidden'><div style='font:800 24px/1.2 system-ui;margin-bottom:12px'>A title</div><div style='margin-bottom:10px'><div style='font:700 11px/1.4 system-ui;letter-spacing:.06em;text-transform:uppercase;color:#64748b'>Body</div><div style='font:400 15px/1.5 system-ui;color:#334155'>What the note says.</div></div><div style='margin-bottom:10px'><div style='font:700 11px/1.4 system-ui;letter-spacing:.06em;text-transform:uppercase;color:#64748b'>Status</div><div style='font:400 15px/1.5 system-ui;color:#334155'>open</div></div></div></div><div style='margin-top:10px;font:700 11px/16px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#475569'>Summary</div><div style='margin-top:24px;width:120px;height:110px'><div style='width:100%;height:100%;box-sizing:border-box;padding:16px;border-radius:18px;background:#ede9fe;border:1px solid #e2e8f0;font-family:system-ui;color:#0f172a;overflow:hidden'><div style='color:#7c3aed;font-size:22px;font-weight:800'>E</div><div style='font:800 15px/1.2 system-ui;margin-top:8px'>A title</div></div></div><div style='margin-top:10px;font:700 11px/16px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#475569'>Icon</div></div></div><figcaption style='margin-top:10px;font:400 13px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>Fig. 1</b> &nbsp;A new Example Note at each of its three sizes, holding its starting values.</figcaption></figure><div style='display:flex;flex-wrap:wrap;flex-direction:row-reverse;align-items:flex-start;gap:32px 40px;padding-top:44px'><aside style='flex:1 1 220px;min-width:0;padding-top:10px;border-top:3px solid #0f172a'><h2 style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>Settings</h2><dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid #cbd5e1'><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Key</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>example-note</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Label</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>Example Note</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Size</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>420 by 260</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Glyph</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>Article</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Required fields</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>title</dd></dl></aside><div style='flex:999 1 380px;min-width:0'><section><h2 style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f766e'>Description and rationale</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#1e293b'><span style='float:left;padding:6px 10px 0 0;font:500 68px/54px Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#0f172a'>S</span>ay what this class is in a sentence or two, in the words of someone deciding whether to use it. The one-line meaning at the top of the page comes from the Meaning property; this is the fuller version.</p><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#1e293b'>Then say why it exists: what it holds that an existing class does not.</p></section></div></div><blockquote style='margin:48px 0 0;padding:32px 0;border-top:1px solid #0f172a;border-bottom:1px solid #0f172a'><p style='margin:0 0 12px;font:italic 500 clamp(30px,6.4cqw,46px)/1.1 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.015em;color:#0f766e;text-wrap:balance'>Every Example Note needs a title.</p><p style='margin:0;font:400 14px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>The fields.</b> Three in all: title, body and status.</p></blockquote><figure style='margin:40px 0 0'><h2 style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f766e'>Fields</h2><div style='overflow-x:auto'><table style='border-collapse:collapse;width:100%;min-width:460px'><thead><tr><th style='text-align:left;padding:10px 16px 10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a;font:800 12px/16px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#0f172a'>Field</th><th style='text-align:left;padding:10px 16px 10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a;font:800 12px/16px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#0f172a'>Type</th><th style='text-align:left;padding:10px 16px 10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a;font:800 12px/16px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#0f172a'>Required</th><th style='text-align:left;padding:10px 16px 10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a;font:800 12px/16px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#0f172a'>Starts as</th></tr></thead><tbody><tr><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155;font:600 14px/20px ui-monospace,Cascadia Code,Consolas,monospace;color:#0f172a'>title</td><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155'>text</td><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155;font-weight:600;color:#0f172a'>yes</td><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155'>A title</td></tr><tr><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155;font:600 14px/20px ui-monospace,Cascadia Code,Consolas,monospace;color:#0f172a'>body</td><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155'>multiline</td><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155'>no</td><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155'>What the note says.</td></tr><tr><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155;font:600 14px/20px ui-monospace,Cascadia Code,Consolas,monospace;color:#0f172a'>status</td><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155'>select (open, done, dropped)</td><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155'>no</td><td style='padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155'>open</td></tr></tbody></table></div><figcaption style='margin-top:10px;font:400 13px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>Fig. 2</b> &nbsp;What every node of the class holds, in the order its field rows sit in the graph.</figcaption></figure><div style='display:flex;flex-wrap:wrap;flex-direction:row-reverse;align-items:flex-start;gap:32px 40px;padding-top:44px'><aside style='flex:1 1 220px;min-width:0;padding-top:10px;border-top:3px solid #0f172a'><h2 style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>Ports</h2><div style='margin:0 0 12px'><div style='font:600 14px/20px ui-monospace,Cascadia Code,Consolas,monospace;color:#0f172a'>root</div><div style='font:400 13px/20px system-ui;color:#475569'>bidirectional · top at 0.5 · any edge</div></div><div style='margin-top:6px;padding-top:14px;border-top:1px solid #cbd5e1'><h2 style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>Events</h2><div style='margin:0 0 12px'><div style='font:600 14px/20px ui-monospace,Cascadia Code,Consolas,monospace;color:#0f172a'>node.changed</div><div style='font:400 13px/20px system-ui;color:#475569'>Example Note changed</div></div></div></aside><div style='flex:999 1 380px;min-width:0'><section><h2 style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f766e'>Evidence</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#1e293b'>Say what shows it is right: where it is used, what depends on it, what was tried before it. Point at real graphs and real files.</p></section></div></div></div></div>"
        }
      },
      "positionLocked": true
    },
