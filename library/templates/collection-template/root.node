        "semanticLevel": "summary",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;font-family:system-ui,-apple-system,Segoe UI,sans-serif;padding:4cqw;border-radius:1cqw;background:#f4edf9;border:.8cqw solid #7543a4;display:flex;flex-direction:column;gap:3cqw;overflow:hidden'><div style='flex:none;font:700 6cqw/1.1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;text-transform:uppercase;color:#7543a4'>Collection</div><div style='flex:none;font:850 15cqw/1.02 system-ui,-apple-system,Segoe UI,sans-serif;letter-spacing:-.01em;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Templates</div><div style='flex:none;font:700 6.5cqw/1.2 system-ui,sans-serif;color:#334155'>3 graphs</div><div style='flex:1 1 0;min-height:0;overflow:hidden;display:flex;flex-wrap:wrap;gap:2cqw;align-content:flex-start'><a href='tlz://twilite.zone/library/templates/page-template/root.node' title='Page Template' aria-label='Page Template' style='box-sizing:border-box;max-width:100%;padding:1.2cqw 3cqw;border-radius:9cqw;background:#a631291a;border:.5cqw solid #a6312966;color:#0f172a;font:700 6cqw/1.25 system-ui,-apple-system,Segoe UI,sans-serif;text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Page Template</a><a href='tlz://twilite.zone/library/templates/task-template/root.node' title='Task Template' aria-label='Task Template' style='box-sizing:border-box;max-width:100%;padding:1.2cqw 3cqw;border-radius:9cqw;background:#b91c1c1a;border:.5cqw solid #b91c1c66;color:#0f172a;font:700 6cqw/1.25 system-ui,-apple-system,Segoe UI,sans-serif;text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Task Template</a><a href='tlz://twilite.zone/library/templates/declaration-template/root.node' title='Declaration Template' aria-label='Declaration Template' style='box-sizing:border-box;max-width:100%;padding:1.2cqw 3cqw;border-radius:9cqw;background:#29