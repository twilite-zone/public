    {
      "id": "idea-derive-method",
      "type": "method",
      "label": "Derive the idea views",
      "position": {
        "x": 1340,
        "y": -1600
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        },
        {
          "id": "invokes",
          "key": "invokes",
          "label": "invokes",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        },
        {
          "id": "invokes",
          "key": "invokes",
          "label": "invokes",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "invokes"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the idea views",
        "parameters": [],
        "source": "// Derives an idea map's views from its cards: nothing is typed into a view.\n// It reads the Idea (the card of that type: the subject), its Points (a part, a reason, an example or an objection), its Questions, and the edges between them: `leads-to` from one card to the next (its label is\n// the connecting word: because, so, but, for example) and `asks` from an idea or point to a question it leaves open. It writes the Detail (the idea explained, walked outward from the centre with the labels as\n// the connecting words, then what is still open), the Summary (a card) and the Glyph, and only those, which its declared effects say. It counts what there is and what is still open and shows the counts; it never\n// scores an idea, and it never decides an idea is right. Anything a card marks `check` (\"I am not sure this is right\") is gathered in a notice at the top and on the card.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst SERIF = 'system-ui,Segoe UI,sans-serif'; const SANS = 'Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'; const MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst CORAL = '#465B9E'; const INK = '#1f2937'; const PAPER = '#EEF3FF'; const MUTED = '#64748b'; const AMBER = '#31406B'; const BLUE = '#0369a1'; const PURPLE = '#7e22ce'; const GREEN = '#15803d'; const RED = '#b91c1c';\n\nconst nodes = await api.getNodes();\n// The window takes the Detail's shape, holds every node, and its stage (measured, like the stage numbers, in hundredths of the window's width) holds the cards seen when browsing.\nconst fitWindow = ({ shape, stage, cards, all, pad }) => {\n  const box = (list) => ({ l: Math.min(...list.map((n) => n.position.x)), t: Math.min(...list.map((n) => n.position.y)), r: Math.max(...list.map((n) => n.position.x + n.width)), b: Math.max(...list.map((n) => n.position.y + n.height)) });\n  const A = box(all);\n  const C = box(cards.length ? cards : all);\n  const across = 100 - stage.left - stage.right;\n  const down = 100 * shape - stage.top - stage.bottom;\n  const clamp = (value, low, high) => Math.min(high, Math.max(low, value));\n  let w = Math.ceil(Math.max((C.r - C.l + 2 * pad) * 100 / across, (C.b - C.t + 2 * pad) * 100 / down, A.r - A.l, (A.b - A.t) / shape));\n  for (let tries = 0; ; tries += 1) {\n    const h = Math.round(w * shape);\n    const xLow = Math.ceil(Math.max(A.r - w, C.r + pad - w * (100 - stage.right) / 100));\n    const xHigh = Math.floor(Math.min(A.l, C.l - pad - w * stage.left / 100));\n    const yLow = Math.ceil(Math.max(A.b - h, C.b + pad - (h - w * stage.bottom / 100)));\n    const yHigh = Math.floor(Math.min(A.t, C.t - pad - w * stage.top / 100));\n    if ((xLow <= xHigh && yLow <= yHigh) || tries > 800) {\n      return { x: clamp(Math.round((C.l + C.r - w) / 2), xLow, xHigh), y: clamp(Math.round((C.t + C.b) / 2 - w * (stage.top + down / 2) / 100), yLow, yHigh), width: w, height: h };\n    }\n    w = Math.ceil(w * 1.01) + 1;\n  }\n};\n// A graph that borrows this Method from its template declares its own writes. The newer surfaces (the Icon and, where the template did not write one before, the\n// environment) are written only where that declaration names them, so an older graph keeps what it has and is not refused.\nconst declaredHere = (target) => Boolean(target) && nodes.some((method) => method.type === 'method' && (method.data?.effects || []).some((effect) => effect.kind === 'update-node' && (!effect.targets || effect.targets.includes(target.id))));\nconst edges = await api.getEdges();\nconst ofType = (type) => nodes.filter((node) => clean(node.type) === type);\nconst byId = (id) => nodes.find((node) => node.id === id);\nconst nameOf = (node) => clean(node?.data?.title || node?.label) || 'Untitled';\nconst edgesOf = (type) => edges.filter((e) => clean(e.type) === type);\n\nconst notion = ofType('notion')[0] || null;\nconst points = ofType('point');\nconst queries = ofType('query');\nconst flagged = [notion, ...points, ...queries].filter((node) => node && node.data?.check === true);\nconst openQueries = queries.filter((q) => clean(q.data?.status) !== 'answered');\nconst name = notion ? nameOf(notion) : 'Name the idea';\nconst lead = clean(notion?.data?.body);\nconst plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;\nconst ROLES = { part: ['Part', BLUE], reason: ['Reason', GREEN], example: ['Example', CORAL], objection: ['Objection', RED] };\nconst roleOf = (point) => ROLES[clean(point.data?.role)] || ROLES.part;\nconst askedBy = (node) => edgesOf('asks').filter((e) => e.source === node.id).map((e) => byId(e.target)).filter((q) => q && clean(q.type) === 'query');\n\n// walk outward from the idea along leads-to, each card once, in the order the edges give\nconst outline = []; const seen = new Set(notion ? [notion.id] : []);\nconst walk = (from, depth) => {\n  for (const e of edgesOf('leads-to').filter((edge) => edge.source === from.id)) {\n    const next = byId(e.target);\n    if (!next || seen.has(next.id) || clean(next.type) !== 'point') continue;\n    seen.add(next.id); outline.push({ node: next, label: clean(e.label), depth }); walk(next, depth + 1);\n  }\n};\nif (notion) walk(notion, 0);\nconst apart = points.filter((point) => !seen.has(point.id));\n\nconst flag = (node) => (node?.data?.check === true ? `<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#EEF3FF;border:1px solid #B9C7F5;color:${AMBER};font:700 1.9cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span>` : '');\nconst heading = (text) => `<div style='font:700 2cqw/1.2 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${CORAL};margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(70,91,158,.35)'>${text}</div>`;\nconst para = (text, size = 2.7) => (clean(text) ? `<div style='font:400 ${size}cqw/1.55 ${SERIF};color:#334155;margin-top:.4cqw'>${esc(text)}</div>` : '');\nconst chip = (text, colour) => `<span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.9cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:${colour};border:1px solid ${colour}'>${text}</span>`;\nconst questionLine = (q) => `<div style='margin-top:.9cqw;padding:1cqw 1.6cqw;border-radius:1cqw;background:#F1EEFF;border:1px solid #D6CBF8;font:italic 2.4cqw/1.45 ${SERIF};color:${PURPLE}'>${clean(q.data?.status) === 'answered' ? 'Settled' : 'Still unsure'}: <b style='font-style:normal'>${esc(nameOf(q))}</b>${flag(q)}${clean(q.data?.body) ? ` <span style='color:#334155'>${esc(q.data.body)}</span>` : ''}</div>`;\n\nconst pointBlock = ({ node, label, depth }) => {\n  const [roleName, colour] = roleOf(node);\n  return `<div style='margin:0 0 2cqw ${Math.min(depth, 4) * 3.2}cqw;padding:1.8cqw 2.2cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0;border-left:1cqw solid ${colour}'>`\n    + (label ? `<div style='font:italic 2.2cqw/1.4 ${SERIF};color:${MUTED};margin-bottom:.5cqw'>${esc(label)}</div>` : '')\n    + `<div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 3.1cqw/1.2 ${SERIF};color:${INK}'>${esc(nameOf(node))}${flag(node)}</div><div style='flex:0 0 auto'>${chip(roleName, colour)}</div></div>`\n    + para(node.data?.body) + askedBy(node).map(questionLine).join('') + `</div>`;\n};\nconst notice = flagged.length\n  ? `<div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:1.2cqw;background:#EEF3FF;border:1px solid #B9C7F5;color:${AMBER};font:600 2.2cqw/1.4 ${SANS}'>${plural(flagged.length, 'thing', 'things')} to check: ${flagged.map((node) => esc(nameOf(node))).join(', ')}</div>`\n  : '';\nconst asker = (q) => edgesOf('asks').filter((e) => e.target === q.id).map((e) => byId(e.source)).filter(Boolean)[0] || null;\n\nconst detail = `<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:${PAPER};font-family:${SERIF};color:${INK}'>`\n  + `<div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 5cqw 5cqw;border-top:1.2cqw solid #6C86D9'>`\n  + `<div style='font:700 2cqw/1.2 ${MONO};letter-spacing:.3em;text-transform:uppercase;color:${CORAL}'>Idea map</div>`\n  + `<div style='font:700 7cqw/1.05 ${SERIF};margin:1.4cqw 0 .8cqw;color:${INK}'>${esc(name)}</div>`\n  + (lead ? `<div style='font:400 3cqw/1.4 ${SERIF};color:#334155;margin-top:2cqw;max-width:84cqw'>${esc(lead)}</div>` : '')\n  + `<div style='margin-top:1.6cqw;font:600 2.3cqw/1.4 ${SANS};color:${MUTED}'>${plural(points.length, 'point', 'points')} · ${queries.length ? `${openQueries.length} of ${plural(queries.length, 'question', 'questions')} open` : 'no open questions'}</div>`\n  + notice\n  + (notion && askedBy(notion).length ? askedBy(notion).map(questionLine).join('') : '')\n  + (outline.length ? heading('The idea, explained') + outline.map(pointBlock).join('') : '')\n  + (apart.length ? heading('Also in the map') + apart.map((p) => pointBlock({ node: p, label: '', depth: 0 })).join('') : '')\n  + (openQueries.length ? heading('Still open') + openQueries.map((q) => `<div style='margin-bottom:1.4cqw'><div style='font:700 2.8cqw/1.3 ${SERIF};color:${PURPLE}'>${esc(nameOf(q))}${flag(q)}</div>${asker(q) ? `<div style='font:600 2cqw/1.4 ${SANS};color:${MUTED}'>Raised by ${esc(nameOf(asker(q)))}</div>` : ''}${para(q.data?.body)}</div>`).join('') : '')\n  + `</div></div>`;\n\nconst bulb = (size, colour) => `<svg viewBox='0 0 64 64' style='width:${size};height:${size};display:block' aria-hidden='true'><g fill='none' stroke='${colour}' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'><path d='M24 44C24 38 14 34 14 24A18 18 0 0 1 50 24C50 34 40 38 40 44'/><path d='M24 44H40'/><path d='M26 52H38'/><path d='M29 58H35'/></g></svg>`;\nconst objections = points.filter((p) => clean(p.data?.role) === 'objection').length;\n// The Summary is seen small, so it is the kind with its mark, the name, and two lines of facts: everything 6cqw or more and bold (scripts/library/auditSummaryType.mjs measures this).\n// The kind, the name and the mark never shrink; the facts give way when the tile is short. A name past 12 characters is set smaller, but never under 9cqw, and is cut at two lines.\nconst nameChars = [...String(name)].length;\nconst nameSize = nameChars <= 12 ? 14 : nameChars <= 24 ? 11 : 9;\nconst fact = (text, colour = '#334155') => `<div style='font:700 6.5cqw/1.2 ${SANS};color:${colour}'>${text}</div>`;\nconst pill = (text) => `<div style='align-self:flex-start;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#EEF3FF;border:1px solid #B9C7F5;color:#31406B;font:700 6cqw/1.3 ${SANS};letter-spacing:.04em;text-transform:uppercase'>${text}</div>`;\nconst summary = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;background:#EEF3FF;color:#31406B;border-radius:4cqw;border:.6cqw solid #C3D2FF;border-bottom:1.6cqw solid #31406B;overflow:hidden;font-family:system-ui;display:flex;flex-direction:column;padding:3.5cqw;gap:1.7cqw'><div style='display:flex;align-items:center;gap:3cqw'><div style='width:23cqw;aspect-ratio:1;flex:none'><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"63\" r=\"56\" fill=\"#31406B\"/><circle cx=\"60\" cy=\"59\" r=\"54\" fill=\"#C3D2FF\"/><circle cx=\"60\" cy=\"59\" r=\"47\" fill=\"#6C86D9\"/><circle cx=\"60\" cy=\"59\" r=\"43\" fill=\"none\" stroke=\"#F4F8FF\" stroke-opacity=\".4\" stroke-width=\"1.8\"/><path d=\"M44 80C44 69 30 65 30 47A30 30 0 0 1 90 47C90 65 76 69 76 80Z\" fill=\"#E2F8FF\"/><path d=\"M45 85H75M49 93H71M54 101H66\" stroke=\"#F4F8FF\" stroke-width=\"6\" stroke-linecap=\"round\"/><path d=\"M60 12V5M22 23 15 16M98 23 105 16\" stroke=\"#A6DCEB\" stroke-width=\"5\" stroke-linecap=\"round\"/><path d=\"M48 52 60 65 73 51\" stroke=\"#6C86D9\" stroke-width=\"5\" stroke-linecap=\"round\" fill=\"none\"/></svg></div><div style='min-width:0;flex:1'><div style='font:850 6cqw/1.1 system-ui;letter-spacing:.12em'>IDEA</div><div style='font:850 ${nameSize}cqw/1.04 system-ui;letter-spacing:-.04em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'>${esc(name)}</div></div></div><div style='flex:1;min-height:0;overflow:hidden;display:flex;flex-direction:column;gap:1.3cqw'>${fact(plural(points.length,'point','points')+(objections?' · '+plural(objections,'objection','objections'):'') )}${fact(openQueries.length?plural(openQueries.length,'open question','open questions'):'No open questions',openQueries.length?PURPLE:MUTED)}${flagged.length?pill(flagged.length+' to check'):''}</div></div></div>`;\nconst icon = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;height:100%;background:#EEF3FF;color:#31406B;border-radius:4cqw;border:.6cqw solid #C3D2FF;border-bottom:1.6cqw solid #31406B;font-family:system-ui;display:flex;flex-direction:column;overflow:hidden;padding:3.5cqw'><div style='display:flex;gap:3cqw;align-items:center;flex:1;min-height:0'><div style='width:36cqw;aspect-ratio:1;flex:none'><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"63\" r=\"56\" fill=\"#31406B\"/><circle cx=\"60\" cy=\"59\" r=\"54\" fill=\"#C3D2FF\"/><circle cx=\"60\" cy=\"59\" r=\"47\" fill=\"#6C86D9\"/><circle cx=\"60\" cy=\"59\" r=\"43\" fill=\"none\" stroke=\"#F4F8FF\" stroke-opacity=\".4\" stroke-width=\"1.8\"/><path d=\"M44 80C44 69 30 65 30 47A30 30 0 0 1 90 47C90 65 76 69 76 80Z\" fill=\"#E2F8FF\"/><path d=\"M45 85H75M49 93H71M54 101H66\" stroke=\"#F4F8FF\" stroke-width=\"6\" stroke-linecap=\"round\"/><path d=\"M60 12V5M22 23 15 16M98 23 105 16\" stroke=\"#A6DCEB\" stroke-width=\"5\" stroke-linecap=\"round\"/><path d=\"M48 52 60 65 73 51\" stroke=\"#6C86D9\" stroke-width=\"5\" stroke-linecap=\"round\" fill=\"none\"/></svg></div><div style='min-width:0;flex:1'><div style='font:850 4cqw/1.2 system-ui;letter-spacing:.12em'>IDEA</div><div style='font:850 8.2cqw/1.04 system-ui;letter-spacing:-.04em;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${esc(name)}</div></div></div><div style='display:flex;justify-content:space-between;align-items:center;border-top:1px solid #C3D2FF;padding-top:1.4cqw;font:750 3.7cqw/1.2 system-ui'><span>${plural(points.length,'point','points')} · ${plural(openQueries.length,'open question','open questions')}</span><span style='color:#31406B'>${flagged.length?flagged.length+' to check':''}</span></div></div></div>`;\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary], ['icon', icon]]) {\n  const target = faceFor(level);\n  if (target && (level !== 'icon' || declaredHere(target))) await api.updateView(target.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: {\"kind\":\"svg\",\"value\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"4 4 112 112\\\"><path d=\\\"M35 79C35 66 18 64 18 42A42 42 0 0 1 102 42C102 64 85 66 85 79ZM38 85H82V94H38ZM45 100H75V110H45Z\\\" fill=\\\"white\\\"/></svg>\",\"color\":\"#6C86D9\"} } });\n// The idea studio frames the map without making a judgment about the idea.\nconst root=nodes.find(n=>clean(n.type)==='root'), env=faces.find(n=>clean(n.data?.view?.payload)==='node.web.environment');\nconst visible=nodes.filter(n=>n.position && n.visible!==false && !['root','face','glyph','import','export','method','script'].includes(clean(n.type)));\nif(root&&declaredHere(root)&&declaredHere(env)&&visible.length){\n const l=Math.min(...visible.map(n=>n.position.x)),rr=Math.max(...visible.map(n=>n.position.x+n.width)),t=Math.min(...visible.map(n=>n.position.y)),bb=Math.max(...visible.map(n=>n.position.y+n.height));\n const detailNode = nodes.find((node) => clean(node.type) === 'face' && clean(node.data?.semanticLevel) === 'detail');\n const ratio = detailNode?.width && detailNode?.height ? detailNode.height / detailNode.width : 2 / 3, header = 24, footer = 8, pad = 85;\n const stageH = ratio * 100 - header - footer;\n const { x, y, width: w, height: h } = fitWindow({ shape: ratio, stage: { left: 4, right: 4, top: header, bottom: footer }, cards: visible, all: nodes.filter((node) => node.position), pad });\n const page=`<div style='container-type:inline-size;width:100%;height:100%'><div style='position:relative;box-sizing:border-box;width:100%;height:100%;background:#252D49;color:#F4F8FF;font-family:system-ui;overflow:hidden'><div style='position:absolute;inset:0;background:radial-gradient(ellipse at 88% 8%,#4e527c,transparent 48%),linear-gradient(135deg,#313A61,#191e36)'></div><div style='position:absolute;left:4cqw;right:4cqw;top:2.7cqw;border-top:.45cqw solid #B9C7F5;padding-top:1.1cqw;font:800 1.9cqw/1.2 system-ui;letter-spacing:.16em;color:#D2DCF6'>IDEA / THE THINKING ROOM</div><div style='position:absolute;left:4cqw;right:24cqw;top:6.8cqw;font:850 ${name.length>34?5:name.length>20?6.4:8}cqw/1.05 system-ui;letter-spacing:-.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${esc(name)}</div><div style='position:absolute;left:4cqw;right:25cqw;top:16cqw;font:600 2.4cqw/1.2 system-ui;color:#EEF3FF;overflow:hidden;text-overflow:ellipsis;white-space:nowrap'>${esc(lead||'An idea worth exploring.')}</div><div style='position:absolute;left:4cqw;right:24cqw;top:20cqw;font:800 2cqw/1.2 system-ui;color:#A6DCEB;overflow:hidden;white-space:nowrap;text-overflow:ellipsis'>${plural(points.length,'point','points')} · ${plural(openQueries.length,'open question','open questions')} · ${flagged.length} to check</div><div style='position:absolute;right:4cqw;top:3.5cqw;width:18cqw;height:18cqw'><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"63\" r=\"56\" fill=\"#31406B\"/><circle cx=\"60\" cy=\"59\" r=\"54\" fill=\"#C3D2FF\"/><circle cx=\"60\" cy=\"59\" r=\"47\" fill=\"#6C86D9\"/><circle cx=\"60\" cy=\"59\" r=\"43\" fill=\"none\" stroke=\"#F4F8FF\" stroke-opacity=\".4\" stroke-width=\"1.8\"/><path d=\"M44 80C44 69 30 65 30 47A30 30 0 0 1 90 47C90 65 76 69 76 80Z\" fill=\"#E2F8FF\"/><path d=\"M45 85H75M49 93H71M54 101H66\" stroke=\"#F4F8FF\" stroke-width=\"6\" stroke-linecap=\"round\"/><path d=\"M60 12V5M22 23 15 16M98 23 105 16\" stroke=\"#A6DCEB\" stroke-width=\"5\" stroke-linecap=\"round\"/><path d=\"M48 52 60 65 73 51\" stroke=\"#6C86D9\" stroke-width=\"5\" stroke-linecap=\"round\" fill=\"none\"/></svg></div><div style='position:absolute;left:4cqw;top:24cqw;width:92cqw;height:${stageH}cqw;box-sizing:border-box;border:.3cqw solid #B9C7F5;border-radius:1cqw;background:#252d49;background-image:radial-gradient(#a8b6ea24 .11cqw,transparent .11cqw);background-size:3cqw 3cqw'></div><div style='position:absolute;left:4cqw;right:4cqw;bottom:2.6cqw;border-top:.3cqw solid #B9C7F5;padding-top:1cqw;font:750 1.8cqw/1.2 system-ui;color:#D2DCF6;display:flex;justify-content:space-between;gap:2cqw'><span>EXPLORE / CONNECT / QUESTION</span><span>${plural(objections,'objection','objections')} · ${apart.length} unconnected</span></div></div></div>`;\n await api.updateView(env.id,{content:{kind:'html',value:page},view:{...env.data.view,fit:'window',stage:{left:4,right:4,top:header,bottom:footer}}});\n await api.updateNode(root.id,{data:{...root.data,membrane:{...root.data.membrane,bounds:{x,y,width:w,height:h}}}});\n}\nreturn { name, points: points.length, questions: queries.length, openQuestions: openQueries.length, toCheck: flagged.length, reached: outline.length, apart: apart.length };\n",
