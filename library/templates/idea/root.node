        "semanticLevel": "summary",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;background:#EEF3FF;color:#31406B;border-radius:4cqw;border:.6cqw solid #C3D2FF;border-bottom:1.6cqw solid #31406B;overflow:hidden;font-family:system-ui;display:flex;flex-direction:column;padding:3.5cqw;gap:1.7cqw'><div style='display:flex;align-items:center;gap:3cqw'><div style='width:23cqw;aspect-ratio:1;flex:none'><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"63\" r=\"56\" fill=\"#31406B\"/><circle cx=\"60\" cy=\"59\" r=\"54\" fill=\"#C3D2FF\"/><circle cx=\"60\" cy=\"59\" r=\"47\" fill=\"#6C86D9\"/><circle cx=\"60\" cy=\"59\" r=\"43\" fill=\"none\" stroke=\"#F4F8FF\" stroke-opacity=\".4\" stroke-width=\"1.8\"/><path d=\"M44 80C44 69 30 65 30 47A30 30 0 0 1 90 47C90 65 76 69 76 80Z\" fill=\"#E2F8FF\"/><path d=\"M45 85H75M49 93H71M54 101H66\" stroke=\"#F4F8FF\" stroke-width=\"6\" stroke-linecap=\"round\"/><path d=\"M60 12V5M22 23 15 16M98 23 105 16\" stroke=\"#A6DCEB\" stroke-width=\"5\" stroke-linecap=\"round\"/><path d=\"M48 52 60 65 73 51\" stroke=\"#6C86D9\" stroke-width=\"5\" stroke-linecap=\"round\" fill=\"none\"/></svg></div><div style='min-width:0;flex:1'><div style='font:850 6cqw/1.1 system-ui;letter-spacing:.12em'>IDEA</div><div style='font:850 11cqw/1.04 system-ui;letter-spacing:-.04em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'>Name the idea</div></div></div><div style='flex:1;min-height:0;overflow:hidden;display:flex;flex-direction:column;gap:1.3cqw'><div style='font:700 6.5cqw/1.2 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#334155'>4 points · 1 objection</div><div style='font:700 6.5cqw/1.2 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#7e22ce'>1 open question</div><div style='align-self:flex-start;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#EEF3FF;border:1px solid #B9C7F5;color:#31406B;font:700 6cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.04em;text-transform:uppercase'>1 to check</div></div></div></div>"
