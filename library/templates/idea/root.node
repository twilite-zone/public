      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "identity": {
          "graphId": "idea"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "scroll": "page"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:#EEF3FF;font-family:system-ui,Segoe UI,sans-serif;color:#1f2937'><div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 5cqw 5cqw;border-top:1.2cqw solid #6C86D9'><div style='font:700 2cqw/1.2 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.3em;text-transform:uppercase;color:#465B9E'>Idea map</div><div style='font:700 7cqw/1.05 system-ui,Segoe UI,sans-serif;margin:1.4cqw 0 .8cqw;color:#1f2937'>Name the idea</div><div style='font:400 3cqw/1.4 system-ui,Segoe UI,sans-serif;color:#334155;margin-top:2cqw;max-width:84cqw'>What it is, and why it is worth understanding.</div><div style='margin-top:1.6cqw;font:600 2.3cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>4 points · 1 of 1 question open</div><div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:1.2cqw;background:#EEF3FF;border:1px solid #B9C7F5;color:#31406B;font:600 2.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'>1 thing to check: A reason to doubt it</div><div style='margin-top:.9cqw;padding:1cqw 1.6cqw;border-radius:1cqw;background:#F1EEFF;border:1px solid #D6CBF8;font:italic 2.4cqw/1.45 system-ui,Segoe UI,sans-serif;color:#7e22ce'>Still unsure: <b style='font-style:normal'>Something not yet known</b> <span style='color:#334155'>What is not known, and what an answer would change.</span></div><div style='font:700 2cqw/1.2 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#465B9E;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(70,91,158,.35)'>The idea, explained</div><div style='margin:0 0 2cqw 0cqw;padding:1.8cqw 2.2cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0;border-left:1cqw solid #0369a1'><div style='font:italic 2.2cqw/1.4 system-ui,Segoe UI,sans-serif;color:#64748b;margin-bottom:.5cqw'>is made of</div><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 3.1cqw/1.2 system-ui,Segoe UI,sans-serif;color:#1f2937'>A part of it</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.9cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#0369a1;border:1px solid #0369a1'>Part</span></div></div><div style='font:400 2.7cqw/1.55 system-ui,Segoe UI,sans-serif;color:#334155;margin-top:.4cqw'>One piece of the idea.</div></div><div style='margin:0 0 2cqw 3.2cqw;padding:1.8cqw 2.2cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0;border-left:1cqw solid #465B9E'><div style='font:italic 2.2cqw/1.4 system-ui,Segoe UI,sans-serif;color:#64748b;margin-bottom:.5cqw'>for example</div><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 3.1cqw/1.2 system-ui,Segoe UI,sans-serif;color:#1f2937'>An example</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.9cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#465B9E;border:1px solid #465B9E'>Example</span></div></div><div style='font:400 2.7cqw/1.55 system-ui,Segoe UI,sans-serif;color:#334155;margin-top:.4cqw'>A case that shows the part at work.</div></div><div style='margin:0 0 2cqw 0cqw;padding:1.8cqw 2.2cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0;border-left:1cqw solid #15803d'><div style='font:italic 2.2cqw/1.4 system-ui,Segoe UI,sans-serif;color:#64748b;margin-bottom:.5cqw'>because</div><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 3.1cqw/1.2 system-ui,Segoe UI,sans-serif;color:#1f2937'>Why it holds</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.9cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#15803d;border:1px solid #15803d'>Reason</span></div></div><div style='font:400 2.7cqw/1.55 system-ui,Segoe UI,sans-serif;color:#334155;margin-top:.4cqw'>A reason to believe it.</div></div><div style='margin:0 0 2cqw 0cqw;padding:1.8cqw 2.2cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0;border-left:1cqw solid #b91c1c'><div style='font:italic 2.2cqw/1.4 system-ui,Segoe UI,sans-serif;color:#64748b;margin-bottom:.5cqw'>but</div><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 3.1cqw/1.2 system-ui,Segoe UI,sans-serif;color:#1f2937'>A reason to doubt it<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#EEF3FF;border:1px solid #B9C7F5;color:#31406B;font:700 1.9cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span></div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.9cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#b91c1c;border:1px solid #b91c1c'>Objection</span></div></div><div style='font:400 2.7cqw/1.55 system-ui,Segoe UI,sans-serif;color:#334155;margin-top:.4cqw'>The strongest case against. A point you are not sure of is marked to check.</div></div><div style='font:700 2cqw/1.2 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#465B9E;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(70,91,158,.35)'>Still open</div><div style='margin-bottom:1.4cqw'><div style='font:700 2.8cqw/1.3 system-ui,Segoe UI,sans-serif;color:#7e22ce'>Something not yet known</div><div style='font:600 2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>Raised by Name the idea</div><div style='font:400 2.7cqw/1.55 system-ui,Segoe UI,sans-serif;color:#334155;margin-top:.4cqw'>What is not known, and what an answer would change.</div></div></div></div>"
        },
        "memo": "The Detail: the idea explained, walked outward from the centre, written from the cards. The Method writes it, so edit the cards and not this.",
        "link": "",
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1793398054115,
          "reason": "node-drag"
        }
      }
