        },
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:clamp(18px,6.09cqw,41px);background:#f6efe2;border-radius:0;border:1px solid #d9c9a8;border-top:1.5cqw solid #b4532a;font-family:system-ui;color:#3b2a1a;overflow:auto'><div style='font-weight:800;font-size:clamp(8px,2.61cqw,17px);font-family:system-ui;letter-spacing:2px;color:#b4532a;text-transform:uppercase;margin-bottom:10px'>Page Settings</div><p style='margin:0 0 12px;max-width:52ch;font-weight:400;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;font-family:system-ui;color:#3b2a1a'>A small table of facts about the page itself, rendered as a labeled list. Each <strong>row</strong> is a label and a value.</p><p style='margin:0;max-width:52ch;font-weight:400;font-size:clamp(10px,3.26cqw,22px);line-height:1.7;font-family:system-ui;color:#3b2a1a'>A page has at most one settings piece, and it renders last.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791496022567,
