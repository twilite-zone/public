          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:clamp(13px,5.56cqw,29px);background:#f6efe2;border-radius:0;border:1px solid #d9c9a8;border-top:1.5cqw solid #b4532a;overflow:auto'><h2 style='margin:0 0 10px;font-weight:800;font-size:7cqw;line-height:1.2;font-family:system-ui;color:#3b2a1a'>{{data.title || label || \"Settings\"}}</h2><div style='font-weight:600;font-size:clamp(8px,3.61cqw,19px);line-height:1.6;font-family:system-ui;color:#6b5640'>{{data.rows.length}} {{eq(data.rows.length, \"1\", \"setting\", \"settings\")}}</div></div>"
