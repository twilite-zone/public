    {
      "id": "canon-standard-section-14",
      "type": "page-section",
      "label": "13. An environment",
      "position": {
        "x": 90,
        "y": 700
      },
      "width": 620,
      "height": 380,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "13. An environment",
        "body": "A canon template has an environment: a face of its own on an `environment` edge from the root, the backdrop its interior sits on. It is never the Detail, the Summary or the Glyph.\n\n*Why:* A graph's interior is the room its work happens in. A template that sets none leaves every graph made from it on whatever backdrop the app falls back to, so it cannot say what kind of room this is.\n\n*Checked by:* Test (mechanical).",
        "identity": {
          "graphId": "canon-standard"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
