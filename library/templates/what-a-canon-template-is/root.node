    {
      "id": "canon-standard-section-9",
      "type": "page-section",
      "label": "8. One export",
      "position": {
        "x": 810,
        "y": 220
      },
      "width": 620,
      "height": 380,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "8. One export",
        "body": "The template hands on its classes and its Method through a single export with an allowlist. A graph made from it imports once.\n\n*Why:* One Bridge is a thing to read; ten are a thing to maintain.\n\n*Checked by:* Test (mechanical).",
        "identity": {
          "graphId": "canon-standard"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
