    {
      "id": "canon-standard-section-2",
      "type": "page-section",
      "label": "1. One surface, three looks",
      "position": {
        "x": 90,
        "y": -260
      },
      "width": 620,
      "height": 380,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "1. One surface, three looks",
        "body": "A canon template presents through one Surface: a Detail, then a Summary, then a Glyph. An Icon view is optional. Add one when the template benefits from it (the Person Profile's face is an example), and leave it off when it doesn't.\n\n*Why:* The glyph is the floor: it stands for the graph at small sizes and hands over to the lowest view once that view can be read.\n\n*Checked by:* Test (mechanical).",
        "identity": {
          "graphId": "canon-standard"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
