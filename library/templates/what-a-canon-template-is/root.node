        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background-color:#203b68;background-image:linear-gradient(color-mix(in srgb,#2a5aa0 26%,transparent) 0.12cqw,transparent 0.12cqw),linear-gradient(90deg,color-mix(in srgb,#2a5aa0 26%,transparent) 0.12cqw,transparent 0.12cqw),linear-gradient(color-mix(in srgb,#2a5aa0 12%,transparent) 0.08cqw,transparent 0.08cqw),linear-gradient(90deg,color-mix(in srgb,#2a5aa0 12%,transparent) 0.08cqw,transparent 0.08cqw);background-size:10cqw 10cqw,10cqw 10cqw,2cqw 2cqw,2cqw 2cqw;font-family:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#ffffff'><div style='position:absolute;left:4cqw;top:3.4cqw;font:800 1.5cqw/1.2 Inter,system-ui,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#b5d4ff'><a href='tlz://twilite.zone/library/templates/root.node' style='color:inherit;text-decoration:none'>← Templates</a></div><div style='position:absolute;left:4cqw;right:4cqw;top:6.2cqw;font:800 4.7cqw/1.05 system-ui,sans-serif;letter-spacing:-.035em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>What a canon template is</div><div style='position:absolute;left:4cqw;right:4cqw;top:13.080000000000002cqw;font:400 2.5cqw/1.3 Inter,system-ui,sans-serif;color:#cfe0ff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Fourteen rules, each with its reason and how it is checked.</div><div style='position:absolute;left:4cqw;top:23.200000000000003cqw;font:400 1.7cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:#b5d4ff'>Twelve are checked by tests, two by judgement.</div><div style='position:absolute;left:4cqw;top:27.6cqw;width:92cqw;height:30.166666666666657cqw;box-sizing:border-box;border-radius:2cqw;background:color-mix(in srgb,#b5d4ff 7%,#203b68);border:.3cqw solid color-mix(in srgb,#b5d4ff 28%,#203b68)'></div><div style='position:absolute;right:4cqw;top:3cqw;display:flex;gap:2.2cqw;font:700 1.9cqw/1.2 Inter,system-ui,sans-serif;white-space:nowrap'><a href='tlz://twilite.zone/library/templates/page-template/root.node' style='color:#b5d4ff;text-decoration:none'>Page Template →</a><a href='tlz://twilite.zone/library/templates/task-template/root.node' style='color:#b5d4ff;text-decoration:none'>Task Template →</a><a href='tlz://twilite.zone/library/templates/collection-template/root.node' style='color:#b5d4ff;text-decoration:none'>Collection Template →</a></div></div></div>"
        }
