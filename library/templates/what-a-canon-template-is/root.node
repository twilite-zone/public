    {
      "id": "canon-standard-section-5",
      "type": "page-section",
      "label": "4. Each look is the graph at that size",
      "position": {
        "x": 2250,
        "y": -260
      },
      "width": 620,
      "height": 380,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "4. Each look is the graph at that size",
        "body": "The Glyph says what kind of thing the graph is, and carries its state if it has one. The Summary is the graph in miniature. The Detail is the graph. If graphs of this template have a state someone has to act on (for example the status of a task, or an open question), it is shown on every look, so no one has to open the graph to find out whether they need to.\n\n*Why:* A look should answer the question its size can answer. The state rule applies only to templates that have a state.\n\n*Checked by:* Judgement; each look and each state is a case in the tests of the template itself.",
        "identity": {
          "graphId": "canon-standard"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
