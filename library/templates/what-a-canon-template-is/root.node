        "scriptName": "Assemble the page",
        "parameters": [],
        "source": "// Assembles the page from its pieces and writes it into the views the Declaration exposes: the Detail (one page, in the regular 3:2 shape),\n// the Summary (the same shape, smaller) and the Glyph. It also writes their sizes and the window, which is the Detail's shape and holds\n// everything the graph has. The graph's change event runs it through an invokes edge, so the stored page is always current. It reads the\n// pieces in graph order and writes only what its declared effects say.\nconst ROLES = ['page-masthead', 'page-route', 'page-section', 'page-settings'];\n\nconst clean = (value) => String(value ?? '').trim();\nconst escapeHtml = (value) => clean(value)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\n// Rows are { label, value } pairs, or \"label: value\" lines.\nconst settingRows = (rows) => (Array.isArray(rows) ? rows : []).map((row) => {\n  if (row && typeof row === 'object') return [clean(row.label), clean(row.value)];\n  const text = clean(row);\n  const cut = text.indexOf(':');\n  return cut < 0 ? [text, ''] : [clean(text.slice(0, cut)), clean(text.slice(cut + 1))];\n}).filter(([name, value]) => name || value);\nconst roleOf = (node) => clean(node?.type);\n\n// --- How the page looks ------------------------------------------------------------------------\n// The page reads as an article. Inline styles only, attributes in single quotes, font names unquoted, and\n// every fluid size taken from the view's own width (cqw), because a View may be drawn at any size.\nconst SERIF = 'system-ui,Segoe UI,Arial,sans-serif';\nconst ACCENT = '#294b83';\nconst KICKER = 'font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase';\n// Escapes without trimming, for the rest of a paragraph after its first letter has been lifted out.\nconst escapeText = (value) => String(value ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst kicker = (text, color = ACCENT) => `<h2 style='margin:0 0 14px;${KICKER};color:${color}'>${escapeHtml(text)}</h2>`;\n// Body text. Paragraphs, bullet lists (one level of nesting), fenced code blocks and sub-headings, with `code` and\n// **bold** and [links](address) inside a line. Everything authored is escaped first; only these few marks become markup. The first\n// paragraph of the page's first section opens with a drop cap, when the section starts with a letter.\nconst MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst inlineText = (value) => escapeText(value)\n  .replace(/`([^`]+)`/g, (_, code) => `<code style='padding:1px 4px;border-radius:3px;background:#dce9f7;font:400 .84em ${MONO};overflow-wrap:anywhere'>${code}</code>`)\n  .replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>')\n  // A link written as [words](address) becomes a link, when the address is one Twilite or the web can open.\n  .replace(/\\[([^\\]]+)\\]\\(((?:tlz|https|github):\\/\\/[^\\s)]+)\\)/g, (_, words, address) => `<a href='${address}' style='color:${ACCENT};text-decoration:underline'>${words}</a>`);\nconst bodyBlocks = (value) => {\n  const lines = String(value ?? '').replace(/\\r\\n/g, '\\n').split('\\n');\n  const blocks = [];\n  let paragraph = [];\n  let afterBlank = true;\n  const flush = () => { if (paragraph.length) blocks.push({ kind: 'p', text: paragraph.join('\\n') }); paragraph = []; };\n  for (let index = 0; index < lines.length; index += 1) {\n    const line = lines[index];\n    if (/^```/.test(line.trim())) {\n      flush();\n      const code = [];\n      index += 1;\n      while (index < lines.length && !/^```/.test(lines[index].trim())) { code.push(lines[index]); index += 1; }\n      blocks.push({ kind: 'code', text: code.join('\\n') });\n      afterBlank = true;\n      continue;\n    }\n    if (!line.trim()) { flush(); afterBlank = true; continue; }\n    const heading = /^#{2,4} +(.+)$/.exec(line.trim());\n    if (heading) { flush(); blocks.push({ kind: 'h', text: heading[1] }); afterBlank = true; continue; }\n    const item = /^(\\s*)([-*]|\\d+[.)]) +(.*)$/.exec(line);\n    const last = blocks[blocks.length - 1];\n    if (item) {\n      flush();\n      // The list this item joins is the block just before it once a paragraph above it has been written out: a list that follows a line of text starts its own.\n      const tail = blocks[blocks.length - 1];\n      // A numbered item (1. 2. 3.) makes an ordered list. An indented item belongs to the list above whatever its marker; one at the left edge joins it only if it is the same kind.\n      const ordered = /\\d/.test(item[2]);\n      const list = tail?.kind === 'list' && !afterBlank && (item[1].length >= 2 || tail.ordered === ordered) ? tail : null;\n      const entry = { text: item[3], children: [] };\n      if (list && item[1].length >= 2 && list.items.length) list.items[list.items.length - 1].children.push(entry);\n      else if (list) list.items.push(entry);\n      else blocks.push({ kind: 'list', ordered, items: [entry] });\n      afterBlank = false;\n      continue;\n    }\n    // A line that follows a list item without a blank line between continues that item.\n    if (last?.kind === 'list' && !afterBlank && !paragraph.length) {\n      const owner = last.items[last.items.length - 1];\n      const target = owner.children.length ? owner.children[owner.children.length - 1] : owner;\n      target.text += ` ${line.trim()}`;\n      continue;\n    }\n    paragraph.push(line.trim());\n    afterBlank = false;\n  }\n  flush();\n  return blocks;\n};\nconst listMarkup = (items, nested, ordered = false) => `<${ordered ? 'ol' : 'ul'} style='margin:${nested ? '6px 0 0' : '0 0 14px'};padding-left:${ordered ? 26 : 22}px;${nested ? '' : `max-width:60ch;font:400 18px/1.55 ${SERIF};color:#253c58`}'>`\n  + items.map((item) => `<li style='margin:0 0 6px'>${inlineText(item.text)}${item.children.length ? listMarkup(item.children, true) : ''}</li>`).join('')\n  + `</${ordered ? 'ol' : 'ul'}>`;\nconst bodyText = (value, dropCap) => bodyBlocks(value).map((block, index) => {\n  if (block.kind === 'code') return `<pre style='margin:0 0 16px;padding:14px 16px;overflow-x:auto;white-space:pre;background:#dce9f7;border-left:3px solid ${ACCENT};font:400 13px/1.55 ${MONO};color:#182d4c'>${escapeText(block.text)}</pre>`;\n  if (block.kind === 'h') return `<h3 style='margin:22px 0 8px;font:700 15px/20px system-ui;color:#182d4c'>${inlineText(block.text)}</h3>`;\n  if (block.kind === 'list') return listMarkup(block.items, false, block.ordered);\n  const cap = false;\n  return `<p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 ${SERIF};color:#253c58'>`\n    + (cap ? `<span style='float:left;padding:6px 10px 0 0;font:500 68px/54px ${SERIF};color:#182d4c'>${block.text[0]}</span>` : '')\n    + `${inlineText(cap ? block.text.slice(1) : block.text).replace(/\\n/g, '<br>')}</p>`;\n}).join('');\n\n// --- One renderer per role: what that piece contributes ------------------------------------------\nconst RENDER = {\n  // The eyebrow is the nameplate, the title the headline, the subtitle the standfirst.\n  'page-masthead': (data) => `<header data-role='masthead'>`\n    + `<div style='padding:${clean(data.eyebrow) ? '10px 0' : '0'};border-top:6px solid ${ACCENT};${clean(data.eyebrow) ? 'border-bottom:1px solid #182d4c;' : ''}${KICKER};color:${ACCENT}'>${escapeHtml(data.eyebrow)}</div>`\n    + `<h1 style='margin:40px 0 0;font:850 clamp(36px,9.5cqw,72px)/.98 system-ui,sans-serif;letter-spacing:-.035em;text-wrap:balance;color:#182d4c'>${escapeHtml(data.title)}</h1>`\n    + (clean(data.subtitle) ? `<p style='margin:18px 0 0;max-width:36ch;font:400 clamp(20px,3.6cqw,26px)/1.4 ${SERIF};color:#46617f'>${escapeHtml(data.subtitle)}</p>` : '')\n    + `</header>`,\n  // A teaser: a rule, a title, a line or two, and where it leads. A primary route is drawn heavier.\n  'page-route': (data) => {\n    // Drawn as a Portal-style card when the route asks for it: a bordered card, the whole of which is the link.\n    if (clean(data.appearance).toLowerCase() === 'portal') {\n      const ref = /^(tlz|https|github):\\/\\//.test(clean(data.destinationRef)) ? clean(data.destinationRef) : '';\n      const tag = ref ? 'a' : 'div';\n      return `<${tag} data-role='route' data-appearance='portal'${ref ? ` href='${escapeHtml(ref)}'` : ''} style='height:100%;box-sizing:border-box;display:flex;flex-direction:column;gap:4px;padding:12px 16px;background:#f6c945;border:2px solid #171d26;border-radius:0;border-left:8px solid #171d26;text-decoration:none;color:#182d4c'>`\n        + `<span style='font:800 11px/14px system-ui;letter-spacing:.14em;color:#171d26'>${escapeHtml(clean(data.destinationLabel) || 'Open').toUpperCase()}</span>`\n        + `<h2 style='margin:0;font:800 22px/26px system-ui;letter-spacing:-.03em;color:#182d4c'>${escapeHtml(data.title)}</h2>`\n        + (clean(data.body) ? `<span style='font:400 13px/18px system-ui;color:#46617f'>${escapeHtml(data.body)}</span>` : '')\n        + `</${tag}>`;\n    }\n    const primary = clean(data.prominence).toLowerCase() !== 'secondary';\n    return `<section data-role='route' data-prominence='${primary ? 'primary' : 'secondary'}' style='height:100%;box-sizing:border-box;display:flex;flex-direction:column;`\n      + `${primary ? `padding-top:12px;border-top:3px solid ${ACCENT}` : 'padding-top:14px;border-top:1px solid #182d4c'}'>`\n      + `<h2 style='margin:0 0 8px;font:750 ${primary ? 26 : 22}px/1.1 system-ui;letter-spacing:-.01em;color:#182d4c'>${escapeHtml(data.title)}</h2>`\n      + (clean(data.body) ? `<p style='margin:0 0 10px;font:400 14px/1.55 system-ui;color:#46617f'>${escapeHtml(data.body)}</p>` : '')\n      // Where it leads is a link to the route's destination, when it names one Twilite or the web can open.\n      + (/^(tlz|https|github):\\/\\//.test(clean(data.destinationRef))\n        ? `<a data-role='route-link' href='${escapeHtml(clean(data.destinationRef))}' style='margin-top:auto;font:700 13px/20px system-ui;text-decoration:none;color:${primary ? ACCENT : '#46617f'}'>${escapeHtml(data.destinationLabel || 'Open')} →</a></section>`\n        : `<div style='margin-top:auto;font:700 13px/20px system-ui;color:${primary ? ACCENT : '#46617f'}'>${escapeHtml(data.destinationLabel || 'Open')} →</div></section>`);\n  },\n  // A ruled list. A short value sits beside its name; a long one runs underneath at the full width of the list.\n  'page-settings': (data) => `<section data-role='settings' style='padding-top:10px;border-top:3px solid #182d4c'>`\n    + kicker(data.title || 'Settings', '#182d4c')\n    + `<dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid #a6bed9'>`\n    + settingRows(data.rows).map(([name, value]) => {\n      const wide = value.length > 24;\n      const span = wide ? 'grid-column:1/-1;' : '';\n      return `<dt style='${span}padding:9px 0 ${wide ? 0 : 9}px;border-top:1px solid #a6bed9;font:400 13px/20px system-ui;color:#46617f'>${escapeHtml(name)}</dt>`\n        + `<dd style='${span}margin:0;padding:${wide ? '2px 0 9px' : '9px 0;border-top:1px solid #a6bed9;text-align:right'};font:600 14px/20px system-ui;color:#182d4c;overflow-wrap:anywhere'>${escapeHtml(value)}</dd>`;\n    }).join('')\n    + `</dl></section>`,\n  'page-section': (data, { dropCap }) => `<section data-role='section'>${kicker(data.title)}${bodyText(data.body, dropCap)}</section>`\n};\n\n// --- The three views --------------------------------------------------------------------------\n// The pieces stay in graph order. Three things sit side by side when the view is wide enough and stack when it\n// is not: routes that follow one another, and a settings list next to the section it comes before or after,\n// which is set as that section's sidebar. Everything else takes the full width. A role with no pieces\n// contributes nothing.\nconst stackPage = (pieces) => {\n  const firstSection = pieces.find((piece) => piece.role === 'page-section');\n  const render = (piece) => RENDER[piece.role](piece.data, { dropCap: piece === firstSection });\n  const text = (piece) => `<div style='flex:999 1 380px;min-width:0'>${render(piece)}</div>`;\n  const side = (piece) => `<div style='flex:1 1 220px;min-width:0'>${render(piece)}</div>`;\n  const row = (inner, gap, reverse) => `<div style='display:flex;flex-wrap:wrap;${reverse ? 'flex-direction:row-reverse;' : ''}align-items:${reverse === undefined ? 'stretch' : 'flex-start'};gap:${gap}'>${inner}</div>`;\n  const blocks = [];\n  for (let index = 0; index < pieces.length; index += 1) {\n    const piece = pieces[index];\n    const next = pieces[index + 1];\n    if (piece.role === 'page-route') {\n      const routes = [piece];\n      while (pieces[index + 1]?.role === 'page-route') { index += 1; routes.push(pieces[index]); }\n      blocks.push([40, row(routes.map((route) => `<div style='flex:1 1 190px;min-width:0'>${render(route)}</div>`).join(''), '28px 32px')]);\n    } else if (piece.role === 'page-section' && next?.role === 'page-settings') {\n      index += 1;\n      blocks.push([48, row(text(piece) + side(next), '32px 40px', false)]);\n    } else if (piece.role === 'page-settings' && next?.role === 'page-section') {\n      index += 1;\n      blocks.push([48, row(side(piece) + text(next), '32px 40px', true)]);\n    } else blocks.push([piece.role === 'page-masthead' ? 32 : 48, render(piece)]);\n  }\n  return `<div style='width:100%;height:100%;overflow:auto;box-sizing:border-box;container-type:inline-size;background:#eef4fb;font-family:${SERIF};color:#182d4c'>`\n    + `<div style='box-sizing:border-box;max-width:900px;margin:0 auto;padding:0 clamp(20px,5cqw,40px) 64px'>`\n    + blocks.map(([gap, inner]) => `<div style='padding-top:${gap}px'>${inner}</div>`).join('')\n    + `</div></div>`;\n};\n// A size drawn for one width that follows the width the view is actually shown at.\nconst fluid = (px, base) => `clamp(0.5px,${(px / base * 100).toFixed(2)}cqw,${Math.round(px * 1.5)}px)`;\nconst stackSummary = (pieces) => { const masthead = pieces.find(p => p.role === 'page-masthead')?.data || {}; const count = pieces.filter(p => p.role === 'page-section' && /^\\d+\\./.test(clean(p.data.title))).length; return `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;height:100%;padding:5cqw;background:#eef4fb;border:1px solid #a6bed9;border-top:2cqw solid #294b83;color:#182d4c;font-family:system-ui;display:flex;flex-direction:column;gap:2cqw;overflow:hidden'><div style='font:750 3.6cqw/1.15 ui-monospace,monospace;letter-spacing:.1em;color:#294b83'>CANON / SPECIFICATION</div><div style='font:800 8cqw/1.05 system-ui;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'>${escapeHtml(masthead.title || 'Untitled standard')}</div><div style='font:650 4.6cqw/1.2 system-ui;color:#46617f'>${count} rules · reasons · checks</div><div style='margin-top:auto;padding-top:1.5cqw;border-top:1px solid #a6bed9;font:700 3.4cqw/1.15 ui-monospace,monospace;color:#294b83'>TWILITE / TECHNICAL SIGNAGE</div></div></div>`; };\nconst stackIcon = (pieces) => { const masthead = pieces.find(p => p.role === 'page-masthead')?.data || {}; const count = pieces.filter(p => p.role === 'page-section' && /^\\d+\\./.test(clean(p.data.title))).length; return `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;height:100%;padding:4.5cqw;background:#294b83;border:1px solid #b5d4ff;border-radius:3cqw;color:#fff;font-family:system-ui;display:flex;flex-direction:column;overflow:hidden'><div style='font:750 3.8cqw/1.15 ui-monospace,monospace;letter-spacing:.1em;color:#b5d4ff;border-top:1px solid #80c9f2;padding-top:1.6cqw'>INFRASTRUCTURE / 04</div><div style='display:flex;flex:1;min-height:0;align-items:center;gap:3cqw'><div style='flex:1;min-width:0;font:800 7.7cqw/1.04 system-ui;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${escapeHtml(masthead.title || 'Untitled standard')}</div><div style='width:29cqw;aspect-ratio:1;flex:none'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 96' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Technical checklist'><rect x='3' y='3' width='90' height='90' rx='5' fill='none' stroke='#80c9f2'/><rect x='22' y='17' width='54' height='67' rx='4' fill='none' stroke='#b5d4ff' stroke-width='2'/><path d='M29 33L33 37L40 29M29 49L33 53L40 45M29 65L33 69L40 61M46 34H66M46 50H66M46 66H66' fill='none' stroke='#b5d4ff' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/></svg></div></div><div style='border-bottom:1px solid #80c9f2;padding-bottom:1.4cqw;color:#b5d4ff;font:750 3.5cqw/1.2 ui-monospace,monospace'>CANON STANDARD / ${count} RULES</div></div></div>`; };\n\n// --- Run --------------------------------------------------------------------------------------\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst pieces = nodes.filter((node) => ROLES.includes(roleOf(node)))\n  .map((node) => ({ role: roleOf(node), data: node.data || {} }));\n\nconst declaration = nodes.find((node) => node?.type === 'root');\n// The exposed views are reached by walking the Declaration's own Surface chain -- surfaces to the\n// first face, then next-face links to the next -- the same path every graph in the library uses.\nconst chainNext = (fromId) => edges.find((edge) => edge.source === fromId\n  && clean(edge.type) === 'next-face')?.target;\nconst surfaceEdge = edges.find((edge) => edge.source === declaration?.id\n  && clean(edge.type) === 'surface');\nconst detailId = surfaceEdge?.target || '';\nconst summaryId = detailId ? chainNext(detailId) || '' : '';\nconst byId = new Map(nodes.map((node) => [node.id, node]));\nconst detailFace = byId.get(detailId);\nconst summaryFace = byId.get(summaryId);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nconst iconFace = nodes.find((node) => clean(node.type) === 'face' && clean(node.data?.semanticLevel) === 'icon');\n\n// The Detail defines the graph's shape: the regular 3:2 card, drawn as one page that scrolls. The Summary and the window take it.\nconst RATIO = 2 / 3;\nconst DETAIL_WIDTH = 760;\nconst SUMMARY_WIDTH = 300;\nconst sizeOf = (width) => ({ width, height: Math.round(width * RATIO) });\n// A graph made from the template declares what its own Method may write. What it does not declare is left as it is.\nconst attempt = async (write) => { try { await write(); } catch (error) { /* not declared by this graph */ } };\n\nconst updated = [];\nif (detailFace) {\n  await api.updateView(detailFace.id, { content: { kind: 'html', value: stackPage(pieces) }, view: { ...(detailFace.data?.view || {}), scroll: 'page' } });\n  await attempt(() => api.updateNode(detailFace.id, sizeOf(DETAIL_WIDTH)));\n  updated.push(detailFace.id);\n}\nif (summaryFace) {\n  await api.updateView(summaryFace.id, { content: { kind: 'html', value: stackSummary(pieces) } });\n  await attempt(() => api.updateNode(summaryFace.id, sizeOf(SUMMARY_WIDTH)));\n  updated.push(summaryFace.id);\n}\nif (iconFace) await attempt(() => api.updateView(iconFace.id, { content: { kind: 'html', value: stackIcon(pieces) } }));\n// The Glyph is the page's mark: the first letter of its title.\nconst title = clean(pieces.find((piece) => piece.role === 'page-masthead')?.data.title) || 'Page';\nif (glyph) await attempt(() => api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'symbol', value: title.charAt(0).toUpperCase(), color: ACCENT } } }));\n\n// The window is the Detail's shape and holds everything the graph has. A graph whose environment is a page that stops at its own window (a poster, with a stage for\n// the graph) sizes the window to that page itself, so it is left as it is.\nconst windowIsOwn = nodes.some((node) => clean(node.type) === 'face' && clean(node.data?.view?.payload) === 'node.web.environment' && clean(node.data?.view?.fit) === 'window');\nif (declaration && !windowIsOwn) {\n  const placed = nodes.filter((node) => node.position).map((node) => (node === detailFace ? { ...node, ...sizeOf(DETAIL_WIDTH) } : node === summaryFace ? { ...node, ...sizeOf(SUMMARY_WIDTH) } : node));\n  const pad = 80;\n  let x0 = Math.min(...placed.map((node) => node.position.x)) - pad;\n  let y0 = Math.min(...placed.map((node) => node.position.y)) - pad;\n  let w = Math.max(...placed.map((node) => node.position.x + node.width)) + pad - x0;\n  let h = Math.max(...placed.map((node) => node.position.y + node.height)) + pad - y0;\n  if (w / h < 1 / RATIO) { const next = Math.round(h / RATIO); x0 -= Math.round((next - w) / 2); w = next; } else { const next = Math.round(w * RATIO); y0 -= Math.round((next - h) / 2); h = next; }\n  await attempt(() => api.updateNode(declaration.id, { data: { ...declaration.data, membrane: { ...(declaration.data?.membrane || {}), bounds: { x: Math.round(x0), y: Math.round(y0), width: Math.round(w), height: Math.round(h) } } } }));\n}\nreturn { updated, pieces: pieces.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "canon-standard-detail",
              "canon-standard-summary",
              "canon-standard-glyph",
              "canon-standard",
              "canon-standard-icon"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "canon-standard"
        }
      }
    },
    {
      "id": "canon-standard-masthead",
      "type": "page-masthead",
      "label": "What a canon template is",
      "position": {
        "x": -330,
        "y": -1516
      },
      "width": 520,
      "height": 260,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Abc"
          },
          "baseLevel": "detail"
        },
        "eyebrow": "TWILITE ZONE · TEMPLATES",
        "title": "What a canon template is",
        "subtitle": "",
        "identity": {
          "graphId": "canon-standard"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-masthead.node-class.node"
      },
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "side": "top",
          "offset": 0.5,
          "position": {
            "side": "top",
            "offset": 0.5
          },
          "metadata": {
            "interface": true,
            "structural": true,
            "role": "view.content",
            "hideLabel": true,
            "glyph": {
              "kind": "icon",
              "name": "Login"
            }
          }
        },
        {
          "id": "input",
          "key": "input",
          "label": "input",
          "direction": "input",
          "dataType": "any",
          "side": "left",
          "offset": 0.35,
          "position": {
            "side": "left",
            "offset": 0.35
          },
          "metadata": {
            "structural": true,
            "courtesy": true,
            "glyph": {
              "kind": "icon",
              "name": "Input"
            }
          }
        },
        {
          "id": "prev",
          "key": "prev",
          "label": "prev",
          "direction": "input",
          "dataType": "any",
          "side": "left",
          "offset": 0.65,
          "position": {
            "side": "left",
            "offset": 0.65
          },
