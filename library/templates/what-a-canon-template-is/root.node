    {
      "id": "canon-standard-section-6",
      "type": "page-section",
      "label": "5. A view fits its page, or is one page that scrolls",
      "position": {
        "x": 2970,
        "y": -260
      },
      "width": 620,
      "height": 380,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "5. A view fits its page, or is one page that scrolls",
        "body": "A view is measured from its own width (cqw inside an outer container, never on the container itself) and is one of two things. A **card** fits its fixed page and says how many more when there is more than fits. A **page** is one scrolling area, the whole view, which the workspace can scroll at every size by the wheel, the thumb and the track. A scrolling area nested inside a fixed card is not allowed for now, because the workspace cannot carry it yet; that can change if a template needs one.\n\n*Why:* The app already scrolls a page view at every size and moves the nodes with it. It cannot yet scroll a region inside a card, so a card that needed one would show a scrollbar nobody could use.\n\n*Checked by:* Test: a card has no scrolling area, a long list still fits, and a page has exactly one (mechanical).",
        "identity": {
          "graphId": "canon-standard"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
