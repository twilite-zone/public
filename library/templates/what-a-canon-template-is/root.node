    {
      "id": "canon-standard-section-13",
      "type": "page-section",
      "label": "12. It is tested",
      "position": {
        "x": -630,
        "y": 700
      },
      "width": 620,
      "height": 380,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
