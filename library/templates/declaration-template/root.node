          },
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "identity": {
          "graphId": "declaration-template"
        },
        "title": "What a Declaration is",
        "body": "A Declaration is the one node that gives a graph its identity. It says what the graph is called, what kind of thing it is, how it presents itself at every size, and what it lets other graphs use.\n\nIt is also the graph's root. Visitors and other graphs reach everything through it, so you never add a separate root node. A graph without a Declaration is only a fragment: content that has not been given an identity yet.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          }
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      }
    },
