        "title": "The parts at a glance",
        "rows": [
          {
            "label": "Identity",
            "value": "A name, a version, a description, and a stable id"
          },
          {
            "label": "Intent",
            "value": "What kind of graph this is, and who it is for"
          },
          {
            "label": "Surface",
            "value": "A chain of Views, richest first, ending in a Glyph"
          },
          {
            "label": "Ground",
            "value": "Where a visitor lands, and the frame of the graph"
          },
          {
            "label": "Ports",
            "value": "Optional named entry points other graphs can use"
          },
          {
            "label": "Authority",
            "value": "Who may create, change or delete: people, agents, tools"
          }
        ],
        "presentation": {
