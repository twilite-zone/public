      "data": {
        "surfaceId": "",
        "direction": "input",
        "dataType": "any",
        "interfaceContract": {
          "version": 1,
          "semanticViews": true
        },
        "presentation": {
          "detail": {
            "mode": "own"
          },
          "summary": {
            "mode": "fallback"
          },
          "icon": {
            "mode": "shared"
          },
          "glyph": {
            "mode": "shared"
          }
        },
        "identity": {
          "graphId": "declaration-template",
          "portId": "editor",
          "name": "Declaration Editor"
        },
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "host": {
              "kind": "declaration-editor",
              "description": "Edit every field a Declaration holds."
            },
            "layout": {
              "chrome": {
                "eyebrow": "Editor Surface",
                "title": "Declaration Editor",
                "badge": "every field",
                "summary": "Edit everything a Declaration holds: identity, kind, Surfaces, who may change the graph, and where it is saved."
              },
              "appearance": {
                "panelBackground": "linear-gradient(180deg, rgba(255,255,255,0.98), rgba(243,244,255,0.96))",
                "panelBorder": "rgba(109,40,217,0.14)",
                "eyebrow": "#7c3aed",
                "title": "#312e81",
                "badgeBackground": "rgba(124,58,237,0.1)",
                "badgeForeground": "#5b21b6",
                "sectionBackground": "rgba(255,255,255,0.92)",
                "sectionBorder": "rgba(109,40,217,0.12)",
                "sectionTitle": "#4338ca",
                "summary": "#4c1d95",
                "helper": "#5b21b6"
              },
              "sections": [
                {
                  "key": "identity",
                  "title": "Identity",
                  "summary": "The canonical name, ids, version and description of this graph."
                },
                {
                  "key": "intent",
                  "title": "Kind of graph",
                  "summary": "What this graph is and how Twilite should treat it."
                },
                {
                  "key": "surfaces",
                  "title": "Surfaces",
                  "summary": "How the graph presents itself, and what it exposes to other graphs."
                },
                {
                  "key": "authority",
                  "title": "Authority",
                  "summary": "What may be changed, and by whom. Anything not granted is not allowed."
                },
                {
                  "key": "settings",
                  "title": "Settings and address",
                  "summary": "How the graph behaves in the editor and where it lives."
                },
                {
                  "key": "narrative",
                  "title": "Purpose",
                  "summary": "Why this graph exists and how it should be read."
                },
                {
                  "key": "analytics",
                  "title": "Analytics",
                  "summary": "Optional reporting, off unless you turn it on."
                }
              ]
            },
            "fields": [
              {
                "key": "graphName",
                "label": "Name",
                "type": "declaration-name",
                "path": "data.identity.name",
                "section": "identity",
                "placeholder": "Untitled Graph",
                "helperText": "What people see. Rename it whenever you like."
              },
              {
                "key": "graphId",
                "label": "Graph ID",
                "type": "graph-id",
                "path": "data.identity.graphId",
                "section": "identity",
                "placeholder": "graph-id",
                "helperText": "Other graphs find this one by its id. Set it once and keep it."
              },
              {
                "key": "nodeId",
                "label": "Node ID",
                "type": "text",
                "path": "data.identity.nodeId",
                "section": "identity",
                "placeholder": "node-id",
                "helperText": "Names this graph when it is used as a reusable node. Set it once and keep it."
              },
              {
                "key": "version",
                "label": "Version",
                "type": "declaration-version",
                "path": "data.identity.version",
                "section": "identity",
                "placeholder": "0.1.0"
              },
              {
                "key": "description",
                "label": "Description",
                "type": "declaration-description",
                "path": "data.identity.description",
                "section": "identity",
                "multiline": true,
                "rows": 3,
                "placeholder": "One sentence for someone who has never seen this graph.",
                "helperText": "Shown on cards and in lists."
              },
              {
                "key": "changelog",
                "label": "Changelog",
                "type": "json",
                "path": "data.identity.changelog",
                "section": "identity",
                "helperText": "A short note per version, oldest first. The app appends to this; edit it here if you need to correct an entry."
              },
              {
                "key": "intentKind",
                "label": "Kind of graph",
                "type": "declaration-intent-kind",
                "path": "data.intent.kind",
                "section": "intent",
                "placeholder": "plan, note, contract, task-board, template",
                "helperText": "What kind of thing this graph is. It belongs here, not in a title node."
              },
              {
                "key": "intentScope",
                "label": "Scope",
                "type": "select",
                "path": "data.intent.scope",
                "section": "intent",
                "options": [
                  {
                    "label": "Local",
                    "value": "local"
                  },
                  {
                    "label": "Shared",
                    "value": "shared"
                  },
                  {
                    "label": "Public",
                    "value": "public"
                  },
                  {
                    "label": "Mixed",
                    "value": "mixed"
                  }
                ],
                "helperText": "Local for your own work, shared for something others build on."
              },
              {
                "key": "declarationKind",
                "label": "Declared type",
                "type": "text",
                "path": "data.root.kind",
                "section": "intent",
                "placeholder": "graph",
                "helperText": "The declaration kind. It stays extensible."
              },
              {
                "key": "artifactKind",
                "label": "Artifact kind",
                "type": "text",
                "path": "data.root.artifactKind",
                "section": "intent",
                "placeholder": "graph, template, node-class, primitive-spec",
                "helperText": "What this graph is as a file."
              },
              {
                "key": "defaultSurfaceId",
                "label": "Default Surface",
                "type": "declaration-default-surface",
                "path": "data.root.defaultSurfaceId",
                "section": "surfaces",
                "placeholder": "default",
                "helperText": "The Surface a viewer sees when it does not ask for one. Left empty, the first Surface answers."
              },
              {
                "key": "surfaces",
                "label": "Exposed entries",
                "type": "declaration-surfaces",
                "path": "data.root.surfaces",
                "section": "surfaces",
                "multiline": true,
                "rows": 8,
                "helperText": "Ports and exports this graph offers to others. Presentation Surfaces are drawn on the canvas and listed above."
              },
              {
                "key": "allowCreate",
                "label": "Allow creating nodes",
                "type": "boolean",
                "path": "data.authority.mutation.allowCreate",
                "section": "authority"
              },
              {
                "key": "allowUpdate",
                "label": "Allow changing nodes",
                "type": "boolean",
                "path": "data.authority.mutation.allowUpdate",
                "section": "authority"
              },
              {
                "key": "allowDelete",
                "label": "Allow deleting nodes",
                "type": "boolean",
                "path": "data.authority.mutation.allowDelete",
                "section": "authority"
              },
              {
                "key": "appendOnly",
                "label": "Append only",
                "type": "boolean",
                "path": "data.authority.mutation.appendOnly",
                "section": "authority",
                "helperText": "New nodes may be added, but existing ones are never changed or removed."
              },
              {
                "key": "actorHumans",
                "label": "People may edit",
                "type": "boolean",
                "path": "data.authority.actors.humans",
                "section": "authority"
              },
              {
                "key": "actorAgents",
                "label": "Agents may edit",
                "type": "boolean",
                "path": "data.authority.actors.agents",
                "section": "authority"
              },
              {
                "key": "actorTools",
                "label": "Tools may edit",
                "type": "boolean",
                "path": "data.authority.actors.tools",
                "section": "authority"
              },
              {
                "key": "styleAuthority",
                "label": "Weight of styling",
                "type": "select",
                "path": "data.authority.styleAuthority",
                "section": "authority",
                "options": [
                  {
                    "label": "Descriptive",
                    "value": "descriptive"
                  },
                  {
                    "label": "Authoritative",
                    "value": "authoritative"
                  },
                  {
                    "label": "Ignored",
                    "value": "ignored"
                  }
                ],
                "helperText": "How much weight the styling in this graph carries."
              },
              {
                "key": "rewriteAllowed",
                "label": "Allow rewriting history",
                "type": "boolean",
                "path": "data.authority.history.rewriteAllowed",
                "section": "authority",
                "helperText": "Off by default, so earlier versions stay as they were."
              },
              {
                "key": "squashAllowed",
                "label": "Allow squashing history",
                "type": "boolean",
                "path": "data.authority.history.squashAllowed",
                "section": "authority"
              },
              {
                "key": "layoutMode",
                "label": "Layout",
                "type": "select",
                "path": "data.settings.layout.mode",
                "section": "settings",
                "options": [
                  {
                    "label": "Auto (only when positions omitted)",
                    "value": "autoOnMissingPositions"
                  },
                  {
                    "label": "Manual (never auto-layout on paste)",
                    "value": "manual"
                  }
                ]
              },
              {
                "key": "documentUrl",
                "label": "Address",
                "type": "text",
                "path": "data.document.url",
                "section": "settings",
                "placeholder": "tlz://twilite.zone/path/root.node",
                "helperText": "Where this graph is saved. It is filled in when you save."
              },
              {
                "key": "purpose",
                "label": "Purpose",
                "type": "markdown",
                "path": "data.purpose",
                "section": "narrative",
                "multiline": true,
                "rows": 4,
                "placeholder": "Say what this graph means and how readers should use it."
              },
              {
                "key": "analytics",
                "label": "Analytics",
                "type": "json",
                "path": "data.analytics",
                "section": "analytics",
                "multiline": true,
                "rows": 6,
                "helperText": "Optional. Opt this graph in to page-view reporting."
              }
            ]
          }
        },
        "semanticLevel": "editor",
        "visibilityRole": "editor"
      }
    },
