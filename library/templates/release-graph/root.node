          "angle": 270,
          "portId": "root"
        }
      ],
      "visible": false,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "release-graph"
        },
        "content": {
          "kind": "markdown",
          "value": "# Release Graph\n\nA release is a graph with one **release date**, a title and a few **entries**. Each entry is a Release Entry card: a title, a category (new, changed or fixed) and a summary for a customer.\n\nThe Detail, Summary and Glyph are not written by hand: the Method reads the graph and writes them. The intro under the title is the root's description, the date is its `releaseDate`, and the highlights are the titles of the entries in New, so none of them is typed twice.\n\nA graph made from this template **imports it once** (an import of this template's graph), and gets the Release Entry class and the Method. Set the graph's name, description and `releaseDate` (as YYYY-MM-DD) on its root.\n\nA published release is not edited: a correction is a new release."
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791502752029,
          "reason": "node-drag"
        }
      }
    },
    {
      "id": "release-graph-derive-method",
      "type": "method",
      "label": "Assemble the release",
      "position": {
        "x": -50,
        "y": 1233
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Assemble the release",
        "parameters": [],
        "source": "// Derives a release's views from its entries: nothing is typed into a view.\n// It reads the release's own identity (its name, its description, its release date) and the Release Entry cards (nodes of the type `release-entry`), in the order they sit in the graph. It writes the Detail\n// (the release as a page: a masthead, the highlights, and the entries under New, Changed and Fixed), the Summary (a card) and the Glyph, and only those, which its declared effects say.\n// The intro is the root's description, and the highlights are the titles of the entries in New, so neither is typed twice. A card with a review record (a private one, from the queue) is not published here, so\n// it is left out: the page shows public fields only.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst SERIF = 'Georgia,Iowan Old Style,Palatino Linotype,serif'; const SANS = 'Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'; const MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst VIOLET = '#6d28d9'; const GOLD = '#b45309'; const INK = '#1f2937'; const PAPER = '#faf7ff'; const MUTED = '#64748b';\nconst CATEGORIES = [['new', 'New', '#15803d'], ['changed', 'Changed', '#1d4ed8'], ['fixed', 'Fixed', '#b45309']];\nconst MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\n\nconst nodes = await api.getNodes();\nconst root = nodes.find((node) => clean(node.type) === 'root');\nconst identity = root?.data?.identity || {};\nconst name = clean(identity.name) || 'A release';\nconst lead = clean(identity.description);\nconst dateParts = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(clean(identity.releaseDate));\nconst dateText = dateParts && MONTHS[Number(dateParts[2]) - 1] ? `${Number(dateParts[3])} ${MONTHS[Number(dateParts[2]) - 1]} ${dateParts[1]}` : '';\nconst entries = nodes.filter((node) => clean(node.type) === 'release-entry' && !(node.data && node.data.review));\nconst titleOf = (entry) => clean(entry.data?.title || entry.label) || 'Untitled';\nconst inCategory = (key) => entries.filter((entry) => clean(entry.data?.category) === key);\nconst highlights = inCategory('new').slice(0, 3);\nconst counts = CATEGORIES.map(([key]) => inCategory(key).length);\nconst plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;\n\nconst paragraphs = (text, size) => clean(text).split(/\\n{2,}/).map((p) => p.trim()).filter(Boolean)\n  .map((p) => `<div style='font:400 ${size}cqw/1.55 ${SERIF};color:#334155;margin-top:.6cqw'>${esc(p)}</div>`).join('');\nconst heading = (label, colour, count) => `<div style='display:flex;justify-content:space-between;align-items:baseline;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'>`\n  + `<span style='font:700 1.5cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${colour}'>${label}</span>`\n  + `<span style='font:600 1.4cqw/1 ${SANS};color:${MUTED}'>${count}</span></div>`;\nconst entryBlock = (entry, colour) => `<div style='margin-bottom:2.4cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e9e5f5;border-left:.7cqw solid ${colour}'>`\n  + `<div style='font:700 2.2cqw/1.3 ${SERIF};color:${INK}'>${esc(titleOf(entry))}</div>`\n  + paragraphs(entry.data?.summary, 1.75)\n  + paragraphs(entry.data?.detail, 1.6)\n  + (clean(entry.data?.ref) ? `<div style='margin-top:1cqw;font:600 1.5cqw/1.4 ${SANS};color:${VIOLET};overflow-wrap:anywhere'>${esc(entry.data.ref)}</div>` : '')\n  + `</div>`;\n\nconst detail = `<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:${PAPER};font-family:${SERIF};color:${INK}'>`\n  + `<div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'>`\n  + `<div style='padding:1.4cqw 0;border-top:.4cqw solid ${INK};border-bottom:.1cqw solid ${INK};display:flex;justify-content:space-between;font:700 1.3cqw/1 ${MONO};letter-spacing:.3em;text-transform:uppercase;color:${VIOLET}'><span>Release notes</span><span style='color:${GOLD}'>${esc(dateText)}</span></div>`\n  + `<div style='font:700 5.4cqw/1.1 ${SERIF};margin:3cqw 0 .8cqw;color:${INK}'>${esc(name)}</div>`\n  + (lead ? `<div style='font:400 2.2cqw/1.5 ${SERIF};color:#334155;margin-top:2cqw;max-width:62cqw'>${esc(lead)}</div>` : '')\n  + (highlights.length ? `<div style='margin-top:3cqw'><div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${GOLD};margin-bottom:1.2cqw'>Highlights</div>`\n    + highlights.map((entry) => `<div style='font:600 1.9cqw/1.5 ${SANS};color:${INK};margin-top:.5cqw'><span style='color:${GOLD}'>◆</span> ${esc(titleOf(entry))}</div>`).join('') + `</div>` : '')\n  + (entries.length ? CATEGORIES.map(([key, label, colour]) => (inCategory(key).length ? heading(label, colour, plural(inCategory(key).length, 'change', 'changes')) + inCategory(key).map((entry) => entryBlock(entry, colour)).join('') : '')).join('')\n    : `<div style='margin-top:4cqw;font:italic 1.8cqw/1.5 ${SERIF};color:${MUTED}'>No entries yet.</div>`)\n  + `</div></div>`;\n\nconst tally = CATEGORIES.map(([key, label], i) => (counts[i] ? `${counts[i]} ${label.toLowerCase()}` : '')).filter(Boolean).join(' · ') || 'No entries yet';\nconst summary = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:${PAPER};border:.9cqw solid ${VIOLET};border-top:2cqw solid #f5c542;color:${INK};overflow:hidden;display:flex;flex-direction:column;gap:2cqw'>`\n  + `<div style='display:flex;justify-content:space-between;font:700 3cqw/1 ${MONO};letter-spacing:.2em;text-transform:uppercase;color:${VIOLET}'><span>Release notes</span><span style='color:${GOLD}'>${esc(dateText)}</span></div>`\n  + `<div style='font:700 8cqw/1.12 ${SERIF};display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${esc(name)}</div>`\n  + `<div style='font:600 3.6cqw/1.3 ${SANS};color:#334155'>${esc(tally)}</div>`\n  + (highlights.length ? `<div style='font:500 3.4cqw/1.35 ${SANS};color:${MUTED};display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${highlights.slice(0, 2).map((entry) => `<span style='color:${GOLD}'>◆</span> ${esc(titleOf(entry))}`).join('<br>')}</div>` : '')\n  + `</div></div>`;\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary]]) {\n  const target = faceFor(level);\n  if (target) await api.updateView(target.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'icon', name: 'NewReleases', color: VIOLET } } });\nreturn { name, date: clean(identity.releaseDate), entries: entries.length, new: counts[0], changed: counts[1], fixed: counts[2] };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "release-graph-detail",
              "release-graph-summary",
              "release-graph-glyph"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "release-graph-declaration"
        }
      }
    },
