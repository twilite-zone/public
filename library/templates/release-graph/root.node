          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background:linear-gradient(160deg,#faf7ff,#ece3fb);font-family:Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><div style='position:absolute;inset:0;background-image:repeating-linear-gradient(0deg,rgba(109,40,217,.07) 0,rgba(109,40,217,.07) .12cqw,transparent .12cqw,transparent 4.2cqw)'></div><div style='position:absolute;inset:1.4cqw;border:.2cqw solid rgba(109,40,217,.5)'></div><div style='position:absolute;left:1.4cqw;right:1.4cqw;top:1.4cqw;height:.9cqw;background:#f5c542'></div><div style='position:absolute;left:4.6cqw;top:3.6cqw;font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.3em;text-transform:uppercase;color:#6d28d9'>Template</div><div style='position:absolute;left:4.6cqw;right:18cqw;top:6.4cqw;font:700 6.6cqw/1.05 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Release Graph</div><div style='position:absolute;left:4.6cqw;right:18cqw;top:14.4cqw;font:italic 2cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>One release as a few entries: what is new, what changed and what was fixed.</div><div style='position:absolute;right:5.4cqw;top:3.4cqw;width:11cqw;height:11cqw;border-radius:50%;overflow:hidden;border:.4cqw solid #6d28d9;background:#f5f3ff;display:flex;align-items:center;justify-content:center'><svg viewBox='0 0 64 64' style='width:70%;height:70%' aria-hidden='true'><g fill='none' stroke='#6d28d9' stroke-width='4.5' stroke-linecap='round' stroke-linejoin='round'><path d='M32 6L38 22L54 16L46 32L58 38L42 42L44 58L32 48L20 58L22 42L6 38L18 32L10 16L26 22Z'/></g></svg></div><div style='position:absolute;left:13.5cqw;right:3.5cqw;top:22cqw;bottom:8cqw;box-sizing:border-box;border-radius:1cqw;border:.3cqw dashed rgba(109,40,217,.5);background-color:rgba(109,40,217,.04)'></div><div style='position:absolute;left:13.5cqw;right:3.5cqw;bottom:3cqw;font:400 1.15cqw/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;text-transform:uppercase;color:#6d28d9'>Add an entry for each change<span style='color:#b45309'> · </span>the page, the card and the glyph follow</div></div></div>"
