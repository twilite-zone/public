    },
    {
      "id": "release-graph-environment",
      "type": "face",
      "label": "Release bulletin",
      "position": {
        "x": -500,
        "y": -1387
      },
      "width": 400,
      "height": 240,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "release-graph-declaration"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.environment",
          "fit": "window",
          "stage": {
            "left": 4,
            "right": 4,
            "top": 21,
            "bottom": 6
          }
        },
        "content": {
          "kind": "html",
