          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0,
          "position": {
            "side": "right",
            "offset": 0.5
          }
        }
      ],
      "handles": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "memo": "The one export of this template: the Method that assembles a release's views and glyph from its entries, and the Release Entry class it hands on.",
        "identity": {
          "graphId": "release-graph-declaration"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1793397964948,
          "reason": "node-drag"
        },
        "bridge": {
          "ref": "tlz://twilite.zone/library/templates/release-graph/root.node",
          "resourceKind": "graph",
          "scope": "focused-graph",
          "grants": [
            "read",
