    {
      "id": "repo-template-repo",
      "type": "repo",
      "label": "Library",
      "position": {
        "x": 680,
        "y": 200
      },
      "width": 420,
      "height": 240,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Name this library",
        "body": "What this library is for.",
        "audience": "Who it is for: readers, collaborators, or just you.",
        "owner": "owner",
        "repo": "repository",
        "branch": "main",
        "readFrom": "github",
        "host": "",
        "published": false,
        "startHere": "",
        "sort": "order",
        "includeFolder": false,
        "sourcesSummary": "2 portals · 2 members",
        "identity": {
          "graphId": "repo-template",
          "nodeId": "repo-template-repo"
        },
        "classRef": "tlz://twilite.zone/library/classes/nodes/repo/repo.node-class.node"
      },
      "ports": [
        {
          "id": "members",
          "key": "members",
          "label": "members",
          "direction": "output",
