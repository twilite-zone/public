        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;font-family:system-ui,-apple-system,Segoe UI,sans-serif;padding:4cqw;border-radius:3cqw;background:#ffffff;border:1px solid #e2e8f0;display:flex;flex-direction:column;gap:2cqw'><div style='display:flex;flex-direction:column;gap:.9cqw'><div style='font-size:2.2cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#6d28d9'>Library</div><div style='font-weight:600;font-size:4.6cqw;line-height:1.2;color:#0f172a'>Name this library</div><div style='font-size:2.6cqw;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:#6d28d9'>owner/repository · main</div><div style='font-size:2.4cqw;color:#64748b'>read from GitHub, through the app</div><div style='font-size:2.9cqw;line-height:1.4;color:#334155'>What this library is for.</div><div style='font-size:2.5cqw;line-height:1.35;color:#64748b'>Who it is for: readers, collaborators, or just you.</div><a href='tlz://twilite.zone/library/templates/repo-template/shelves/tasks/root.node' style='align-self:flex-start;margin-top:.4cqw;padding:1.1cqw 2.8cqw;border-radius:6cqw;background:#6d28d9;color:#ffffff;font-size:2.8cqw;font-weight:600;text-decoration:none'>Start here →</a></div><div style='flex:1;min-height:0;overflow:auto'><div style='display:grid;grid-template-columns:repeat(auto-fill,minmax(26.2cqw,1fr));gap:1.4cqw;align-content:start'><a href='tlz://twilite.zone/library/templates/repo-template/shelves/tasks/root.node' style='display:flex;gap:2.2cqw;align-items:flex-start;box-sizing:border-box;height:17cqw;padding:1.6cqw 2.1cqw;border:1px solid #e2e8f0;border-radius:2.4cqw;background:#f8fafc;text-decoration:none;color:inherit;min-width:0;overflow:hidden'><span style='flex:none;width:6.2cqw;height:6.2cqw;border-radius:1.6cqw;background:#6d28d922;color:#6d28d9;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:3cqw'>T</span><span style='min-width:0'><span style='display:block;font-weight:600;font-size:2.9cqw;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#0f172a'>Tasks</span><span style='display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:2.6cqw;line-height:1.3;color:#64748b'>The work in progress, one graph to a task.</span><span style='display:block;margin-top:.6cqw;font-size:2.4cqw;font-weight:600;color:#6d28d9'>3 graphs</span></span></a><a href='tlz://twilite.zone/library/templates/repo-template/shelves/notes/root.node' style='display:flex;gap:2.2cqw;align-items:flex-start;box-sizing:border-box;height:17cqw;padding:1.6cqw 2.1cqw;border:1px solid #e2e8f0;border-radius:2.4cqw;background:#f8fafc;text-decoration:none;color:inherit;min-width:0;overflow:hidden'><span style='flex:none;width:6.2cqw;height:6.2cqw;border-radius:1.6cqw;background:#6d28d922;color:#6d28d9;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:3cqw'>N</span><span style='min-width:0'><span style='display:block;font-weight:600;font-size:2.9cqw;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#0f172a'>Notes</span><span style='display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:2.6cqw;line-height:1.3;color:#64748b'>Loose thinking that is not a task yet.</span><span style='display:block;margin-top:.6cqw;font-size:2.4cqw;font-weight:600;color:#6d28d9'>0 graphs</span></span></a></div></div></div></div>"
