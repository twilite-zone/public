        "nodeClass": {
          "contractVersion": "1.0.0",
          "key": "workflow-question",
          "label": "Question",
          "meaning": "The problem to resolve, its required answer shape, evidence, completion criterion and unresolved response. The question is independent of the workflow steps.",
          "requiredDataKeys": [
            "title",
            "question",
            "answerKind",
            "answerSchema",
            "requiredEvidence",
            "completion",
            "onUnresolved"
          ],
          "nodeDef": {
            "key": "workflow-question",
            "ref": "tlz://twilite.zone/library/templates/repeatable-workflow/classes/workflow-question.node-class.node",
            "source": "github",
            "version": ">=0.1.0",
            "defaults": {
              "label": "Question",
              "size": {
                "width": 600,
                "height": 350
              },
              "showLabel": false,
              "data": {
                "title": "Question to resolve",
                "question": "What must this workflow determine or accomplish?",
                "answerKind": "structured-answer",
                "answerSchema": "{\"type\":\"object\",\"required\":[\"answer\",\"evidence\",\"resolution\"],\"properties\":{\"answer\":{\"type\":\"string\"},\"evidence\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"resolution\":{\"enum\":[\"resolved\",\"unresolved\",\"blocked\"]}},\"additionalProperties\":false}",
                "requiredEvidence": "Verifiable source references\nAcceptance-check result",
                "completion": "All required evidence is present and the answer passes the declared acceptance checks.",
                "onUnresolved": "Report unresolved or blocked with the reason and missing evidence; do not fabricate an answer.",
                "presentation": {
                  "glyph": {
                    "kind": "icon",
                    "name": "CircleHelp"
                  }
                }
              },
              "ports": [
                {
                  "id": "root",
                  "key": "root",
                  "label": "root",
                  "direction": "bidirectional",
                  "dataType": "any",
                  "angle": 270,
                  "position": {
                    "side": "top",
                    "offset": 0.5
                  }
                }
              ],
              "events": [
                {
                  "eventKey": "node.changed",
                  "label": "Question card changed",
                  "payloadContract": {
                    "type": "object"
                  }
                }
              ]
            }
          }
        },
