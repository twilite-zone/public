        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:auto;padding:4cqw;border:2px solid #63858b;border-radius:19px;background:#132c3b;color:#effaf6;font-family:system-ui\"><div style=\"font:800 clamp(10px,1.7cqw,17px)/1.2 system-ui;letter-spacing:.14em;color:#e9c27c\">QUESTION / ANSWER CONTRACT</div><h2 style=\"font:600 clamp(24px,4.3cqw,44px)/1.1 Georgia,serif;margin:2cqw 0\">{{data.title}}</h2><div style=\"font:500 clamp(17px,2.8cqw,26px)/1.35 Georgia,serif;color:#8fe3d1;white-space:pre-line\">{{data.question}}</div><div style=\"margin-top:2.8cqw;border-top:1px solid #42656c;padding-top:2cqw;font-size:clamp(12px,1.9cqw,18px);line-height:1.48\"><b style=\"color:#e9c27c\">ANSWER KIND</b><div>{{data.answerKind}}</div><b style=\"display:block;margin-top:1.6cqw;color:#e9c27c\">REQUIRED EVIDENCE</b><div style=\"white-space:pre-line\">{{data.requiredEvidence}}</div><b style=\"display:block;margin-top:1.6cqw;color:#e9c27c\">WHEN RESOLVED</b><div style=\"white-space:pre-line\">{{data.completion}}</div><b style=\"display:block;margin-top:1.6cqw;color:#e9c27c\">IF UNRESOLVED</b><div style=\"white-space:pre-line\">{{data.onUnresolved}}</div><b style=\"display:block;margin-top:1.6cqw;color:#e9c27c\">ANSWER SCHEMA (JSON)</b><div style=\"font:clamp(10px,1.55cqw,14px)/1.45 ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere\">{{data.answerSchema}}</div></div></div>"
        },
