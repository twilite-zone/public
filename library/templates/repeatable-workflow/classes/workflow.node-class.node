        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:hidden;padding:4.7cqw;background:#113644;border:2px solid #40777e;border-radius:19px;color:white;font-family:system-ui'><div style='display:flex;align-items:center;gap:2cqw;justify-content:space-between'><span style='font:800 clamp(9px,1.6cqw,15px)/1.2 system-ui;letter-spacing:.13em;color:#8fe9cf'>PROCESS</span><span style='width:2.4cqw;height:2.4cqw;min-width:8px;min-height:8px;border-radius:50%;background:#8fe9cf'></span></div><div style='font:650 clamp(18px,5.3cqw,32px)/1.12 Georgia,serif;letter-spacing:-.02em;overflow-wrap:anywhere;margin-top:3.4cqw;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>{{data.title}}</div><div style='min-width:0;margin-top:2.7cqw;'><div style='font:800 clamp(9px,1.7cqw,13px)/1.15 system-ui;letter-spacing:.08em;text-transform:uppercase;color:#8fe9cf;opacity:.9'>Purpose</div><div style='font:500 clamp(12px,2.8cqw,20px)/1.4 system-ui;white-space:pre-line;overflow:hidden;overflow-wrap:anywhere;color:#e2eef1;'>{{data.purpose}}</div></div><div style='min-width:0;margin-top:2.7cqw;'><div style='font:800 clamp(9px,1.7cqw,13px)/1.15 system-ui;letter-spacing:.08em;text-transform:uppercase;color:#8fe9cf;opacity:.9'>Trigger</div><div style='font:500 clamp(12px,2.8cqw,20px)/1.4 system-ui;white-space:pre-line;overflow:hidden;overflow-wrap:anywhere;color:#e2eef1;'>{{data.trigger}}</div></div><div style='min-width:0;margin-top:2.7cqw;'><div style='font:800 clamp(9px,1.7cqw,13px)/1.15 system-ui;letter-spacing:.08em;text-transform:uppercase;color:#8fe9cf;opacity:.9'>Resource bindings</div><div style='font:500 clamp(12px,2.8cqw,20px)/1.4 system-ui;white-space:pre-line;overflow:hidden;overflow-wrap:anywhere;color:#e2eef1;'>{{data.resources}}</div></div><div style='min-width:0;margin-top:2.7cqw;'><div style='font:800 clamp(9px,1.7cqw,13px)/1.15 system-ui;letter-spacing:.08em;text-transform:uppercase;color:#8fe9cf;opacity:.9'>Required tools</div><div style='font:500 clamp(12px,2.8cqw,20px)/1.4 system-ui;white-space:pre-line;overflow:hidden;overflow-wrap:anywhere;color:#e2eef1;'>{{data.tools}}</div></div><div style='min-width:0;margin-top:2.7cqw;'><div style='font:800 clamp(9px,1.7cqw,13px)/1.15 system-ui;letter-spacing:.08em;text-transform:uppercase;color:#8fe9cf;opacity:.9'>Policy reference</div><div style='font:500 clamp(12px,2.8cqw,20px)/1.4 system-ui;white-space:pre-line;overflow:hidden;overflow-wrap:anywhere;color:#e2eef1;'>{{data.policyRef}}</div></div><div style='min-width:0;margin-top:2.7cqw;'><div style='font:800 clamp(9px,1.7cqw,13px)/1.15 system-ui;letter-spacing:.08em;text-transform:uppercase;color:#8fe9cf;opacity:.9'>Run record destination</div><div style='font:500 clamp(12px,2.8cqw,20px)/1.4 system-ui;white-space:pre-line;overflow:hidden;overflow-wrap:anywhere;color:#e2eef1;'>{{data.runRecordRef}}</div></div><div style='min-width:0;margin-top:2.7cqw;'><div style='font:800 clamp(9px,1.7cqw,13px)/1.15 system-ui;letter-spacing:.08em;text-transform:uppercase;color:#8fe9cf;opacity:.9'>Inputs</div><div style='font:500 clamp(12px,2.8cqw,20px)/1.4 system-ui;white-space:pre-line;overflow:hidden;overflow-wrap:anywhere;color:#e2eef1;'>{{data.inputs}}</div></div><div style='min-width:0;margin-top:2.7cqw;'><div style='font:800 clamp(9px,1.7cqw,13px)/1.15 system-ui;letter-spacing:.08em;text-transform:uppercase;color:#8fe9cf;opacity:.9'>Outputs</div><div style='font:500 clamp(12px,2.8cqw,20px)/1.4 system-ui;white-space:pre-line;overflow:hidden;overflow-wrap:anywhere;color:#e2eef1;'>{{data.outputs}}</div></div><div style='min-width:0;margin-top:2.7cqw;'><div style='font:800 clamp(9px,1.7cqw,13px)/1.15 system-ui;letter-spacing:.08em;text-transform:uppercase;color:#8fe9cf;opacity:.9'>Execution mode</div><div style='font:500 clamp(12px,2.8cqw,20px)/1.4 system-ui;white-space:pre-line;overflow:hidden;overflow-wrap:anywhere;color:#e2eef1;'>{{data.mode}}</div></div><div style='