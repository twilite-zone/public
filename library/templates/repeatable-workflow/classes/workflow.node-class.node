          "graphId": "workflow-class"
        },
        "title": "Description and rationale",
        "body": "A Workflow describes how a question is answered. The linked workflow-question node defines the question and its independent answer contract. Workflow Step and Gate nodes implement the procedure. The run record must state whether the question was resolved, unresolved or blocked, independently of the sequence outcome.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          }
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
