    {
      "id": "workflow-class-derive-method",
      "type": "method",
      "label": "Derive the class",
      "position": {
        "x": 1560,
        "y": 2040
      },
      "width": 420,
      "height": 300,
      "visible": true,
      "showLabel": true,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "portId": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "portId": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "data": {
        "scriptName": "Refresh exposed views",
        "source": "// Derives the node class this graph describes, from its Properties and its rows, and keeps everything the class shows current:\n//   - the class itself, on the Declaration (key, label, meaning, required keys, and the defaults every new node starts with),\n//   - the views every node of the class shows: detail, summary and icon, as templates over the node's data, and its editor,\n//   - the page this graph opens on, which lists the class and draws a specimen of it.\n// Every Handler in the graph calls this one Method, so what the class says is always what its rows say. It writes only the\n// nodes its declared effects name.\n\nconst clean = (value) => String(value ?? '').trim();\nconst isObject = (value) => Boolean(value && typeof value === 'object' && !Array.isArray(value));\nconst escapeXml = (value) => String(value ?? '').replace(/[&<>\"']/g, (character) => ({\n  '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&apos;'\n})[character]);\n\nconst nodes = await api.getNodes();\nconst byId = (id) => nodes.find((node) => node?.id === id);\nconst bindingKey = (node) => clean(node?.type).toLowerCase();\nconst rowsOf = (key) => nodes.filter((node) => bindingKey(node) === key || clean(node?.type).toLowerCase() === key);\n\n// --- Properties ----------------------------------------------------------------------------------------------------------\nconst properties = {};\nfor (const node of nodes) {\n  if (bindingKey(node) !== 'property' && clean(node?.type).toLowerCase() !== 'property') continue;\n  const data = node.data || {};\n  const name = clean(data.name);\n  if (!name) continue;\n  if (Object.hasOwn(data, 'value') && data.value !== undefined) properties[name] = data.value;\n  else if (Object.hasOwn(data, 'defaultValue') && data.defaultValue !== undefined) properties[name] = data.defaultValue;\n}\nconst key = clean(properties.key);\nif (!key) return { updated: [], skipped: 'The class has no key yet' };\nconst label = clean(properties.label) || key;\nconst meaning = clean(properties.meaning);\nconst number = (value, fallback) => { const parsed = Number(value); return Number.isFinite(parsed) && parsed > 0 ? Math.round(parsed) : fallback; };\nconst size = { width: number(properties.width, 420), height: number(properties.height, 260) };\nconst glyphName = clean(properties.glyph) || 'Article';\nconst declaration = nodes.find((node) => node?.type === 'root');\nconst classRef = clean(declaration?.data?.document?.url);\n\n// --- Rows ------------------------------------------------------------------------------------------------------------------\nconst toBoolean = (value) => ['true', 'yes', '1', 'on'].includes(clean(value).toLowerCase()) || value === true;\nconst FIELD_TYPES = ['text', 'multiline', 'number', 'boolean', 'select'];\nconst humanize = (name) => clean(name).replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/[-_.]+/g, ' ').replace(/^./, (c) => c.toUpperCase());\nconst optionList = (value) => clean(value).split(',').map(clean).filter(Boolean);\nconst fields = rowsOf('class-field-row').map((node) => {\n  const data = node.data || {};\n  const name = clean(data.name);\n  const type = FIELD_TYPES.includes(clean(data.fieldType)) ? clean(data.fieldType) : 'text';\n  return { name, label: clean(data.label) || humanize(name), type, required: toBoolean(data.required), defaultValue: data.defaultValue, options: optionList(data.options), description: clean(data.description) };\n}).filter((field) => field.name);\nconst coerce = (field) => {\n  const raw = field.defaultValue;\n  if (field.type === 'number') { const parsed = Number(raw); return Number.isFinite(parsed) ? parsed : 0; }\n  if (field.type === 'boolean') return toBoolean(raw);\n  return clean(raw);\n};\nconst SIDE_ANGLE = { top: 270, right: 0, bottom: 90, left: 180 };\nconst ports = rowsOf('class-port-row').map((node) => {\n  const data = node.data || {};\n  const id = clean(data.portId);\n  const side = SIDE_ANGLE[clean(data.side)] !== undefined ? clean(data.side) : 'top';\n  const offset = Number.isFinite(Number(data.offset)) ? Math.max(0, Math.min(1, Number(data.offset))) : 0.5;\n  const accepts = clean(data.acceptsEdgeClasses).split(',').map(clean).filter(Boolean);\n  return {\n    id, key: id, label: clean(data.label) || id,\n    direction: ['input', 'output', 'bidirectional'].includes(clean(data.direction)) ? clean(data.direction) : 'bidirectional',\n    dataType: clean(data.dataType) || 'any', angle: SIDE_ANGLE[side], position: { side, offset },\n    ...(accepts.length ? { allowedEdgeTypes: accepts } : {})\n  };\n}).filter((port) => port.id);\nconst events = rowsOf('class-event-row').map((node) => {\n  const data = node.data || {};\n  return { eventKey: clean(data.eventKey), label: clean(data.label) || clean(data.eventKey), payloadContract: { type: 'object' } };\n}).filter((event) => event.eventKey);\n\n// --- The class -------------------------------------------------------------------------------------------------------------\nconst defaultData = Object.fromEntries(fields.map((field) => [field.name, coerce(field)]));\nconst defaults = {\n  label, size, showLabel: false,\n  data: { ...defaultData, presentation: { glyph: { kind: 'icon', name: glyphName } } },\n  ports, events\n};\nconst nodeClass = {\n  contractVersion: '1.0.0', key, label, meaning,\n  requiredDataKeys: fields.filter((field) => field.required).map((field) => field.name),\n  nodeDef: { key, ref: classRef, source: 'github', version: '>=0.1.0', defaults }\n};\n\n// --- What a node of the class shows ------------------------------------------------------------------------------------------\nconst renderClassViews = function renderClassViews({key,label,fields}){\n const esc=value=>String(value??\"\").replace(/[&<>\"']/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c]));\n const slot=name=>\"{{data.\"+name+\"}}\";\n const configurations={\n  workflow:{tag:\"PROCESS\",accent:\"#8fe9cf\",bg:\"#113644\",line:\"#40777e\",glyph:\"◈\",detail:['purpose','trigger','resources','tools','policyRef','runRecordRef','inputs','outputs','mode','status'],summary:[\"purpose\",\"status\"],tone:\"teal\"},\n  \"workflow-step\":{tag:\"WORKFLOW STEP\",accent:\"#91d4ff\",bg:\"#143b55\",line:\"#377894\",glyph:\"◆\",detail:[\"phase\",\"instruction\",\"authority\",\"inputs\",\"outputs\",\"onFailure\"],summary:[\"phase\",\"instruction\"],tone:\"blue\"},\n  \"workflow-gate\":{tag:\"SAFETY GATE\",accent:\"#f2c786\",bg:\"#39294d\",line:\"#987cba\",glyph:\"◇\",detail:[\"gateType\",\"requirement\",\"decision\",\"evidence\",\"authority\",\"onFailure\"],summary:[\"gateType\",\"decision\",\"requirement\"],tone:\"violet\"}\n };\n const cfg=configurations[key]||configurations.workflow;\n const map=Object.fromEntries(fields.map(f=>[f.name,f]));\n const titleName=map.title?\"title\":fields[0]?.name;\n const title=titleName?slot(titleName):esc(label);\n const row=(name,compact=false)=>{\n   const f=map[name];if(!f)return \"\";\n   return `<div style='min-width:0;${compact?\"margin-top:2.2cqw;\":\"margin-top:2.7cqw;\"}'><div style='font:800 clamp(9px,1.7cqw,13px)/1.15 system-ui;letter-spacing:.08em;text-transform:uppercase;color:${cfg.accent};opacity:.9'>${esc(f.label||name)}</div><div style='font:500 clamp(12px,2.8cqw,20px)/1.4 system-ui;white-space:pre-line;overflow:hidden;overflow-wrap:anywhere;color:#e2eef1;${compact?\"display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;\":\"\"}'>${slot(name)}</div></div>`;\n };\n const wrap=(contents,compact=false)=>`<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:hidden;padding:${compact?\"5cqw\":\"4.7cqw\"};background:${cfg.bg};border:${compact?\"1px\":\"2px\"} solid ${cfg.line};border-radius:19px;color:white;font-family:system-ui'><div style='display:flex;align-items:center;gap:2cqw;justify-content:space-between'><span style='font:800 clamp(9px,1.6cqw,15px)/1.2 system-ui;letter-spacing:.13em;color:${cfg.accent}'>${cfg.tag}</span><span style='width:2.4cqw;height:2.4cqw;min-width:8px;min-height:8px;border-radius:50%;background:${cfg.accent}'></span></div>${contents}</div>`;\n const heading=(compact=false)=>`<div style='font:650 clamp(18px,${compact?\"6.7cqw\":\"5.3cqw\"},32px)/1.12 Georgia,serif;letter-spacing:-.02em;overflow-wrap:anywhere;margin-top:${compact?\"4.1cqw\":\"3.4cqw\"};display:-webkit-box;-webkit-line-clamp:${compact?\"2\":\"3\"};-webkit-box-orient:vertical;overflow:hidden'>${title}</div>`;\n const detail=wrap(heading(false)+cfg.detail.map(n=>row(n,false)).join(\"\"),false);\n // Summary: the title owns the flexible center of the card; the important description\n // has a full-width bottom band, while phase/status/decision move into the compact header.\n // This retains every field selected by cfg.summary without stacking tiny labeled rows.\n const summaryLead = key === \"workflow\" ? \"purpose\" : key === \"workflow-step\" ? \"instruction\" : \"requirement\";\n const summaryMeta = cfg.summary.filter(n => n !== summaryLead && map[n]);\n const summaryMetaHtml = summaryMeta.map(n => `<span style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${slot(n)}</span>`).join(\"<span aria-hidden='true' style='opacity:.5'>·</span>\");\n const summary=`<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:hidden;padding:4cqw;background:${cfg.bg};border:1px solid ${cfg.line};border-radius:18px;color:white;font-family:system-ui;display:flex;flex-direction:column;gap:2cqw'>`\n   + `<div style='display:flex;align-items:center;justify-content:space-between;gap:2cqw;min-height:0'><span style='flex:0 0 auto;font:800 clamp(9px,2.8cqw,12px)/1.15 system-ui;letter-spacing:.07em;color:${cfg.accent}'>${cfg.tag}</span><span style='min-width:0;display:flex;align-items:center;justify-content:flex-end;gap:1cqw;font:750 clamp(9px,2.9cqw,12px)/1.2 system-ui;color:${cfg.accent};text-transform:uppercase'>${summaryMetaHtml}</span></div>`\n   + `<div style='flex:0 0 auto;font:650 clamp(15px,5.2cqw,22px)/1.15 Georgia,serif;letter-spacing:-.015em;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'>${title}</div>`\n   + `<div style='flex:1;min-height:0;display:flex;flex-direction:column;border-top:1px solid ${cfg.line};padding-top:1.7cqw'><div style='flex:0 0 auto;font:800 clamp(9px,2.55cqw,11px)/1.15 system-ui;letter-spacing:.065em;color:${cfg.accent};text-transform:uppercase'>${esc(map[summaryLead]?.label||summaryLead)}</div><div style='margin-top:.6cqw;flex:1;min-height:0;font:520 clamp(12px,3.9cqw,16px)/1.35 system-ui;color:#e2eef1;white-space:pre-line;overflow-wrap:anywhere;overflow:hidden;-webkit-mask-image:linear-gradient(#000 80%,transparent);mask-image:linear-gradient(#000 80%,transparent)'>${slot(summaryLead)}</div></div></div>`;\n // Icon: a genuinely vector-led tile. SVG draws the identity mark, lines, and\n // background; the instance title is a lightweight HTML overlay for reliable wrapping.\n // (Native SVG inline-size text wrapping is not reliably implemented in browsers.)\n const glyphArt = key === \"workflow\"\n   ? \"<path d='M0 -54 L53 0 L0 54 L-53 0 Z' fill='none' stroke='\"+cfg.accent+\"' stroke-width='7' stroke-linejoin='round' opacity='.9'/><path d='M0 -32 L31 0 L0 32 L-31 0 Z' fill='\"+cfg.accent+\"' fill-opacity='.28' stroke='\"+cfg.accent+\"' stroke-opacity='.82' stroke-width='4'/><circle cx='0' cy='0' r='7' fill='\"+cfg.accent+\"'/>\"\n   : key === \"workflow-step\"\n   ? \"<path d='M0 -54 L54 0 L0 54 L-54 0 Z' fill='\"+cfg.accent+\"' fill-opacity='.26' stroke='\"+cfg.accent+\"' stroke-width='6' stroke-linejoin='round'/><path d='M-25 0 H25 M9 -16 L26 0 L9 16' fill='none' stroke='#f7fcff' stroke-width='7' stroke-linecap='round' stroke-linejoin='round'/>\"\n   : \"<path d='M0 -55 L55 0 L0 55 L-55 0 Z' fill='\"+cfg.accent+\"' fill-opacity='.16' stroke='\"+cfg.accent+\"' stroke-width='7' stroke-linejoin='round'/><path d='M-24 1 L-7 18 L25 -18' fill='none' stroke='#fff4df' stroke-width='8' stroke-linecap='round' stroke-linejoin='round'/>\";\n const icon = `<div style='container-type:inline-size;position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;border:1px solid ${cfg.line};border-radius:14px;background:${cfg.bg};color:#f7fbff;font-family:system-ui'>`\n   + `<svg xmlns='http://www.w3.org/2000/svg' aria-hidden='true' viewBox='0 0 320 198' width='100%' height='100%' preserveAspectRatio='xMaxYMid slice' style='position:absolute;inset:0;display:block'>`\n   + `<rect width='320' height='198' fill='${cfg.bg}'/><path d='M0 46 H320 M0 49 H320' fill='none' stroke='${cfg.line}' stroke-width='1.5' opacity='.45'/>`\n   \n   + `<g transform='translate(246 73)'>${glyphArt}</g></svg>`\n   + `<div style='position:absolute;left:5.2cqw;top:4.2cqw;right:30cqw;font:800 clamp(10px,6.8cqw,48px)/1.15 system-ui;letter-spacing:.09em;color:${cfg.accent};white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${cfg.tag}</div>`\n   + `<div style='position:absolute;left:0;right:0;bottom:0;box-sizing:border-box;height:59%;padding:2cqw 5cqw 3cqw;display:flex;align-items:center;background:rgba(6,26,37,.84);border-top:1px solid ${cfg.accent}'>`\n   + `<div style='width:100%;font:800 clamp(17px,10cqw,60px)/1.05 system-ui;letter-spacing:-.025em;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${title}</div></div></div>`;\n return {detail,summary,icon};\n};\nconst authoredViews = renderClassViews({key,label,fields});\nconst detailHtml = authoredViews.detail;\nconst summaryHtml = authoredViews.summary;\nconst iconHtml = authoredViews.icon;\nconst EDITOR_TYPES = { text: 'text', multiline: 'textarea', number: 'number', boolean: 'checkbox', select: 'select' };\nconst editor = { web: { fields: [\n  { key: 'label', label: 'Label', type: 'text', path: 'label' },\n  ...fields.map((field) => ({\n    key: field.name, label: field.label, type: field.type === 'select' && !field.options.length ? 'text' : EDITOR_TYPES[field.type], path: `data.${field.name}`,\n    ...(field.type === 'select' && field.options.length ? { options: field.options.map((value) => ({ label: humanize(value), value })) } : {}),\n    ...(field.description ? { placeholder: field.description } : {})\n  }))\n] } };\n\n// --- The page this graph opens on --------------------------------------------------------------------------------------------\n// The page reads as an article: a nameplate, the label as the headline and the meaning as the standfirst, then a specimen\n// of the class at its three sizes. The authored page sections are the body, in graph order. The technical details sit\n// around them: Settings beside the first section, the required fields set large, the fields as a ruled table, and the\n// ports and events beside the second section. Sizes follow the view's own width.\nconst fill = (html) => html.replace(/\\{\\{data\\.([^}]+)\\}\\}/g, (_, name) => escapeXml(defaultData[name] ?? ''));\nconst SERIF = 'Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif';\nconst MONO = 'ui-monospace,Cascadia Code,Consolas,monospace';\nconst ACCENT = '#0f766e';\nconst KICKER = 'font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase';\nconst heading2 = (text, color = ACCENT) => `<h2 style='margin:0 0 14px;${KICKER};color:${color}'>${escapeXml(text)}</h2>`;\nconst paragraphs = (value, dropCap) => clean(value).split(/\\n{2,}/).map((part) => part.trim()).filter(Boolean)\n  .map((part, index) => {\n    const cap = dropCap && index === 0 && /^[A-Za-z]/.test(part);\n    return `<p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 ${SERIF};color:#1e293b'>`\n      + (cap ? `<span style='float:left;padding:6px 10px 0 0;font:500 68px/54px ${SERIF};color:#0f172a'>${part[0]}</span>` : '')\n      + `${escapeXml(cap ? part.slice(1) : part).replace(/\\n/g, '<br>')}</p>`;\n  }).join('');\nconst caption = (number, text) => `<figcaption style='margin-top:10px;font:400 13px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>Fig. ${number}</b> &nbsp;${escapeXml(text)}</figcaption>`;\nconst note = (text) => `<p style='margin:0;font:400 14px/1.5 system-ui;color:#475569'>${escapeXml(text)}</p>`;\nconst settings = [['Key', key], ['Label', label], ['Size', `${size.width} by ${size.height}`], ['Glyph', glyphName], ['Required fields', nodeClass.requiredDataKeys.join(', ') || 'none']]\n  .filter(([, value]) => clean(value));\n// A short value sits beside its name; a long one runs underneath it at the full width of the list.\nconst settingsList = settings.map(([name, value]) => {\n  const wide = clean(value).length > 24;\n  const span = wide ? 'grid-column:1/-1;' : '';\n  return `<dt style='${span}padding:9px 0 ${wide ? 0 : 9}px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>${escapeXml(name)}</dt>`\n    + `<dd style='${span}margin:0;padding:${wide ? '2px 0 9px' : '9px 0;border-top:1px solid #cbd5e1;text-align:right'};font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>${escapeXml(value)}</dd>`;\n}).join('');\nconst SIDE = 'flex:1 1 220px;min-width:0;padding-top:10px;border-top:3px solid #0f172a';\nconst settingsSide = `<aside style='${SIDE}'>${heading2('Settings', '#0f172a')}`\n  + `<dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid #cbd5e1'>${settingsList}</dl></aside>`;\nconst sideEntry = (name, detail) => `<div style='margin:0 0 12px'><div style='font:600 14px/20px ${MONO};color:#0f172a'>${escapeXml(name)}</div><div style='font:400 13px/20px system-ui;color:#475569'>${escapeXml(detail)}</div></div>`;\nconst connectionsSide = `<aside style='${SIDE}'>${heading2('Ports', '#0f172a')}`\n  + (ports.length ? ports.map((port) => sideEntry(port.id, `${port.direction} · ${port.position.side} at ${port.position.offset} · ${(port.allowedEdgeTypes || ['any edge']).join(', ')}`)).join('') : note('No ports yet. Add a port row.'))\n  + `<div style='margin-top:6px;padding-top:14px;border-top:1px solid #cbd5e1'>${heading2('Events', '#0f172a')}`\n  + (events.length ? events.map((event) => sideEntry(event.eventKey, event.label)).join('') : note('No events.')) + `</div></aside>`;\n// The class at its three sizes, each view filled with the values a new node starts with.\nconst specimenLabel = (text) => `<div style='margin-top:10px;font:700 11px/16px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#475569'>${escapeXml(text)}</div>`;\nconst specimen = `<figure style='margin:0'>${heading2('Specimen')}`\n  + `<div style='display:flex;flex-wrap:wrap;justify-content:center;align-items:flex-start;gap:24px;padding:28px 12px;border-radius:6px;background:#eef2f6'>`\n  + `<div style='max-width:100%'><div style='width:${Math.min(size.width, 460)}px;max-width:100%;height:${Math.min(size.height, 340)}px'>${fill(detailHtml)}</div>${specimenLabel(`Detail · ${size.width} by ${size.height}`)}</div>`\n  + `<div><div style='width:${Math.min(size.width, 300) / 1.4}px;height:${Math.min(size.height, 200) / 1.4}px'>${fill(summaryHtml)}</div>${specimenLabel('Summary')}`\n  + `<div style='margin-top:24px;width:120px;height:110px'>${fill(iconHtml)}</div>${specimenLabel('Icon')}</div></div>`\n  + `${caption(1, `A new ${label} at each of its three sizes, holding its starting values.`)}</figure>`;\n// The required fields, set large; the count and names of all the fields underneath.\nconst COUNT_WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];\nconst listOf = (items) => items.length > 1 ? `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}` : (items[0] || '');\nconst withArticle = (word) => `${/^[aeiou]/i.test(word) ? 'an' : 'a'} ${word}`;\nconst fieldWord = (field) => field.label.toLowerCase();\nconst requiredFields = fields.filter((field) => field.required);\nconst quoteLead = requiredFields.length\n  ? `Every ${label} needs ${listOf(requiredFields.map((field) => withArticle(fieldWord(field))))}.`\n  : `No field of ${withArticle(label)} is required.`;\nconst quoteRest = fields.length\n  ? `${COUNT_WORDS[fields.length] || fields.length} in all: ${listOf(fields.map(fieldWord))}.`\n  : 'None yet. Add a field row.';\nconst quote = `<blockquote style='margin:48px 0 0;padding:32px 0;border-top:1px solid #0f172a;border-bottom:1px solid #0f172a'>`\n  + `<p style='margin:0 0 12px;font:italic 500 clamp(30px,6.4cqw,46px)/1.1 ${SERIF};letter-spacing:-.015em;color:${ACCENT};text-wrap:balance'>${escapeXml(quoteLead)}</p>`\n  + `<p style='margin:0;font:400 14px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>The fields.</b> ${escapeXml(quoteRest)}</p></blockquote>`;\nconst TH = 'text-align:left;padding:10px 16px 10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a;font:800 12px/16px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#0f172a';\nconst TD = 'padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155';\nconst fieldRow = (field) => `<tr><td style='${TD};font:600 14px/20px ${MONO};color:#0f172a'>${escapeXml(field.name)}</td>`\n  + `<td style='${TD}'>${escapeXml(field.type + (field.options.length ? ` (${field.options.join(', ')})` : ''))}</td>`\n  + `<td style='${TD}${field.required ? ';font-weight:600;color:#0f172a' : ''}'>${field.required ? 'yes' : 'no'}</td>`\n  + `<td style='${TD}'>${escapeXml(clean(defaultData[field.name]) || '—')}</td></tr>`;\nconst fieldsFigure = `<figure style='margin:40px 0 0'>${heading2('Fields')}`\n  + (fields.length\n    ? `<div style='overflow-x:auto'><table style='border-collapse:collapse;width:100%;min-width:460px'><thead><tr>${['Field', 'Type', 'Required', 'Starts as'].map((cell) => `<th style='${TH}'>${cell}</th>`).join('')}</tr></thead><tbody>${fields.map(fieldRow).join('')}</tbody></table></div>`\n      + caption(2, 'What every node of the class holds, in the order its field rows sit in the graph.')\n    : note('No fields yet. Add a field row.')) + `</figure>`;\n// A sidebar and the text it sits beside. The sidebar comes first, so in a narrow view it stacks above the text.\nconst pageRow = (side, main) => `<div style='display:flex;flex-wrap:wrap;flex-direction:row-reverse;align-items:flex-start;gap:32px 40px;padding-top:44px'>${side}<div style='flex:999 1 380px;min-width:0'>${main}</div></div>`;\nconst sides = [settingsSide, connectionsSide];\nconst blocks = nodes.filter((node) => bindingKey(node) === 'page-section').map((node, index) => {\n  const body = `<section>${heading2(node.data?.title)}${paragraphs(node.data?.body, index === 0)}</section>`;\n  return index < sides.length ? pageRow(sides[index], body) : `<div style='padding-top:44px'>${body}</div>`;\n});\nfor (let index = blocks.length; index < sides.length; index += 1) blocks.push(pageRow(sides[index], ''));\nblocks.splice(1, 0, quote, fieldsFigure);\nconst page = `<div style='min-height:100%;box-sizing:border-box;container-type:inline-size;background:#ffffff;font-family:${SERIF};color:#0f172a'>`\n  + `<div style='box-sizing:border-box;max-width:900px;margin:0 auto;padding:32px clamp(20px,5cqw,40px) 64px'>`\n  + `<div style='padding:10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a;font:800 12px/16px system-ui;letter-spacing:.18em;color:${ACCENT}'>NODE CLASS · ${escapeXml(key)}</div>`\n  + `<header style='padding:40px 0 32px'>`\n  + `<h1 style='margin:0;font:500 clamp(40px,9.5cqw,72px)/.98 ${SERIF};letter-spacing:-.025em;text-wrap:balance;color:#0f172a'>${escapeXml(label)}</h1>`\n  + (meaning ? `<p style='margin:18px 0 0;max-width:38ch;font:italic 400 clamp(20px,3.6cqw,26px)/1.35 ${SERIF};color:#475569'>${escapeXml(meaning)}</p>` : '') + `</header>`\n  + specimen + blocks.join('') + `</div></div>`;\n\n// --- Write only what changed the effects name -------------------------------------------------------------------------------\nconst edges = await api.getEdges();\nconst targetOf = (handle) => edges.find((edge) => edge.source === declaration?.id && (edge.sourcePort === handle || edge.type === handle))?.target;\nconst portNode = (id) => byId(id);\nconst updated = [];\nconst write = async (id, data) => { if (!id || !byId(id)) return; await api.updateNode(id, { data: { ...(byId(id).data || {}), ...data } }); updated.push(id); };\nawait write(declaration?.id, { nodeClass });\n// The views a node of the class shows are the Views of the graph's Surface, in order: detail, then summary, then icon.\nconst roleOf = (edge) => clean(edge.type);\nconst nextView = (fromId) => edges.find((edge) => edge.source === fromId && roleOf(edge) === 'next-face')?.target;\nconst isView = (id) => clean(byId(id)?.type) === 'face';\nconst detailId = edges.find((edge) => edge.source === declaration?.id && roleOf(edge) === 'surface')?.target;\nconst summaryId = isView(detailId) ? nextView(detailId) : '';\nconst iconId = isView(summaryId) ? nextView(summaryId) : '';\nconst editorId = nodes.find((node) => clean(node?.type) === 'face' && clean(node.data?.view?.intent) === 'editor')?.id;\nif (isView(detailId)) await write(detailId, { content: { kind: 'html', value: detailHtml } });\nif (isView(summaryId)) await write(summaryId, { content: { kind: 'html', value: summaryHtml } });\nif (isView(iconId)) await write(iconId, { content: { kind: 'html', value: iconHtml } });\nawait write(editorId, { editor });\nawait write(targetOf('ground'), { content: { kind: 'html', value: page } });\nreturn { updated, key, fields: fields.length, ports: ports.length, events: events.length };\n",
        "parameters": [],
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "workflow-class-declaration",
              "workflow-class-detail",
              "workflow-class-summary",
              "workflow-class-icon",
              "workflow-class-editor",
              "workflow-class-landing"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false
      }
    },
    {
      "id": "workflow-class-environment",
      "type": "face",
      "label": "Node class environment",
      "position": {
        "x": 0,
        "y": 300
      },
      "width": 400,
      "height": 240,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "workflow-class"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.environment"
        },
