      "data": {
        "identity": {
          "graphId": "workflow-step-class"
        },
        "title": "Evidence",
        "body": "Private prototype generated from the current public Node Class Template. Structural checks performed; editor rendering and runtime binding must be tested in Twilite before canon promotion.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          }
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
