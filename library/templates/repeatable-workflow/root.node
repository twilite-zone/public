      },
      "width": 520,
      "height": 300,
      "showLabel": true,
      "visible": true,
      "data": {
        "identity": {
          "graphId": "repeatable-workflow",
          "nodeId": "repeatable-workflow-export"
        },
        "bridge": {
          "ref": "tlz://twilite.zone/library/templates/repeatable-workflow/root.node",
          "resourceKind": "graph",
          "scope": "focused-graph",
          "grants": [
