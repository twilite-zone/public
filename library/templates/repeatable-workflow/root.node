        "instruction": "Begin only on a named manual request; bind the Workflow Question and capture run ID and input values. The Question is the objective; stage completion alone is not success.",
        "inputs": "runId\ninputs",
        "outputs": "runContext",
        "authority": "read-only",
        "onFailure": "Stop and record the reason for failure.",
