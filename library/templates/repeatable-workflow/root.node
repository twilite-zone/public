    {
      "id": "repeatable-workflow-preflight-method",
      "type": "method",
      "label": "Validate workflow and build agent run plan",
      "position": {
        "x": 2760,
        "y": 2050
      },
      "width": 550,
      "height": 330,
      "showLabel": true,
      "visible": true,
      "data": {
        "scriptName": "Workflow and Question preflight v1.2",
        "parameters": [],
        "source": "// Shared workflow contract v1.2.0. Runs against the CONSUMER graph through its template Bridge.\n// Preflight is deliberately read-only: it returns an ordered plan, never calls tools, never\n// uses a gate's saved decision as authority, and never writes/publishes anything.\nconst clean = (v) => String(v == null ? '' : v).trim();\nconst lines = (v) => clean(v).split(/\\r?\\n/).map(clean).filter(Boolean);\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst byId = new Map(nodes.map((node) => [node.id, node]));\nconst errors = [];\nconst warnings = [];\nconst fail = (code, message) => errors.push({ code, message });\nconst warn = (code, message) => warnings.push({ code, message });\nconst stageTypes = new Set(['workflow-step', 'workflow-gate']);\n// A single Workflow owns the Step/Gate nodes in this graph. No redundant membership edges.\nconst sequence = (e) => (clean(e.type) === 'workflow.next' || clean(e.data?.edgeClassKey) === 'workflow.next')\n  && clean(e.sourcePort) === 'next' && clean(e.targetPort) === 'previous';\nconst workflows = nodes.filter((node) => clean(node.type) === 'workflow');\nif (workflows.length !== 1) fail('WORKFLOW_COUNT', 'Exactly one Workflow instance is required, found ' + workflows.length);\nconst workflow = workflows[0] || null;\n// The Question states what must be answered. The Workflow states how to try.\nconst questionNodes = nodes.filter((node) => clean(node.type) === 'workflow-question');\nconst questionId = clean(workflow?.data?.questionId);\nconst questionRequired = workflow?.data?.questionRequired === true;\nlet questionContract = null;\nlet questionContractReady = false;\nif (!questionId) {\n  if (questionRequired || questionNodes.length) fail('QUESTION_REF_MISSING', 'Workflow needs a questionId pointing to one workflow-question node');\n  else if (workflow) warn('QUESTION_UNBOUND_LEGACY', 'Legacy workflow lacks a Question/answer contract; migrate before calling its answer verified');\n} else {\n  const questionNode = byId.get(questionId);\n  if (!questionNode || clean(questionNode.type) !== 'workflow-question') {\n    fail('QUESTION_REF_INVALID', 'questionId must point to a workflow-question in the current graph');\n  } else {\n    if (questionNodes.length !== 1) fail('QUESTION_COUNT', 'Exactly one workflow-question node is expected in a single-Workflow graph');\n    const d = questionNode.data || {};\n    for (const field of ['title', 'question', 'answerKind', 'answerSchema', 'completion', 'onUnresolved'])\n      if (!clean(d[field])) fail('QUESTION_FIELD_MISSING', 'Question must define ' + field);\n    const evidence = lines(d.requiredEvidence);\n    if (!evidence.length) fail('QUESTION_EVIDENCE_MISSING', 'Question must name required evidence');\n    let schema = null;\n    try { schema = JSON.parse(clean(d.answerSchema)); }\n    catch (_) { fail('ANSWER_SCHEMA_JSON', 'Question answerSchema must contain valid JSON'); }\n    if (schema && (typeof schema !== 'object' || Array.isArray(schema) || !['object', 'array', 'string'].includes(schema.type)))\n      fail('ANSWER_SCHEMA_SHAPE', 'answerSchema must be a JSON object with type object, array, or string');\n    if (schema?.type === 'object' && (!schema.properties || typeof schema.properties !== 'object' || !Array.isArray(schema.required)))\n      fail('ANSWER_SCHEMA_SHAPE', 'Object answerSchema must declare properties and required field names');\n    questionContract = {\n      id: questionNode.id, title: clean(d.title), question: clean(d.question),\n      answerKind: clean(d.answerKind), answerSchema: schema,\n      requiredEvidence: evidence, completion: clean(d.completion),\n      onUnresolved: clean(d.onUnresolved),\n      resultStatuses: ['resolved', 'unresolved', 'blocked']\n    };\n    questionContractReady = !errors.some((error) => error.code.startsWith('QUESTION_') || error.code.startsWith('ANSWER_SCHEMA_'));\n  }\n}\nconst id = workflow?.id || '';\nconst title = clean(workflow?.data?.title);\nconst status = clean(workflow?.data?.status);\nif (workflow && !title) fail('WORKFLOW_TITLE', 'Give the Workflow instance a title');\nconst resourceLines = lines(workflow?.data?.resources);\nconst resources = [];\nconst aliases = new Set();\nfor (const line of resourceLines) {\n  const sep = line.indexOf('=');\n  const alias = sep < 0 ? '' : clean(line.slice(0, sep));\n  const ref = sep < 0 ? '' : clean(line.slice(sep + 1));\n  if (!/^[A-Za-z][A-Za-z0-9_-]*$/.test(alias) || !/^(github:\\/\\/|tlz:\\/\\/|https:\\/\\/)/i.test(ref)) {\n    fail('RESOURCE_FORMAT', 'Expected alias = github://..., tlz://..., or https://...: ' + line.slice(0, 120));\n    continue;\n  }\n  if (aliases.has(alias)) fail('RESOURCE_DUPLICATE', 'Repeated resource alias: ' + alias);\n  aliases.add(alias);\n  resources.push({ alias, ref });\n}\nconst tools = lines(workflow?.data?.tools);\nconst toolNames = new Set(tools);\nfor (const [field, value] of [['policyRef', workflow?.data?.policyRef], ['runRecordRef', workflow?.data?.runRecordRef]]) {\n  const ref = clean(value);\n  if (ref && !/^(github:\\/\\/|tlz:\\/\\/|https:\\/\\/)/i.test(ref))\n    fail('REFERENCE_FORMAT', field + ' must be a complete github://, tlz:// or https:// address');\n}\nconst members = nodes.filter((node) => stageTypes.has(clean(node.type)));\nconst memberIds = new Set(members.map((stage) => stage.id));\nif (workflow && !members.length) fail('EMPTY_WORKFLOW', 'A workflow must have at least one Step or Gate');\nif (memberIds.size !== members.length) fail('STAGE_ID_DUPLICATE', 'All stages must have unique IDs');\nconst startStepId = clean(workflow?.data?.startStepId);\nif (workflow && !startStepId) fail('START_REF_MISSING', 'Workflow must declare a startStepId');\nif (startStepId && !memberIds.has(startStepId)) fail('START_REF_INVALID', 'startStepId must identify a Step or Gate in this graph');\nconst sequenceEdges = edges.filter(sequence);\nconst incoming = new Map();\nconst outgoing = new Map();\nfor (const edge of sequenceEdges) {\n  const a = byId.get(edge.source), b = byId.get(edge.target);\n  if (!a || !b || !stageTypes.has(a.type) || !stageTypes.has(b.type)) { fail('SEQUENCE_KIND', 'An ordered stage edge has an invalid endpoint'); continue; }\n  if (!memberIds.has(a.id) || !memberIds.has(b.id)) { fail('SEQUENCE_STAGE', 'An ordered edge points outside the Workflow stages'); continue; }\n  if (outgoing.has(a.id)) fail('SEQUENCE_BRANCH', 'Multiple success paths from ' + a.id);\n  if (incoming.has(b.id)) fail('SEQUENCE_MERGE', 'Multiple incoming stages to ' + b.id);\n  outgoing.set(a.id, b.id);\n  incoming.set(b.id, a.id);\n}\nconst starts = members.filter((n) => n && !incoming.has(n.id));\nif (workflow && starts.length !== 1) fail('SEQUENCE_START', 'Expected one start stage, found ' + starts.length);\nif (startStepId && incoming.has(startStepId)) fail('START_HAS_INCOMING', 'The declared start must not have an incoming workflow.next edge');\nif (startStepId && starts.length === 1 && starts[0].id !== startStepId) fail('START_REF_MISMATCH', 'The declared start does not match the first stage of the sequence');\nconst ordered = [], visited = new Set();\nlet current = startStepId && memberIds.has(startStepId) ? byId.get(startStepId) : null;\nwhile (current && !visited.has(current.id) && ordered.length <= nodes.length) {\n  visited.add(current.id);\n  ordered.push(current);\n  current = byId.get(outgoing.get(current.id));\n}\nif (current) fail('SEQUENCE_CYCLE', 'The stage path contains a cycle');\nif (workflow && ordered.length !== memberIds.size) fail('SEQUENCE_DISCONNECTED', 'One or more stages are not reachable from the start');\nconst validAuthorities = new Set(['read-only', 'private-draft', 'record-only', 'approved-write', 'owner-approval-required']);\nlet ownerGateSeen = false;\nconst stages = [];\nfor (const stage of ordered) {\n  const d = stage.data || {}, kind = stage.type, authority = clean(d.authority) || 'read-only';\n  if (!validAuthorities.has(authority)) fail('AUTHORITY_UNKNOWN', 'Unknown authority at ' + stage.id);\n  if (kind === 'workflow-step' && !clean(d.instruction)) fail('STEP_INSTRUCTION', 'Missing instruction at ' + stage.id);\n  if (kind === 'workflow-gate') {\n    if (!clean(d.requirement)) fail('GATE_REQUIREMENT', 'Missing gate requirement at ' + stage.id);\n    if (!clean(d.evidence)) warn('GATE_EVIDENCE', 'No evidence specified for ' + stage.id);\n    if (clean(d.gateType) === 'owner-approval') ownerGateSeen = true;\n  }\n  if (authority === 'approved-write' && !ownerGateSeen)\n    fail('WRITE_WITHOUT_GATE', 'An approved-write stage must follow an owner-approval gate: ' + stage.id);\n  if (authority === 'approved-write' && !clean(d.tool)) warn('WRITE_TOOL_UNDECLARED', 'Name the tool for ' + stage.id);\n  if (clean(d.tool) && !toolNames.has(clean(d.tool))) fail('TOOL_UNDECLARED', 'Tool ' + clean(d.tool) + ' is not declared in the Workflow');\n  stages.push({\n    id: stage.id, kind, title: clean(d.title || stage.label),\n    phase: clean(d.phase), gateType: clean(d.gateType),\n    instruction: kind === 'workflow-step' ? clean(d.instruction) : clean(d.requirement),\n    inputs: lines(d.inputs), outputs: lines(d.outputs), tool: clean(d.tool),\n    effects: lines(d.effects), evidence: lines(d.evidence),\n    authority, onFailure: clean(d.onFailure) || 'Stop and record the reason',\n    nextId: outgoing.get(stage.id) || null,\n    gateDecisionIsNotPermission: kind === 'workflow-gate'\n  });\n}\nif (workflow && !ownerGateSeen && ordered.some((n) => clean(n.data?.authority) === 'approved-write'))\n  fail('APPROVAL_GATE_MISSING', 'A workflow with approved writes needs an owner-approval gate');\nreturn {\n  contractVersion: '1.2.0',\n  workflowId: id,\n  title, status, startStepId,\n  questionId, questionContract, questionContractReady,\n  answerOutcomeContract: { statuses: ['resolved', 'unresolved', 'blocked'], independentOfProcedureStatus: true, requiredInRunRecord: true },\n  trigger: clean(workflow?.data?.trigger),\n  mode: clean(workflow?.data?.mode),\n  resources, tools,\n  policyRef: clean(workflow?.data?.policyRef),\n  runRecordRef: clean(workflow?.data?.runRecordRef),\n  inputs: lines(workflow?.data?.inputs),\n  outputs: lines(workflow?.data?.outputs),\n  stages, errors, warnings,\n  failureRecording: { required: true, on: 'every terminal outcome including gate failure', mode: 'out-of-band; not contingent on reaching the success-path record stage' },\n  structurallyValid: errors.length === 0,\n  rehearsalOnly: !['validated', 'live'].includes(status),\n  executionAuthority: 'none (the host and owner must separately authorize every operation)',\n  behavior: 'read-only structural and Question contract preflight; does not validate actual answers, execute stage instructions, resolve remote references, or publish anything'\n};",
        "allowMutations": false,
        "dryRun": true,
        "identity": {
          "graphId": "repeatable-workflow",
          "nodeId": "repeatable-workflow-preflight-method"
        },
        "effects": []
      }
    },
    {
      "id": "repeatable-workflow-export",
      "type": "export",
      "label": "Workflow Template · Shared Protocol",
      "position": {
        "x": 3340,
