      "data": {
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background:#10222c;color:#e8f2ed;font-family:system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;padding:4.2cqw 4.6cqw;display:flex;flex-direction:column'><div style='font:800 1.6cqw/1 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.2em;color:#74d5ba'>TWILITE · WORKFLOW TEMPLATE</div><div style='font:650 5.6cqw/1.08 Georgia,Iowan Old Style,Palatino Linotype,serif;letter-spacing:-.02em;margin-top:1.8cqw;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>Repeatable Workflow</div><div style='max-width:78cqw;font:400 2.3cqw/1.5 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#c3d5d4;margin-top:1.4cqw;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical'>A reusable agent-assisted process with a fail-closed approval gate.</div><div style='flex:1;min-height:0;margin-top:2.6cqw;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:min-content;gap:1.3cqw;align-content:start'><div style='min-width:0;box-sizing:border-box;background:#1b3d48;border:.2cqw solid #3c7c76;border-radius:1.6cqw;padding:1.4cqw 1.7cqw'><div style='font:700 1.55cqw/1.1 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.1em;color:#74d5ba'>01 · STEP</div><div style='font:650 2.5cqw/1.15 Georgia,Iowan Old Style,Palatino Linotype,serif;margin-top:.6cqw;color:#e8f2ed;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>Start</div><div style='font:500 1.65cqw/1.2 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;margin-top:.5cqw;color:#c3d5d4'>reads only</div></div><div style='min-width:0;box-sizing:border-box;background:#1b3d48;border:.2cqw solid #3c7c76;border-radius:1.6cqw;padding:1.4cqw 1.7cqw'><div style='font:700 1.55cqw/1.1 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.1em;color:#74d5ba'>02 · STEP</div><div style='font:650 2.5cqw/1.15 Georgia,Iowan Old Style,Palatino Linotype,serif;margin-top:.6cqw;color:#e8f2ed;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>Collect inputs</div><div style='font:500 1.65cqw/1.2 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;margin-top:.5cqw;color:#c3d5d4'>reads only</div></div><div style='min-width:0;box-sizing:border-box;background:#1b3d48;border:.2cqw solid #3c7c76;border-radius:1.6cqw;padding:1.4cqw 1.7cqw'><div style='font:700 1.55cqw/1.1 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.1em;color:#74d5ba'>03 · STEP</div><div style='font:650 2.5cqw/1.15 Georgia,Iowan Old Style,Palatino Linotype,serif;margin-top:.6cqw;color:#e8f2ed;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>Perform work</div><div style='font:500 1.65cqw/1.2 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;margin-top:.5cqw;color:#c3d5d4'>private drafts</div></div><div style='min-width:0;box-sizing:border-box;background:#3a3020;border:.2cqw solid #b8863f;border-radius:1.6cqw;padding:1.4cqw 1.7cqw'><div style='font:700 1.55cqw/1.1 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.1em;color:#e9b96d'>04 · GATE</div><div style='font:650 2.5cqw/1.15 Georgia,Iowan Old Style,Palatino Linotype,serif;margin-top:.6cqw;color:#e8f2ed;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>Check the result</div><div style='font:500 1.65cqw/1.2 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;margin-top:.5cqw;color:#c3d5d4'>reads only</div></div><div style='min-width:0;box-sizing:border-box;background:#3a3020;border:.2cqw solid #b8863f;border-radius:1.6cqw;padding:1.4cqw 1.7cqw'><div style='font:700 1.55cqw/1.1 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.1em;color:#e9b96d'>05 · GATE</div><div style='font:650 2.5cqw/1.15 Georgia,Iowan Old Style,Palatino Linotype,serif;margin-top:.6cqw;color:#e8f2ed;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>Owner gate</div><div style='font:500 1.65cqw/1.2 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;margin-top:.5cqw;color:#c3d5d4'>the owner decides</div></div><div style='min-width:0;box-sizing:border-box;background:#1b3d48;border:.2cqw solid #3c7c76;border-radius:1.6cqw;padding:1.4cqw 1.7cqw'><div style='font:700 1.55cqw/1.1 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.1em;color:#74d5ba'>06 · STEP</div><div style='font:650 2.5cqw/1.15 Georgia,Iowan Old Style,Palatino Linotype,serif;margin-top:.6cqw;color:#e8f2ed;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>Commit output</div><div style='font:500 1.65cqw/1.2 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;margin-top:.5cqw;color:#c3d5d4'>writes once approved</div></div><div style='min-width:0;box-sizing:border-box;background:#1b3d48;border:.2cqw solid #3c7c76;border-radius:1.6cqw;padding:1.4cqw 1.7cqw'><div style='font:700 1.55cqw/1.1 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.1em;color:#74d5ba'>07 · STEP</div><div style='font:650 2.5cqw/1.15 Georgia,Iowan Old Style,Palatino Linotype,serif;margin-top:.6cqw;color:#e8f2ed;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>Record the run</div><div style='font:500 1.65cqw/1.2 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;margin-top:.5cqw;color:#c3d5d4'>records only</div></div></div><div style='display:flex;justify-content:space-between;gap:2cqw;margin-top:1.6cqw;font:600 1.6cqw/1.3 system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.04em;color:#e9b96d'><span>7 stages · 2 gates · 1 owner decision</span><span style='color:#c3d5d4'>agent-assisted · manual</span></div></div>"
