    {
      "id": "repeatable-workflow-policy",
      "type": "content",
      "label": "Permission boundary",
      "position": {
        "x": 0,
        "y": 1400
      },
      "width": 515,
      "height": 380,
      "visible": true,
      "showLabel": true,
      "style": {
        "background": "#153340",
        "color": "#e8f2ed",
        "borderColor": "#3e6970",
        "borderWidth": 1,
        "borderStyle": "solid",
        "borderRadius": 18
      },
      "data": {
        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:hidden;border-radius:20px;background:#243842;color:#edf7f5;font-family:system-ui;padding:4cqw;border:1px solid #42636c\"><div style=\"letter-spacing:.14em;font-weight:800;font-size:clamp(11px,1.5cqw,17px);color:#edc78e\">SAFETY RULE</div><h2 style=\"font:500 clamp(23px,3.6cqw,42px)/1.12 Georgia;margin:2cqw 0 1.5cqw\">No silent side effects.</h2><p style=\"font-size:clamp(13px,1.85cqw,20px);line-height:1.45;color:#d2e4de\">Steps declare tools, effects and evidence. Gates declare proof. The shared preflight inspects both, but executes nothing.</p><p style=\"font-size:clamp(13px,1.65cqw,19px);line-height:1.4;color:#d2e4de\">A tool name or authority field is not a permission grant. External writes still require an authorized tool and owner approval. Stop on failed evidence.</p></div>"
        }
      }
    },
    {
      "id": "repeatable-workflow-run-schema",
      "type": "workflow-info-card",
      "label": "Run record guidance",
      "position": {
        "x": 570,
        "y": 1400
      },
      "width": 780,
      "height": 345,
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Keep every run separate.",
        "eyebrow": "EXECUTION HISTORY",
        "body": "Give each run a separate record destination. Preserve the Question ID and text, final answer or reference, evidence, answerStatus (resolved/unresolved/blocked), missing evidence and unresolved reason, alongside procedural stage outcomes, approvals, errors, tools, and outputs.\n\nA completed workflow is not automatically a resolved Question. A blocked run must be recorded independently of the success-path Record step. Changes to the template never rewrite history.",
        "note": "Distinguish procedure outcome from answer outcome; record failures even when a gate stops the path.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "FileText"
          }
        },
        "identity": {
          "graphId": "repeatable-workflow",
          "nodeId": "repeatable-workflow-run-schema"
        },
        "classRef": "tlz://twilite.zone/library/templates/repeatable-workflow/classes/workflow-info-card.node-class.node"
      }
    },
