    {
      "id": "repeatable-workflow-derive-method",
      "type": "method",
      "label": "Derive the workflow views",
      "position": {
        "x": 1350,
        "y": 2400
      },
      "width": 420,
      "height": 150,
      "ports": [
        {
          "id": "invokes",
          "key": "invokes",
          "label": "invokes",
          "direction": "input",
          "dataType": "any",
          "angle": 180,
          "position": {
            "side": "left",
            "offset": 0.5
          }
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the workflow views",
        "parameters": [],
        "source": "// Derives the Repeatable Workflow template's views from the workflow it holds: nothing is typed into a summary.\n// It reads the Workflow node (its title, purpose, trigger and mode) and its stages (Workflow Step and Workflow Gate nodes), puts the stages in the order the workflow.next edges give (from the Workflow's\n// startStepId), and writes the Detail and Summary views and the Glyph. It writes only those three, which its declared effects say. A card has no scrolling area: the Detail shows as many stages as fit and says\n// how many more there are.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst SERIF = 'Georgia,Iowan Old Style,Palatino Linotype,serif';\nconst SANS = 'system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif';\nconst INK = '#e8f2ed'; const MUTED = '#c3d5d4'; const PAPER = '#10222c';\nconst STEP = { line: '#3c7c76', fill: '#1b3d48', accent: '#74d5ba' };\nconst GATE = { line: '#b8863f', fill: '#3a3020', accent: '#e9b96d' };\nconst OWNER = 'owner-approval-required';\n\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst workflow = nodes.find((node) => clean(node?.type) === 'workflow');\nconst members = nodes.filter((node) => ['workflow-step', 'workflow-gate'].includes(clean(node?.type)));\n\n// The stages in order: follow workflow.next from the start; any stage the chain does not reach follows, top to bottom.\nconst next = new Map();\nfor (const edge of edges) if (clean(edge?.sourcePort) === 'next' && clean(edge?.targetPort) === 'previous') next.set(edge.source, edge.target);\nconst byId = new Map(members.map((node) => [node.id, node]));\nconst ordered = [];\nconst seen = new Set();\nlet cursor = clean(workflow?.data?.startStepId);\nwhile (cursor && byId.has(cursor) && !seen.has(cursor)) { seen.add(cursor); ordered.push(byId.get(cursor)); cursor = next.get(cursor); }\nconst rest = members.filter((node) => !seen.has(node.id)).sort((a, b) => ((a.position?.y || 0) - (b.position?.y || 0)) || ((a.position?.x || 0) - (b.position?.x || 0)));\nconst stages = [...ordered, ...rest];\nconst isGate = (node) => clean(node?.type) === 'workflow-gate';\nconst gates = stages.filter(isGate);\nconst ownerGates = gates.filter((node) => clean(node.data?.gateType) === 'owner-approval' || clean(node.data?.authority) === OWNER);\nconst writes = stages.filter((node) => clean(node.data?.authority) === 'approved-write');\n\nconst title = clean(workflow?.data?.title) || 'Workflow';\nconst purpose = clean(workflow?.data?.purpose);\nconst mode = clean(workflow?.data?.mode) || 'agent-assisted';\nconst trigger = clean(workflow?.data?.trigger) || 'manual';\nconst plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;\nconst facts = [plural(stages.length, 'stage', 'stages'), plural(gates.length, 'gate', 'gates'), plural(ownerGates.length, 'owner decision', 'owner decisions')];\n\nconst AUTHORITY = { 'read-only': 'reads only', 'private-draft': 'private drafts', 'record-only': 'records only', 'approved-write': 'writes once approved', [OWNER]: 'the owner decides' };\nconst authorityText = (node) => AUTHORITY[clean(node.data?.authority)] || clean(node.data?.authority) || 'reads only';\n\n// ---- Detail: the workflow as a page that fits (a card): the headline, what it is for, the stages in order, and how it runs.\nconst SHOWN = 8;\nconst chip = (node, index) => {\n  const palette = isGate(node) ? GATE : STEP;\n  return `<div style='min-width:0;box-sizing:border-box;background:${palette.fill};border:.2cqw solid ${palette.line};border-radius:1.6cqw;padding:1.4cqw 1.7cqw'>`\n    + `<div style='font:700 1.55cqw/1.1 ${SANS};letter-spacing:.1em;color:${palette.accent}'>${String(index + 1).padStart(2, '0')} · ${isGate(node) ? 'GATE' : 'STEP'}</div>`\n    + `<div style='font:650 2.5cqw/1.15 ${SERIF};margin-top:.6cqw;color:${INK};overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>${esc(clean(node.data?.title).replace(/^\\d+\\s*[·.\\-:]\\s*/, '') || node.label)}</div>`\n    + `<div style='font:500 1.65cqw/1.2 ${SANS};margin-top:.5cqw;color:${MUTED}'>${esc(authorityText(node))}</div></div>`;\n};\nconst shown = stages.slice(0, SHOWN);\nconst more = stages.length - shown.length;\nconst detail = `<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background:${PAPER};color:${INK};font-family:${SANS};padding:4.2cqw 4.6cqw;display:flex;flex-direction:column'>`\n  + `<div style='font:800 1.6cqw/1 ${SANS};letter-spacing:.2em;color:${STEP.accent}'>TWILITE · WORKFLOW TEMPLATE</div>`\n  + `<div style='font:650 5.6cqw/1.08 ${SERIF};letter-spacing:-.02em;margin-top:1.8cqw;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>${esc(title)}</div>`\n  + (purpose ? `<div style='max-width:78cqw;font:400 2.3cqw/1.5 ${SANS};color:${MUTED};margin-top:1.4cqw;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical'>${esc(purpose)}</div>` : '')\n  + `<div style='flex:1;min-height:0;margin-top:2.6cqw;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:min-content;gap:1.3cqw;align-content:start'>${shown.map(chip).join('')}</div>`\n  + `<div style='display:flex;justify-content:space-between;gap:2cqw;margin-top:1.6cqw;font:600 1.6cqw/1.3 ${SANS};letter-spacing:.04em;color:${GATE.accent}'>`\n  + `<span>${esc(facts.join(' · '))}${more > 0 ? ` · and ${more} more` : ''}</span><span style='color:${MUTED}'>${esc(mode)} · ${esc(trigger)}</span></div></div>`;\n\n// ---- Summary: the workflow in miniature: its name, how many stages and who decides, and one dot for each stage (gold for a gate).\nconst dots = stages.slice(0, 24).map((node) => `<span style='flex:0 0 auto;width:3.2cqw;height:3.2cqw;border-radius:50%;background:${isGate(node) ? GATE.accent : STEP.accent}'></span>`).join('');\nconst summary = `<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background:${PAPER};color:${INK};font-family:${SANS};padding:5cqw;border-left:1.6cqw solid ${STEP.accent};display:flex;flex-direction:column'>`\n  + `<div style='font:800 2.6cqw/1.1 ${SANS};letter-spacing:.14em;color:${GATE.accent}'>WORKFLOW TEMPLATE</div>`\n  + `<div style='font:650 7.6cqw/1.1 ${SERIF};letter-spacing:-.02em;margin-top:2.4cqw;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>${esc(title)}</div>`\n  + `<div style='font:600 3.6cqw/1.3 ${SANS};color:${STEP.accent};margin-top:2cqw'>${esc(facts[0])} · ${esc(facts[2])}</div>`\n  + `<div style='display:flex;flex-wrap:wrap;gap:1.6cqw;margin-top:3cqw'>${dots}</div>`\n  + `<div style='flex:1;min-height:0'></div>`\n  + `<div style='font:400 3cqw/1.4 ${SANS};color:${MUTED};overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>${esc(writes.length ? 'Nothing is written until the owner has approved.' : (purpose || 'An agent-assisted process with an owner gate.'))}</div></div>`;\n\nconst faces = nodes.filter((node) => clean(node?.type) === 'face');\nconst level = (name) => faces.find((node) => clean(node?.data?.semanticLevel) === name);\nconst glyph = nodes.find((node) => clean(node?.type) === 'glyph');\nconst updated = [];\nfor (const [name, html] of [['detail', detail], ['summary', summary]]) {\n  const view = level(name);\n  if (!view) continue;\n  await api.updateView(view.id, { content: { ...(view.data?.content || {}), kind: 'html', value: html } });\n  updated.push(view.id);\n}\nif (glyph) {\n  await api.updateNode(glyph.id, { data: { ...(glyph.data || {}), glyph: { kind: 'icon', name: 'Workflow' } } });\n  updated.push(glyph.id);\n}\nreturn { updated, stages: stages.length, gates: gates.length, ownerDecisions: ownerGates.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "repeatable-workflow-detail",
              "repeatable-workflow-summary",
              "repeatable-workflow-glyph"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "repeatable-workflow",
          "nodeId": "repeatable-workflow-preflight-method"
        }
      }
    },
