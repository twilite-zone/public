        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:clamp(20px,4cqw,44px);background:#ffffff;font-family:system-ui;color:#0f172a;overflow:auto'><div style='font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#6d28d9'>Edge class · link</div><h1 style='margin:14px 0 0;font:500 clamp(32px,7cqw,54px)/1 Newsreader,Georgia,serif;letter-spacing:-.02em;color:#0f172a'>Link</h1><p style='margin:16px 0 0;max-width:52ch;font:400 18px/1.55 Newsreader,Georgia,serif;color:#334155'>A hyperlink.</p><p style='margin:18px 0 0;max-width:60ch;font:400 14px/1.55 system-ui;color:#475569'>Its Properties, Strokes and page sections are nodes on this graph. The Detail, Summary and Icon views are derived from them and kept current.</p></div>"
        }
