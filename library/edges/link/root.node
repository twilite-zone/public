          "dataType": "any",
          "angle": 180,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "bridge": {
          "ref": "tlz://twilite.zone/library/edges/classes/property.node-class.node",
          "role": "import",
          "resourceKind": "node-class",
          "scope": "focused-graph",
          "grants": [
            "read",
            "create",
            "update"
          ]
        },
        "identity": {
          "graphId": "edge-class-link"
        }
      }
    },
    {
      "id": "refresh-views-method",
      "type": "method",
      "label": "Refresh exposed views",
      "root": false,
      "position": {
        "x": -3510.97269642131,
        "y": 222.327932024917
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "portId": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "portId": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Refresh exposed views",
        "source": "// Re-renders the graph's exposed views (icon, summary, and the detail page) from its Properties, strokes and page sections.\n// Every Property's change Handler calls this one Method, so the stored views are always current.\n// It only writes the three views the Declaration exposes, and its declared effects say so.\nconst EDGE_STYLES = {\"relationship\":{\"width\":2,\"dash\":[],\"route\":\"curved\",\"showArrow\":false,\"arrowPosition\":\"both\"},\"contains\":{\"color\":\"#6d4c41\",\"width\":2,\"dash\":[],\"route\":\"orthogonal\",\"showArrow\":true,\"arrowPosition\":\"end\"},\"dependsOn\":{\"color\":\"#ff9800\",\"width\":2,\"dash\":[8,4],\"route\":\"orthogonal\",\"showArrow\":true,\"arrowPosition\":\"end\"},\"requires\":{\"color\":\"#ef6c00\",\"width\":2,\"dash\":[6,4],\"route\":\"orthogonal\",\"showArrow\":true,\"arrowPosition\":\"end\"},\"precedes\":{\"color\":\"#00695c\",\"width\":2,\"dash\":[4,4],\"route\":\"orthogonal\",\"showArrow\":true,\"arrowPosition\":\"end\"},\"derivesFrom\":{\"color\":\"#5e35b1\",\"width\":2,\"dash\":[8,3],\"route\":\"orthogonal\",\"showArrow\":true,\"arrowPosition\":\"end\"},\"constrains\":{\"color\":\"#d32f2f\",\"width\":2,\"dash\":[2,6],\"route\":\"orthogonal\",\"showArrow\":true,\"arrowPosition\":\"end\"},\"governs\":{\"color\":\"#283593\",\"width\":2,\"dash\":[],\"route\":\"orthogonal\",\"showArrow\":true,\"arrowPosition\":\"end\"},\"equivalentTo\":{\"color\":\"#37474f\",\"width\":2,\"dash\":[3,3],\"route\":\"orthogonal\",\"showArrow\":false,\"arrowPosition\":\"both\"},\"transformsTo\":{\"color\":\"#7e57c2\",\"width\":2,\"dash\":[6,3],\"route\":\"orthogonal\",\"showArrow\":true,\"arrowPosition\":\"end\"},\"conflictsWith\":{\"color\":\"#c62828\",\"width\":2,\"dash\":[2,4],\"route\":\"orthogonal\",\"showArrow\":true,\"arrowPosition\":\"both\"},\"references\":{\"color\":\"#9c27b0\",\"width\":1.5,\"dash\":[3,3],\"route\":\"orthogonal\",\"showArrow\":true,\"arrowPosition\":\"end\"},\"relates\":{},\"child\":{},\"peer\":{},\"dataFlow\":{},\"dependency\":{},\"reference\":{},\"bidirectional\":{},\"weak\":{},\"strong\":{},\"temporal\":{},\"energyFlow\":{},\"derives\":{}};\n\nconst isObject = (value) => Boolean(value && typeof value === 'object' && !Array.isArray(value));\nconst clean = (value) => String(value ?? '').trim();\nconst escapeXml = (value) => String(value ?? '').replace(/[&<>\"']/g, (character) => ({\n  '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&apos;'\n})[character]);\nconst summarize = (value, length) => {\n  const text = clean(value);\n  return text.length > length ? `${text.slice(0, length - 1).trimEnd()}…` : text;\n};\n\n// --- Reading the class from the graph -----------------------------------------------------------\nconst bindingKey = (node) => clean(node?.data?._classBinding?.key || node?.data?.definitionKey).toLowerCase();\nconst isStroke = (node) => bindingKey(node) === 'edge-class-stroke' || clean(node?.type).toLowerCase() === 'edge-class-stroke' || (clean(node?.type).toLowerCase() === 'bridge' && node?.data?.edgeClassStroke === true);\nconst isProperty = (node) => clean(node?.type).toLowerCase() === 'property' || bindingKey(node) === 'property';\nconst isField = (node) => !isStroke(node) && (clean(node?.type).toLowerCase() === 'field' || bindingKey(node) === 'field');\n\nconst propertyValue = (node) => {\n  const data = node?.data || {};\n  if (data.valueKind === 'computed') {\n    return data.computation?.kind === 'constant' ? { has: true, value: data.computation.value } : { has: false };\n  }\n  if (Object.hasOwn(data, 'value') && data.value !== undefined) return { has: true, value: data.value };\n  if (Object.hasOwn(data, 'defaultValue') && data.defaultValue !== undefined) return { has: true, value: data.defaultValue };\n  return { has: false };\n};\nconst parseBoolean = (raw) => {\n  const text = clean(raw).toLowerCase();\n  if (!text) return false;\n  if (['true', 'yes', '1'].includes(text)) return true;\n  if (['false', 'no', '0'].includes(text)) return false;\n  return true;\n};\nconst fieldValue = (node) => {\n  const data = node?.data || {};\n  const type = clean(data.fieldType).toLowerCase();\n  const raw = data.value;\n  if (raw === undefined || raw === null) return '';\n  if (['number', 'float', 'int'].includes(type)) { const numeric = Number(raw); return Number.isFinite(numeric) ? numeric : ''; }\n  if (['boolean', 'bool'].includes(type)) return parseBoolean(raw);\n  if (['json', 'array', 'object'].includes(type)) {\n    if (typeof raw !== 'string') return raw;\n    try { return JSON.parse(raw); } catch { return raw; }\n  }\n  return typeof raw === 'string' ? raw.trim() : raw;\n};\n\nconst SEGMENTS = {\n  renderdefaults: 'renderDefaults', showarrow: 'showArrow', arrowposition: 'arrowPosition', usageguidance: 'usageGuidance',\n  defaultedgetype: 'defaultEdgeType', semanticauthority: 'semanticAuthority', legendrole: 'legendRole',\n  routinghint: 'routingHint', labeltone: 'labelTone'\n};\nconst SHORT = {\n  key: 'key', label: 'label', meaning: 'meaning', usageguidance: 'usageGuidance', defaultedgetype: 'defaultEdgeType',\n  sourcekinds: 'sourceKinds', targetkinds: 'targetKinds', maxoutgoing: 'maxOutgoing', maxincoming: 'maxIncoming', semanticauthority: 'semanticAuthority', legendrole: 'legendRole',\n  stroke: 'renderDefaults.stroke', width: 'renderDefaults.width', dash: 'renderDefaults.dash',\n  routinghint: 'renderDefaults.routingHint', labeltone: 'renderDefaults.labelTone'\n};\nconst fieldPath = (rawKey) => {\n  const key = clean(rawKey).replace(/\\s+/g, ' ').toLowerCase();\n  if (!key) return '';\n  const bare = key.startsWith('edgeclass.') ? key.slice('edgeclass.'.length) : key;\n  if (bare.includes('.')) return bare.split('.').map((part) => SEGMENTS[part.trim()] || part.trim()).join('.');\n  return SHORT[bare.replace(/\\s+/g, '')] || bare;\n};\nconst setAtPath = (target, path, value) => {\n  const parts = clean(path).split('.').map((part) => part.trim()).filter(Boolean);\n  if (!parts.length) return;\n  let current = target;\n  for (let i = 0; i < parts.length - 1; i += 1) {\n    if (!isObject(current[parts[i]])) current[parts[i]] = {};\n    current = current[parts[i]];\n  }\n  current[parts[parts.length - 1]] = value;\n};\nconst toList = (value) => {\n  if (Array.isArray(value)) return value.map(clean).filter(Boolean);\n  const text = clean(value);\n  if (!text) return [];\n  if (text.startsWith('[') && text.endsWith(']')) {\n    try { const parsed = JSON.parse(text); if (Array.isArray(parsed)) return parsed.map(clean).filter(Boolean); } catch { /* fall through */ }\n  }\n  return text.split(',').map(clean).filter(Boolean);\n};\nconst strokeFromNode = (node) => {\n  const data = node?.data || {};\n  if (data.enabled === false) return null;\n  const color = clean(data.color || data.stroke);\n  const width = Number(data.width ?? data.strokeWidth);\n  const opacity = Number(data.opacity);\n  const dashRaw = data.dash ?? data.strokeDasharray ?? data.dashPattern;\n  const dash = Array.isArray(dashRaw) ? dashRaw : (() => {\n    const text = clean(dashRaw);\n    if (!text) return undefined;\n    if (['solid', 'none', 'dashed', 'dotted'].includes(text)) return text;\n    if (text.startsWith('[') && text.endsWith(']')) { try { const parsed = JSON.parse(text); if (Array.isArray(parsed)) return parsed; } catch { /* keep text */ } }\n    return text;\n  })();\n  const gradient = isObject(data.gradient) ? data.gradient : null;\n  if (!color && !gradient) return null;\n  return {\n    ...(color ? { color } : {}),\n    ...(Number.isFinite(width) && width > 0 ? { width } : {}),\n    ...(Number.isFinite(opacity) ? { opacity: Math.max(0, Math.min(1, opacity)) } : {}),\n    ...(dash !== undefined ? { dash } : {}),\n    ...(gradient ? { gradient } : {})\n  };\n};\n\nconst readEdgeClass = (nodes) => {\n  const edgeClass = {};\n  nodes.filter((node) => isField(node) || isProperty(node)).forEach((node) => {\n    const property = isProperty(node);\n    const rawKey = property ? clean(node.data?.name) : clean(node.data?.title || node.data?.key || node.label || node.id);\n    const path = fieldPath(rawKey);\n    if (!path) return;\n    if (property) {\n      const resolved = propertyValue(node);\n      if (!resolved.has) return;\n      setAtPath(edgeClass, path, resolved.value);\n    } else setAtPath(edgeClass, path, fieldValue(node));\n  });\n  // Every stroke node in the graph paints, in graph order, whether or not anything connects it.\n  const strokes = nodes.filter((node) => isStroke(node)).map(strokeFromNode).filter(Boolean);\n  if (strokes.length) edgeClass.renderDefaults = { ...(isObject(edgeClass.renderDefaults) ? edgeClass.renderDefaults : {}), strokes };\n  if (!Object.keys(edgeClass).length) return null;\n  edgeClass.key = clean(edgeClass.key);\n  if (!edgeClass.key) return null;\n  if (edgeClass.sourceKinds !== undefined) edgeClass.sourceKinds = toList(edgeClass.sourceKinds);\n  if (edgeClass.targetKinds !== undefined) edgeClass.targetKinds = toList(edgeClass.targetKinds);\n  for (const limit of ['maxOutgoing', 'maxIncoming']) {\n    const count = Number(edgeClass[limit]);\n    if (edgeClass[limit] === undefined || edgeClass[limit] === '' || !Number.isFinite(count) || count < 0) delete edgeClass[limit];\n    else edgeClass[limit] = Math.floor(count);\n  }\n  return edgeClass;\n};\n\n// --- Style ---------------------------------------------------------------------------------------\nconst toBoolean = (value) => {\n  if (value === undefined || value === null) return undefined;\n  if (typeof value === 'boolean') return value;\n  if (typeof value === 'number') return value !== 0;\n  const text = clean(value).toLowerCase();\n  if (['true', '1', 'yes', 'y', 'on'].includes(text)) return true;\n  if (['false', '0', 'no', 'n', 'off'].includes(text)) return false;\n  return undefined;\n};\nconst dashToArray = (value) => {\n  if (Array.isArray(value)) return value.map(Number).filter((n) => Number.isFinite(n) && n > 0);\n  if (typeof value === 'string') {\n    const text = value.trim().toLowerCase();\n    if (!text || text === 'solid' || text === 'none') return [];\n    if (text === 'dashed') return [8, 4];\n    if (text === 'dotted') return [2, 4];\n    return text.split(/[,\\s]+/).map(Number).filter((n) => Number.isFinite(n) && n > 0);\n  }\n  if (typeof value === 'number' && Number.isFinite(value) && value > 0) return [value, value];\n  return [];\n};\nconst resolveStyle = (edgeClass) => {\n  const base = EDGE_STYLES[clean(edgeClass.defaultEdgeType)] || EDGE_STYLES.relationship || {};\n  const rd = isObject(edgeClass.renderDefaults) ? edgeClass.renderDefaults : {};\n  const routeRaw = clean(rd.route ?? rd.routing ?? rd.router ?? rd.routingHint).toLowerCase();\n  const route = ['curved', 'orthogonal', 'straight', 'direct'].includes(routeRaw) ? (routeRaw === 'direct' ? 'straight' : routeRaw) : '';\n  const color = clean(rd.color || rd.stroke);\n  const width = Number(rd.width ?? rd.strokeWidth);\n  const position = clean(rd.arrowPosition).toLowerCase();\n  const showArrow = toBoolean(rd.showArrow);\n  const hasDash = rd.dash !== undefined || rd.strokeDasharray !== undefined;\n  return {\n    color: color || base.color || '#6b7280',\n    width: Number.isFinite(width) && width > 0 ? width : (base.width ?? 2),\n    dash: hasDash ? dashToArray(rd.dash ?? rd.strokeDasharray) : (Array.isArray(base.dash) ? base.dash : []),\n    route: route || base.route || null,\n    showArrow: showArrow ?? base.showArrow ?? true,\n    arrowPosition: ['start', 'end', 'both'].includes(position) ? position : (base.arrowPosition || 'end')\n  };\n};\n\n// --- Rendering -----------------------------------------------------------------------------------\nconst label = (x, y, value, size = 14, color = '#f8fafc', weight = 400) =>\n  `<text x='${x}' y='${y}' fill='${color}' font-family='system-ui' font-size='${size}' font-weight='${weight}'>${escapeXml(value)}</text>`;\nconst kinds = (value) => (Array.isArray(value) && value.length && !value.some((kind) => clean(kind).toLowerCase() === 'any') ? value.join(', ') : 'Any node');\n// The rule the editor enforces on every edge of this class: the kinds at each end, and how many. It is the same rule the\n// editor checks when a connection is made (utils/edgeLegality.js), so this sentence is what will be refused.\nconst ruleSentence = (edgeClass) => {\n  const parts = [`From ${kinds(edgeClass.sourceKinds).toLowerCase()} to ${kinds(edgeClass.targetKinds).toLowerCase()}.`];\n  if (Number.isFinite(edgeClass.maxOutgoing)) parts.push(`At most ${edgeClass.maxOutgoing} from one node.`);\n  if (Number.isFinite(edgeClass.maxIncoming)) parts.push(`At most ${edgeClass.maxIncoming} into one node.`);\n  parts.push('The editor refuses any other connection.');\n  return parts.join(' ');\n};\nconst dashArray = (value) => (Array.isArray(value) ? value.join(' ') : value === 'dashed' ? '8 4' : value === 'dotted' ? '2 4' : '');\nconst previewPath = (route, left, right, mid) => {\n  if (route === 'orthogonal') {\n    const elbow = Math.round((left + right) / 2);\n    return `M${left} ${mid + 18} L${elbow - 20} ${mid + 18} Q${elbow} ${mid + 18} ${elbow} ${mid - 2} L${elbow} ${mid - 18} Q${elbow} ${mid - 38} ${elbow + 20} ${mid - 38} L${right} ${mid - 38}`;\n  }\n  if (route === 'straight' || route === 'direct') return `M${left} ${mid} L${right} ${mid}`;\n  return `M${left} ${mid} C${left + (right - left) / 3} ${mid - 56} ${right - (right - left) / 3} ${mid + 56} ${right} ${mid}`;\n};\n\nconst renderPreview = (edgeClass, variant) => {\n  const icon = variant === 'icon';\n  const detail = variant === 'detail';\n  // The page's figure is the edge alone between its two labelled ends; the page sets the title and the facts in type.\n  const figure = variant === 'figure';\n  const large = detail || figure;\n  const width = icon ? 260 : large ? 760 : 520;\n  const height = icon ? 220 : detail ? 460 : figure ? 250 : 300;\n  const left = icon ? 80 : detail ? 130 : figure ? 205 : 100;\n  const right = width - left;\n  const mid = icon ? 110 : detail ? 255 : figure ? 135 : 175;\n  const defaults = edgeClass.renderDefaults || {};\n  const baseStyle = resolveStyle(edgeClass);\n  const route = clean(baseStyle.route || defaults.routingHint || 'curved').toLowerCase();\n  const path = previewPath(route, left, right, mid);\n  const strokes = Array.isArray(defaults.strokes) && defaults.strokes.length\n    ? defaults.strokes\n    : [{ color: baseStyle.color, width: baseStyle.width, dash: baseStyle.dash }];\n  const paint = strokes.map((stroke) => {\n    const color = escapeXml(stroke.color || stroke.stroke || '#c4b5fd');\n    const strokeWidth = Math.max(1, Number(stroke.width || stroke.strokeWidth) || 3);\n    const opacity = Number.isFinite(Number(stroke.opacity)) ? ` opacity='${Math.max(0, Math.min(1, Number(stroke.opacity)))}'` : '';\n    const dash = dashArray(stroke.dash);\n    return `<path d='${path}' fill='none' stroke='${color}' stroke-width='${strokeWidth}' stroke-linecap='round' stroke-linejoin='round'${opacity}${dash ? ` stroke-dasharray='${escapeXml(dash)}'` : ''}/>`;\n  }).join('');\n  const arrowColor = escapeXml(strokes[strokes.length - 1]?.color || '#c4b5fd');\n  const arrowPosition = clean(baseStyle.arrowPosition || 'end').toLowerCase();\n  const showArrow = baseStyle.showArrow !== false;\n  const arrowY = route === 'orthogonal' ? mid - 38 : mid;\n  const arrows = showArrow ? [\n    ['start', 'both'].includes(arrowPosition) ? `<path d='M${left - 9} ${mid} L${left + 5} ${mid - 8} L${left + 5} ${mid + 8} Z' fill='${arrowColor}'/>` : '',\n    ['end', 'both'].includes(arrowPosition) ? `<path d='M${right + 9} ${arrowY} L${right - 5} ${arrowY - 8} L${right - 5} ${arrowY + 8} Z' fill='${arrowColor}'/>` : ''\n  ].join('') : '';\n  const title = summarize(edgeClass.label || edgeClass.key || 'Edge class', detail ? 54 : 34);\n  const meaning = summarize(edgeClass.meaning || edgeClass.usageGuidance || '', detail ? 100 : 66);\n  const source = summarize(kinds(edgeClass.sourceKinds), detail ? 31 : figure ? 16 : 20);\n  const target = summarize(kinds(edgeClass.targetKinds), detail ? 31 : figure ? 16 : 20);\n  const type = summarize(edgeClass.defaultEdgeType || 'relationship', 22);\n  const edgeLabel = summarize(edgeClass.label, large ? 44 : 28);\n  const background = `<rect width='${width}' height='${height}' rx='${figure ? 8 : 24}' fill='#0f172a'/>`;\n  const end = (x, y, text, tag, fill, line, ink, tagInk, tagX, tagAnchor) =>\n    `<text x='${tagX}' y='${y - 46}' text-anchor='${tagAnchor}' fill='${tagInk}' font-family='system-ui' font-size='12' font-weight='700' letter-spacing='2'>${tag}</text>`\n    + `<rect x='${x}' y='${y - 32}' width='150' height='64' rx='14' fill='${fill}' stroke='${line}' stroke-width='2'/>`\n    + `<text x='${x + 75}' y='${y + 5}' text-anchor='middle' fill='${ink}' font-family='system-ui' font-size='15' font-weight='600'>${escapeXml(text)}</text>`;\n  const endpoints = figure\n    ? end(left - 165, mid, source, 'FROM', '#082f49', '#0ea5e9', '#e0f2fe', '#7dd3fc', left - 165, 'start')\n      + end(right + 15, arrowY, target, 'TO', '#4c0519', '#fb7185', '#ffe4e6', '#fda4af', right + 165, 'end')\n    : `<circle cx='${left - 24}' cy='${mid}' r='19' fill='#0ea5e9'/><circle cx='${right + 24}' cy='${arrowY}' r='19' fill='#fb7185'/>`;\n  const heading = icon || figure ? '' : [\n    label(30, detail ? 48 : 42, title, detail ? 25 : 21, '#f8fafc', 700),\n    label(30, detail ? 76 : 69, summarize(edgeClass.key || '', detail ? 78 : 52), 12, '#a5b4fc'),\n    meaning ? label(30, detail ? 108 : 94, meaning, detail ? 15 : 12, '#cbd5e1') : ''\n  ].join('');\n  const renderedEdgeLabel = icon || !edgeLabel ? '' : (() => {\n    const labelWidth = Math.min(large ? 360 : 260, Math.max(112, edgeLabel.length * (large ? 8 : 7) + 30));\n    const x = Math.round((width - labelWidth) / 2);\n    const y = large ? mid + 50 : mid + 46;\n    return `<rect x='${x}' y='${y - 25}' width='${labelWidth}' height='34' rx='17' fill='#111827' stroke='#8b5cf6' stroke-width='2'/>`\n      + `<text x='${width / 2}' y='${y - 2}' text-anchor='middle' fill='#f5f3ff' font-family='system-ui' font-size='13' font-weight='700'>${escapeXml(edgeLabel)}</text>`;\n  })();\n  const information = detail ? [\n    label(38, 352, `FROM  ${source}`, 13, '#7dd3fc', 600),\n    label(394, 352, `TO  ${target}`, 13, '#fda4af', 600),\n    label(38, 390, `TYPE  ${type}`, 13, '#cbd5e1'),\n    label(394, 390, `ROUTE  ${route}`, 13, '#cbd5e1'),\n    label(38, 426, `PAINT  ${strokes.length} stroke${strokes.length === 1 ? '' : 's'}`, 13, '#cbd5e1'),\n    label(394, 426, `ARROW  ${showArrow ? arrowPosition : 'none'}`, 13, '#cbd5e1')\n  ].join('') : icon || figure ? '' : [\n    label(30, 266, `${source}  →  ${target}`, 12, '#cbd5e1'),\n    label(300, 266, `${type} · ${route}`, 12, '#a5b4fc')\n  ].join('');\n  return `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${width} ${height}'>${background}${heading}${endpoints}${paint}${arrows}${renderedEdgeLabel}${information}</svg>`;\n};\n\n\n// --- The definition page -------------------------------------------------------------------------\n// The detail view reads as an article: a nameplate, the label as the headline and the meaning as the standfirst, then the\n// drawing as its first figure. The authored page sections are the body, in graph order. The technical details sit beside\n// them: Settings (from the live Properties and strokes) beside the first section, the paint order beside the second, and\n// the connection rule set large between them. Sizes follow the view's own width. The icon and summary views stay drawings.\nconst isSection = (node) => bindingKey(node) === 'page-section' || clean(node?.type).toLowerCase() === 'page-section';\nconst SERIF = 'Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif';\nconst MONO = 'ui-monospace,Cascadia Code,Consolas,monospace';\nconst KICKER = 'font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase';\nconst pageParagraphs = (value, dropCap) => clean(value).split(/\\n{2,}/).map((part) => part.trim()).filter(Boolean)\n  .map((part, index) => {\n    const cap = dropCap && index === 0 && /^[A-Za-z]/.test(part);\n    return `<p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 ${SERIF};color:#1e293b'>`\n      + (cap ? `<span style='float:left;padding:6px 10px 0 0;font:500 68px/54px ${SERIF};color:#0f172a'>${part[0]}</span>` : '')\n      + `${escapeXml(cap ? part.slice(1) : part).replace(/\\n/g, '<br>')}</p>`;\n  }).join('');\nconst settingsRows = (edgeClass) => {\n  const style = resolveStyle(edgeClass);\n  const painted = Array.isArray(edgeClass.renderDefaults?.strokes) ? edgeClass.renderDefaults.strokes.length : 0;\n  return [\n    ['Key', edgeClass.key],\n    ['Label', edgeClass.label],\n    ['Default edge type', edgeClass.defaultEdgeType || 'relationship'],\n    ['Route', style.route || 'default'],\n    ['Arrow', style.showArrow ? style.arrowPosition : 'none'],\n    ['From', kinds(edgeClass.sourceKinds)],\n    ['To', kinds(edgeClass.targetKinds)],\n    ['Connection rule', ruleSentence(edgeClass)],\n    ['Strokes', painted ? `${painted} painted` : 'one, from the edge type']\n  ].filter(([, value]) => clean(value));\n};\nconst heading = (text, color = '#6d28d9') => `<h2 style='margin:0 0 14px;${KICKER};color:${color}'>${escapeXml(text)}</h2>`;\n// A short value sits beside its name; a long one runs underneath it at the full width of the list.\nconst settingsList = (edgeClass) => settingsRows(edgeClass).map(([name, value]) => {\n  const wide = clean(value).length > 24;\n  const span = wide ? 'grid-column:1/-1;' : '';\n  return `<dt style='${span}padding:9px 0 ${wide ? 0 : 9}px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>${escapeXml(name)}</dt>`\n    + `<dd style='${span}margin:0;padding:${wide ? '2px 0 9px' : '9px 0;border-top:1px solid #cbd5e1;text-align:right'};font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>${escapeXml(value)}</dd>`;\n}).join('');\n// The paint layers by name, in graph order, which is paint order.\nconst paintLayers = (edgeClass, nodes) => {\n  const named = nodes.filter((node) => isStroke(node)).map((node) => ({ stroke: strokeFromNode(node), name: clean(node.label) })).filter((layer) => layer.stroke);\n  if (named.length) return named;\n  const style = resolveStyle(edgeClass);\n  return [{ stroke: { color: style.color, width: style.width, dash: style.dash }, name: 'From the edge type' }];\n};\nconst dashName = (value) => {\n  if (Array.isArray(value)) return value.length ? `dash ${value.join(' ')}` : 'solid';\n  const text = clean(value).toLowerCase();\n  return text && text !== 'none' ? text : 'solid';\n};\nconst paintList = (layers) => layers.map((layer, index) => {\n  const stroke = layer.stroke;\n  const color = escapeXml(stroke.color || '#c4b5fd');\n  const strokeWidth = Math.max(1, Number(stroke.width) || 3);\n  const opacity = Number.isFinite(Number(stroke.opacity)) ? Math.max(0, Math.min(1, Number(stroke.opacity))) : 1;\n  const dash = dashArray(stroke.dash);\n  const facts = [color, `${strokeWidth} px`, escapeXml(dashName(stroke.dash)), opacity < 1 ? `${Math.round(opacity * 100)}%` : ''].filter(Boolean).join(' · ');\n  return `<div style='margin:0 0 14px'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 190 36' preserveAspectRatio='none' style='display:block;width:100%;height:36px'>`\n    + `<rect width='190' height='36' fill='#0f172a'/><path d='M18 18 L172 18' fill='none' stroke='${color}' stroke-width='${strokeWidth}' stroke-linecap='round'${opacity < 1 ? ` opacity='${opacity}'` : ''}${dash ? ` stroke-dasharray='${escapeXml(dash)}'` : ''}/></svg>`\n    + `<div style='margin-top:6px;font:600 14px/20px system-ui;color:#0f172a'>${index + 1} · ${escapeXml(layer.name || `Stroke ${index + 1}`)}</div>`\n    + `<div style='font:400 12px/18px ${MONO};color:#475569'>${facts}</div></div>`;\n}).join('');\nconst caption = (number, text) => `<figcaption style='margin-top:10px;font:400 13px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>Fig. ${number}</b> &nbsp;${escapeXml(text)}</figcaption>`;\n// A sidebar and the text it sits beside. The sidebar comes first, so in a narrow view it stacks above the text.\nconst pageRow = (side, main) => `<div style='display:flex;flex-wrap:wrap;flex-direction:row-reverse;align-items:flex-start;gap:32px 40px;padding-top:44px'>${side}<div style='flex:999 1 380px;min-width:0'>${main}</div></div>`;\nconst renderPage = (edgeClass, nodes) => {\n  const title = clean(edgeClass.label || edgeClass.key);\n  const meaning = clean(edgeClass.meaning || edgeClass.usageGuidance);\n  const style = resolveStyle(edgeClass);\n  const layers = paintLayers(edgeClass, nodes);\n  const arrow = !style.showArrow ? 'no arrow' : style.arrowPosition === 'both' ? 'arrows at both ends' : `an arrow at the ${style.arrowPosition}`;\n  const drawing = renderPreview(edgeClass, 'figure').replace('<svg ', \"<svg style='width:100%;height:auto;display:block' \");\n  const rule = ruleSentence(edgeClass);\n  const ruleBreak = rule.indexOf('. ') + 1;\n  const settingsSide = `<aside data-role='settings' style='flex:1 1 220px;min-width:0;padding-top:10px;border-top:3px solid #0f172a'>${heading('Settings', '#0f172a')}`\n    + `<dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid #cbd5e1'>${settingsList(edgeClass)}</dl></aside>`;\n  const paintSide = `<figure data-role='paint' style='flex:1 1 220px;min-width:0;margin:0;padding-top:10px;border-top:3px solid #0f172a'>`\n    + `<div style='margin:0 0 14px;${KICKER};color:#0f172a'>Paint order</div>${paintList(layers)}`\n    + `${caption(2, layers.length > 1 ? 'Each stroke is painted over the one before it.' : 'A single stroke.')}</figure>`;\n  const quote = `<blockquote data-role='rule' style='margin:48px 0 0;padding:32px 0;border-top:1px solid #0f172a;border-bottom:1px solid #0f172a'>`\n    + `<p style='margin:0 0 12px;font:italic 500 clamp(30px,6.4cqw,46px)/1.1 ${SERIF};letter-spacing:-.015em;color:#6d28d9;text-wrap:balance'>${escapeXml(rule.slice(0, ruleBreak))}</p>`\n    + `<p style='margin:0;font:400 14px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>The connection rule.</b> ${escapeXml(rule.slice(ruleBreak + 1))}</p></blockquote>`;\n  const sides = [settingsSide, paintSide];\n  const blocks = nodes.filter(isSection).map((node, index) => {\n    const body = `<section data-role='section'>${heading(node.data?.title)}${pageParagraphs(node.data?.body, index === 0)}</section>`;\n    return index < sides.length ? pageRow(sides[index], body) : `<div style='padding-top:44px'>${body}</div>`;\n  });\n  for (let index = blocks.length; index < sides.length; index += 1) blocks.push(pageRow(sides[index], ''));\n  blocks.splice(1, 0, quote);\n  return `<div style='min-height:100%;box-sizing:border-box;container-type:inline-size;background:#ffffff;font-family:${SERIF};color:#0f172a'>`\n    + `<div style='box-sizing:border-box;max-width:900px;margin:0 auto;padding:32px clamp(20px,5cqw,40px) 64px'>`\n    + `<div style='display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:6px 16px;padding:10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a'>`\n    + `<div style='${KICKER};color:#6d28d9'>Edge class</div><div style='font:400 13px/16px ${MONO};color:#475569'>${escapeXml(edgeClass.key)}</div></div>`\n    + `<header data-role='masthead' style='padding:40px 0 32px'>`\n    + `<h1 style='margin:0;font:500 clamp(40px,9.5cqw,72px)/.98 ${SERIF};letter-spacing:-.025em;text-wrap:balance;color:#0f172a'>${escapeXml(title)}</h1>`\n    + (meaning ? `<p style='margin:18px 0 0;max-width:34ch;font:italic 400 clamp(20px,3.6cqw,26px)/1.35 ${SERIF};color:#475569'>${escapeXml(meaning)}</p>` : '') + `</header>`\n    + `<figure data-role='preview' style='margin:0'>${drawing}${caption(1, `The edge as the editor draws it: ${style.route || 'curved'}, ${layers.length} stroke${layers.length === 1 ? '' : 's'}, ${arrow}.`)}</figure>`\n    + `${blocks.join('')}</div></div>`;\n};\n\n// --- Run -----------------------------------------------------------------------------------------\nconst invocation = api.invocation || {};\nconst changed = invocation.eventPayload || {};\nconst changedName = clean(changed.propertyName).toLowerCase();\nconst bridgeId = clean(invocation.eventBridgeNodeId);\nif (invocation.eventKey === 'property.changed' && bridgeId && ['color', 'width', 'opacity', 'dash', 'enabled'].includes(changedName)) {\n  const bridge = await api.getNode(bridgeId);\n  if (bridge?.type === 'bridge' && bridge.data?.edgeClassStroke === true) {\n    const currentValue = { ...bridge.data };\n    if (changed.state === 'value') currentValue[changedName] = changed.value;\n    else delete currentValue[changedName];\n    await api.updateNode(bridgeId, { data: currentValue });\n  }\n}\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst edgeClass = readEdgeClass(nodes);\nif (!edgeClass) return { updated: [], skipped: 'The graph does not define an edge class yet' };\n\nconst declaration = nodes.find((node) => node?.type === 'declaration');\n// The exposed views are reached by walking the Declaration's own Surface chain -- surfaces to the\n// first View, then view-sequence links down to the next -- the same path every graph in the\n// library uses, not a shortcut relationship of its own.\nconst chainNext = (fromId) => edges.find((edge) => edge.source === fromId\n  && clean(edge.data?.role || edge.type) === 'view-sequence')?.target;\nconst surfaceEdge = edges.find((edge) => edge.source === declaration?.id\n  && clean(edge.data?.role || edge.type) === 'surface');\nconst detailId = surfaceEdge?.target || '';\nconst summaryId = detailId ? chainNext(detailId) || '' : '';\nconst iconId = summaryId ? chainNext(summaryId) || '' : '';\nconst exposed = [[iconId, 'icon'], [summaryId, 'summary'], [detailId, 'detail']];\nconst updated = [];\nfor (const [viewId, variant] of exposed) {\n  if (!viewId) continue;\n  // The detail view is the definition page (html); the smaller views are drawings (svg).\n  const page = variant === 'detail';\n  const kind = page ? 'html' : 'svg';\n  await api.updateView(viewId, { content: { kind, value: page ? renderPage(edgeClass, nodes) : renderPreview(edgeClass, variant) }, renderShape: { kind } });\n  updated.push(viewId);\n}\nreturn { updated };\n",
        "parameters": [],
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "icon-view",
              "summary-view",
              "detail-view",
              "stroke-outer",
              "stroke-inner"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "edge-class-link"
        }
      }
    },
