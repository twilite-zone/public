        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='min-height:100%;box-sizing:border-box;container-type:inline-size;background:#ffffff;font-family:Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#0f172a'><div style='box-sizing:border-box;max-width:900px;margin:0 auto;padding:32px clamp(20px,5cqw,40px) 64px'><div style='display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:6px 16px;padding:10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a'><div style='font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#6d28d9'>Edge class</div><div style='font:400 13px/16px ui-monospace,Cascadia Code,Consolas,monospace;color:#475569'>link</div></div><header data-role='masthead' style='padding:40px 0 32px'><h1 style='margin:0;font:500 clamp(40px,9.5cqw,72px)/.98 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.025em;text-wrap:balance;color:#0f172a'>Link</h1><p style='margin:18px 0 0;max-width:34ch;font:italic 400 clamp(20px,3.6cqw,26px)/1.35 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#475569'>A hyperlink.</p></header><figure data-role='preview' style='margin:0'><svg style='width:100%;height:auto;display:block' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 760 250'><rect width='760' height='250' rx='8' fill='#0f172a'/><text x='40' y='89' text-anchor='start' fill='#7dd3fc' font-family='system-ui' font-size='12' font-weight='700' letter-spacing='2'>FROM</text><rect x='40' y='103' width='150' height='64' rx='14' fill='#082f49' stroke='#0ea5e9' stroke-width='2'/><text x='115' y='140' text-anchor='middle' fill='#e0f2fe' font-family='system-ui' font-size='15' font-weight='600'>Any node</text><text x='720' y='89' text-anchor='end' fill='#fda4af' font-family='system-ui' font-size='12' font-weight='700' letter-spacing='2'>TO</text><rect x='570' y='103' width='150' height='64' rx='14' fill='#4c0519' stroke='#fb7185' stroke-width='2'/><text x='645' y='140' text-anchor='middle' fill='#ffe4e6' font-family='system-ui' font-size='15' font-weight='600'>Any node</text><path d='M205 135 L555 135' fill='none' stroke='#075985' stroke-width='5' stroke-linecap='round' stroke-linejoin='round' opacity='1'/><path d='M205 135 L555 135' fill='none' stroke='#7dd3fc' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' opacity='1'/><path d='M564 135 L550 127 L550 143 Z' fill='#7dd3fc'/><rect x='324' y='160' width='112' height='34' rx='17' fill='#111827' stroke='#8b5cf6' stroke-width='2'/><text x='380' y='183' text-anchor='middle' fill='#f5f3ff' font-family='system-ui' font-size='13' font-weight='700'>Link</text></svg><figcaption style='margin-top:10px;font:400 13px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>Fig. 1</b> &nbsp;The edge as the editor draws it: straight, 2 strokes, an arrow at the end.</figcaption></figure><div style='display:flex;flex-wrap:wrap;flex-direction:row-reverse;align-items:flex-start;gap:32px 40px;padding-top:44px'><aside data-role='settings' style='flex:1 1 220px;min-width:0;padding-top:10px;border-top:3px solid #0f172a'><h2 style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>Settings</h2><dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid #cbd5e1'><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Key</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>link</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Label</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>Link</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Default edge type</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>reference</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Route</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>straight</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Arrow</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>end</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>From</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>Any node</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>To</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>Any node</dd><dt style='grid-column:1/-1;padding:9px 0 0px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Connection rule</dt><dd style='grid-column:1/-1;margin:0;padding:2px 0 9px;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>From any node to any node. The editor refuses any other connection.</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Strokes</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>2 painted</dd></dl></aside><div style='flex:999 1 380px;min-width:0'><section data-role='section'><h2 style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#6d28d9'>Description and rationale</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#1e293b'><span style='float:left;padding:6px 10px 0 0;font:500 68px/54px Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#0f172a'>A</span> link is an ordinary hyperlink: something here points at an address, on the web or anywhere else an address can name. It claims nothing about the thing it points at, and asks nothing of it.</p><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#1e293b'>A link is drawn in the workspace when both of its ends are there, however that comes about: the thing that holds the link, and whatever its address names.</p></section></div></div><blockquote data-role='rule' style='margin:48px 0 0;padding:32px 0;border-top:1px solid #0f172a;border-bottom:1px solid #0f172a'><p style='margin:0 0 12px;font:italic 500 clamp(30px,6.4cqw,46px)/1.1 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.015em;color:#6d28d9;text-wrap:balance'>From any node to any node.</p><p style='margin:0;font:400 14px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>The connection rule.</b> The editor refuses any other connection.</p></blockquote><div style='display:flex;flex-wrap:wrap;flex-direction:row-reverse;align-items:flex-start;gap:32px 40px;padding-top:44px'><figure data-role='paint' style='flex:1 1 220px;min-width:0;margin:0;padding-top:10px;border-top:3px solid #0f172a'><div style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>Paint order</div><div style='margin:0 0 14px'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 190 36' preserveAspectRatio='none' style='display:block;width:100%;height:36px'><rect width='190' height='36' fill='#0f172a'/><path d='M18 18 L172 18' fill='none' stroke='#075985' stroke-width='5' stroke-linecap='round'/></svg><div style='margin-top:6px;font:600 14px/20px system-ui;color:#0f172a'>1 · Stroke 1</div><div style='font:400 12px/18px ui-monospace,Cascadia Code,Consolas,monospace;color:#475569'>#075985 · 5 px · solid</div></div><div style='margin:0 0 14px'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 190 36' preserveAspectRatio='none' style='display:block;width:100%;height:36px'><rect width='190' height='36' fill='#0f172a'/><path d='M18 18 L172 18' fill='none' stroke='#7dd3fc' stroke-width='2' stroke-linecap='round'/></svg><div style='margin-top:6px;font:600 14px/20px system-ui;color:#0f172a'>2 · Stroke 2</div><div style='font:400 12px/18px ui-monospace,Cascadia Code,Consolas,monospace;color:#475569'>#7dd3fc · 2 px · solid</div></div><figcaption style='margin-top:10px;font:400 13px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>Fig. 2</b> &nbsp;Each stroke is painted over the one before it.</figcaption></figure><div style='flex:999 1 380px;min-width:0'><section data-role='section'><h2 style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#6d28d9'>Evidence</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#1e293b'>The links a graph holds are found in components/GraphEditor/utils/graphLinks.js: a Page Route’s destination, a node’s link, and the links written in Content. The workspace draws one, from the graph that holds it to the graph it points at, when both are open (components/GraphEditor/utils/workspaceBridge.js), and paints it with this class’s Strokes, route and arrow. An address that names something other than an open graph is not drawn yet.</p></section></div></div></div></div>"
        },
        "renderShape": {
          "kind": "html"
        },
        "identity": {
          "graphId": "edge-class-link"
        }
      }
    },
