    {
      "id": "bridge-where-this-lives",
      "type": "page-section",
      "label": "Where this lives",
      "position": {
        "x": 3000,
        "y": 150
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Where this lives",
        "body": "Source (twilite repository; the files still carry the old name):\n- `components/GraphEditor/utils/importExport.js`\n- `components/GraphEditor/utils/bridgeSettings.js`\n- `components/GraphEditor/utils/eventBridge.js`\n- `components/GraphEditor/utils/bridgeEvents.js`\n- `components/GraphEditor/components/BridgeEventsEditorSection.js`\n- `components/GraphEditor/utils/graphNodeContract.js`\n- `components/GraphEditor/utils/bridgeEditing.js`\n- `components/GraphEditor/Nodes/BridgeInlineEditor.js`\n\nFocused tests:\n- `tests/bridgeSettings.test.js`\n- `tests/bridgeEvents.test.js`",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Folder"
          },
          "baseLevel": "detail"
        },
        "_placement": {
