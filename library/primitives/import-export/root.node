    {
      "id": "bridge-ports",
      "type": "page-section",
      "label": "Ports and Relationships",
      "position": {
        "x": 2670,
        "y": -1636
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Ports and Relationships",
        "body": "An import or an export states cross-graph authority and participation. Its structural root socket and authored class/resource contract are distinct from the root's presentation Surface chains. Imports own cross-graph event subscriptions; exports expose emitter contracts. The Bridge drawn in the workspace is derived from an import and the export it uses, not a new authority record.\n\nPort/handle projections may be materialized by the runtime. Do not infer that every import is unconnected or that a Bridge line itself persists a grant.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592047777,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "fe331a1c-0790-447b-ad05-83ddc1898214"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any",
          "position": {
            "side": "top",
            "offset": 0.2
