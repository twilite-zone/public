    {
      "id": "bridge-ports",
      "type": "page-section",
      "label": "Ports and Relationships",
      "position": {
        "x": 2160,
        "y": -350
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Ports and Relationships",
        "body": "An import or an export states cross-graph authority and participation. Its structural root socket and authored class/resource contract are distinct from the root's presentation Surface chains. A Bridge carries no events today: a Method runs only through an `invokes` edge from an event port, in the same graph. Events across a Bridge are designed and not built (see Known gaps). The Bridge drawn in the workspace is derived from an import and the export it uses, not a new authority record.\n\nPort/handle projections may be materialized by the runtime. Do not infer that every import is unconnected or that a Bridge line itself persists a grant.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592047777,
          "reason": "bridge-reference"
        },
