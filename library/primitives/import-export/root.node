    {
      "id": "bridge-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -360,
        "y": 150
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Known gaps",
        "body": "Resource-kind support depends on the actual consumer. The library-kind reservation above remains a limitation, not a promised expansion path. Runtime delivery and browser connection behavior require their own smoke evidence.\n\n**Events across a Bridge: limits.** Only graphs that are open are reached; a closed graph hears nothing. A Method an event runs for a graph that is not in focus may use only `updateNode`; any other change is refused so it cannot land on the focused graph. The emitting graph never learns who listens. An earlier design carried subscriptions on the import; it was retired on 2026-10-16 with the Event Handler node, and this replaces it.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Rule"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
