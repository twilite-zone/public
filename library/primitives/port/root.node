    {
      "id": "port-ports",
      "type": "page-section",
      "label": "Ports and Relationships",
      "position": {
        "x": 2350,
        "y": -1596
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Ports and Relationships",
        "body": "A Port has a root interface socket and two relationships: `surfaces` (repeatable, to the first face of a chain, the same way the root does it) and `ground`. A Glyph is reached by walking a Surface chain to its end, not through a relationship of its own. A Port with a Surface shows its own faces and ends in its own Glyph, so a back-door Port can draw a back-door entrance. The retired default-view, summary-view and icon-view relationships are not written any more; some readers in the app still recognise them.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
