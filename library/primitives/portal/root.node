    {
      "id": "portal-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -410,
        "y": 200
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Known gaps",
        "body": "Mode support depends on the actual navigation caller; do not claim an arbitrary target.mode works everywhere. The Surface host integration task records remaining non-default host selection gaps.\n\nA Portal’s `target.mode` is stored by older graphs but changes nothing the editor offers, and no behaviour is known to depend on it.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Rule"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592072631,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "primitive-portal"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
