ht='76' rx='5' fill='none' stroke='#b5d4ff' stroke-width='3'/><path d='M22 35H64M22 45H47' stroke='#b5d4ff' stroke-width='3'/><rect x='22' y='57' width='76' height='29' rx='4' fill='#203b68' stroke='#80c9f2' stroke-width='2'/><path d='M30 71H73' stroke='#fff' stroke-width='3' stroke-linecap='round'/><path d='M84 63V79' stroke='#b5d4ff' stroke-width='2'/><circle cx='12' cy='72' r='5' fill='#fff'/><circle cx='108' cy='72' r='5' fill='#fff'/>\",\"method\":\"<rect x='31' y='15' width='65' height='90' rx='5' fill='none' stroke='#b5d4ff' stroke-width='3'/><path d='M9 38H31M22 29L31 38L22 47' fill='none' stroke='#fff' stroke-width='3'/><path d='M48 34L40 43L48 52M78 34L86 43L78 52M67 30L59 56' stroke='#b5d4ff' stroke-width='3' fill='none' stroke-linecap='round'/><path d='M39 67H88M45 81L50 86L58 77M65 82H85' stroke='#80c9f2' stroke-width='3' fill='none' stroke-linecap='round'/>\",\"import-and-export\":\"<rect x='8' y='20' width='38' height='80' rx='4' stroke='#b5d4ff' stroke-width='3' fill='none'/><rect x='74' y='20' width='38' height='80' rx='4' stroke='#b5d4ff' stroke-width='3' fill='none'/><path d='M18 34H36M18 43H32M84 34H102M84 43H98' stroke='#b5d4ff' stroke-width='2'/><rect x='40' y='50' width='12' height='20' rx='2' fill='#fff'/><rect x='68' y='50' width='12' height='20' rx='2' fill='#fff'/><path d='M52 60H68M61 53L68 60L61 67' stroke='#80c9f2' stroke-width='3' fill='none'/><path d='M18 84H36M84 84H102' stroke='#b5d4ff' stroke-width='2'/>\",\"portal\":\"<rect x='11' y='19' width='98' height='82' rx='5' stroke='#b5d4ff' stroke-width='3' fill='none'/><rect x='23' y='30' width='45' height='59' rx='4' stroke='#80c9f2' stroke-width='2' fill='#203b68'/><path d='M39 45L59 60L39 75Z' fill='#fff'/><path d='M60 60H100M90 50L100 60L90 70' fill='none' stroke='#b5d4ff' stroke-width='3' stroke-linejoin='round'/>\",\"membrane\":\"<rect x='15' y='19' width='90' height='82' rx='9' fill='none' stroke='#b5d4ff' stroke-width='3' stroke-dasharray='6 3'/><rect x='30' y='34' width='25' height='22' rx='3' fill='#80c9f2'/><rect x='64' y='65' width='25' height='22' rx='3' fill='#b5d4ff'/><path d='M55 45H76V65' stroke='#b5d4ff' stroke-width='2' fill='none'/><circle cx='15' cy='60' r='6' fill='#fff'/><circle cx='105' cy='60' r='6' fill='#fff'/><path d='M15 13V25M9 19H21M105 95V107M99 101H111' stroke='#80c9f2' stroke-width='2'/>\"}; return `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;height:100%;padding:4.5cqw;background:#294b83;border:1px solid #b5d4ff;border-radius:3cqw;color:#fff;font-family:system-ui;display:flex;flex-direction:column;overflow:hidden'><div style='font:750 4cqw/1.15 ui-monospace,monospace;letter-spacing:.1em;color:#b5d4ff;border-top:1px solid #80c9f2;padding-top:1.6cqw'>PRIMITIVE / ${escapeHtml(key.toUpperCase())}</div><div style='display:flex;flex:1;min-height:0;align-items:center;gap:3cqw'><div style='flex:1;min-width:0;font:800 13cqw/1.02 system-ui;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${escapeHtml(masthead.title || 'Primitive')}</div><div style='width:35cqw;aspect-ratio:1;flex:none'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Primitive schematic'><rect x='3' y='3' width='114' height='114' rx='6' fill='none' stroke='#80c9f2'/>${art[key] || art.root}</svg></div></div><div style='border-bottom:1px solid #80c9f2;padding-bottom:1.4cqw;color:#b5d4ff;font:750 3.6cqw/1.2 ui-monospace,monospace'>TWILITE / GRAPH LANGUAGE</div></div></div>`; };\n\n// --- Run --------------------------------------------------------------------------------------\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst pieces = nodes.filter((node) => ROLES.includes(roleOf(node)))\n  .map((node) => ({ role: roleOf(node), data: node.data || {} }));\n\nconst declaration = nodes.find((node) => node?.type === 'root');\n// The exposed views are reached by walking the Declaration's own Surface chain -- surfaces to the\n// first face, then next-face links to the next -- the same path every graph in the library uses.\nconst chainNext = (fromId) => edges.find((edge) => edge.source === fromId\n  && clean(edge.type) === 'next-face')?.target;\nconst surfaceEdge = edges.find((edge) => edge.source === declaration?.id\n  && clean(edge.type) === 'surface');\nconst detailId = surfaceEdge?.target || '';\nconst summaryId = detailId ? chainNext(detailId) || '' : '';\nconst byId = new Map(nodes.map((node) => [node.id, node]));\nconst detailFace = byId.get(detailId);\nconst summaryFace = byId.get(summaryId);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nconst iconFace = nodes.find((node) => clean(node.type) === 'face' && clean(node.data?.semanticLevel) === 'icon');\n\n// The Detail defines the graph's shape: the regular 3:2 card, drawn as one page that scrolls. The Summary and the window take it.\nconst RATIO = 2 / 3;\nconst DETAIL_WIDTH = 760;\nconst SUMMARY_WIDTH = 300;\nconst sizeOf = (width) => ({ width, height: Math.round(width * RATIO) });\n// A graph made from the template declares what its own Method may write. What it does not declare is left as it is.\nconst attempt = async (write) => { try { await write(); } catch (error) { /* not declared by this graph */ } };\n\nconst updated = [];\nif (detailFace) {\n  await api.updateView(detailFace.id, { content: { kind: 'html', value: stackPage(pieces) }, view: { ...(detailFace.data?.view || {}), scroll: 'page' } });\n  await attempt(() => api.updateNode(detailFace.id, sizeOf(DETAIL_WIDTH)));\n  updated.push(detailFace.id);\n}\nif (summaryFace) {\n  await api.updateView(summaryFace.id, { content: { kind: 'html', value: stackSummary(pieces) } });\n  await attempt(() => api.updateNode(summaryFace.id, sizeOf(SUMMARY_WIDTH)));\n  updated.push(summaryFace.id);\n}\nif (iconFace) await attempt(() => api.updateView(iconFace.id, { content: { kind: 'html', value: stackIcon(pieces) } }));\n// The Glyph is the page's mark: the first letter of its title.\nconst title = clean(pieces.find((piece) => piece.role === 'page-masthead')?.data.title) || 'Page';\nif (glyph) await attempt(() => api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'symbol', value: title.charAt(0).toUpperCase(), color: ACCENT } } }));\n\n// The window is the Detail's shape and holds everything the graph has. A graph whose environment is a page that stops at its own window (a poster, with a stage for\n// the graph) sizes the window to that page itself, so it is left as it is.\nconst windowIsOwn = nodes.some((node) => clean(node.type) === 'face' && clean(node.data?.view?.payload) === 'node.web.environment' && clean(node.data?.view?.fit) === 'window');\nif (declaration && !windowIsOwn) {\n  const placed = nodes.filter((node) => node.position).map((node) => (node === detailFace ? { ...node, ...sizeOf(DETAIL_WIDTH) } : node === summaryFace ? { ...node, ...sizeOf(SUMMARY_WIDTH) } : node));\n  const pad = 80;\n  let x0 = Math.min(...placed.map((node) => node.position.x)) - pad;\n  let y0 = Math.min(...placed.map((node) => node.position.y)) - pad;\n  let w = Math.max(...placed.map((node) => node.position.x + node.width)) + pad - x0;\n  let h = Math.max(...placed.map((node) => node.position.y + node.height)) + pad - y0;\n  if (w / h < 1 / RATIO) { const next = Math.round(h / RATIO); x0 -= Math.round((next - w) / 2); w = next; } else { const next = Math.round(w * RATIO); y0 -= Math.round((next - h) / 2); h = next; }\n  await attempt(() => api.updateNode(declaration.id, { data: { ...declaration.data, membrane: { ...(declaration.data?.membrane || {}), bounds: { x: Math.round(x0), y: Math.round(y0), width: Math.round(w), height: Math.round(h) } } } }));\n}\nreturn { updated, pieces: pieces.length };\n",
