        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;height:100%;padding:5cqw;background:#eef4fb;border:1px solid #a6bed9;border-top:2cqw solid #294b83;color:#182d4c;font-family:system-ui;display:flex;flex-direction:column;gap:2cqw;overflow:hidden'><div style='font:750 3.6cqw/1.15 ui-monospace,monospace;letter-spacing:.1em;color:#294b83'>PRIMITIVE / PORTAL</div><div style='font:800 11cqw/1.02 system-ui;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'>Portal</div><div style='font:550 4.8cqw/1.23 system-ui;color:#46617f;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>An opening from one graph into another graph’s interface.</div><div style='margin-top:auto;padding-top:1.5cqw;border-top:1px solid #a6bed9;font:700 3.4cqw/1.15 ui-monospace,monospace;color:#294b83'>10 SECTIONS / LANGUAGE CONTRACT</div></div></div>"
