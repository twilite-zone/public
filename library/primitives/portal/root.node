    {
      "id": "portal-invariants",
      "type": "page-section",
      "label": "Invariants",
      "position": {
        "x": 430,
        "y": -300
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Invariants",
        "body": "A Portal names another artifact without acquiring its authorship. Following, opening alongside and projecting a graph must preserve target identity and source provenance. A missing target is a resolution failure, not permission to invent a replacement node.",
