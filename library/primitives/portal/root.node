      "id": "portal-meaning",
      "type": "page-section",
      "label": "Meaning",
      "position": {
        "x": -410,
        "y": -100
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Meaning",
        "body": "An addressed opening that consumes or follows another graph’s exposed interface. Encoding: a `portal` node with a target and source provenance.\n\nA Portal is where one graph appears in another. It shows the target graph’s outside face: one of the faces the target offers, chosen for the room the Portal has. Going through it puts the visitor on the target’s ground, or in the graph as a whole when it has none.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592072626,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "primitive-portal"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "ports": [
        {
          "id": "root",
