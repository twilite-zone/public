    {
      "id": "portal-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": 2950,
        "y": -300
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Behavior",
        "body": "graphNavigationAddress resolves public exposure and the ground. workspaceCapabilities and the workspace loader open or focus target graph instances. A Page Route acts as a Portal in the graph: a click on it sends the same navigation request a Portal does (`utils/pageRoute.js`). A Portal only moves you. It has no expand mode; including a piece of a node is the Fragment's job.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
