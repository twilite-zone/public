    {
      "id": "assemble-page-method",
      "type": "method",
      "label": "Assemble the page",
      "position": {
        "x": 3460,
        "y": -1226
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Assemble the page",
        "parameters": [],
        "source": "// Assembles the page from its pieces and writes it into the views the Declaration exposes: the Detail (one page, in the regular 3:2 shape),\n// the Summary (the same shape, smaller) and the Glyph. It also writes their sizes and the window, which is the Detail's shape and holds\n// everything the graph has. The graph's change event runs it through an invokes edge, so the stored page is always current. It reads the\n// pieces in graph order and writes only what its declared effects say.\nconst ROLES = ['page-masthead', 'page-route', 'page-section', 'page-settings'];\n\nconst clean = (value) => String(value ?? '').trim();\nconst escapeHtml = (value) => clean(value)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\n// Rows are { label, value } pairs, or \"label: value\" lines.\nconst settingRows = (rows) => (Array.isArray(rows) ? rows : []).map((row) => {\n  if (row && typeof row === 'object') return [clean(row.label), clean(row.value)];\n  const text = clean(row);\n  const cut = text.indexOf(':');\n  return cut < 0 ? [text, ''] : [clean(text.slice(0, cut)), clean(text.slice(cut + 1))];\n}).filter(([name, value]) => name || value);\nconst roleOf = (node) => clean(node?.type);\n\n// --- How the page looks ------------------------------------------------------------------------\n// The page reads as an article. Inline styles only, attributes in single quotes, font names unquoted, and\n// every fluid size taken from the view's own width (cqw), because a View may be drawn at any size.\nconst SERIF = 'system-ui,Segoe UI,Arial,sans-serif';\nconst ACCENT = '#294b83';\nconst KICKER = 'font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase';\n// Escapes without trimming, for the rest of a paragraph after its first letter has been lifted out.\nconst escapeText = (value) => String(value ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst kicker = (text, color = ACCENT) => `<h2 style='margin:0 0 14px;${KICKER};color:${color}'>${escapeHtml(text)}</h2>`;\n// Body text. Paragraphs, bullet lists (one level of nesting), fenced code blocks and sub-headings, with `code` and\n// **bold** and [links](address) inside a line. Everything authored is escaped first; only these few marks become markup. The first\n// paragraph of the page's first section opens with a drop cap, when the section starts with a letter.\nconst MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst inlineText = (value) => escapeText(value)\n  .replace(/`([^`]+)`/g, (_, code) => `<code style='padding:1px 4px;border-radius:3px;background:#dce9f7;font:400 .84em ${MONO};overflow-wrap:anywhere'>${code}</code>`)\n  .replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>')\n  // A link written as [words](address) becomes a link, when the address is one Twilite or the web can open.\n  .replace(/\\[([^\\]]+)\\]\\(((?:tlz|https|github):\\/\\/[^\\s)]+)\\)/g, (_, words, address) => `<a href='${address}' style='color:${ACCENT};text-decoration:underline'>${words}</a>`);\nconst bodyBlocks = (value) => {\n  const lines = String(value ?? '').replace(/\\r\\n/g, '\\n').split('\\n');\n  const blocks = [];\n  let paragraph = [];\n  let afterBlank = true;\n  const flush = () => { if (paragraph.length) blocks.push({ kind: 'p', text: paragraph.join('\\n') }); paragraph = []; };\n  for (let index = 0; index < lines.length; index += 1) {\n    const line = lines[index];\n    if (/^```/.test(line.trim())) {\n      flush();\n      const code = [];\n      index += 1;\n      while (index < lines.length && !/^```/.test(lines[index].trim())) { code.push(lines[index]); index += 1; }\n      blocks.push({ kind: 'code', text: code.join('\\n') });\n      afterBlank = true;\n      continue;\n    }\n    if (!line.trim()) { flush(); afterBlank = true; continue; }\n    const heading = /^#{2,4} +(.+)$/.exec(line.trim());\n    if (heading) { flush(); blocks.push({ kind: 'h', text: heading[1] }); afterBlank = true; continue; }\n    const item = /^(\\s*)([-*]|\\d+[.)]) +(.*)$/.exec(line);\n    const last = blocks[blocks.length - 1];\n    if (item) {\n      flush();\n      // The list this item joins is the block just before it once a paragraph above it has been written out: a list that follows a line of text starts its own.\n      const tail = blocks[blocks.length - 1];\n      // A numbered item (1. 2. 3.) makes an ordered list. An indented item belongs to the list above whatever its marker; one at the left edge joins it only if it is the same kind.\n      const ordered = /\\d/.test(item[2]);\n      const list = tail?.kind === 'list' && !afterBlank && (item[1].length >= 2 || tail.ordered === ordered) ? tail : null;\n      const entry = { text: item[3], children: [] };\n      if (list && item[1].length >= 2 && list.items.length) list.items[list.items.length - 1].children.push(entry);\n      else if (list) list.items.push(entry);\n      else blocks.push({ kind: 'list', ordered, items: [entry] });\n      afterBlank = false;\n      continue;\n    }\n    // A line that follows a list item without a blank line between continues that item.\n    if (last?.kind === 'list' && !afterBlank && !paragraph.length) {\n      const owner = last.items[last.items.length - 1];\n      const target = owner.children.length ? owner.children[owner.children.length - 1] : owner;\n      target.text += ` ${line.trim()}`;\n      continue;\n    }\n    paragraph.push(line.trim());\n    afterBlank = false;\n  }\n  flush();\n  return blocks;\n};\nconst listMarkup = (items, nested, ordered = false) => `<${ordered ? 'ol' : 'ul'} style='margin:${nested ? '6px 0 0' : '0 0 14px'};padding-left:${ordered ? 26 : 22}px;${nested ? '' : `max-width:60ch;font:400 18px/1.55 ${SERIF};color:#253c58`}'>`\n  + items.map((item) => `<li style='margin:0 0 6px'>${inlineText(item.text)}${item.children.length ? listMarkup(item.children, true) : ''}</li>`).join('')\n  + `</${ordered ? 'ol' : 'ul'}>`;\nconst bodyText = (value, dropCap) => bodyBlocks(value).map((block, index) => {\n  if (block.kind === 'code') return `<pre style='margin:0 0 16px;padding:14px 16px;overflow-x:auto;white-space:pre;background:#dce9f7;border-left:3px solid ${ACCENT};font:400 13px/1.55 ${MONO};color:#182d4c'>${escapeText(block.text)}</pre>`;\n  if (block.kind === 'h') return `<h3 style='margin:22px 0 8px;font:700 15px/20px system-ui;color:#182d4c'>${inlineText(block.text)}</h3>`;\n  if (block.kind === 'list') return listMarkup(block.items, false, block.ordered);\n  const cap = false;\n  return `<p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 ${SERIF};color:#253c58'>`\n    + (cap ? `<span style='float:left;padding:6px 10px 0 0;font:500 68px/54px ${SERIF};color:#182d4c'>${block.text[0]}</span>` : '')\n    + `${inlineText(cap ? block.text.slice(1) : block.text).replace(/\\n/g, '<br>')}</p>`;\n}).join('');\n\n// --- One renderer per role: what that piece contributes ------------------------------------------\nconst RENDER = {\n  // The eyebrow is the nameplate, the title the headline, the subtitle the standfirst.\n  'page-masthead': (data) => `<header data-role='masthead'>`\n    + `<div style='padding:${clean(data.eyebrow) ? '10px 0' : '0'};border-top:6px solid ${ACCENT};${clean(data.eyebrow) ? 'border-bottom:1px solid #182d4c;' : ''}${KICKER};color:${ACCENT}'>${escapeHtml(data.eyebrow)}</div>`\n    + `<h1 style='margin:40px 0 0;font:850 clamp(36px,9.5cqw,72px)/.98 system-ui,sans-serif;letter-spacing:-.035em;text-wrap:balance;color:#182d4c'>${escapeHtml(data.title)}</h1>`\n    + (clean(data.subtitle) ? `<p style='margin:18px 0 0;max-width:36ch;font:400 clamp(20px,3.6cqw,26px)/1.4 ${SERIF};color:#46617f'>${escapeHtml(data.subtitle)}</p>` : '')\n    + `</header>`,\n  // A teaser: a rule, a title, a line or two, and where it leads. A primary route is drawn heavier.\n  'page-route': (data) => {\n    // Drawn as a Portal-style card when the route asks for it: a bordered card, the whole of which is the link.\n    if (clean(data.appearance).toLowerCase() === 'portal') {\n      const ref = /^(tlz|https|github):\\/\\//.test(clean(data.destinationRef)) ? clean(data.destinationRef) : '';\n      const tag = ref ? 'a' : 'div';\n      return `<${tag} data-role='route' data-appearance='portal'${ref ? ` href='${escapeHtml(ref)}'` : ''} style='height:100%;box-sizing:border-box;display:flex;flex-direction:column;gap:4px;padding:12px 16px;background:#f6c945;border:2px solid #171d26;border-radius:0;border-left:8px solid #171d26;text-decoration:none;color:#182d4c'>`\n        + `<span style='font:800 11px/14px system-ui;letter-spacing:.14em;color:#171d26'>${escapeHtml(clean(data.destinationLabel) || 'Open').toUpperCase()}</span>`\n        + `<h2 style='margin:0;font:800 22px/26px system-ui;letter-spacing:-.03em;color:#182d4c'>${escapeHtml(data.title)}</h2>`\n        + (clean(data.body) ? `<span style='font:400 13px/18px system-ui;color:#46617f'>${escapeHtml(data.body)}</span>` : '')\n        + `</${tag}>`;\n    }\n    const primary = clean(data.prominence).toLowerCase() !== 'secondary';\n    return `<section data-role='route' data-prominence='${primary ? 'primary' : 'secondary'}' style='height:100%;box-sizing:border-box;display:flex;flex-direction:column;`\n      + `${primary ? `padding-top:12px;border-top:3px solid ${ACCENT}` : 'padding-top:14px;border-top:1px solid #182d4c'}'>`\n      + `<h2 style='margin:0 0 8px;font:750 ${primary ? 26 : 22}px/1.1 system-ui;letter-spacing:-.01em;color:#182d4c'>${escapeHtml(data.title)}</h2>`\n      + (clean(data.body) ? `<p style='margin:0 0 10px;font:400 14px/1.55 system-ui;color:#46617f'>${escapeHtml(data.body)}</p>` : '')\n      // Where it leads is a link to the route's destination, when it names one Twilite or the web can open.\n      + (/^(tlz|https|github):\\/\\//.test(clean(data.destinationRef))\n        ? `<a data-role='route-link' href='${escapeHtml(clean(data.destinationRef))}' style='margin-top:auto;font:700 13px/20px system-ui;text-decoration:none;color:${primary ? ACCENT : '#46617f'}'>${escapeHtml(data.destinationLabel || 'Open')} →</a></section>`\n        : `<div style='margin-top:auto;font:700 13px/20px system-ui;color:${primary ? ACCENT : '#46617f'}'>${escapeHtml(data.destinationLabel || 'Open')} →</div></section>`);\n  },\n  // A ruled list. A short value sits beside its name; a long one runs underneath at the full width of the list.\n  'page-settings': (data) => `<section data-role='settings' style='padding-top:10px;border-top:3px solid #182d4c'>`\n    + kicker(data.title || 'Settings', '#182d4c')\n    + `<dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid #a6bed9'>`\n    + settingRows(data.rows).map(([name, value]) => {\n      const wide = value.length > 24;\n      const span = wide ? 'grid-column:1/-1;' : '';\n      return `<dt style='${span}padding:9px 0 ${wide ? 0 : 9}px;border-top:1px solid #a6bed9;font:400 13px/20px system-ui;color:#46617f'>${escapeHtml(name)}</dt>`\n        + `<dd style='${span}margin:0;padding:${wide ? '2px 0 9px' : '9px 0;border-top:1px solid #a6bed9;text-align:right'};font:600 14px/20px system-ui;color:#182d4c;overflow-wrap:anywhere'>${escapeHtml(value)}</dd>`;\n    }).join('')\n    + `</dl></section>`,\n  'page-section': (data, { dropCap }) => `<section data-role='section'>${kicker(data.title)}${bodyText(data.body, dropCap)}</section>`\n};\n\n// --- The three views --------------------------------------------------------------------------\n// The pieces stay in graph order. Three things sit side by side when the view is wide enough and stack when it\n// is not: routes that follow one another, and a settings list next to the section it comes before or after,\n// which is set as that section's sidebar. Everything else takes the full width. A role with no pieces\n// contributes nothing.\nconst stackPage = (pieces) => {\n  const firstSection = pieces.find((piece) => piece.role === 'page-section');\n  const render = (piece) => RENDER[piece.role](piece.data, { dropCap: piece === firstSection });\n  const text = (piece) => `<div style='flex:999 1 380px;min-width:0'>${render(piece)}</div>`;\n  const side = (piece) => `<div style='flex:1 1 220px;min-width:0'>${render(piece)}</div>`;\n  const row = (inner, gap, reverse) => `<div style='display:flex;flex-wrap:wrap;${reverse ? 'flex-direction:row-reverse;' : ''}align-items:${reverse === undefined ? 'stretch' : 'flex-start'};gap:${gap}'>${inner}</div>`;\n  const blocks = [];\n  for (let index = 0; index < pieces.length; index += 1) {\n    const piece = pieces[index];\n    const next = pieces[index + 1];\n    if (piece.role === 'page-route') {\n      const routes = [piece];\n      while (pieces[index + 1]?.role === 'page-route') { index += 1; routes.push(pieces[index]); }\n      blocks.push([40, row(routes.map((route) => `<div style='flex:1 1 190px;min-width:0'>${render(route)}</div>`).join(''), '28px 32px')]);\n    } else if (piece.role === 'page-section' && next?.role === 'page-settings') {\n      index += 1;\n      blocks.push([48, row(text(piece) + side(next), '32px 40px', false)]);\n    } else if (piece.role === 'page-settings' && next?.role === 'page-section') {\n      index += 1;\n      blocks.push([48, row(side(piece) + text(next), '32px 40px', true)]);\n    } else blocks.push([piece.role === 'page-masthead' ? 32 : 48, render(piece)]);\n  }\n  return `<div style='width:100%;height:100%;overflow:auto;box-sizing:border-box;container-type:inline-size;background:#eef4fb;font-family:${SERIF};color:#182d4c'>`\n    + `<div style='box-sizing:border-box;max-width:900px;margin:0 auto;padding:0 clamp(20px,5cqw,40px) 64px'>`\n    + blocks.map(([gap, inner]) => `<div style='padding-top:${gap}px'>${inner}</div>`).join('')\n    + `</div></div>`;\n};\n// A size drawn for one width that follows the width the view is actually shown at.\nconst fluid = (px, base) => `clamp(0.5px,${(px / base * 100).toFixed(2)}cqw,${Math.round(px * 1.5)}px)`;\nconst stackSummary = (pieces) => { const masthead = pieces.find(p => p.role === 'page-masthead')?.data || {}; const glance = pieces.find(p => p.role === 'page-settings')?.data || {}; const rawType = clean((glance.rows || []).find(r => ['node type','node types'].includes(clean(r.label).toLowerCase()))?.value).toLowerCase(); const key = rawType === 'import, export' ? 'import-and-export' : /^[a-z][a-z-]*$/.test(rawType) ? rawType : clean(masthead.title).toLowerCase().replace(/\\s+/g, '-') || 'primitive'; const sections = pieces.filter(p => p.role === 'page-section').length; const art = {\"root\":\"<path d='M60 40V61M20 61H100M20 61V80M60 61V80M100 61V80' stroke='#b5d4ff' stroke-width='4' fill='none'/><rect x='39' y='14' width='42' height='26' rx='4' fill='#fff'/><g fill='#b5d4ff'><rect x='8' y='80' width='24' height='23' rx='3'/><rect x='48' y='80' width='24' height='23' rx='3'/><rect x='88' y='80' width='24' height='23' rx='3'/></g>\",\"face\":\"<rect x='12' y='16' width='69' height='53' rx='4' fill='none' stroke='#b5d4ff' stroke-width='3'/><path d='M22 30H70M22 41H58M22 52H66' stroke='#b5d4ff' stroke-width='3'/><rect x='40' y='54' width='55' height='40' rx='4' fill='#294b83' stroke='#b5d4ff' stroke-width='3'/><path d='M50 67H84M50 78H74' stroke='#b5d4ff' stroke-width='3'/><rect x='83' y='83' width='26' height='26' rx='4' fill='#fff'/><circle cx='96' cy='96' r='5' fill='#294b83'/>\",\"glyph\":\"<path d='M60 15L70 44L101 44L76 63L86 94L60 75L34 94L44 63L19 44L50 44Z' fill='#b5d4ff' stroke='#fff' stroke-width='2' stroke-linejoin='round'/>\",\"content\":\"<rect x='23' y='15' width='74' height='90' rx='5' stroke='#b5d4ff' stroke-width='3' fill='none'/><path d='M35 30H85M35 42H74M35 54H85' stroke='#b5d4ff' stroke-width='3'/><rect x='35' y='65' width='50' height='27' rx='2' stroke='#b5d4ff' fill='none' stroke-width='2'/><circle cx='46' cy='73' r='4' fill='#fff'/><path d='M39 88L53 76L63 84L75 72L82 88Z' fill='#b5d4ff'/>\",\"port\":\"<rect x='12' y='18' width='54' height='84' rx='5' fill='none' stroke='#b5d4ff' stroke-width='3'/><circle cx='66' cy='60' r='12' fill='#294b83' stroke='#fff' stroke-width='3'/><circle cx='66' cy='60' r='4' fill='#fff'/><path d='M78 60H108' stroke='#b5d4ff' stroke-width='3'/><path d='M97 49L108 60L97 71' fill='none' stroke='#b5d4ff' stroke-width='3' stroke-linejoin='round'/>\",\"handle\":\"<rect x='12' y='20' width='54' height='80' rx='5' fill='none' stroke='#b5d4ff' stroke-width='3'/><circle cx='66' cy='60' r='20' fill='#294b83' stroke='#b5d4ff' stroke-width='3' stroke-dasharray='4 3'/><path d='M66 45L81 60L66 75L51 60Z' fill='#fff'/><circle cx='66' cy='60' r='5' fill='#294b83'/><path d='M87 60H110' stroke='#b5d4ff' stroke-width='2'/>\",\"edge\":\"<rect x='8' y='19' width='32' height='32' rx='4' fill='none' stroke='#b5d4ff' stroke-width='3'/><rect x='80' y='70' width='32' height='32' rx='4' fill='none' stroke='#b5d4ff' stroke-width='3'/><circle cx='40' cy='35' r='5' fill='#fff'/><circle cx='80' cy='86' r='5' fill='#fff'/><path d='M45 35H54Q60 35 60 41V80Q60 86 66 86H74' fill='none' stroke='#b5d4ff' stroke-width='4' stroke-linejoin='round'/>\",\"edge-class\":\"<rect x='12' y='14' width='96' height='92' rx='4' fill='none' stroke='#b5d4ff' stroke-width='2'/><path d='M20 34H100M20 74H100' stroke='#80c9f2' stroke-width='2'/><rect x='22' y='43' width='20' height='20' rx='3' fill='none' stroke='#b5d4ff' stroke-width='2'/><rect x='78' y='43' width='20' height='20' rx='3' fill='none' stroke='#b5d4ff' stroke-width='2'/><path d='M42 53H78M69 46L76 53L69 60' stroke='#fff' stroke-width='3' fill='none'/><path d='M24 87L29 92L37 83M46 88H94' fill='none' stroke='#b5d4ff' stroke-width='3' stroke-linecap='round'/>\",\"node-class\":\"<rect x='14' y='13' width='92' height='94' rx='5' fill='none' stroke='#b5d4ff' stroke-width='3'/><path d='M15 35H105M15 77H105M60 35V77' stroke='#80c9f2' stroke-width='2'/><path d='M25 24H77M25 47H49M25 58H44M25 69H49' stroke='#b5d4ff' stroke-width='3'/><rect x='70' y='43' width='25' height='25' rx='3' fill='none' stroke='#b5d4ff' stroke-width='2'/><circle cx='106' cy='55' r='5' fill='#fff'/><circle cx='14' cy='55' r='5' fill='#fff'/><path d='M25 89H49M25 96H43M71 90H94' stroke='#b5d4ff' stroke-width='3'/>\",\"property\":\"<rect x='12' y='22' width='96' height='76' rx='5' fill='none' stroke='#b5d4ff' stroke-width='3'/><path d='M22 35H64M22 45H47' stroke='#b5d4ff' stroke-width='3'/><rect x='22' y='57' width='76' height='29' rx='4' fill='#203b68' stroke='#80c9f2' stroke-width='2'/><path d='M30 71H73' stroke='#fff' stroke-width='3' stroke-linecap='round'/><path d='M84 63V79' stroke='#b5d4ff' stroke-width='2'/><circle cx='12' cy='72' r='5' fill='#fff'/><circle cx='108' cy='72' r='5' fill='#fff'/>\",\"method\":\"<rect x='31' y='15' width='65' height='90' rx='5' fill='none' stroke='#b5d4ff' stroke-width='3'/><path d='M9 38H31M22 29L31 38L22 47' fill='none' stroke='#fff' stroke-width='3'/><path d='M48 34L40 43L48 52M78 34L86 43L78 52M67 30L59 56' stroke='#b5d4ff' stroke-width='3' fill='none' stroke-linecap='round'/><path d='M39 67H88M45 81L50 86L58 77M65 82H85' stroke='#80c9f2' stroke-width='3' fill='none' stroke-linecap='round'/>\",\"import-and-export\":\"<rect x='8' y='20' width='38' height='80' rx='4' stroke='#b5d4ff' stroke-width='3' fill='none'/><rect x='74' y='20' width='38' height='80' rx='4' stroke='#b5d4ff' stroke-width='3' fill='none'/><path d='M18 34H36M18 43H32M84 34H102M84 43H98' stroke='#b5d4ff' stroke-width='2'/><rect x='40' y='50' width='12' height='20' rx='2' fill='#fff'/><rect x='68' y='50' width='12' height='20' rx='2' fill='#fff'/><path d='M52 60H68M61 53L68 60L61 67' stroke='#80c9f2' stroke-width='3' fill='none'/><path d='M18 84H36M84 84H102' stroke='#b5d4ff' stroke-width='2'/>\",\"portal\":\"<rect x='11' y='19' width='98' height='82' rx='5' stroke='#b5d4ff' stroke-width='3' fill='none'/><rect x='23' y='30' width='45' height='59' rx='4' stroke='#80c9f2' stroke-width='2' fill='#203b68'/><path d='M39 45L59 60L39 75Z' fill='#fff'/><path d='M60 60H100M90 50L100 60L90 70' fill='none' stroke='#b5d4ff' stroke-width='3' stroke-linejoin='round'/>\",\"membrane\":\"<rect x='15' y='19' width='90' height='82' rx='9' fill='none' stroke='#b5d4ff' stroke-width='3' stroke-dasharray='6 3'/><rect x='30' y='34' width='25' height='22' rx='3' fill='#80c9f2'/><rect x='64' y='65' width='25' height='22' rx='3' fill='#b5d4ff'/><path d='M55 45H76V65' stroke='#b5d4ff' stroke-width='2' fill='none'/><circle cx='15' cy='60' r='6' fill='#fff'/><circle cx='105' cy='60' r='6' fill='#fff'/><path d='M15 13V25M9 19H21M105 95V107M99 101H111' stroke='#80c9f2' stroke-width='2'/>\"}; return `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;height:100%;padding:5cqw;background:#eef4fb;border:1px solid #a6bed9;border-top:2cqw solid #294b83;color:#182d4c;font-family:system-ui;display:flex;flex-direction:column;gap:2cqw;overflow:hidden'><div style='font:750 3.6cqw/1.15 ui-monospace,monospace;letter-spacing:.1em;color:#294b83'>PRIMITIVE / ${escapeHtml(key.toUpperCase())}</div><div style='font:800 11cqw/1.02 system-ui;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'>${escapeHtml(masthead.title || 'Untitled primitive')}</div><div style='font:550 4.8cqw/1.23 system-ui;color:#46617f;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${escapeHtml(masthead.subtitle || '')}</div><div style='margin-top:auto;padding-top:1.5cqw;border-top:1px solid #a6bed9;font:700 3.4cqw/1.15 ui-monospace,monospace;color:#294b83'>${sections} SECTIONS / LANGUAGE CONTRACT</div></div></div>`; };\nconst stackIcon = (pieces) => { const masthead = pieces.find(p => p.role === 'page-masthead')?.data || {}; const glance = pieces.find(p => p.role === 'page-settings')?.data || {}; const rawType = clean((glance.rows || []).find(r => ['node type','node types'].includes(clean(r.label).toLowerCase()))?.value).toLowerCase(); const key = rawType === 'import, export' ? 'import-and-export' : /^[a-z][a-z-]*$/.test(rawType) ? rawType : clean(masthead.title).toLowerCase().replace(/\\s+/g, '-') || 'primitive'; const sections = pieces.filter(p => p.role === 'page-section').length; const art = {\"root\":\"<path d='M60 40V61M20 61H100M20 61V80M60 61V80M100 61V80' stroke='#b5d4ff' stroke-width='4' fill='none'/><rect x='39' y='14' width='42' height='26' rx='4' fill='#fff'/><g fill='#b5d4ff'><rect x='8' y='80' width='24' height='23' rx='3'/><rect x='48' y='80' width='24' height='23' rx='3'/><rect x='88' y='80' width='24' height='23' rx='3'/></g>\",\"face\":\"<rect x='12' y='16' width='69' height='53' rx='4' fill='none' stroke='#b5d4ff' stroke-width='3'/><path d='M22 30H70M22 41H58M22 52H66' stroke='#b5d4ff' stroke-width='3'/><rect x='40' y='54' width='55' height='40' rx='4' fill='#294b83' stroke='#b5d4ff' stroke-width='3'/><path d='M50 67H84M50 78H74' stroke='#b5d4ff' stroke-width='3'/><rect x='83' y='83' width='26' height='26' rx='4' fill='#fff'/><circle cx='96' cy='96' r='5' fill='#294b83'/>\",\"glyph\":\"<path d='M60 15L70 44L101 44L76 63L86 94L60 75L34 94L44 63L19 44L50 44Z' fill='#b5d4ff' stroke='#fff' stroke-width='2' stroke-linejoin='round'/>\",\"content\":\"<rect x='23' y='15' width='74' height='90' rx='5' stroke='#b5d4ff' stroke-width='3' fill='none'/><path d='M35 30H85M35 42H74M35 54H85' stroke='#b5d4ff' stroke-width='3'/><rect x='35' y='65' width='50' height='27' rx='2' stroke='#b5d4ff' fill='none' stroke-width='2'/><circle cx='46' cy='73' r='4' fill='#fff'/><path d='M39 88L53 76L63 84L75 72L82 88Z' fill='#b5d4ff'/>\",\"port\":\"<rect x='12' y='18' width='54' height='84' rx='5' fill='none' stroke='#b5d4ff' stroke-width='3'/><circle cx='66' cy='60' r='12' fill='#294b83' stroke='#fff' stroke-width='3'/><circle cx='66' cy='60' r='4' fill='#fff'/><path d='M78 60H108' stroke='#b5d4ff' stroke-width='3'/><path d='M97 49L108 60L97 71' fill