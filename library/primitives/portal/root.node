      "type": "page-section",
      "label": "Explicitly Not Part of This Primitive",
      "position": {
        "x": 1270,
        "y": 200
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Explicitly Not Part of This Primitive",
        "body": "Not an import’s grant, not a face, and not an instruction to normalize or rewrite the target graph.\n\nNot a Fragment. A Portal goes somewhere; a Fragment includes a piece of the node you are in.",
