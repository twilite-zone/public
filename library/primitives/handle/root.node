    {
      "id": "handle-ports",
      "type": "page-section",
      "label": "Ports and Relationships",
      "position": {
        "x": 2250,
        "y": -1536
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Ports and Relationships",
        "body": "A Handle is not a node in the graph that uses it, and it has no Ports of its own. The Port names it by address; nothing is drawn between them. An older `handle` relationship from a Port to a Handle was cut from the model and cannot be created.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
