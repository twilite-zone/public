    {
      "id": "handle-meaning",
      "type": "page-section",
      "label": "Meaning",
      "position": {
        "x": 10,
        "y": -1536
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Meaning",
        "body": "**What is this thing?** A Handle is how a Port is drawn. It is decoration: the Port connects, accepts and refuses exactly the same with or without it. A Port with no Handle is drawn as a plain disc with a ring and a glyph. A Handle can be set on a Port, or by the graph's root for every Port the graph exposes; the Port's own wins. A Handle is a small graph whose view holds the art (SVG, HTML or canvas). The art is drawn whole with its centre on the border, as the plain disc is. Keep it small and quiet.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070375,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "primitive-handle"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
