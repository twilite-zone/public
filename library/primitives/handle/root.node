        "y": -1176
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Representations",
        "body": "SVG, HTML or canvas, in the view of a small graph. The plain disc (a disc, a ring, and a glyph or a pip) is the default. Canon has two examples, a ring and a diamond.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
