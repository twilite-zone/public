    {
      "id": "handle-boundary",
      "type": "page-section",
      "label": "Explicitly Not Part of This Primitive",
      "position": {
        "x": 110,
        "y": -1176
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Explicitly Not Part of This Primitive",
        "body": "- It is not the Port. A Port is what it connects; a Handle is how it is drawn.\n- It is not the node's glyph, which is the small picture standing for the whole graph.\n- It is not a way to show type or direction. Colour and shape that carry meaning belong to the Port's type, not to its Handle.\n- It is not a connection.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
