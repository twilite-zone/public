      "data": {
        "title": "At a glance",
        "rows": [
          {
            "label": "Node type",
            "value": "none: a Handle is a small graph that a Port points at"
          },
          {
            "label": "Shown when browsing",
            "value": "Yes: the art is always drawn; it takes the pointer while editing"
          },
          {
            "label": "Encoded as",
            "value": "`handlePresentation` on a Port or node, or `defaultHandle` on the root, naming a graph whose view holds the art"
          }
        ],
        "presentation": {
