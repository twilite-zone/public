    {
      "id": "handle-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -780,
        "y": 250
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Known gaps",
        "body": "- The type glyph is drawn over the art, which hides text in it. Art with letters in it reads badly.\n- The picker offers only the canon Handles. Using another still means writing its address as `data.handlePresentation` under Advanced, or from a Method.\n- Nothing checks the art's size, so a large Handle can cover its node.\n- A Handle graph that cannot be fetched falls back to the plain disc without saying so.\n- The canon smoke suite for graph-defined Handles was built before the art was drawn whole on the border, and has not been looked at since.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Rule"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070381,
          "reason": "bridge-reference"
        },
