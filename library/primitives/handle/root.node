    {
      "id": "handle-contract",
      "type": "page-section",
      "label": "Contract",
      "position": {
        "x": 1690,
        "y": -1536
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Contract",
        "body": "- A Port or node names a Handle with `data.handlePresentation` (older: `data.handleRef`); the root names its default with `data.defaultHandle`. The value is an address, or `{ sourceRef, sourceNodeId, sourcePayload }`, where `sourceNodeId` is the id of the root of the Handle graph.\n- The Handle graph's view has the payload `handle.web` and holds one of `svg`, `html` or `canvas`. It may give `width` and `height` (44 by 32 if not), a `hotspot` (the centre if not) and a `rotation`.\n- The art points along its own +X, and is turned so that +X faces away from the node.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070379,
          "reason": "bridge-reference"
        },
        "identity": {
