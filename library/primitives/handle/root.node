    {
      "id": "handle-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": 2810,
        "y": -1536
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Behavior",
        "body": "- The art is drawn whole, with its hotspot on the node's border, in the graph editor and on a workspace tile.\n- While editing, every Port on every node can be dragged from, whatever it wears. While browsing, only the focused node's Ports can.\n- On a workspace tile a drawn Handle stays on the border at any size, and gives way to the glyph below 6% zoom. A plain handle comes out when the tile is pointed at.\n- The Handle's name appears in a tooltip. A sign beside it appears only while a connection is being dragged, or on a handle that leads somewhere.\n- Handles on one side that would sit too close are spread along it so that their labels do not overlap.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070381,
          "reason": "bridge-reference"
        },
        "identity": {
