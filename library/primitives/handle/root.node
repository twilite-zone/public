      "width": 520,
      "height": 320,
      "data": {
        "title": "Where this lives",
        "body": "Source (twilite repository):\n- `components/NodeGraph/graphHandlePresentation.js`\n- `components/NodeGraph/GraphHandleVisual.js`\n- `components/NodeGraph/HandleLayer.js`\n- `components/NodeGraph/handleSpread.js`\n- `components/NodeGraph/handleVisibility.js`\n- `components/GraphEditor/utils/workspaceCapabilities.js`\n- `components/GraphEditor/components/WorkspaceLayer.js`\n\nFocused tests (twilite repository):\n- `tests/graphHandlePresentation.test.js`\n- `tests/handleDrag.test.js`\n- `tests/handleSpread.test.js`\n- `tests/handleVisibility.test.js`\n- `tests/workspaceCapabilities.test.js`\n\nThese pointers identify evidence to inspect. Structural validation does not prove runtime or browser behavior.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Folder"
          },
          "baseLevel": "detail"
        },
