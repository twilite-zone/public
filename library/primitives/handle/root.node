    {
      "id": "handle-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -1010,
        "y": -1176
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Known gaps",
        "body": "- The type glyph is drawn over the art, which hides text in it. Art with letters in it reads badly.\n- There is no control for a Handle in the Properties panel. It is set by writing the path in Advanced, or from a Method.\n- Nothing checks the art's size, so a large Handle can cover its node.\n- A Handle graph that cannot be fetched falls back to the plain disc without saying so.\n- The canon smoke suite for graph-defined Handles was built before the art was drawn whole on the border, and has not been looked at since.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Rule"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070381,
          "reason": "bridge-reference"
