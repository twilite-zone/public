      "width": 720,
      "height": 380,
      "data": {
        "title": "Meaning",
        "body": "Durable material that a face or another reader can consume. Encoding: a `content` node with a typed payload, independent of how many presentations use it.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
