    {
      "id": "content-representations",
      "type": "page-section",
      "label": "Representations",
      "position": {
        "x": 380,
        "y": 80
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Representations",
        "body": "One Content value can have several Views. Material kind selects a payload renderer; Surface and View selection choose the presentation. A selected representation uses the existing workspace frame. Surface and resolution changes do not implicitly resize it, reflow neighbors or change camera zoom. Focusing a graph draws it at its own authored size, whatever size it was dragged to in the workspace while it was not focused; that workspace size is kept for when focus leaves and never changes the graph. Manual resizing is explicit: on a focused graph it sets the graph’s own window, on an unfocused one only its size in this workspace. Internal nodes, edges, handles and pointer targets are clipped; exposed boundary controls remain accessible. Workspace title bars belong to View representations (including glyph-shaped artwork), not a terminal Glyph.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "definitionKey": "page-section",
