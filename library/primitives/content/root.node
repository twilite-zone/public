    {
      "id": "content-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -1170,
        "y": 450
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Known gaps",
        "body": "The previous plan listed only six kinds; the payload normalizer also recognizes canvas. This spec documents all seven without promoting canvas rendering into a new semantic primitive. Browser rendering and external image delivery are separate from payload normalization tests.\n\nRenderer boundary: The content normalizer and inline preview mapper recognize canvas, but ContentNode and ViewContentPayload currently use a fallback textual preview rather than a dedicated canvas renderer. Accepting a payload kind in the normalizer does not prove every face host has a dedicated renderer for it.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Rule"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592050118,
          "reason": "bridge-reference"
        },
        "identity": {
