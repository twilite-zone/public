    {
      "id": "view-invariants",
      "type": "page-section",
      "label": "Invariants",
      "position": {
        "x": 290,
        "y": -40
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Invariants",
        "body": "A face may render glyph-shaped artwork without being named Icon. It is still a face. Every authored Surface starts with at least one face and ends in its ordinary Glyph; the terminal Glyph does not replace the face, and a Glyph is not a face.\n\nA face can be shared by more than one valid chain. Its geometry and resolution requirement are distinct from the owning graph frame. Graph-facing presentation and the root node's own class presentation have different owners.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
