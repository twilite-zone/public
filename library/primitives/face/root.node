    {
      "id": "view-meaning",
      "type": "page-section",
      "label": "Meaning",
      "position": {
        "x": -550,
        "y": -40
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Meaning",
        "body": "One way a node or graph looks. Encoding: a `face` node. A Surface is a chain of faces joined by `next-face` edges and ended by a Glyph; a host selects the face that fits.\n\nFaces are named by their author. Detail, Summary and Icon are the usual names, not required ones: a graph can name its faces anything, and they work the same way.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
