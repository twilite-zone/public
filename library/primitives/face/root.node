    {
      "id": "view-boundary",
      "type": "page-section",
      "label": "Explicitly Not Part of This Primitive",
      "position": {
        "x": 1130,
        "y": 460
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Explicitly Not Part of This Primitive",
        "body": "A face is not the material itself, not a camera, and not an instruction to resize the graph. Its name does not make a semantic primitive named Detail, Summary or Icon. A Glyph is not a face: it is a node's mark, and it ends the chain of faces.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
