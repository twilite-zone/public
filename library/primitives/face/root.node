    {
      "id": "view-ports",
      "type": "page-section",
      "label": "Ports and Relationships",
      "position": {
        "x": 1970,
        "y": -40
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Ports and Relationships",
        "body": "`root` receives the `surface` edge from the graph's root (or the `next-face` edge from the face before it); `surface-delegate` selects material; `sequence-in` and `sequence-out` carry the `next-face` edges of a chain. A Port reaches its faces the same way, through its own `surfaces` relationship.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
