    {
      "id": "view-contract",
      "type": "page-section",
      "label": "Contract",
      "position": {
        "x": 1130,
        "y": -40
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Contract",
        "body": "`data.name` is the face's name, chosen by its author; without one, its exposure level, payload or label stands in. `data.view` describes intent, payload and optional enabled state. Payload names such as node.web.detail and editor.web identify web-host intent; they are not a fixed three-step ontology. `data.semanticZoom.resolution` participates in continuous selection. A face owns `data.content` or delegates to Content.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
