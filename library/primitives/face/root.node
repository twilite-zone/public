    {
      "id": "view-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -550,
        "y": 460
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Known gaps",
        "body": "Graph presentation and node-class presentation still have separate callers. The workspace bands faces by resolution or by the payload names for detail, summary and icon; a freely named face with no resolution of its own is not yet chosen there. The dedicated root renderer and full host/3D integration remain tracked in tlz://twilite.zone/tasks/declaration-surfaces/root.node. Do not claim uniform dispatch merely because the shared resolver exists.",
        "presentation": {
