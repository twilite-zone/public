    {
      "id": "view-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": 2810,
        "y": -40
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Behavior",
        "body": "viewResolution computes continuous requirements and selects a fitting entry; viewSequence resolves names and fallbacks. surfaceChains scopes candidates and glyphs to a selected Surface; graphViewPresentation uses that selection. A disabled face is unavailable to resolvers that honor availability. Host/payload selection is not camera control.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
