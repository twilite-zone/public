    {
      "id": "view-examples",
      "type": "page-section",
      "label": "Examples",
      "position": {
        "x": 1970,
        "y": 460
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Examples",
        "body": "The linked example is a separate graph. Inspect its relevant nodes and relationships; this specification does not embed or execute the example.\n\nThe Page Template has three faces in one Surface chain: Detail, Summary and Icon. Each holds its own content, which the template's Method writes from the page's pieces.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
