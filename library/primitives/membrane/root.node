    {
      "id": "membrane-invariants",
      "type": "page-section",
      "label": "Invariants",
      "position": {
        "x": -10,
        "y": -200
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Invariants",
        "body": "A boundary encloses a graph instance; it does not transfer ownership of nodes outside its outline. A custom control chain must be complete and unbranched. A selected representation uses the existing workspace frame. Surface and resolution changes do not implicitly resize it, reflow neighbors or change camera zoom. Focusing a graph draws it at its own authored size, whatever size it was dragged to in the workspace while it was not focused; that workspace size is kept for when focus leaves and never changes the graph. Manual resizing is explicit: on a focused graph it sets the graph’s own window, on an unfocused one only its size in this workspace. Internal nodes, edges, handles and pointer targets are clipped; exposed boundary controls remain accessible. Workspace title bars belong to faces (including glyph-shaped artwork), not a terminal Glyph.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592065869,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "primitive-membrane"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
