    {
      "id": "membrane-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": 2510,
        "y": -200
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Behavior",
        "body": "membraneChain traverses the authored chain; membraneGeometry derives the outline. validateGraphInvariants reports MEMBRANE_CHAIN_INCOMPLETE. graphWorkspace resizeWorkspaceInstance decides what a drag on a graph’s corner means: on a focused graph resizeGraphMembrane stores explicit bounds on the root, and on an unfocused one only a size for this workspace is kept and the graph is not touched. activeFrameClip computes the internal clip. Workspace layout uses the resulting frame rather than semantic-level screen-size substitutions.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592065871,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "primitive-membrane"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
