    {
      "id": "membrane-meaning",
      "type": "page-section",
      "label": "Meaning",
      "position": {
        "x": -850,
        "y": -200
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Meaning",
        "body": "The graph boundary that contains its internal presentation and locates exposed controls. Encoding: an authored frame and, optionally, a chain of membrane control nodes. Boundary meaning is distinct from the nodes used to draw it.",
