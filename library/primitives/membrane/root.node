    {
      "id": "membrane-ports",
      "type": "page-section",
      "label": "Ports and Relationships",
      "position": {
        "x": 1670,
        "y": -200
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Ports and Relationships",
        "body": "Boundary control nodes have root/next sockets; membrane edges connect them. The complete path determines a closed geometric outline. Ports, imports and exports may be placed on that outline without becoming the control chain itself.",
