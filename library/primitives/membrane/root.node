    {
      "id": "membrane-contract",
      "type": "page-section",
      "label": "Contract",
      "position": {
        "x": 830,
        "y": -200
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Contract",
        "body": "The root’s boundary-begin/boundary-end relationships delimit the control chain; membrane nodes carry position and segmentToNext. graphWorkspace also reads the root’s `data.membrane`: its bounds, aspect ratio and clip state. The root’s `ground` edge supplies the default interface frame.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592065869,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "primitive-membrane"
