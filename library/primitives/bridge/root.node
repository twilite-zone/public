            "name": "Page Section",
            "version": "0.8.1",
            "description": ""
          },
          "intent": "node-class",
          "meaning": "",
          "description": "",
          "defaults": {
            "label": "Page Section",
            "size": {
              "width": 520,
              "height": 320
            },
            "showLabel": false,
            "ports": [
              {
                "id": "root",
