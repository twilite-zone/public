    {
      "id": "specification-examples",
      "type": "page-section",
      "label": "Examples",
      "position": {
        "x": 380,
        "y": 440
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Examples",
        "body": "The linked example is a separate graph. Inspect its relevant nodes and relationships; this specification does not embed or execute the example.\n\nThe Glyph specification is one page written to this form: the ten sections in order, an “At a glance” list and an example link, built from the Page Template.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
