    {
      "id": "specification-representations",
      "type": "page-section",
      "label": "Representations",
      "position": {
        "x": 380,
        "y": 80
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Representations",
        "body": "A spec is a page built from the Page Template: one Bridge to that template, a masthead, an “At a glance” list, the eight sections as Page Section nodes and a Page Route for each example. The template’s Method assembles them into the Detail, Summary and Icon Views. The Detail View is the page a reader sees; the pieces themselves are hidden when browsing. The Declaration is top left, the pieces in the interior, the Views along the bottom. Preserve existing stable IDs. The View chain ends in a Glyph. A View may render glyph-shaped artwork without being an icon View. It is still a View representation. Every authored Surface starts with at least one View and ends in its ordinary Glyph; the terminal Glyph does not replace the View.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "definitionKey": "page-section",
