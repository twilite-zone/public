    {
      "id": "surface-invariants",
      "type": "page-section",
      "label": "Invariants",
      "position": {
        "x": 310,
        "y": 0
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Invariants",
        "body": "A Surface is a chain face → … → Glyph, and its id is on the `surface` edge. See Face and Root.",
