    {
      "id": "surface-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": 2830,
        "y": 0
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Behavior",
        "body": "A host chooses a Surface before it chooses a face. A host that names a Surface gets it. Without a request, the root’s `defaultSurfaceId` answers, else the first Surface. A Surface the host cannot render anything of is never chosen. The web canvas is the only host that asks today.\n\n`collectSurfaceChains` reads every Surface of a graph, and `resolveSurface` makes the choice (`utils/surfaceChains.js`).",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592079326,
          "reason": "bridge-reference"
        },
