    {
      "id": "surface-meaning",
      "type": "page-section",
      "label": "Meaning",
      "position": {
        "x": -530,
        "y": 0
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Meaning",
        "body": "A Surface is not a node. It is a relationship: a chain of faces that ends in a Glyph, named by the `surface` edge from the root’s `surfaces` port. The chain is the Face page, and the port and the edge are the Root page. This page keeps the one idea written nowhere else: a graph may offer more than one chain, each for a different host, and a host chooses one. The case it was written for: a node that is ordinary on the graph canvas but needs a different continuum on a map, because a map measures apparent size, not screen occupancy.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592079321,
          "reason": "bridge-reference"
        },
        "identity": {
