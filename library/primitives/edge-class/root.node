    {
      "id": "edge-class-contract",
      "type": "page-section",
      "label": "Contract",
      "position": {
        "x": -180,
        "y": -280
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Contract",
        "body": "edgeClassRule reads key, sourceKinds, targetKinds, maxOutgoing and maxIncoming. Empty kind lists or any permit all kinds; absent limits are unbounded. Numeric limits are nonnegative integer bounds. Classes also carry presentation/stroke information read by edgeClass.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
