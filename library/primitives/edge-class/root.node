    {
      "id": "edge-class-examples",
      "type": "page-section",
      "label": "Examples",
      "position": {
        "x": 1290,
        "y": 250
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Examples",
        "body": "The linked example is a separate graph. Inspect its relevant nodes and relationships; this specification does not embed or execute the example.\n\nThe `leads-to` class says one thing follows from another, and joins any source to any target. The `invokes` class ends only at a Method. The Surface Edge Class states its meaning, its kinds and its limits as Properties, and its paint as Strokes.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
