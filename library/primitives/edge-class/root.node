    {
      "id": "edge-class-representations",
      "type": "page-section",
      "label": "Representations",
      "position": {
        "x": -390,
        "y": 250
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Representations",
        "body": "A class is a graph: a Property for each rule and render setting, and a Stroke node for each paint layer. A Stroke paints because it is in the graph, not because anything connects it; a stroke that should not paint is disabled.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
