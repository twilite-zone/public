    {
      "id": "glyph-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": 2830,
        "y": -300
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Behavior",
        "body": "TypeGlyph resolves known icon names and symbolic characters. collectSurfaceChains stops at the first Glyph and diagnoses continuation; resolveSurfaceGlyph selects the terminal mark and declared fallback.",
