    {
      "id": "glyph-where-this-lives",
      "type": "page-section",
      "label": "Where this lives",
      "position": {
        "x": 2830,
        "y": 200
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Where this lives",
        "body": "Source (twilite repository):\n- `components/GraphEditor/components/TypeGlyph.js`\n- `components/GraphEditor/utils/glyphDefinition.js`\n- `components/GraphEditor/utils/surfaceChains.js`\n- `components/GraphEditor/utils/portDeclarations.js`\n- `components/GraphEditor/utils/glyphFonts.js`\n- `components/GraphEditor/Nodes/GlyphInlineEditor.js`\n\nFocused tests (twilite repository):\n- `tests/glyphDefinition.test.js`\n- `tests/surfaceChains.test.js`\n- `tests/hitboxGlyph.test.js`\n- `tests/glyphInlineEditor.test.js`\n- `tests/glyphCharacters.test.js`\n- `tests/glyphFonts.test.js`\n\nThese pointers identify evidence to inspect. Structural validation does not prove runtime or browser behavior.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Folder"
          },
          "baseLevel": "detail"
        },
