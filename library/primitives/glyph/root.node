    {
      "id": "glyph-contract",
      "type": "page-section",
      "label": "Contract",
      "position": {
        "x": -180,
        "y": -280
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Contract",
        "body": "TypeGlyph reads named icon definitions `{kind: \"icon\", name}`, text/symbol definitions with value/symbol/name, as object definitions. An older graph may contain a bare string, but TypeGlyph does not treat a bare string as an authored icon or symbol object. Text is limited to one grapheme by getSingleCharacterGlyph. Readers differ: surfaceChains extracts object glyph definitions; callers retain compatibility fallbacks. Do not assume every reader accepts every older form identically.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
