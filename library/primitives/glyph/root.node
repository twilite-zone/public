    {
      "id": "glyph-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -530,
        "y": 200
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Known gaps",
        "body": "Bare-string compatibility belongs to the concrete reader; current object-only extraction in surfaceChains means broad claims of universal string support need a dedicated regression. The smallest workspace representation’s interaction policy remains a product question, not a reason to add a title bar to Glyph.\n\n**Still open.** The workspace interaction policy at terminal Glyph scale is still open. The accepted boundary is that a face drawing glyph-shaped artwork remains a face, and a terminal Glyph does not get a graph title bar. This spec does not decide new glyph zoom/navigation behavior.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Rule"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592063635,
          "reason": "bridge-reference"
        },
        "identity": {
