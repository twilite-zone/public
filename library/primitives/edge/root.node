    {
      "id": "edge-contract",
      "type": "page-section",
      "label": "Contract",
      "position": {
        "x": 800,
        "y": -300
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Contract",
        "body": "An edge records id, source, target, sourcePort/targetPort, type and data. Its `type` is its kind: the key of its class, or `edge` for an edge with no class. `data.classRef` names the class graph. An edge is called a link when it is on the web: a hyperlink from one graph to another. Edge label and style are not substitutes for connection rules.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592054833,
          "reason": "bridge-reference"
        },
