    {
      "id": "edge-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": 2480,
        "y": -300
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Behavior",
        "body": "edgeLegality resolves the class key, checks kinds and counts matching incoming/outgoing relationships. The graph validator diagnoses loaded invalid relationships, and mutation paths can reject illegal new edges. Intergraph edge references preserve ownership on the participating graphs’ roots.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
