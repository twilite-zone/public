    {
      "id": "method-invariants",
      "type": "page-section",
      "label": "Invariants",
      "position": {
        "x": 380,
        "y": -640
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Invariants",
        "body": "Invocation is distinct from source storage. Declared effects describe intended permitted operations; the spec must identify exactly which host calls enforce them. An empty declared effects list is read-only under that contract.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "definitionKey": "page-section",
        "_classBinding": {
