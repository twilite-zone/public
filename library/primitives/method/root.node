    {
      "id": "method-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": -180,
        "y": 80
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Behavior",
        "body": "MethodNode draws the effect summary and uses scriptRunnerResult. `resolveMethodSource` finds the source to run: the node’s own, or the one its template hands on, reached through the named import, which must grant `execute`. What may be written is always the declared effects of the node in the graph it runs in. If the template cannot be loaded nothing runs. methodEffects normalizes declarations and usePluginRuntime calls enforceDeclaredEffects. The current HOST_CALL_EFFECTS mapping gates updateNode and updateView (which writes a face); other calls retain existing host checks. Method cards are edit-mode only.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "definitionKey": "page-section",
        "_classBinding": {
