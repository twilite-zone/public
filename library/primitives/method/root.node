    {
      "id": "method-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -780,
        "y": 0
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Known gaps",
        "body": "Effect declarations currently describe more operations than the targeted enforcement mapping covers. This is an implementation gap, not a full sandbox guarantee. Extending enforcement needs a separate runtime task and negative tests per operation.",
