    {
      "id": "decl-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -180,
        "y": 800
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Known gaps",
        "body": "The root's template and uniform node presentation, Surface authoring polish, host/3D selection and live smoke evidence remain tracked at tlz://twilite.zone/tasks/declaration-surfaces/root.node. Rooting — making a new graph from several selected in a workspace — is not built. A specification update does not complete those runtime tasks.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Rule"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592052369,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "ac97492b-7402-428b-9bce-5c5e91c7f981"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any",
          "position": {
            "side": "top",
            "offset": 0.2
          }
        }
      ],
      "outputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any",
          "position": {
            "side": "top",
            "offset": 0.2
          }
        }
      ],
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "side": "top",
          "offset": 0.2,
          "position": {
            "side": "top",
