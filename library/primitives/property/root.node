    {
      "id": "field-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": 2560,
        "y": -300
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Behavior",
        "body": "PropertyNode listens for nodeInput addressed to its `set` input, updates `data.value` through nodeUpdate, and emits nodeOutput for `value`. Every write that changes the value announces `property.changed` (GraphCrud announces it when a node is saved), so a Method can act on it through an `invokes` edge from the Property's `property.changed` event port. editorResolutionPolicy distinguishes product-owned editors from class-backed editing.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592061428,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "primitive-field"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
