    {
      "id": "field-contract",
      "type": "page-section",
      "label": "Contract",
      "position": {
        "x": 880,
        "y": -300
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Contract",
        "body": "PropertyNode reads `data.name`, `data.value`, `data.valueType` and `data.required`. It falls back to the node's label for its name, normalizes `valueType` to a string and retains the value's actual data. A class binding supplies additional meaning rather than turning every named value into a primitive.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
