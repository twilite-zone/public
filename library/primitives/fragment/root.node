    {
      "id": "fragment-boundary",
      "type": "page-section",
      "label": "Explicitly Not Part of This Primitive",
      "position": {
        "x": 910,
        "y": 260
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Explicitly Not Part of This Primitive",
        "body": "- It is not the Portal. A Portal is movement: it takes you to a graph or node.\n- It is not the Bridge. A Bridge is access and grants.\n- It is not a copy. A fragment is not a second node and not a duplicate; it is part of the one node.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
