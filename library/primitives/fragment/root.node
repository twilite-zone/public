    {
      "id": "fragment-invariants",
      "type": "page-section",
      "label": "Invariants",
      "position": {
        "x": 70,
        "y": -240
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Invariants",
        "body": "- Every piece of a node carries the same `identity.nodeId` on its root, and its own `graphId`, because the pieces are one node.\n- A piece holds a Fragment for each piece it is adjacent to. The pieces of one node are the ones joined by them, however many: in a node of three pieces, the first and the last need not name each other. A piece you expand must hold a Fragment back to the file that expands it; a piece with none is refused.\n- A stand-in names the file it was given. A piece whose stand-in back names a different file is refused.\n- A piece you expand is never saved into the graph you expanded it in.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070377,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "primitive-fragment"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "ports": [
        {
          "id": "root",
