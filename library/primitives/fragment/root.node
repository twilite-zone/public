          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;min-height:100%;padding:clamp(0.5px,7.33cqw,33px) clamp(0.5px,8.00cqw,36px);border-radius:min(18px,6cqw);background:#ffffff;border:1px solid #e2e8f0;color:#0f172a;overflow:hidden;display:flex;flex-direction:column'><div style='margin-bottom:clamp(0.5px,3.33cqw,15px);font-weight:800;font-size:clamp(0.5px,3.67cqw,17px);line-height:1.3;font-family:system-ui;letter-spacing:.18em;text-transform:uppercase;color:#6d28d9'>PRIMITIVE · fragment</div><div style='font-weight:500;font-size:clamp(0.5px,10.67cqw,48px);line-height:1;font-family:Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.02em'>Fragment</div><div style='margin-top:clamp(0.5px,3.33cqw,15px);font-weight:600;font-size:clamp(0.5px,4.33cqw,20px);line-height:1.4;font-family:system-ui;color:#6d28d9'>Fragment smoke test</div><div style='margin-top:auto;padding-top:clamp(0.5px,2.67cqw,12px);font-weight:400;font-size:clamp(0.5px,4.00cqw,18px);line-height:1.3;font-family:system-ui;color:#475569'>13 pieces</div></div></div>"
