    {
      "id": "fragment-at-a-glance",
      "type": "page-settings",
      "label": "At a glance",
      "position": {
        "x": 430,
        "y": -1825
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "At a glance",
        "rows": [
          {
            "label": "Node type",
            "value": "fragment: a node that stands for the other piece and draws a face of it"
          },
          {
            "label": "Shown when browsing",
            "value": "Yes: it draws a face of the other piece, with an Expand/Collapse button on its title bar; the included nodes are drawn once expanded"
          },
          {
            "label": "Encoded as",
            "value": "a `fragment` node with `data.target.mode: \"expand\"` and a `ref`, and the same `identity.nodeId` on the root of every piece"
          }
        ],
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Settings"
          },
          "baseLevel": "detail"
        },
        "_placement": {
