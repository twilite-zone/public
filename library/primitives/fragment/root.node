    {
      "id": "fragment-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -770,
        "y": 260
      },
      "width": 720,
      "height": 380,
      "data": {
        "title": "Known gaps",
        "body": "- **Bridges a piece needs are granted one by one by the host.** Nothing yet shows the host which Bridges a piece wants; it has to open the piece to see. Whether the piece's root should list them is undecided.\n- **The hash pin** applies only to a piece that is fetched. A piece given inline skips it.\n- **Pieces from outside the host's own repository** are not required to be pinned to a version.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Rule"
          },
          "baseLevel": "detail"
        },
        "_placement": {
