          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;min-height:100%;padding:clamp(14px,7.33cqw,33px) clamp(16px,8.00cqw,36px);border-radius:18px;background:#ffffff;border:1px solid #e2e8f0;color:#0f172a;overflow:hidden;display:flex;flex-direction:column'><div style='margin-bottom:clamp(7px,3.33cqw,15px);font-weight:800;font-size:clamp(7px,3.67cqw,17px);line-height:1.3;font-family:system-ui;letter-spacing:.18em;text-transform:uppercase;color:#6d28d9'>LIBRARY · glossary</div><div style='font-weight:500;font-size:clamp(21px,10.67cqw,48px);line-height:1;font-family:Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.02em'>Glossary</div><div style='margin-top:auto;padding-top:clamp(5px,2.67cqw,12px);font-weight:400;font-size:clamp(8px,4.00cqw,18px);line-height:1.3;font-family:system-ui;color:#475569'>8 pieces</div></div>"
