        "key": "node.web.detail",
        "intent": "node",
        "payload": "node.web.detail",
        "semanticLevel": "detail",
        "visibilityRole": "editor",
        "html": "<div style=\"width:100%;height:100%;box-sizing:border-box;padding:18px;border-radius:18px;background:linear-gradient(145deg,#ecfeff,#f8fafc);border:2px solid #2dd4bf;color:#134e4a;font-family:ui-sans-serif,system-ui,sans-serif;display:flex;flex-direction:column;gap:11px;overflow:auto;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;\"><div style=\"font-size:21px;font-weight:850;\">{{data.scriptName || label || 'Script'}}</div><span style=\"padding:4px 9px;border-radius:999px;background:#ccfbf1;color:#0f766e;font-size:10px;font-weight:900;text-transform:uppercase;\">{{data.multiplicity || 'many'}}</span></div><div style=\"font-size:13px;line-height:1.45;color:#475569;\">{{data.memo || 'Graph-owned executable behavior.'}}</div><div style=\"padding:9px;border-radius:10px;background:#fff;border:1px solid #99f6e4;font:600 11px/1.4 ui-monospace,monospace;color:#334155;word-break:break-all;\">{{data.scriptRef || 'Inline graph-owned source'}}</div><div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;font-size:11px;color:#64748b;\"><div><b style=\"color:#0f766e;\">Mutations</b><br>{{data.allowMutations || false}}</div><div><b style=\"color:#0f766e;\">Dry run</b><br>{{data.dryRun || false}}</div><div><b style=\"color:#0f766e;\">Auto run</b><br>{{data.autoRun || false}}</div><div><b style=\"color:#0f766e;\">Graph change</b><br>{{data.autoRunOnGraphChange || false}}</div></div><div style=\"padding-top:9px;border-top:1px solid #ccfbf1;font-size:11px;line-height:1.45;color:#64748b;\"><b style=\"color:#0f766e;\">Effects</b><br>{{data.effects || 'not declared'}}</div><div style=\"font-size:11px;line-height:1.45;color:#64748b;\"><b style=\"color:#0f766e;\">Requires</b><br>{{data.requirements || 'none'}}</div><div style=\"font-size:11px;line-height:1.45;color:#64748b;\"><b style=\"color:#0f766e;\">Grants</b><br>{{data.grants || 'execute'}}</div></div>"
      }
