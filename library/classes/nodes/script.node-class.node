    {
      "id": "script-editor-view",
      "type": "view",
      "label": "Script Editor",
      "position": {
        "x": 80,
        "y": -420
      },
      "visible": true,
      "showLabel": true,
      "width": 620,
      "height": 500,
      "data": {
        "key": "editor.web",
        "intent": "editor",
        "payload": "editor.web",
        "editor": {
          "web": {
            "host": {
              "kind": "script-editor"
            },
            "fields": [
              {
                "key": "label",
                "label": "Label",
                "path": "label",
                "type": "text",
                "placeholder": "Script"
              },
              {
                "key": "scriptName",
                "label": "Behavior Name",
                "path": "data.scriptName",
                "type": "text",
                "placeholder": "Collection Window Controller"
              },
              {
                "key": "memo",
                "label": "Purpose",
                "path": "data.memo",
                "type": "multiline",
                "rows": 3,
                "placeholder": "Explain what this behavior provides."
              },
              {
                "key": "scriptRef",
                "label": "Source Reference",
                "path": "data.scriptRef",
                "type": "text",
                "placeholder": "github://owner/repo/path.js"
              },
              {
                "key": "allowMutations",
                "label": "Allow Mutations",
                "path": "data.allowMutations",
                "type": "checkbox"
              },
              {
                "key": "dryRun",
                "label": "Dry Run",
                "path": "data.dryRun",
                "type": "checkbox"
              },
              {
                "key": "autoRun",
                "label": "Auto Run",
                "path": "data.autoRun",
                "type": "checkbox"
              },
              {
                "key": "autoRunOnLoad",
                "label": "Run On Load",
                "path": "data.autoRunOnLoad",
                "type": "checkbox"
              },
              {
                "key": "autoRunOnGraphChange",
                "label": "Run On Graph Change",
                "path": "data.autoRunOnGraphChange",
                "type": "checkbox"
              },
              {
                "key": "multiplicity",
                "label": "Multiplicity",
                "path": "data.multiplicity",
                "type": "select",
                "options": [
                  "many",
                  "singleton"
                ]
              },
              {
                "key": "summaryNodeId",
                "label": "Owned Summary Node",
                "path": "data.summaryNodeId",
                "type": "text",
                "placeholder": "summary-node-id"
              },
              {
                "key": "requirements",
                "label": "Required Companion Nodes",
                "path": "data.requirements",
                "type": "multiline",
                "rows": 3,
                "placeholder": "lane-now\nlane-next"
              },
              {
                "key": "effects",
                "label": "Declared Effects",
                "path": "data.effects",
                "type": "multiline",
                "rows": 3,
                "placeholder": "creates collection member portals\nupdates runtime window state"
              },
              {
                "key": "grants",
                "label": "Required Grants",
                "path": "data.grants",
                "type": "multiselect",
                "options": [
                  "read",
                  "execute",
                  "create",
                  "update",
                  "delete",
                  "mutate"
                ]
              }
            ]
          }
        },
        "semanticLevel": "detail",
        "visibilityRole": "editor"
      },
