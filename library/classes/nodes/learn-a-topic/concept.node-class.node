    {
      "id": "concept-notes",
      "type": "content",
      "label": "Concept Landing Surface",
      "position": {
        "x": 520,
        "y": -360
      },
      "width": 460,
      "height": 220,
      "handles": [
        {
          "id": "root",
          "key": "root",
