      "data": {
        "identity": {
          "graphId": "concept-class",
          "nodeId": "concept"
        },
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Concept",
                "type": "text",
                "path": "data.title",
                "placeholder": "A short name for the thing to know"
              },
              {
                "key": "body",
                "label": "What it is",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "What it means, in the learner's own words.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "confidence",
                "label": "How well it is known",
                "type": "select",
                "path": "data.confidence",
                "options": [
                  {
                    "label": "Not yet",
                    "value": "unknown"
                  },
                  {
                    "label": "Shaky",
                    "value": "shaky"
                  },
                  {
                    "label": "Solid",
                    "value": "solid"
                  }
                ]
              },
              {
                "key": "check",
                "label": "To check",
                "type": "select",
                "path": "data.check",
                "options": [
                  {
                    "label": "Looks right",
                    "value": false
                  },
                  {
                    "label": "To check",
                    "value": true
                  }
                ]
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Concept"
              }
            ]
          }
        }
      }
    },
