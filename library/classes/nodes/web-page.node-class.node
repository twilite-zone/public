        "renderShape": {
          "kind": "html"
        },
        "html": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;display:flex;flex-direction:column;gap:2.2cqw;padding:3.4cqw;border-radius:4cqw;background:#ecfeff;border:2px solid #0e7490;color:#0f172a;font-family:system-ui,sans-serif'><div style='display:flex;align-items:baseline;justify-content:space-between;gap:2.4cqw;font-size:3.4cqw;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#0e7490'><span>Web page</span><span style='font-weight:600;letter-spacing:0;text-transform:none;color:#475569;overflow:hidden;text-overflow:ellipsis;white-space:nowrap'>{{data.frame.url || data.url}}</span></div><div style='font-weight:700;font-size:6.4cqw;line-height:1.15;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'>{{data.title || label}}</div><div data-player-slot='default' style='flex:1;min-height:0;width:100%;border-radius:3cqw;overflow:hidden;background:#ffffff;display:{{eq(data.frame.status, 'frameable', 'block', 'none')}}'></div><div style='flex:1;min-height:0;display:{{eq(data.frame.status, 'frameable', 'none', 'flex')}};flex-direction:column;justify-content:center;gap:2.4cqw;padding:3cqw;border-radius:3cqw;background:#ffffff;border:1px dashed #0e7490'><div style='font-size:3.8cqw;line-height:1.4;color:#334155'>{{data.frame.reason || 'Add an address to show a page here.'}}</div><a href='{{data.url}}' target='_blank' rel='noopener noreferrer' style='align-self:flex-start;font-size:3.8cqw;font-weight:700;color:#0e7490'>Open in a new tab</a></div></div></div>",
