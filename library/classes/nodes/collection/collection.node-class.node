        "editor": {
          "web": {
            "fields": [
              {
                "key": "label",
                "label": "Label",
                "type": "text",
                "path": "label",
                "placeholder": "Collection"
              },
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "placeholder": "Name this collection"
              },
              {
                "key": "body",
                "label": "What it is for",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "What this collection is for",
                "multiline": true,
                "rows": 4
              },
              {
                "key": "sort",
                "label": "Order",
                "type": "select",
                "path": "data.sort",
                "options": [
                  {
                    "label": "As listed",
                    "value": "order"
                  },
                  {
                    "label": "By name",
                    "value": "name"
                  },
                  {
                    "label": "By kind",
                    "value": "kind"
                  }
                ]
              },
              {
                "key": "members",
                "label": "Graphs in the list",
                "type": "text",
                "path": "data.members",
                "multiline": true,
                "rows": 6,
                "monospace": true,
                "section": "members",
                "placeholder": "One address to a line, or the JSON that Copy graphs as JSON writes",
                "helperText": "Graphs this collection holds by address. Portals it contains, and (if switched on) the graphs in its folder, are members too."
              },
              {
                "key": "includeFolder",
                "label": "Include the graphs in this folder",
                "type": "boolean",
                "path": "data.includeFolder",
                "section": "members",
                "helperText": "Adds each graph in the folder this collection sits in. Needs a github:// address; a published site cannot list its folders."
              },
              {
                "key": "sourcesSummary",
                "label": "Where the members come from",
                "type": "text",
                "path": "data.sourcesSummary",
                "readOnly": true,
                "fullWidth": true,
                "section": "members",
                "helperText": "Written by the collection each time it changes."
              }
            ]
          }
        }
      }
