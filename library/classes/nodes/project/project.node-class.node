        "editor": {
          "web": {
            "fields": [
              {
                "key": "label",
                "label": "Label",
                "type": "text",
                "path": "label",
                "placeholder": "Repo"
              },
              {
                "key": "title",
                "label": "Name",
                "type": "text",
                "path": "data.title",
                "placeholder": "Name this project"
              },
              {
                "key": "body",
                "label": "What it is for",
                "type": "markdown",
                "path": "data.body",
                "multiline": true,
                "rows": 4,
                "placeholder": "Why this project exists, in a sentence"
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Idea",
                    "value": "idea"
                  },
                  {
                    "label": "Active",
                    "value": "active"
                  },
                  {
                    "label": "Paused",
                    "value": "paused"
                  },
                  {
                    "label": "Done",
                    "value": "done"
                  }
                ]
              },
              {
                "key": "standing",
                "label": "Where it stands now",
                "type": "text",
                "path": "data.standing",
                "placeholder": "The next step, in a line"
              },
              {
                "key": "lead",
                "label": "Lead",
                "type": "text",
                "path": "data.lead",
                "placeholder": "Who leads it"
              },
              {
                "key": "lives",
                "label": "Where it lives",
                "type": "text",
                "path": "data.lives",
                "placeholder": "A repository or an address"
              },
              {
                "key": "sort",
                "label": "Order of the shelves",
                "type": "select",
                "path": "data.sort",
                "options": [
                  {
                    "label": "As listed",
                    "value": "order"
                  },
                  {
                    "label": "By name",
                    "value": "name"
                  },
                  {
                    "label": "By kind",
                    "value": "kind"
                  }
                ]
              },
              {
                "key": "includeFolder",
                "label": "Include the folders of this repository",
                "type": "boolean",
                "path": "data.includeFolder",
                "section": "members",
                "helperText": "Adds each folder of the repository that has a root graph. Needs a github:// address; a published site cannot list its folders."
              },
              {
                "key": "sourcesSummary",
                "label": "Where the shelves come from",
                "type": "text",
                "path": "data.sourcesSummary",
                "readOnly": true,
                "fullWidth": true,
                "section": "members",
                "helperText": "Written by the library each time it changes."
              }
            ]
          }
        }
      }
