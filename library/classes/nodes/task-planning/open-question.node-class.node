        "html": "<div style=\"container-type:inline-size;width:100%;height:100%\"><div style=\"box-sizing:border-box;width:100%;height:100%;background:#f4e9fb;color:#56346c;font-family:system-ui,sans-serif;border-radius:4cqw;border:.6cqw solid #d5b7ef;border-bottom:1.6cqw solid #56346c;overflow:hidden;display:flex;flex-direction:column\"><div style=\"display:flex;gap:3cqw;align-items:center;padding:4cqw;min-height:0;flex:1\"><div style=\"width:38cqw;aspect-ratio:1;flex:none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"63\" r=\"56\" fill=\"#56346c\"/><circle cx=\"60\" cy=\"59\" r=\"54\" fill=\"#d5b7ef\"/><circle cx=\"60\" cy=\"59\" r=\"47\" fill=\"#8650ab\"/><circle cx=\"60\" cy=\"59\" r=\"43\" fill=\"none\" stroke=\"#fff5df\" stroke-opacity=\".4\" stroke-width=\"1.8\"/><path d=\"M38 40C38 19 82 19 82 42 82 57 60 57 60 72\" stroke=\"#fff5df\" stroke-width=\"11\" stroke-linecap=\"round\" fill=\"none\"/><circle cx=\"60\" cy=\"91\" r=\"6\" fill=\"#fff5df\"/></svg></div><div style=\"min-width:0;flex:1\"><div style=\"font:850 3.9cqw/1.15 system-ui;letter-spacing:.1em;text-transform:uppercase;color:#56346c\">Open question</div><div style=\"font:850 8cqw/1.06 system-ui;letter-spacing:-.035em;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin:.9cqw 0\">{{data.title || label}}</div></div></div><div style=\"background:#fff8;padding:1.2cqw 4cqw;border-top:1px solid #d5b7ef;text-align:right\"><span style=\"display:{{eq(data.status, 'todo', 'inline-flex', 'none')}};color:#475569;font-weight:800;font-size:3.6cqw;white-space:nowrap\">○ To do</span><span style=\"display:{{eq(data.status, 'open', 'inline-flex', 'none')}};color:#475569;font-weight:800;font-size:3.6cqw;white-space:nowrap\">○ Open</span><span style=\"display:{{eq(data.status, 'in-progress', 'inline-flex', 'none')}};color:#1d4ed8;font-weight:800;font-size:3.6cqw;white-space:nowrap\">▶ In progress</span><span style=\"display:{{eq(data.status, 'blocked', 'inline-flex', 'none')}};color:#b91c1c;font-weight:800;font-size:3.6cqw;white-space:nowrap\">■ Blocked</span><span style=\"display:{{eq(data.status, 'waiting', 'inline-flex', 'none')}};color:#92400e;font-weight:800;font-size:3.6cqw;white-space:nowrap\">… Waiting</span><span style=\"display:{{eq(data.status, 'done', 'inline-flex', 'none')}};color:#166534;font-weight:800;font-size:3.6cqw;white-space:nowrap\">✓ Done</span><span style=\"display:{{eq(data.status, 'achieved', 'inline-flex', 'none')}};color:#166534;font-weight:800;font-size:3.6cqw;white-space:nowrap\">✓ Achieved</span><span style=\"display:{{eq(data.status, 'cancelled', 'inline-flex', 'none')}};color:#64748b;font-weight:800;font-size:3.6cqw;white-space:nowrap\">× Cancelled</span><span style=\"display:{{eq(data.status, 'answered', 'inline-flex', 'none')}};color:#166534;font-weight:800;font-size:3.6cqw;white-space:nowrap\">✓ Answered</span><span style=\"display:{{eq(data.status, 'proposed', 'inline-flex', 'none')}};color:#475569;font-weight:800;font-size:3.6cqw;white-space:nowrap\">○ Proposed</span><span style=\"display:{{eq(data.status, 'decided', 'inline-flex', 'none')}};color:#166534;font-weight:800;font-size:3.6cqw;white-space:nowrap\">✓ Decided</span><span style=\"display:{{eq(data.status, 'accepted', 'inline-flex', 'none')}};color:#166534;font-weight:800;font-size:3.6cqw;white-space:nowrap\">✓ Accepted</span><span style=\"display:{{eq(data.status, 'review', 'inline-flex', 'none')}};color:#6d28d9;font-weight:800;font-size:3.6cqw;white-space:nowrap\">◎ Review</span></div></div></div>",
        "semanticLevel": "icon"
      }
