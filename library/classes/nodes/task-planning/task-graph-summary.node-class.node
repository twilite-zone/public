      "data": {
        "identity": {
          "graphId": "task-graph-summary-class",
          "nodeId": "summary"
        },
        "markdown": "This class is the summary surface for a task graph. A real task graph has a `goal` plus at least one associated `task` or `open-question`. A local graph-authored updater writes goal, status, and progress counts into this node's data.",
        "content": {
          "kind": "markdown",
          "value": "This class is the summary surface for a task graph. A real task graph has a `goal` plus at least one associated `task` or `open-question`. A local graph-authored updater writes goal, status, and progress counts into this node's data."
        },
        "renderShape": {
          "kind": "markdown"
        }
      }
    },
