        "editor": {
          "web": {
            "fields": [
              {
                "key": "label",
                "label": "Label",
                "type": "text",
                "path": "label",
                "placeholder": "Summary"
              },
              {
                "key": "goal",
                "label": "Goal",
                "type": "text",
                "path": "data.goal",
                "placeholder": "Describe the document's current read"
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Todo",
                    "value": "todo"
                  },
                  {
                    "label": "In Progress",
                    "value": "in-progress"
                  },
                  {
                    "label": "Done",
                    "value": "done"
                  },
                  {
                    "label": "Blocked",
                    "value": "blocked"
                  },
                  {
                    "label": "Waiting",
                    "value": "waiting"
                  },
                  {
                    "label": "Cancelled",
                    "value": "cancelled"
                  }
                ]
              },
              {
                "key": "nextAction",
                "label": "Next Action",
                "type": "text",
                "path": "data.nextAction",
                "placeholder": "The next project-level action"
              },
              {
                "key": "blockedReason",
                "label": "Blocker Explanation",
                "type": "markdown",
                "path": "data.blockedReason",
                "placeholder": "Why progress is blocked or waiting",
                "multiline": true,
                "rows": 4
              },
              {
                "key": "health",
                "label": "Health",
                "type": "select",
                "path": "data.health",
                "options": [
                  {
                    "label": "Unknown",
                    "value": "unknown"
                  },
                  {
                    "label": "On Track",
                    "value": "on-track"
                  },
                  {
                    "label": "At Risk",
                    "value": "at-risk"
                  },
                  {
                    "label": "Off Track",
                    "value": "off-track"
                  }
                ]
              },
              {
                "key": "taskProgress",
                "label": "Task Progress",
                "type": "json",
                "path": "data.taskProgress",
                "placeholder": "{\"completed\":0,\"total\":0}"
              },
              {
                "key": "questionProgress",
                "label": "Question Progress",
                "type": "json",
                "path": "data.questionProgress",
                "placeholder": "{\"answered\":0,\"total\":0}"
              }
            ]
          }
        },
        "identity": {
          "graphId": "task-graph-summary-class",
          "nodeId": "summary"
