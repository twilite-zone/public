        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Decision",
                "type": "text",
                "path": "data.title",
                "placeholder": "What was decided?",
                "multiline": true,
                "rows": 2
              },
              {
                "key": "rationale",
                "label": "Rationale",
                "type": "markdown",
                "path": "data.rationale",
                "placeholder": "Why this decision was made...",
                "multiline": true,
                "rows": 8
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Pending",
                    "value": "pending"
                  },
                  {
                    "label": "Proposed",
                    "value": "proposed"
                  },
                  {
                    "label": "Decided",
                    "value": "decided"
                  },
                  {
                    "label": "Superseded",
                    "value": "superseded"
                  }
                ]
              },
              {
                "key": "decidedAt",
                "label": "Decided At",
                "type": "text",
                "path": "data.decidedAt",
                "placeholder": "YYYY-MM-DD"
              },
              {
                "key": "owner",
                "label": "Owner",
                "type": "text",
                "path": "data.owner",
                "placeholder": "owner"
              },
              {
                "key": "supersededBy",
                "label": "Superseded By",
                "type": "text",
                "path": "data.supersededBy",
                "placeholder": "nodeRef"
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Decision"
              }
            ]
          }
        }
      }
