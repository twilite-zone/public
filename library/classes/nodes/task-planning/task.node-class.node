        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "label",
                "label": "Label",
                "type": "text",
                "path": "label",
                "placeholder": "Task"
              },
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "placeholder": "Short human-facing task title"
              },
              {
                "key": "body",
                "label": "Description",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "Describe the task...",
                "multiline": true,
                "rows": 8
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Todo",
                    "value": "todo"
                  },
                  {
                    "label": "In Progress",
                    "value": "in-progress"
                  },
                  {
                    "label": "Done",
                    "value": "done"
                  },
                  {
                    "label": "Blocked",
                    "value": "blocked"
                  },
                  {
                    "label": "Waiting",
                    "value": "waiting"
                  },
                  {
                    "label": "Cancelled",
                    "value": "cancelled"
                  }
                ]
              },
              {
                "key": "priority",
                "label": "Priority",
                "type": "select",
                "path": "data.priority",
                "options": [
                  {
                    "label": "High",
                    "value": "high"
                  },
                  {
                    "label": "Medium",
                    "value": "medium"
                  },
                  {
                    "label": "Low",
                    "value": "low"
                  }
                ]
              },
              {
                "key": "owner",
                "label": "Owner",
                "type": "text",
                "path": "data.owner",
                "placeholder": "owner"
              },
              {
                "key": "estimateHours",
                "label": "Estimate Hours",
                "type": "number",
                "path": "data.estimateHours",
                "placeholder": "2"
              },
              {
                "key": "targetDate",
                "label": "Target Date",
                "type": "text",
                "path": "data.targetDate",
                "placeholder": "YYYY-MM-DD"
              },
              {
                "key": "startedAt",
                "label": "Started At",
                "type": "text",
                "path": "data.startedAt",
                "placeholder": "YYYY-MM-DD"
              },
              {
                "key": "completedAt",
                "label": "Completed At",
                "type": "text",
                "path": "data.completedAt",
                "placeholder": "YYYY-MM-DD"
              },
              {
                "key": "externalRef",
                "label": "External Reference",
                "type": "text",
                "path": "data.externalRef",
                "placeholder": "https://... or durable reference"
              },
              {
                "key": "acceptanceCriteria",
                "label": "Acceptance Criteria Refs",
                "type": "json",
                "path": "data.acceptanceCriteria",
                "placeholder": "[]"
