        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "controls": [
            {
              "id": "task-summary-done",
              "type": "button",
              "label": "Done",
              "icon": "check",
              "variant": "contained",
              "priority": "highest",
              "action": "setData",
              "bind": "data.status",
              "value": "done",
              "when": {
                "path": "data.status",
                "notIn": [
                  "done",
                  "cancelled"
                ]
              }
            },
            {
              "id": "task-summary-reopen",
              "type": "button",
              "label": "Reopen",
              "icon": "restore",
              "variant": "outlined",
              "priority": "high",
              "action": "setData",
              "bind": "data.status",
              "value": "todo",
              "when": {
                "path": "data.status",
                "in": [
