        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "controls": [
            {
              "id": "task-mark-done",
              "type": "button",
              "label": "Done",
              "icon": "check",
              "variant": "contained",
              "priority": "highest",
              "action": "setData",
              "bind": "data.status",
              "value": "done",
              "when": {
                "path": "data.status",
                "notIn": [
                  "done",
                  "cancelled"
                ]
              }
            },
            {
              "id": "task-mark-active",
              "type": "button",
              "label": "Start",
              "icon": "play",
              "variant": "soft",
              "priority": "high",
              "action": "setData",
              "bind": "data.status",
              "value": "in-progress",
              "when": {
                "path": "data.status",
                "in": [
                  "todo",
                  "waiting",
                  "blocked"
                ]
              }
