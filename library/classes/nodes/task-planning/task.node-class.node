      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "task-class",
          "nodeId": "task"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "controls": [
            {
              "id": "task-mark-done",
              "type": "button",
              "label": "Done",
              "icon": "check",
              "variant": "contained",
              "priority": "highest",
              "action": "setData",
              "bind": "data.status",
              "value": "done",
              "when": {
                "path": "data.status",
                "notIn": [
                  "done",
                  "cancelled"
                ]
              }
            },
            {
              "id": "task-mark-active",
              "type": "button",
              "label": "Start",
              "icon": "play",
              "variant": "soft",
              "priority": "high",
              "action": "setData",
              "bind": "data.status",
              "value": "in-progress",
              "when": {
                "path": "data.status",
                "in": [
                  "todo",
                  "waiting",
                  "blocked"
                ]
              }
            },
            {
              "id": "task-mark-todo",
              "type": "button",
              "label": "Reopen",
              "icon": "restore",
              "variant": "outlined",
              "priority": "normal",
              "action": "setData",
              "bind": "data.status",
              "value": "todo",
              "when": {
                "path": "data.status",
                "in": [
                  "done",
                  "cancelled"
                ]
              }
            },
            {
              "id": "task-edit",
              "type": "button",
              "label": "Edit",
              "icon": "edit",
              "variant": "outlined",
              "priority": "high",
              "action": "openEditor"
            }
          ],
          "html": {
            "chrome": true
          }
        },
        "renderShape": {
          "kind": "html"
        },
        "html": "<div style='width:100%;height:100%;display:flex;flex-direction:column;box-sizing:border-box;padding:0;overflow:hidden;border-radius:18px;border:2px solid #1f9d67;background:linear-gradient(180deg, rgba(255,255,255,.96), rgba(228,247,239,.94));color:#23160a;position:relative;'>\n  <div style='display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px;background:linear-gradient(135deg, #9be7c4, #1f9d67);color:#082618;border-bottom:1px solid rgba(0,0,0,.08);'>\n    <div style='display:flex;align-items:center;gap:10px;min-width:0;'>\n      <div style='width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:{{eq(data.status, \"done\", \"rgba(31,157,103,.20)\", \"rgba(255,255,255,.18)\")}};border:1px solid {{eq(data.status, \"done\", \"rgba(8,38,24,.24)\", \"rgba(8,38,24,.32)\")}};color:#082618;font:800 14px system-ui,sans-serif;flex:0 0 auto;'><span aria-hidden=\"true\" style=\"display:{{eq(data.status, 'in-progress', 'inline', 'none')}};color:#2563eb;\">◐</span><span aria-hidden=\"true\" style=\"display:{{eq(data.status, 'done', 'inline', 'none')}};color:#166534;\">✓</span><span aria-hidden=\"true\" style=\"display:{{eq(data.status, 'achieved', 'inline', 'none')}};color:#166534;\">✓</span><span aria-hidden=\"true\" style=\"display:{{eq(data.status, 'blocked', 'inline', 'none')}};color:#b91c1c;\">!</span><span aria-hidden=\"true\" style=\"display:{{eq(data.status, 'waiting', 'inline', 'none')}};color:#92400e;\">Ⅱ</span><span aria-hidden=\"true\" style=\"display:{{eq(data.status, 'cancelled', 'inline', 'none')}};color:#475569;\">×</span></div>\n      <div style='min-width:0;'>\n        <div style='font:700 10px system-ui,sans-serif;letter-spacing:.16em;text-transform:uppercase;opacity:.68;margin-bottom:2px;'>Task</div>\n        <div style='font:800 18px/1.02 Georgia, \"Times New Roman\", serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>{{label}}</div>\n        <div style='font:600 11px/1.2 system-ui,sans-serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:.78;margin-top:4px;'>{{data.title}}</div>\n      </div>\n    </div>\n    <div style='display:inline-flex;align-items:center;justify-content:center;padding:5px 9px;border-radius:999px;background:rgba(255,255,255,.38);border:1px solid rgba(0,0,0,.08);font:700 10px system-ui,sans-serif;text-transform:uppercase;white-space:nowrap;'>{{data.status}}</div>\n  </div>\n  <div style='display:flex;flex-direction:column;gap:12px;padding:14px 16px 14px 16px;min-height:0;flex:1;color:#23160a;'>\n    <div style='display:flex;align-items:center;gap:7px;flex-wrap:wrap;'>\n      <div style='padding:4px 8px;border-radius:999px;background:rgba(0,0,0,.04);border:1px solid rgba(0,0,0,.06);font:700 10px system-ui,sans-serif;color:#23160a;'>Priority: {{data.priority}}</div>\n      <div style='padding:4px 8px;border-radius:999px;background:rgba(0,0,0,.04);border:1px solid rgba(0,0,0,.06);font:700 10px system-ui,sans-serif;color:#23160a;'>Owner: {{data.owner}}</div>\n      <div style='font:700 10px system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;opacity:.74;color:#5b4731;'>Estimate {{data.estimateHours}}h</div>\n    </div>\n    <div style='display:flex;align-items:center;gap:7px;flex-wrap:wrap;font:700 10px system-ui,sans-serif;color:#5b4731;'>\n      <span>Target: {{data.targetDate}}</span><span>•</span><span>Started: {{data.startedAt}}</span><span>•</span><span>Completed: {{data.completedAt}}</span>\n    </div>\n    <div style='padding:12px 13px 11px 13px;border-radius:14px;background:rgba(255,255,255,.72);border:1px solid rgba(0,0,0,.06);color:#23160a;'>\n      <div style='font:700 10px system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;opacity:.66;margin-bottom:6px;color:#6b533a;'>Work</div>\n      <div style='font:500 14px/1.42 system-ui,sans-serif;max-height:5.7em;overflow:hidden;color:#23160a;'>{{data.body}}</div>\n    </div>\n    <div style='margin-top:auto;display:flex;flex-direction:column;gap:6px;color:#23160a;'>\n      <div style='font:700 10px system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;opacity:.66;color:#6b533a;'>Acceptance hook</div>\n      <div style='padding:8px 10px;border-radius:12px;background:rgba(31,157,103,.14);border:1px solid rgba(0,0,0,.06);font:600 11px/1.35 system-ui,sans-serif;white-space:pre-wrap;overflow:hidden;color:#23160a;'>{{data.acceptanceCriteria}}</div>\n      <div style='font:600 10px/1.3 system-ui,sans-serif;color:#3b5b47;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>External: {{data.externalRef}}</div>\n    </div>\n  </div>\n</div>",
        "semanticLevel": "detail"
      }
    },
