        "html": "<div style=\"container-type:inline-size;width:100%;height:100%\"><div style=\"box-sizing:border-box;width:100%;height:100%;background:#fff0d7;color:#713719;font-family:system-ui,sans-serif;border-radius:4cqw;border:.6cqw solid #f5bd65;border-bottom:1.6cqw solid #713719;overflow:hidden;display:flex;flex-direction:column\"><div style=\"display:flex;gap:3cqw;align-items:center;padding:3cqw;min-height:0;\"><div style=\"width:23cqw;aspect-ratio:1;flex:none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"63\" r=\"56\" fill=\"#713719\"/><circle cx=\"60\" cy=\"59\" r=\"54\" fill=\"#f5bd65\"/><circle cx=\"60\" cy=\"59\" r=\"47\" fill=\"#d28b32\"/><circle cx=\"60\" cy=\"59\" r=\"43\" fill=\"none\" stroke=\"#fff5df\" stroke-opacity=\".4\" stroke-width=\"1.8\"/><path d=\"M38 92V27\" stroke=\"#fff5df\" stroke-width=\"8\" stroke-linecap=\"round\"/><path d=\"M43 27H85L75 43 85 59H43Z\" fill=\"#fff5df\"/><path d=\"M29 94H69\" stroke=\"#fff5df\" stroke-width=\"8\" stroke-linecap=\"round\"/></svg></div><div style=\"min-width:0;flex:1\"><div style=\"font:850 3.1cqw/1.15 system-ui;letter-spacing:.1em;text-transform:uppercase;color:#713719\">Goal</div><div style=\"font:850 6.5cqw/1.06 system-ui;letter-spacing:-.035em;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:.9cqw 0\">{{data.title || label}}</div><span style=\"display:{{eq(data.status, 'todo', 'inline-flex', 'none')}};color:#475569;font-weight:800;font-size:3.6cqw;white-space:nowrap\">○ To do</span><span style=\"display:{{eq(data.status, 'open', 'inline-flex', 'none')}};color:#475569;font-weight:800;font-size:3.6cqw;white-space:nowrap\">○ Open</span><span style=\"display:{{eq(data.status, 'in-progress', 'inline-flex', 'none')}};color:#1d4ed8;font-weight:800;font-size:3.6cqw;white-space:nowrap\">▶ In progress</span><span style=\"display:{{eq(data.status, 'blocked', 'inline-flex', 'none')}};color:#b91c1c;font-weight:800;font-size:3.6cqw;white-space:nowrap\">■ Blocked</span><span style=\"display:{{eq(data.status, 'waiting', 'inline-flex', 'none')}};color:#92400e;font-weight:800;font-size:3.6cqw;white-space:nowrap\">… Waiting</span><span style=\"display:{{eq(data.status, 'done', 'inline-flex', 'none')}};color:#166534;font-weight:800;font-size:3.6cqw;white-space:nowrap\">✓ Done</span><span style=\"display:{{eq(data.status, 'achieved', 'inline-flex', 'none')}};color:#166534;font-weight:800;font-size:3.6cqw;white-space:nowrap\">✓ Achieved</span><span style=\"display:{{eq(data.status, 'cancelled', 'inline-flex', 'none')}};color:#64748b;font-weight:800;font-size:3.6cqw;white-space:nowrap\">× Cancelled</span><span style=\"display:{{eq(data.status, 'answered', 'inline-flex', 'none')}};color:#166534;font-weight:800;font-size:3.6cqw;white-space:nowrap\">✓ Answered</span><span style=\"display:{{eq(data.status, 'proposed', 'inline-flex', 'none')}};color:#475569;font-weight:800;font-size:3.6cqw;white-space:nowrap\">○ Proposed</span><span style=\"display:{{eq(data.status, 'decided', 'inline-flex', 'none')}};color:#166534;font-weight:800;font-size:3.6cqw;white-space:nowrap\">✓ Decided</span><span style=\"display:{{eq(data.status, 'accepted', 'inline-flex', 'none')}};color:#166534;font-weight:800;font-size:3.6cqw;white-space:nowrap\">✓ Accepted</span><span style=\"display:{{eq(data.status, 'review', 'inline-flex', 'none')}};color:#6d28d9;font-weight:800;font-size:3.6cqw;white-space:nowrap\">◎ Review</span></div></div><div style=\"padding:0 4cqw 3cqw;flex:1;min-height:0;overflow:auto;display:flex;flex-direction:column;gap:1.8cqw\"><div style=\"border-top:1px solid #0002;padding-top:1.6cqw\"><div style=\"font:800 3cqw/1.2 system-ui;letter-spacing:.07em;text-transform:uppercase\">Outcome</div><div style=\"font-size:3.9cqw;line-height:1.35;white-space:pre-wrap;overflow-wrap:anywhere;margin-top:.6cqw\">{{data.body}}</div></div><div style=\"border-top:1px solid #0002;padding-top:1.6cqw\"><div style=\"font:800 3cqw/1.2 system-ui;letter-spacing:.07em;text-transform:uppercase\">Success signals</div><div style=\"font-size:3.9cqw;line-height:1.35;white-space:pre-wrap;overflow-wrap:anywhere;margin-top:.6cqw\">{{list(data.successMetrics)}}</div></div><div style=\"font:600 3.1cqw/1.35 system-ui;overflow-wrap:anywhere\">Owner: {{data.owner}} · Priority: {{data.priority}} · Target: {{data.targetDate}}</div><div style=\"display:{{eq(data.status, 'blocked', 'block', 'none')}};font-size:3.6cqw;color:#b91c1c\">{{data.blockedReason}}</div></div></div></div>",
