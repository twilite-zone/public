          "nodeId": "goal"
        },
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Goal",
                "type": "text",
                "path": "data.title",
                "placeholder": "What should be true when this is done?",
                "multiline": true,
                "rows": 2
              },
              {
                "key": "body",
                "label": "Description",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "Define success...",
                "multiline": true,
                "rows": 8
              },
              {
                "key": "priority",
                "label": "Priority",
                "type": "select",
                "path": "data.priority",
                "options": [
                  {
                    "label": "High",
                    "value": "high"
                  },
                  {
                    "label": "Medium",
                    "value": "medium"
                  },
                  {
                    "label": "Low",
                    "value": "low"
                  },
                  {
                    "label": "Critical",
                    "value": "critical"
                  }
                ]
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Open",
                    "value": "open"
                  },
                  {
                    "label": "In Progress",
                    "value": "in-progress"
                  },
                  {
                    "label": "Achieved",
                    "value": "achieved"
                  },
                  {
                    "label": "Blocked",
                    "value": "blocked"
                  },
                  {
                    "label": "Waiting",
                    "value": "waiting"
                  },
                  {
                    "label": "Cancelled",
                    "value": "cancelled"
                  }
                ]
              },
              {
                "key": "blockedReason",
                "label": "Blocked because",
                "type": "text",
                "path": "data.blockedReason",
                "placeholder": "What is in the way of this goal, if anything"
              },
              {
                "key": "owner",
                "label": "Owner",
                "type": "text",
                "path": "data.owner",
                "placeholder": "owner"
              },
              {
                "key": "targetDate",
                "label": "Target Date",
                "type": "text",
                "path": "data.targetDate",
                "placeholder": "YYYY-MM-DD"
              },
              {
                "key": "successMetrics",
                "label": "Done when",
                "type": "lines",
                "path": "data.successMetrics",
                "placeholder": "One thing that must be true, one to a line",
                "multiline": true,
                "rows": 4
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Goal"
              }
            ]
          }
        }
      }
