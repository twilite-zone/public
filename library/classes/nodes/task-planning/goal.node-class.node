        "html": "<div style='container-type:inline-size;position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;border-radius:6cqw;background:#ffffff;border:2px solid #d19a00;color:#0f172a;font-family:system-ui,-apple-system,Segoe UI,sans-serif;display:flex;flex-direction:column;gap:2.4cqw;padding:5cqw 6cqw 5cqw 8cqw'><i style='position:absolute;left:0;top:0;bottom:0;width:3cqw;background:#d19a00'></i><div style='position:absolute;inset:0;border-radius:6cqw;border:2px solid #cbd5e1;display:{{eq(data.status, 'todo', 'block', 'none')}};pointer-events:none'></div><div style='position:absolute;inset:0;border-radius:6cqw;border:2px solid #2563eb;display:{{eq(data.status, 'in-progress', 'block', 'none')}};pointer-events:none'></div><div style='position:absolute;inset:0;border-radius:6cqw;border:2px solid #dc2626;background:rgba(220,38,38,.07);display:{{eq(data.status, 'blocked', 'block', 'none')}};pointer-events:none'></div><div style='position:absolute;inset:0;border-radius:6cqw;border:2px dashed #d97706;display:{{eq(data.status, 'waiting', 'block', 'none')}};pointer-events:none'></div><div style='position:absolute;inset:0;border-radius:6cqw;border:2px solid #15803d;background:rgba(21,128,61,.07);display:{{eq(data.status, 'done', 'block', 'none')}};pointer-events:none'></div><div style='position:absolute;inset:0;border-radius:6cqw;border:2px solid #94a3b8;display:{{eq(data.status, 'cancelled', 'block', 'none')}};pointer-events:none'></div><div style='position:relative;display:flex;gap:2.4cqw;align-items:baseline;font-size:3.7cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase'><span style='color:#d19a00'>Goal</span><span style='display:{{eq(data.status, 'todo', 'inline-flex', 'none')}};align-items:center;gap:1.6cqw;color:#475569'><span style='font-size:5cqw;line-height:1'>○</span><span>To do</span></span><span style='display:{{eq(data.status, 'in-progress', 'inline-flex', 'none')}};align-items:center;gap:1.6cqw;color:#1d4ed8'><span style='font-size:5cqw;line-height:1'>▶</span><span>In progress</span></span><span style='display:{{eq(data.status, 'blocked', 'inline-flex', 'none')}};align-items:center;gap:1.6cqw;color:#b91c1c'><span style='font-size:5cqw;line-height:1'>■</span><span>Blocked</span></span><span style='display:{{eq(data.status, 'waiting', 'inline-flex', 'none')}};align-items:center;gap:1.6cqw;color:#b45309'><span style='font-size:5cqw;line-height:1'>…</span><span>Waiting</span></span><span style='display:{{eq(data.status, 'done', 'inline-flex', 'none')}};align-items:center;gap:1.6cqw;color:#15803d'><span style='font-size:5cqw;line-height:1'>✓</span><span>Done</span></span><span style='display:{{eq(data.status, 'cancelled', 'inline-flex', 'none')}};align-items:center;gap:1.6cqw;color:#64748b'><span style='font-size:5cqw;line-height:1'>×</span><span>Cancelled</span></span></div><div style='position:relative;font-weight:600;font-size:6.4cqw;line-height:1.2;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden'>{{data.title || label}}</div><div style='position:relative;margin-top:auto;display:flex;flex-direction:column;gap:1cqw;font-size:4cqw;color:#64748b'><div style='display:{{eq(data.status, 'blocked', 'block', 'none')}};color:#b91c1c'>{{data.blockedReason}}</div><div>{{data.owner}}</div></div></div>",
