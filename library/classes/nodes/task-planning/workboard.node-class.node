        "identity": {
          "graphId": "workboard-class",
          "name": "Workboard Class",
          "version": "0.1.0",
          "description": "Graph-local policy controller for task placement, ordering, and reconciliation.",
          "updatedAt": "2026-08-27T00:00:00.000Z",
          "nodeId": "workboard"
        },
        "intent": {
          "kind": "node-class",
          "scope": "local"
        },
        "dependencies": {
          "nodeTypes": [
            "declaration",
            "content",
            "view",
