        "html": "<div style=\"width:100%;height:100%;box-sizing:border-box;padding:18px;border-radius:18px;background:linear-gradient(145deg,#ecfeff,#f8fafc);border:2px solid #5eead4;color:#134e4a;font-family:ui-sans-serif,system-ui,sans-serif;display:flex;flex-direction:column;gap:12px;overflow:hidden;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;\"><div style=\"font-size:21px;font-weight:850;line-height:1.15;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{label || 'Bridge'}}</div><span style=\"padding:4px 9px;border-radius:999px;background:#ccfbf1;color:#0f766e;font-size:10px;font-weight:900;text-transform:uppercase;\">{{data.bridge.role || data.role || 'import'}}</span></div><div style=\"font:750 12px/1.3 ui-monospace,monospace;color:#0e7490;\">{{data.bridge.resourceKind || data.resourceKind || 'resource'}} · {{data.bridge.scope || data.scope || 'focused-graph'}}</div><div style=\"font-size:13px;line-height:1.45;color:#475569;\">{{data.memo || 'Expose bounded graph authority.'}}</div><div style=\"padding:10px;border-radius:10px;background:#fff;border:1px solid #bae6fd;font:600 11px/1.4 ui-monospace,monospace;color:#334155;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{data.bridge.ref || data.target.ref || data.ref || 'No target selected'}}</div><div style=\"margin-top:auto;font-size:11px;color:#64748b;\"><b style=\"color:#0f766e;\">Grants</b> · {{data.bridge.grants || data.grants || 'none'}}</div></div>"
