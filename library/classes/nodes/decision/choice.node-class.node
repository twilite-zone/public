        "renderShape": {
          "kind": "html"
        },
        "html": "<div style=\"container-type:inline-size;width:100%;height:100%\"><div style=\"box-sizing:border-box;width:100%;height:100%;background:#E8EFFC;color:#223B66;font-family:system-ui,sans-serif;border-radius:4cqw;border:.6cqw solid #C0D1EC;border-bottom:1.6cqw solid #223B66;overflow:hidden;display:flex;flex-direction:column\"><div style=\"display:flex;gap:3cqw;align-items:center;padding:3cqw;min-height:0;\"><div style=\"width:24cqw;aspect-ratio:1;flex:none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"63\" r=\"56\" fill=\"#223B66\"/><circle cx=\"60\" cy=\"59\" r=\"54\" fill=\"#C0D1EC\"/><circle cx=\"60\" cy=\"59\" r=\"47\" fill=\"#345B9E\"/><circle cx=\"60\" cy=\"59\" r=\"43\" fill=\"none\" stroke=\"#F2F7FF\" stroke-opacity=\".45\" stroke-width=\"1.8\"/><path d=\"M60 96V59M60 59 32 31M60 59 88 31M32 46V31H47M73 31H88V46\" fill=\"none\" stroke=\"#F2F7FF\" stroke-width=\"8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"60\" cy=\"96\" r=\"5\" fill=\"#B9E3F0\"/></svg></div><div style=\"min-width:0;flex:1\"><div style=\"font:850 3.1cqw/1.15 system-ui;letter-spacing:.1em;text-transform:uppercase;color:#223B66\">Choice</div><div style=\"font:850 6.5cqw/1.06 system-ui;letter-spacing:-.035em;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:.9cqw 0\">{{data.title || label}}</div><div style=\"display:flex;gap:1.4cqw;align-items:center;flex-wrap:wrap\"><span style=\"font:800 3.5cqw/1.2 system-ui;color:#223B66\">{{eq(data.status, 'decided', '✓ Decided', '○ Open')}}</span><span style=\"display:{{eq(data.check, true, 'inline-block', 'none')}};color:#76501D;background:#FFF5DF;border:1px solid #E8C58B;padding:.5cqw 1.6cqw;border-radius:2cqw;font:800 3.4cqw/1.2 system-ui\">TO CHECK</span></div></div></div><div style=\"padding:0 4cqw 3cqw;flex:1;min-height:0;overflow:auto;display:flex;flex-direction:column;gap:1.8cqw\"><div style=\"border-top:1px solid #0002;padding-top:1.6cqw\"><div style=\"font:800 3cqw/1.2 system-ui;letter-spacing:.07em;text-transform:uppercase\">What needs deciding</div><div style=\"font-size:4.2cqw;line-height:1.35;white-space:pre-wrap;overflow-wrap:anywhere;margin-top:.6cqw\">{{data.body}}</div></div></div></div></div>",
