        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "What is being decided",
                "type": "text",
                "path": "data.title",
                "placeholder": "A short title, as a question or a choice"
              },
              {
                "key": "body",
                "label": "Context",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "Why this needs deciding, and what is at stake.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "status",
                "label": "Where it stands",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Open",
                    "value": "open"
                  },
                  {
                    "label": "Decided",
                    "value": "decided"
                  }
                ]
              },
              {
                "key": "check",
                "label": "To check",
                "type": "select",
                "path": "data.check",
                "options": [
                  {
                    "label": "Looks right",
                    "value": false
                  },
                  {
                    "label": "To check",
                    "value": true
                  }
                ]
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Choice"
              }
            ]
          }
        }
      }
