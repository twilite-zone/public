        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "controls": [
            {
              "id": "criterion-check",
              "type": "button",
              "label": "Mark to check",
              "icon": "bolt",
              "variant": "contained",
              "priority": "highest",
              "action": "setData",
              "bind": "data.check",
              "value": true
            },
            {
              "id": "criterion-looks-right",
              "type": "button",
              "label": "Looks right",
              "icon": "edit",
              "variant": "outlined",
              "priority": "high",
              "action": "setData",
              "bind": "data.check",
              "value": false
            },
            {
              "id": "criterion-edit",
