        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "What matters",
                "type": "text",
                "path": "data.title",
                "placeholder": "A short name for the thing that counts"
              },
              {
                "key": "body",
                "label": "Why it matters",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "Why this counts, and what good looks like.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "weight",
                "label": "How much it matters",
                "type": "select",
                "path": "data.weight",
                "options": [
                  {
                    "label": "Low",
                    "value": "low"
                  },
                  {
                    "label": "Medium",
                    "value": "medium"
                  },
                  {
                    "label": "High",
                    "value": "high"
                  }
                ]
              },
              {
                "key": "check",
                "label": "To check",
                "type": "select",
                "path": "data.check",
                "options": [
                  {
                    "label": "Looks right",
                    "value": false
                  },
                  {
                    "label": "To check",
                    "value": true
                  }
                ]
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Criterion"
              }
            ]
          }
        }
      }
