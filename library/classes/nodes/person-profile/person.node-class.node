        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "controls": [
            {
              "id": "person-check",
              "type": "button",
              "label": "Mark to check",
              "icon": "bolt",
              "variant": "contained",
              "priority": "highest",
              "action": "setData",
              "bind": "data.check",
              "value": true
            },
            {
              "id": "person-looks-right",
              "type": "button",
              "label": "Looks right",
              "icon": "edit",
              "variant": "outlined",
              "priority": "high",
              "action": "setData",
              "bind": "data.check",
              "value": false
            },
            {
              "id": "person-edit",
              "type": "button",
              "label": "Edit",
              "icon": "edit",
              "variant": "outlined",
              "priority": "high",
              "action": "openEditor"
            }
          ],
          "html": {
            "chrome": true
          }
        },
        "renderShape": {
          "kind": "html"
        },
        "html": "<div style='container-type:inline-size;width:100%;height:100%'><div style='position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;border-radius:6cqw;background:#f0fdfa;border:2px solid #0f766e;color:#0f172a;font-family:system-ui,-apple-system,Segoe UI,sans-serif;display:flex;flex-direction:column;gap:2.4cqw;padding:5cqw 6cqw 5cqw 8cqw'><i style='position:absolute;left:0;top:0;bottom:0;width:3cqw;background:#0f766e'></i><div style='position:relative;display:flex;gap:2.4cqw;align-items:center;justify-content:space-between;font-size:3.7cqw;font-weight:700;letter-spacing:.08em;text-transform:uppercase'><span style='color:#0f766e'>Person</span><span style='{{eq(data.check, true, 'display:inline-block', 'display:none')}};padding:.8cqw 2.2cqw;border-radius:99cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font-size:3.2cqw;font-weight:700;letter-spacing:.06em;text-transform:uppercase'>to check</span></div><div style='position:relative;display:flex;gap:5cqw;align-items:center'><div style='flex:0 0 26cqw;height:26cqw'><div style='position:relative;width:100%;height:100%'><svg viewBox='0 0 64 64' style='width:100%;height:100%;display:block' aria-hidden='true'><circle cx='32' cy='32' r='31' fill='#0f766e' opacity='.14'/><circle cx='32' cy='25' r='11' fill='#0f766e'/><path d='M11 56Q13 38 32 38Q51 38 53 56Z' fill='#0f766e'/></svg><div style='position:absolute;inset:0;border-radius:50%;background-image:url(\"{{data.avatar}}\");background-size:cover;background-position:center 30%'></div></div></div><div style='min-width:0'><div style='font-weight:700;font-size:7.4cqw;line-height:1.12'>{{data.title || label}}</div><div style='font-size:4.2cqw;color:#64748b;margin-top:1.4cqw'>{{data.born}}{{eq(data.died, '', '', ' to ' + data.died)}}</div></div></div><div style='position:relative;flex:1 1 auto;min-height:0;font-size:4.4cqw;line-height:1.45;color:#334155;display:-webkit-box;-webkit-line-clamp:8;-webkit-box-orient:vertical;overflow:hidden'>{{data.body}}</div></div></div>",
