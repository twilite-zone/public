          "nodeId": "person"
        },
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Name",
                "type": "text",
                "path": "data.title",
                "placeholder": "Who is this?"
              },
              {
                "key": "body",
                "label": "About",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "One or two lines: who they are, and why they matter here.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "born",
                "label": "Born",
                "type": "text",
                "path": "data.born",
                "placeholder": "a year or a date"
              },
              {
                "key": "died",
                "label": "Died",
                "type": "text",
                "path": "data.died",
                "placeholder": "a year or a date, or leave empty"
              },
              {
                "key": "avatar",
                "label": "Picture",
                "type": "text",
                "path": "data.avatar",
                "placeholder": "An image address, or leave empty"
              },
              {
                "key": "subject",
                "label": "The profile is about this person",
                "type": "select",
                "path": "data.subject",
                "options": [
                  {
                    "label": "No",
                    "value": false
                  },
                  {
                    "label": "Yes",
                    "value": true
                  }
                ]
              },
              {
                "key": "check",
                "label": "To check",
                "type": "select",
                "path": "data.check",
                "options": [
                  {
                    "label": "Looks right",
                    "value": false
                  },
                  {
                    "label": "To check",
                    "value": true
                  }
                ]
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Person"
              }
            ]
          }
        }
      }
    },
