      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "hazard-class",
          "nodeId": "hazard"
        },
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Risk",
                "type": "text",
                "path": "data.title",
                "placeholder": "A short name for what could go wrong"
              },
              {
                "key": "body",
                "label": "What could happen",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "What goes wrong, and what it would cost.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "likelihood",
                "label": "How likely",
                "type": "select",
                "path": "data.likelihood",
                "options": [
                  {
                    "label": "Unlikely",
                    "value": "low"
                  },
                  {
                    "label": "Possible",
                    "value": "medium"
                  },
                  {
                    "label": "Likely",
                    "value": "high"
                  }
                ]
              },
              {
                "key": "mitigation",
                "label": "What reduces it",
                "type": "markdown",
                "path": "data.mitigation",
                "placeholder": "What you do now to make it less likely or less costly.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "fallback",
                "label": "If it happens",
                "type": "markdown",
                "path": "data.fallback",
                "placeholder": "What you do if it happens anyway.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "check",
                "label": "To check",
                "type": "select",
                "path": "data.check",
                "options": [
                  {
                    "label": "Looks right",
                    "value": false
                  },
                  {
                    "label": "To check",
                    "value": true
                  }
                ]
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Risk"
              }
            ]
          }
        }
      }
    },
