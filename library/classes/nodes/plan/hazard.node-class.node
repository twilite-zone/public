        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "controls": [
            {
              "id": "hazard-check",
              "type": "button",
              "label": "Mark to check",
              "icon": "bolt",
              "variant": "contained",
              "priority": "highest",
              "action": "setData",
              "bind": "data.check",
              "value": true
            },
            {
              "id": "hazard-looks-right",
              "type": "button",
              "label": "Looks right",
              "icon": "edit",
              "variant": "outlined",
              "priority": "high",
              "action": "setData",
              "bind": "data.check",
              "value": false
            },
            {
              "id": "hazard-edit",
              "type": "button",
              "label": "Edit",
              "icon": "edit",
              "variant": "outlined",
              "priority": "high",
              "action": "openEditor"
            }
          ],
          "html": {
            "chrome": true
          }
        },
        "renderShape": {
          "kind": "html"
        },
        "html": "<div style=\"container-type:inline-size;width:100%;height:100%\"><div style=\"box-sizing:border-box;width:100%;height:100%;background:#fbe8e1;color:#792f28;font-family:system-ui,sans-serif;border-radius:4cqw;border:.6cqw solid #f0b6a0;border-bottom:1.6cqw solid #792f28;overflow:hidden;display:flex;flex-direction:column\"><div style=\"display:flex;gap:3cqw;align-items:center;padding:3cqw;min-height:0;\"><div style=\"width:24cqw;aspect-ratio:1;flex:none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"63\" r=\"56\" fill=\"#792f28\"/><circle cx=\"60\" cy=\"59\" r=\"54\" fill=\"#f0b6a0\"/><circle cx=\"60\" cy=\"59\" r=\"47\" fill=\"#b64a39\"/><circle cx=\"60\" cy=\"59\" r=\"43\" fill=\"none\" stroke=\"#fff5df\" stroke-opacity=\".4\" stroke-width=\"1.8\"/><path d=\"M60 23 96 89H24Z\" fill=\"#fff5df\" stroke=\"#fff5df\" stroke-width=\"5\" stroke-linejoin=\"round\"/><path d=\"M60 44V65\" stroke=\"#b64a39\" stroke-width=\"9\" stroke-linecap=\"round\"/><circle cx=\"60\" cy=\"77\" r=\"4.5\" fill=\"#b64a39\"/></svg></div><div style=\"min-width:0;flex:1\"><div style=\"font:850 3.1cqw/1.15 system-ui;letter-spacing:.1em;text-transform:uppercase;color:#792f28\">Risk</div><div style=\"font:850 6.5cqw/1.06 system-ui;letter-spacing:-.035em;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:.9cqw 0\">{{data.title || label}}</div><div style=\"display:flex;gap:1.4cqw;align-items:center;flex-wrap:wrap\"><span style=\"font:800 3.5cqw/1.2 system-ui;color:#792f28\">{{eq(data.likelihood, 'high', 'Likely', eq(data.likelihood, 'low', 'Unlikely', 'Possible'))}}</span><span style=\"display:{{eq(data.check, true, 'inline-block', 'none')}};color:#92400e;background:#fff3cf;border:1px solid #e9ba6d;padding:.5cqw 1.6cqw;border-radius:2cqw;font:800 3.4cqw/1.2 system-ui\">TO CHECK</span></div></div></div><div style=\"padding:0 4cqw 3cqw;flex:1;min-height:0;overflow:auto;display:flex;flex-direction:column;gap:1.8cqw\"><div style=\"border-top:1px solid #0002;padding-top:1.6cqw\"><div style=\"font:800 3cqw/1.2 system-ui;letter-spacing:.07em;text-transform:uppercase\">Exposure</div><div style=\"font-size:3.9cqw;line-height:1.35;white-space:pre-wrap;overflow-wrap:anywhere;margin-top:.6cqw\">{{data.body}}</div></div><div style=\"border-top:1px solid #0002;padding-top:1.6cqw\"><div style=\"font:800 3cqw/1.2 system-ui;letter-spacing:.07em;text-transform:uppercase\">Mitigation</div><div style=\"font-size:3.9cqw;line-height:1.35;white-space:pre-wrap;overflow-wrap:anywhere;margin-top:.6cqw\">{{data.mitigation}}</div></div><div style=\"border-top:1px solid #0002;padding-top:1.6cqw\"><div style=\"font:800 3cqw/1.2 system-ui;letter-spacing:.07em;text-transform:uppercase\">Fallback</div><div style=\"font-size:3.9cqw;line-height:1.35;white-space:pre-wrap;overflow-wrap:anywhere;margin-top:.6cqw\">{{data.fallback}}</div></div></div></div></div>",
