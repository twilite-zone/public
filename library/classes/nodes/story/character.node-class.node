      "data": {
        "identity": {
          "graphId": "character-class",
          "nodeId": "character"
        },
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Name",
                "type": "text",
                "path": "data.title",
                "placeholder": "Their name, or what they are called"
              },
              {
                "key": "body",
                "label": "Who they are",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "What they are like, and what the reader should know.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "want",
                "label": "What they want",
                "type": "text",
                "path": "data.want",
                "placeholder": "What drives them in this story"
              },
              {
                "key": "check",
                "label": "To check",
                "type": "select",
                "path": "data.check",
                "options": [
                  {
                    "label": "Looks right",
                    "value": false
                  },
                  {
                    "label": "To check",
                    "value": true
                  }
                ]
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Character"
              }
            ]
          }
        }
      }
