    {
      "id": "release-entry-notes",
      "type": "content",
      "label": "Release Entry ground",
      "position": {
        "x": 520,
        "y": -360
      },
      "width": 460,
      "height": 220,
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 180,
