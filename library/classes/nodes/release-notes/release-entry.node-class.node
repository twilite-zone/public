        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "placeholder": "One line a customer would read, up to 80 characters"
              },
              {
                "key": "category",
                "label": "Category",
                "type": "select",
                "path": "data.category",
                "options": [
                  {
                    "label": "New",
                    "value": "new"
                  },
                  {
                    "label": "Changed",
                    "value": "changed"
                  },
                  {
                    "label": "Fixed",
                    "value": "fixed"
                  }
                ]
              },
              {
                "key": "summary",
                "label": "Summary",
                "type": "markdown",
                "path": "data.summary",
                "placeholder": "One paragraph of plain prose for a customer, up to 500 characters. No status or evidence lines.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "detail",
                "label": "Detail",
                "type": "markdown",
                "path": "data.detail",
                "placeholder": "Optional: a few more paragraphs or a short list.",
                "multiline": true,
                "rows": 4
              },
              {
                "key": "ref",
                "label": "Where to see it",
                "type": "text",
                "path": "data.ref",
                "placeholder": "Optional: a public address that shows the change"
              },
              {
                "key": "review.status",
                "label": "Review status",
                "type": "select",
                "path": "data.review.status",
                "options": [
                  {
                    "label": "Pending review",
                    "value": "pending-review"
                  },
                  {
                    "label": "Approved",
                    "value": "approved"
                  },
                  {
                    "label": "Deferred",
                    "value": "deferred"
                  },
                  {
                    "label": "Excluded",
                    "value": "excluded"
                  },
                  {
                    "label": "Published",
                    "value": "published"
                  }
                ]
              },
              {
                "key": "review.deployStatus",
                "label": "Deployment",
                "type": "select",
                "path": "data.review.deployStatus",
                "options": [
                  {
                    "label": "Unverified",
                    "value": "unverified"
                  },
                  {
                    "label": "Verified",
                    "value": "verified"
                  },
                  {
                    "label": "Not applicable",
                    "value": "not-applicable"
                  }
                ]
              },
              {
                "key": "review.note",
                "label": "Reviewer note",
                "type": "text",
                "path": "data.review.note",
                "placeholder": "Private. Never published."
              },
              {
                "key": "review.reviewedAt",
                "label": "Reviewed on",
                "type": "text",
                "path": "data.review.reviewedAt",
                "placeholder": "Private. A date, such as 2026-11-21"
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Release Entry"
              }
            ]
          }
        }
      }
