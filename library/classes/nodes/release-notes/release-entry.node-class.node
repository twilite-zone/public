        "html": "<div style='container-type:inline-size;width:100%;height:100%'><div style='position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;border-radius:0;background:#F4F0E6;border:1px solid #C8BFB0;color:#292D2C;font-family:system-ui,-apple-system,Segoe UI,sans-serif;display:flex;flex-direction:column;gap:2.4cqw;padding:4cqw 5cqw'><i style='{{eq(data.category, 'new', 'display:block', 'display:none')}};position:absolute;left:0;top:0;right:0;height:1.4cqw;background:#15803d'></i><i style='{{eq(data.category, 'changed', 'display:block', 'display:none')}};position:absolute;left:0;top:0;right:0;height:1.4cqw;background:#1d4ed8'></i><i style='{{eq(data.category, 'fixed', 'display:block', 'display:none')}};position:absolute;left:0;top:0;right:0;height:1.4cqw;background:#b45309'></i><div style='position:relative;display:flex;gap:2.4cqw;align-items:center;justify-content:space-between;font-size:4.2cqw;font-weight:700;letter-spacing:.08em;text-transform:uppercase'><span><span style='{{eq(data.category, 'new', 'display:inline', 'display:none')}};color:#15803d'>New</span><span style='{{eq(data.category, 'changed', 'display:inline', 'display:none')}};color:#1d4ed8'>Changed</span><span style='{{eq(data.category, 'fixed', 'display:inline', 'display:none')}};color:#b45309'>Fixed</span></span><span style='{{eq(data.review.status, '', 'display:none', 'display:inline-block')}};padding:.8cqw 2.4cqw;border-radius:99cqw;background:#ffffff;border:1px solid #354B58;color:#354B58;font-size:3.2cqw;font-weight:700;letter-spacing:.06em;text-transform:uppercase'>{{data.review.status}}</span></div><div style='position:relative;flex:none;font-weight:850;font-size:7.2cqw;line-height:1.15;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'>{{data.title || label}}</div><div style='position:relative;flex:1 1 auto;min-height:0;font-family:Georgia,serif;font-size:4.4cqw;line-height:1.35;color:#334155;display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden'>{{data.summary}}</div><div style='{{eq(data.detail, '', 'display:none', 'display:block')}};position:relative;font-size:4cqw;line-height:1.45;color:#475569;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>{{data.detail}}</div><div style='{{eq(data.ref, '', 'display:none', 'display:block')}};position:relative;font-size:3.4cqw;color:#354B58;overflow:hidden;text-overflow:ellipsis;white-space:nowrap'>See it: {{data.ref}}</div></div></div>",
