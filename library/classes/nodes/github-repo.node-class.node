        "name": "GitHub Repo Node Class",
        "declaresKind": "node-class",
        "purpose": "Declare the reusable GitHub Repo node class used by a repository to participate in the Twilite ecosystem, and expose its semantic presentations to consuming repo graphs.",
        "nodeClass": {
          "contractVersion": "1.0.0",
          "key": "github-repo",
          "meaning": "Represent a GitHub repository as a first-class Twilite object with a stable repo-home contract.",
          "description": "Use this class when a graph needs repo identity, branch context, and home-graph resolution without collapsing the repository into a single file address.",
          "nodeDef": {
            "key": "github-repo",
            "ref": "github://twilite-zone/public/library/classes/nodes/github-repo.node-class.node",
            "source": "local",
            "version": ">=0.1.0",
            "defaults": {
              "label": "GitHub Repo",
              "size": {
                "width": 420,
                "height": 280
              },
              "color": "linear-gradient(135deg, #dbeafe, #c7d2fe)",
              "showLabel": false,
              "data": {
                "title": "GitHub Repo",
                "owner": "",
                "repo": "",
                "branch": "main",
                "homeRef": "/root.node",
                "notes": "",
                "status": "draft"
              }
            }
          }
        },
