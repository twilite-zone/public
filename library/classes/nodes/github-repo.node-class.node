8px;padding:14px 16px;border-radius:18px;background:#0f172a;color:#f8fafc;\"><div style=\"font:700 11px/1.2 ui-sans-serif,system-ui,sans-serif;letter-spacing:0.08em;text-transform:uppercase;color:rgba(248,250,252,0.7);\">Repository Identity</div><div style=\"font:700 18px/1.25 ui-monospace,SFMono-Regular,monospace;color:#f8fafc;\">{{data.owner}}/{{data.repo}}</div><div style=\"font:500 12px/1.45 ui-monospace,SFMono-Regular,monospace;color:rgba(248,250,252,0.82);\">github://{{data.owner}}/{{data.repo}}</div></div><div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;\"><div style=\"padding:14px;border-radius:18px;background:rgba(15,23,42,0.04);border:1px solid rgba(15,23,42,0.08);\"><div style=\"font:700 11px/1.2 ui-sans-serif,system-ui,sans-serif;letter-spacing:0.08em;text-transform:uppercase;color:#64748b;\">Home Ref</div><div style=\"margin-top:8px;font:700 14px/1.3 ui-monospace,SFMono-Regular,monospace;color:#0f172a;\">{{data.homeRef}}</div></div><div style=\"padding:14px;border-radius:18px;background:rgba(15,23,42,0.04);border:1px solid rgba(15,23,42,0.08);\"><div style=\"font:700 11px/1.2 ui-sans-serif,system-ui,sans-serif;letter-spacing:0.08em;text-transform:uppercase;color:#64748b;\">Resolution Rule</div><div style=\"margin-top:8px;font:600 13px/1.45 ui-sans-serif,system-ui,sans-serif;color:#334155;\">Declaration wins. <span style=\"font-family:ui-monospace,SFMono-Regular,monospace;\">/root.node</span> bootstraps.</div></div></div><div style=\"font:500 14px/1.55 ui-sans-serif,system-ui,sans-serif;color:#334155;white-space:pre-wrap;overflow:auto;\">{{data.notes}}</div></div>",
