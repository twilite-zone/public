        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "controls": [
            {
              "id": "query-check",
              "type": "button",
              "label": "Mark to check",
              "icon": "bolt",
              "variant": "contained",
              "priority": "highest",
              "action": "setData",
              "bind": "data.check",
              "value": true
            },
            {
              "id": "query-looks-right",
              "type": "button",
              "label": "Looks right",
              "icon": "edit",
              "variant": "outlined",
              "priority": "high",
              "action": "setData",
              "bind": "data.check",
              "value": false
            },
            {
              "id": "query-edit",
              "type": "button",
              "label": "Edit",
              "icon": "edit",
              "variant": "outlined",
              "priority": "high",
              "action": "openEditor"
            }
          ],
          "html": {
            "chrome": true
          }
        },
        "renderShape": {
          "kind": "html"
        },
        "html": "<div style=\"container-type:inline-size;width:100%;height:100%\"><div style=\"box-sizing:border-box;width:100%;height:100%;background:#F1EEFF;color:#5A4E84;font-family:system-ui,sans-serif;border-radius:4cqw;border:.6cqw solid #D6CBF8;border-bottom:1.6cqw solid #5A4E84;overflow:hidden;display:flex;flex-direction:column\"><div style=\"display:flex;gap:3cqw;align-items:center;padding:3cqw;min-height:0;\"><div style=\"width:24cqw;aspect-ratio:1;flex:none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"63\" r=\"56\" fill=\"#5A4E84\"/><circle cx=\"60\" cy=\"59\" r=\"54\" fill=\"#D6CBF8\"/><circle cx=\"60\" cy=\"59\" r=\"47\" fill=\"#8A7DCE\"/><circle cx=\"60\" cy=\"59\" r=\"43\" fill=\"none\" stroke=\"#F7F5FF\" stroke-opacity=\".4\" stroke-width=\"1.8\"/><path d=\"M38 40C38 19 82 19 82 42 82 57 60 57 60 72\" stroke=\"#F7F5FF\" stroke-width=\"11\" stroke-linecap=\"round\" fill=\"none\"/><circle cx=\"60\" cy=\"91\" r=\"6\" fill=\"#F7F5FF\"/></svg></div><div style=\"min-width:0;flex:1\"><div style=\"font:850 3.1cqw/1.15 system-ui;letter-spacing:.1em;text-transform:uppercase;color:#5A4E84\">Question</div><div style=\"font:850 6.5cqw/1.06 system-ui;letter-spacing:-.035em;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:.9cqw 0\">{{data.title || label}}</div><div style=\"display:flex;gap:1.4cqw;align-items:center;flex-wrap:wrap\"><span style=\"font:800 3.5cqw/1.2 system-ui;color:#5A4E84\">{{eq(data.status, 'answered', '✓ Answered', '○ Open')}}</span><span style=\"display:{{eq(data.check, true, 'inline-block', 'none')}};color:#31406B;background:#EEF3FF;border:1px solid #B9C7F5;padding:.5cqw 1.6cqw;border-radius:2cqw;font:800 3.4cqw/1.2 system-ui\">TO CHECK</span></div></div></div><div style=\"padding:0 4cqw 3cqw;flex:1;min-height:0;overflow:auto;display:flex;flex-direction:column;gap:1.8cqw\"><div style=\"border-top:1px solid #0002;padding-top:1.6cqw\"><div style=\"font:800 3cqw/1.2 system-ui;letter-spacing:.07em;text-transform:uppercase\">What remains unknown</div><div style=\"font-size:4.2cqw;line-height:1.35;white-space:pre-wrap;overflow-wrap:anywhere;margin-top:.6cqw\">{{data.body}}</div></div></div></div></div>",
