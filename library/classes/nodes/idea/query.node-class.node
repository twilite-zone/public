      "data": {
        "identity": {
          "graphId": "query-class",
          "nodeId": "query"
        },
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Question",
                "type": "text",
                "path": "data.title",
                "placeholder": "What is not known, as a question"
              },
              {
                "key": "body",
                "label": "Why it matters",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "What is known so far, and what an answer would change.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "status",
                "label": "Where it stands",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Open",
                    "value": "open"
                  },
                  {
                    "label": "Answered",
                    "value": "answered"
                  }
                ]
              },
              {
                "key": "check",
                "label": "To check",
                "type": "select",
                "path": "data.check",
                "options": [
                  {
                    "label": "Looks right",
                    "value": false
                  },
                  {
                    "label": "To check",
                    "value": true
                  }
                ]
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Question"
              }
            ]
          }
        }
      }
    },
