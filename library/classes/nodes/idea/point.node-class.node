        },
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Point",
                "type": "text",
                "path": "data.title",
                "placeholder": "A short name for this idea"
              },
              {
                "key": "body",
                "label": "In a line or two",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "What it says, and how it bears on the idea.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "role",
                "label": "What it is for",
                "type": "select",
                "path": "data.role",
                "options": [
                  {
                    "label": "Part",
                    "value": "part"
                  },
                  {
                    "label": "Reason",
                    "value": "reason"
                  },
                  {
                    "label": "Example",
                    "value": "example"
                  },
                  {
                    "label": "Objection",
                    "value": "objection"
                  }
                ]
              },
              {
                "key": "check",
                "label": "To check",
                "type": "select",
                "path": "data.check",
                "options": [
                  {
                    "label": "Looks right",
                    "value": false
                  },
                  {
                    "label": "To check",
                    "value": true
                  }
                ]
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Point"
              }
            ]
          }
        }
      }
    },
