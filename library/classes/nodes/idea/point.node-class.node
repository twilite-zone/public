        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "controls": [
            {
              "id": "point-check",
              "type": "button",
              "label": "Mark to check",
              "icon": "bolt",
              "variant": "contained",
              "priority": "highest",
              "action": "setData",
              "bind": "data.check",
              "value": true
            },
            {
              "id": "point-looks-right",
              "type": "button",
              "label": "Looks right",
              "icon": "edit",
              "variant": "outlined",
              "priority": "high",
              "action": "setData",
              "bind": "data.check",
              "value": false
            },
            {
              "id": "point-edit",
              "type": "button",
              "label": "Edit",
              "icon": "edit",
              "variant": "outlined",
              "priority": "high",
              "action": "openEditor"
            }
          ],
          "html": {
            "chrome": true
          }
        },
        "renderShape": {
          "kind": "html"
        },
        "html": "<div style='container-type:inline-size;width:100%;height:100%'><div style='position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;border-radius:6cqw;background:#f0f9ff;border:2px solid #0369a1;color:#0f172a;font-family:system-ui,-apple-system,Segoe UI,sans-serif;display:flex;flex-direction:column;gap:2.4cqw;padding:5cqw 6cqw 5cqw 8cqw'><i style='position:absolute;left:0;top:0;bottom:0;width:3cqw;background:#0369a1'></i><div style='position:relative;display:flex;gap:2.4cqw;align-items:center;justify-content:space-between;font-size:3.7cqw;font-weight:700;letter-spacing:.08em;text-transform:uppercase'><span style='color:#0369a1'>Point</span><span style='display:flex;gap:2cqw;align-items:center'><span style='padding:.8cqw 2.4cqw;border-radius:99cqw;background:#ffffff;border:1px solid #0369a1;color:#0369a1;font-size:3.2cqw;font-weight:700;letter-spacing:.06em;text-transform:uppercase'>{{eq(data.role, 'reason', 'Reason', eq(data.role, 'example', 'Example', eq(data.role, 'objection', 'Objection', 'Part')))}}</span><span style='{{eq(data.check, true, 'display:inline-block', 'display:none')}};padding:.8cqw 2.2cqw;border-radius:99cqw;background:#fffbeb;border:1px solid #fde68a;color:#92400e;font-size:3.2cqw;font-weight:700;letter-spacing:.06em;text-transform:uppercase'>to check</span></span></div><div style='position:relative;font-weight:700;font-size:8cqw;line-height:1.15;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>{{data.title || label}}</div><div style='position:relative;flex:1 1 auto;min-height:0;font-size:4.6cqw;line-height:1.45;color:#334155;display:-webkit-box;-webkit-line-clamp:8;-webkit-box-orient:vertical;overflow:hidden'>{{data.body}}</div></div></div>",
        "semanticLevel": "detail"
      }
    },
