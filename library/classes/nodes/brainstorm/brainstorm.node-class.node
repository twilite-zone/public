        },
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "label",
                "label": "Label",
                "type": "text",
                "path": "label",
                "placeholder": "Repo"
              },
              {
                "key": "title",
                "label": "Subject",
                "type": "text",
                "path": "data.title",
                "placeholder": "What are you thinking about?"
              },
              {
                "key": "body",
                "label": "What it is about",
                "type": "markdown",
                "path": "data.body",
                "multiline": true,
                "rows": 4,
                "placeholder": "The question or subject, in a sentence"
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Exploring",
                    "value": "exploring"
                  },
                  {
                    "label": "Narrowing",
                    "value": "narrowing"
                  },
                  {
                    "label": "Settled",
                    "value": "settled"
                  }
                ]
              },
              {
                "key": "standing",
                "label": "Where it stands",
                "type": "text",
                "path": "data.standing",
                "placeholder": "The open question, in a line"
              },
              {
                "key": "sort",
                "label": "Order of the shelves",
                "type": "select",
                "path": "data.sort",
                "options": [
                  {
                    "label": "As listed",
                    "value": "order"
                  },
                  {
                    "label": "By name",
                    "value": "name"
                  },
                  {
                    "label": "By kind",
                    "value": "kind"
                  }
                ]
              },
              {
                "key": "includeFolder",
                "label": "Include the folders of this repository",
                "type": "boolean",
                "path": "data.includeFolder",
                "section": "members",
                "helperText": "Adds each folder of the repository that has a root graph. Needs a github:// address; a published site cannot list its folders."
              },
              {
                "key": "sourcesSummary",
                "label": "Where the shelves come from",
                "type": "text",
                "path": "data.sourcesSummary",
                "readOnly": true,
                "fullWidth": true,
                "section": "members",
                "helperText": "Written by the library each time it changes."
              }
            ]
          }
        }
      }
