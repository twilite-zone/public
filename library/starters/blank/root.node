          "value": "<div style=\"width:100%;height:100%;container-type:inline-size;overflow:auto;background:#f3f6f8;color:#14283f;font-family:system-ui,sans-serif\"><div style=\"box-sizing:border-box;max-width:900px;margin:0 auto;padding:clamp(20px,5cqw,42px)\"><div style=\"border-top:4px solid #294b83;border-bottom:1px solid #9ab2cc;padding:10px 0;font-size:13px;font-weight:800;letter-spacing:.16em\">NEW GRAPH</div><div style=\"display:flex;align-items:center;gap:4cqw;margin-top:4cqw\"><div style=\"flex:1;min-width:0\"><h1 style=\"font-size:clamp(30px,8cqw,70px);font-weight:850;line-height:1.02;letter-spacing:-.04em;margin:0\">A new graph</h1><p style=\"font-size:clamp(16px,3cqw,23px);line-height:1.45;margin:3cqw 0 0\">Nothing is in it yet. Add a node, draw an edge between two nodes, and give the graph a name and a description.</p></div><div style=\"width:23cqw;max-width:180px;background:#14283f;padding:1cqw\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 120\" preserveAspectRatio=\"xMidYMid meet\" aria-hidden=\"true\"><g fill=\"none\" stroke=\"#a9c9ed\" stroke-width=\"3\"><path d=\"M60 23V54M60 54 25 92M60 54 95 92\"/><rect x=\"47\" y=\"7\" width=\"26\" height=\"26\" rx=\"3\" fill=\"#1e3550\"/><rect x=\"12\" y=\"80\" width=\"26\" height=\"26\" rx=\"3\" fill=\"#1e3550\"/><rect x=\"82\" y=\"80\" width=\"26\" height=\"26\" rx=\"3\" fill=\"#1e3550\"/></g></svg></div></div></div></div>"
