        "semanticLevel": "summary",
        "content": {
          "kind": "html",
          "value": "<div style=\"width:100%;height:100%;container-type:inline-size\"><div style=\"box-sizing:border-box;height:100%;display:flex;flex-direction:column;padding:5cqw 6cqw;background:#101a36;color:#f7faff;font-family:system-ui,sans-serif;overflow:hidden;border-top:.9cqw solid #75ffe4;gap:2cqw\"><div style=\"font-size:3.6cqw;color:#75ffe4;font-weight:800;letter-spacing:.12em;text-transform:uppercase\">AI starter</div><div style=\"display:flex;align-items:center;gap:3cqw;flex:1;min-height:0\"><div style=\"flex:1;min-width:0;font-size:9.4cqw;font-weight:850;line-height:1.02;letter-spacing:-.04em;overflow-wrap:anywhere\">Start with your AI</div><div style=\"width:29cqw;flex:0 0 auto\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 120 120\" preserveAspectRatio=\"xMidYMid meet\" aria-hidden=\"true\"><circle cx=\"60\" cy=\"60\" r=\"44\" fill=\"#298dcd\" fill-opacity=\".12\" stroke=\"#75ffe4\" stroke-opacity=\".5\"/><ellipse cx=\"60\" cy=\"60\" rx=\"55\" ry=\"18\" transform=\"rotate(-28 60 60)\" stroke=\"#75ffe4\" stroke-opacity=\".65\" stroke-width=\"1.5\" fill=\"none\"/><path d=\"M60 23 92 42V78L60 97 28 78V42Z\" fill=\"#1b536d\" stroke=\"#75ffe4\" stroke-width=\"2\"/><path d=\"M60 23V60L92 78M60 60 28 78M28 42 60 60 92 42\" stroke=\"#75ffe4\" stroke-width=\"1.5\" fill=\"none\"/><path d=\"M60 42 76 51V69L60 78 44 69V51Z\" fill=\"#c4fff3\"/><circle cx=\"60\" cy=\"23\" r=\"4\" fill=\"#ffcf82\"/><circle cx=\"28\" cy=\"78\" r=\"4\" fill=\"#ffcf82\"/><circle cx=\"92\" cy=\"78\" r=\"4\" fill=\"#ffcf82\"/></svg></div></div><div style=\"font-size:4.4cqw;line-height:1.25;color:#f7faff;padding-top:2cqw;border-top:1px solid #1d304c\">Your AI puts what you made here.</div></div></div>"
