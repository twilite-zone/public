        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:size;box-sizing:border-box;width:100%;height:100%;position:relative;overflow:hidden;background:radial-gradient(ellipse 70% 32% at 82% 12%,#42307b 0%,transparent 75%),radial-gradient(ellipse 85% 40% at 15% 86%,#1c426e 0%,transparent 75%),#101326;color:#f4e9ff;font-family:system-ui\"><div style=\"position:absolute;inset:0;background-image:linear-gradient(#a18ece0e 1px,transparent 1px),linear-gradient(90deg,#a18ece0e 1px,transparent 1px);background-size:3.5cqw 3.5cqw\"></div><div style=\"position:absolute;inset:2% 2.2%;border:.055cqw solid #8b75ba5a;pointer-events:none\"></div><div style=\"position:absolute;top:2.7%;left:9.5%;right:8%;height:3.2%;border-bottom:.065cqw solid #9d85c5a1;display:flex;align-items:center;justify-content:space-between\"><div style=\"display:flex;gap:1cqw;align-items:center\"><span style=\"display:inline-block;width:2.6cqw\"><img src=\"https://raw.githubusercontent.com/twilite-zone/public/main/logo_light.svg\" alt=\"Twilite logo\" style=\"display:block;width:2.6cqw;height:auto;aspect-ratio:715.29249/659.84117;object-fit:contain;filter:invert(86%) sepia(43%) saturate(671%) hue-rotate(347deg) brightness(106%) contrast(107%)\"></span><span style=\"font:850 1.3cqw;letter-spacing:.2em;color:#f6d363\">TWILITE ZONE</span><span style=\"font:650 .95cqw;letter-spacing:.12em;color:#b5a4d3\">THE FRONT DOOR</span></div><span style=\"font:700 .9cqw;letter-spacing:.11em;color:#c2b2e0\">A WEB OF CONNECTED PLACES</span></div><div style=\"position:absolute;left:4.2%;top:10%;writing-mode:vertical-rl;transform:rotate(180deg);font:850 1.2cqw;letter-spacing:.27em;color:#ddc8ed\">EXPLORE THE TWILITE ZONE</div><div style=\"position:absolute;top:8%;left:8.6%;width:70.5%;height:79%;border:.16cqw solid #d4bdf07d;border-radius:.6cqw;box-shadow:0 0 0 .45cqw #3b2a616b,0 0 0 .55cqw #bba3d34a;pointer-events:none\"></div><div style=\"position:absolute;right:2.8%;top:10%;width:15.2%;display:flex;flex-direction:column;gap:3cqw\"><div style=\"border-bottom:.1cqw solid #f6d363;padding-bottom:1.8cqw\"><div style=\"font:850 1.2cqw;letter-spacing:.16em;color:#f6d363\">WELCOME</div><div style=\"font:520 2.5cqw/1.13 Georgia,serif;margin-top:1cqw\">A different way to see the web.</div></div><div style=\"border-left:.14cqw solid #9e80c7;padding-left:1.2cqw\"><div style=\"font:850 1.1cqw;color:#f6d363\">01 / EXPLORE</div><div style=\"font:490 1.5cqw/1.5 system-ui;margin-top:.6cqw;color:#d8cde7\">Enter public graphs and destinations.</div></div><div style=\"border-left:.14cqw solid #9e80c7;padding-left:1.2cqw\"><div style=\"font:850 1.1cqw;color:#f6d363\">02 / LEARN</div><div style=\"font:490 1.5cqw/1.5 system-ui;margin-top:.6cqw;color:#d8cde7\">Follow the guides, discover the model.</div></div><div style=\"border-left:.14cqw solid #9e80c7;padding-left:1.2cqw\"><div style=\"font:850 1.1cqw;color:#f6d363\">03 / BUILD</div><div style=\"font:490 1.5cqw/1.5 system-ui;margin-top:.6cqw;color:#d8cde7\">Make your own connected world.</div></div></div><div style=\"position:absolute;bottom:3%;left:9.5%;right:8%;padding-top:1.2cqw;border-top:.06cqw solid #a18ece75;display:flex;justify-content:space-between\"><span style=\"font:800 1.1cqw;letter-spacing:.15em;color:#f6d363;white-space:nowrap\">YOUR AI. YOUR WORK. YOUR ZONE.</span><a href=\"tlz://twilite.zone/company/root.node\" style=\"font:650 1cqw;color:#b9aad6;white-space:nowrap;text-decoration:none;margin-left:2cqw\">TWILITE LLC</a></div></div>"
        }
