          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;min-height:0;overflow:hidden;position:relative;background:radial-gradient(ellipse at 88% 10%,#583b91 0%,transparent 50%),linear-gradient(122deg,#28145b,#241640 75%,#18233f);color:white;font-family:system-ui;padding:5cqw;border:3px solid #c1a7ef;border-top:12px solid #ffd55e;border-radius:2cqw;box-shadow:inset 0 0 100px #7f50bf27\"><div style=\"display:flex;align-items:center;gap:1.8cqw\"><img src=\"https://raw.githubusercontent.com/twilite-zone/public/main/logo_light.svg\" alt=\"Twilite logo\" style=\"display:block;width:7.2cqw;height:auto;aspect-ratio:715.29249/659.84117;object-fit:contain;filter:invert(84%) sepia(48%) saturate(624%) hue-rotate(345deg) brightness(106%) contrast(104%)\"><div style=\"font:900 2.9cqw/1.15 system-ui;letter-spacing:.2em;color:#ffd768\">TWILITE ZONE</div></div><div style=\"font:800 2cqw/1.25 system-ui;letter-spacing:.17em;color:#cfb9f0;margin-top:3.2cqw;text-transform:uppercase\">You are about to enter a new dimension.</div><div style=\"font:500 6.5cqw/1.04 Georgia,serif;max-width:90%;letter-spacing:-.015em;margin-top:1.6cqw\">Build knowledge that outlives the conversation.</div><div style=\"font:450 2.65cqw/1.45 system-ui;max-width:85%;color:#e6daf6;margin-top:2.6cqw\">Explore a web of connected graphs, living documents, and places worth visiting. Build with your AI. Keep what you create.</div><div style=\"display:flex;gap:1.4cqw;align-items:center;flex-wrap:wrap;margin-top:4cqw\"><a href=\"tlz://twilite.zone/library/starters/start-with-your-ai/root.node\" style=\"font:850 2cqw/1.2 system-ui;padding:1.45cqw 2.4cqw;background:#ffd768;color:#281548;border-radius:.85cqw;text-decoration:none\">Start with your AI ↗</a><a href=\"tlz://twilite.zone/github/the-commons/root.node\" style=\"font:800 2cqw/1.2 system-ui;padding:1.45cqw 2.4cqw;border:2px solid #cdbbe9;color:white;border-radius:.85cqw;text-decoration:none\">Explore the Zone ↗</a></div><div style=\"font:600 1.9cqw/1.5 system-ui;color:#e6daf6;max-width:58%;margin-top:2.6cqw\">Explore the Zone free. Try the Editor free for 14 days, then $20/month. Bring your own AI.</div><div style=\"position:absolute;right:4cqw;bottom:3.5cqw;font:750 1.6cqw/1.25 system-ui;color:#cfb9f0;letter-spacing:.12em\">EXPLORE · LEARN · BUILD</div></div>"
