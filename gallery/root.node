        "content": {
          "kind": "svg",
          "value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1560 930\" width=\"100%\" role=\"img\" aria-label=\"Twilite gallery hall with three lit exhibit entrances\"><defs><linearGradient id=\"wall\" x2=\"0\" y2=\"1\"><stop stop-color=\"#22294a\"/><stop offset=\"1\" stop-color=\"#10152a\"/></linearGradient><linearGradient id=\"floor\" x2=\".5\" y2=\"1\"><stop stop-color=\"#3a314f\"/><stop offset=\"1\" stop-color=\"#10172b\"/></linearGradient></defs><rect width=\"1560\" height=\"930\" fill=\"#10152a\"/><rect width=\"1560\" height=\"680\" fill=\"url(#wall)\"/><path d=\"M0 665 L1560 665 1560 930 0 930Z\" fill=\"url(#floor)\"/><path d=\"M780 660L370 930M780 660L1190 930M0 810H1560\" stroke=\"#6d668a\" stroke-width=\"3\" opacity=\".55\"/><g fill=\"none\" stroke=\"#e3c583\" stroke-width=\"6\"><path d=\"M25 640V105H1535V640\"/><path d=\"M55 615V135H1505V615\" opacity=\".5\"/></g><text x=\"780\" y=\"94\" fill=\"#e4c783\" text-anchor=\"middle\" font-family=\"system-ui\" letter-spacing=\"9\" font-size=\"31\">THE TWILITE ZONE</text><text x=\"780\" y=\"194\" fill=\"#f5efff\" text-anchor=\"middle\" font-family=\"Georgia,serif\" font-size=\"82\">THE GALLERY</text><text x=\"780\" y=\"243\" fill=\"#c6c9df\" text-anchor=\"middle\" font-family=\"system-ui\" font-size=\"22\">THREE WAYS TO SEE WHAT A GRAPH CAN BE</text><g><rect x=\"95\" y=\"310\" width=\"406\" height=\"343\" rx=\"9\" fill=\"#192c35\" stroke=\"#b8e7d1\" stroke-width=\"9\"/><rect x=\"577\" y=\"310\" width=\"406\" height=\"343\" rx=\"9\" fill=\"#352a27\" stroke=\"#f5ca92\" stroke-width=\"9\"/><rect x=\"1059\" y=\"310\" width=\"406\" height=\"343\" rx=\"9\" fill=\"#2e2348\" stroke=\"#c9b6fa\" stroke-width=\"9\"/><path d=\"M125 643V375Q298 294 471 375V643\" fill=\"#1e4646\" stroke=\"#b8e7d1\" stroke-width=\"3\"/><path d=\"M607 643V375Q780 294 953 375V643\" fill=\"#60422b\" stroke=\"#f5ca92\" stroke-width=\"3\"/><path d=\"M1089 643V375Q1262 294 1435 375V643\" fill=\"#493a68\" stroke=\"#c9b6fa\" stroke-width=\"3\"/></g><g font-family=\"system-ui\" fill=\"#ffffff\" text-anchor=\"middle\"><text x=\"298\" y=\"483\" font-size=\"34\" font-weight=\"700\">THE TASK STUDIO</text><text x=\"780\" y=\"483\" font-size=\"34\" font-weight=\"700\">THE PROJECT</text><text x=\"1262\" y=\"483\" font-size=\"34\" font-weight=\"700\">HEADQUARTERS</text><text x=\"298\" y=\"528\" font-size=\"22\">Work and decisions</text><text x=\"780\" y=\"528\" font-size=\"22\">A connected workspace</text><text x=\"1262\" y=\"528\" font-size=\"22\">A graph as a place</text></g><text x=\"780\" y=\"852\" fill=\"#e4c783\" font-size=\"26\" font-family=\"system-ui\" letter-spacing=\"5\" text-anchor=\"middle\">CHOOSE A DOOR · EXPLORE THE GRAPH</text></svg>"
        },
        "altText": "A gallery hall with three exhibit doorways: Task Studio, Twilite Project, and Headquarters."
      },
      "positionLocked": true
    },
