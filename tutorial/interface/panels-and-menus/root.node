      "data": {
        "title": "Try it",
        "body": "Use the checklist below as a decision aid: if you know what you need to do, it should tell you which control surface is probably the right one first.\n\n## Which surface should I open?\n\n- Need to discover available things? Try legend or elements.\n- Need to inspect or edit the selected node or edge? Open properties.\n- Need app-wide controls, preferences, or account actions? Use menus or account surfaces.\n- Need the graph itself, not a panel? Return to the graph surface.\n\nThe goal is not to memorize every button. The goal is to know which layer answers which kind of question.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "tutorial-interface-panels-and-menus"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
