    {
      "id": "tutorial-interface-browser-bar-know",
      "type": "page-section",
      "label": "What to know",
      "position": {
        "x": 2130,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "What to know",
        "body": "Home goes to the graph you chose as home: the settings menu at the far right has Set Current Document as Home and Clear Home Page. Refresh reads the graph again from its address, and a Shift-click on it is a hard refresh that also clears the graphs kept in memory. A mark at the end of the address field says when the graph has unsaved changes, and READ ONLY says when the graph cannot be saved where it is. A right-click in the address field offers Copy, Paste & Go and a web-friendly form of the address. If you are signed in, your bookmarks follow your account.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "tutorial-interface-browser-bar"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
