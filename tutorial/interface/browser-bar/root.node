    {
      "id": "tutorial-interface-browser-bar-what",
      "type": "page-section",
      "label": "What it is",
      "position": {
        "x": -270,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "What it is",
        "body": "The bar across the top works like a web browser’s. The address field names the graph you are in: a `tlz://` address is a published graph, and a `github://` address is a file in a GitHub repository. Beside it are Back, Forward, Refresh and Home. To the right are your bookmarks, the template gallery, the Twilite (brain) button that copies the guide for your AI, and your account. The File menu for this graph is in the toolbar below.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "tutorial-interface-browser-bar"
        },
