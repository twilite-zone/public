    {
      "id": "tutorial-interface-browser-bar-try",
      "type": "page-section",
      "label": "Try it",
      "position": {
        "x": 930,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "Try it",
        "body": "1. Read the address, then type or paste another one and press Enter to open it.\n2. Follow a link or a Portal, then press Back. You return to where you were, at the same place and distance.\n3. Press the bookmark button to keep the graph you are in, and open the bookmarks menu to come back to it.\n4. Press the template gallery to start from a template.\n5. Press the button that copies the short guide for your AI, and paste it into your chatbot. The menu beside it has other ways to copy the guide.\n6. Open the File menu in the toolbar: New graph, Open graph, Save, Save As… and the rest belong to the graph you are in.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "tutorial-interface-browser-bar"
