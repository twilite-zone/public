    {
      "id": "tutorial-interface-getting-around-try",
      "type": "page-section",
      "label": "Try it",
      "position": {
        "x": 930,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "Try it",
        "body": "1. While browsing, click a node that is far away. The camera comes to it.\n2. Click it again. It takes focus and is brought to reading size.\n3. Click it a third time. You are inside it and can scroll and follow its links.\n4. Press Escape to step out of the node, and again to return to the graph as a whole.\n5. With a node in focus, press the right arrow to walk along the edge leaving it, and the left arrow to walk back. Where there is more than one way on, the up and down arrows choose among the edges by name.\n6. Click an edge: the first click frames both of its ends, the second selects it, and the third travels to the end you are not at.\n7. Press Back in the browser bar. You are returned to exactly where you were.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "tutorial-interface-getting-around"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
