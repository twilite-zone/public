    {
      "id": "tutorial-interface-getting-around-rule",
      "type": "page-section",
      "label": "The rule",
      "position": {
        "x": -270,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "The rule",
        "body": "Everything is seen at some distance. A click on a thing brings you one step closer to it, and stepping out takes you one step back. For a node there are three steps. If it is far or small, the camera comes to it. If it is in view, it takes focus at a size you can read. If it already has focus, you are inside it: its text scrolls and its links answer. A double-click goes straight to the last step.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "tutorial-interface-getting-around"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
