    {
      "id": "tutorial-interface-getting-around-know",
      "type": "page-section",
      "label": "What to know",
      "position": {
        "x": 2130,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "What to know",
        "body": "A drag moves, and a click travels: dragging never takes you anywhere. It moves the node, or pans the view when the node is pinned or you drag empty space. A click never moves anything. A Portal takes the same steps as a node, and its last step goes through to the graph it opens; an Enter button on it does the same in one press. A link inside a page takes one click, because you are already inside. While you are editing, a click selects a node and does not travel, so you never leave the graph you are working on by surprise.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "tutorial-interface-getting-around"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
