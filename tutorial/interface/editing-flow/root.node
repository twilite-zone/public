      "data": {
        "title": "Try it",
        "body": "Use the checklist below as a compact editing rhythm. If you find yourself lost, it should tell you what the next sane step probably is.\n\n## Editing rhythm\n\n1. Select the thing you mean to inspect.\n2. Read the current state before changing it.\n3. Create only what the graph actually needs next.\n4. Connect or place the new thing deliberately.\n5. Reuse by copy/paste only when structure and identity still make sense.\n6. Verify the graph still tells the story you intended.\n\nThe flow matters more than any one button.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "tutorial-interface-editing-flow"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
