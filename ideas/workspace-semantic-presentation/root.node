    {
      "id": "workspace-semantic-presentation-landing-surface",
      "label": "Workspace Semantic Presentation Draft",
      "type": "content",
      "position": {
        "x": -520,
        "y": -620
      },
      "width": 760,
      "height": 420,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
