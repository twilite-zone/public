          "graphId": "app-settings-panel-root",
          "name": "App Settings Panel & Mouse Sensitivity",
          "version": "0.1.0",
          "description": "There is no App Settings panel. App-level preferences are scattered across a half-wired settingsManager.js store, ad-hoc localStorage keys, and the Document Properties dialog. Mouse/zoom sensitivity has no setting at all.",
          "nodeId": "app-settings-panel",
