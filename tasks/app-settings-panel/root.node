      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How much of settingsManager.js’s dormant default state deserves real UI right now?",
        "body": "settingsManager.js's defaultSettings already declares defaultNodeColor, defaultEdgeColor, toolbarPosition, nodeListPanelAnchor, groupListPanelPosition, nodePropertiesPanelAnchor/Width, groupPropertiesPanelPosition, autoLayoutType, snapToGrid, gridSize, and shortcuts — none of which have any UI today. This task graph only asks for mouse sensitivity plus migrating the four settings that already have UI somewhere. Does the new App Settings panel launch with just those five, or is this the moment to surface some of the dormant ones too? Leaving it open rather than deciding silently either way.",
        "status": "open",
        "owner": "",
        "prominence": "high",
        "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node"
      }
    },
