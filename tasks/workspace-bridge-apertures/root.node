      "data": {
        "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 920 460\" role=\"img\" aria-label=\"Two graph frames with bridge-owned openings in their facing borders\"><rect width=\"920\" height=\"460\" rx=\"24\" fill=\"#161326\"/><text x=\"34\" y=\"42\" fill=\"#f5f2ff\" font-family=\"system-ui\" font-size=\"18\" font-weight=\"700\">BRIDGE-OWNED WORKSPACE APERTURE</text><g fill=\"#202238\" stroke=\"#778096\" stroke-width=\"3\"><path d=\"M42 82 H400 V198 M400 262 V408 H42 Z\"/><path d=\"M520 82 H878 V408 H520 V262 M520 198 V82\"/></g><text x=\"66\" y=\"116\" fill=\"#e8e5f0\" font-family=\"system-ui\" font-size=\"15\" font-weight=\"700\">Consumer graph</text><text x=\"544\" y=\"116\" fill=\"#e8e5f0\" font-family=\"system-ui\" font-size=\"15\" font-weight=\"700\">Addressed graph</text><rect x=\"196\" y=\"185\" width=\"150\" height=\"90\" rx=\"14\" fill=\"#32264a\" stroke=\"#b27cff\" stroke-width=\"3\"/><text x=\"271\" y=\"220\" text-anchor=\"middle\" fill=\"#fff\" font-family=\"system-ui\" font-size=\"14\" font-weight=\"700\">Bridge node</text><text x=\"271\" y=\"244\" text-anchor=\"middle\" fill=\"#cdb8ee\" font-family=\"monospace\" font-size=\"11\">bridge.ref → graph</text><path d=\"M346 230 H400\" stroke=\"#b27cff\" stroke-width=\"5\"/><path d=\"M400 230 H520\" stroke=\"#5de1ff\" stroke-width=\"5\" stroke-dasharray=\"12 8\"/><path d=\"M520 230 H574\" stroke=\"#5de1ff\" stroke-width=\"5\"/><path d=\"M564 220 L578 230 L564 240\" fill=\"none\" stroke=\"#5de1ff\" stroke-width=\"4\"/><rect x=\"574\" y=\"185\" width=\"160\" height=\"90\" rx=\"14\" fill=\"#203744\" stroke=\"#5de1ff\" stroke-width=\"3\"/><text x=\"654\" y=\"220\" text-anchor=\"middle\" fill=\"#fff\" font-family=\"system-ui\" font-size=\"14\" font-weight=\"700\">Exposed surface</text><text x=\"654\" y=\"244\" text-anchor=\"middle\" fill=\"#a6edf7\" font-family=\"monospace\" font-size=\"11\">resolved from graph</text><g font-family=\"system-ui\" font-size=\"12\"><rect x=\"48\" y=\"424\" width=\"12\" height=\"12\" fill=\"#b27cff\"/><text x=\"67\" y=\"435\" fill=\"#d8d1e7\">authored bridge</text><rect x=\"202\" y=\"424\" width=\"12\" height=\"12\" fill=\"#5de1ff\"/><text x=\"221\" y=\"435\" fill=\"#d8d1e7\">derived workspace adjacency</text></g></svg>",
        "altText": "Two bordered graph regions in a shared Twilite workspace. The left graph has a bright active border and dirty indicator; the right has a neutral inactive border and read-only badge. A cyan edge crosses between them with boundary markers.",
