        "semanticLevel": "summary",
        "content": {
          "kind": "markdown",
          "value": "## Workspace Bridge Apertures\n\nDefine one identity-preserving rule for connection and foldout: a local portal represents an absent identity; when that identity is spatially present, the same authored edge renders to its live representation through an authorized bridge aperture."
        },
        "interfaceContract": {
          "version": 1,
          "ownsContent": true,
          "surfaceDelegation": true
        },
        "identity": {
          "graphId": "workspace-bridge-apertures-declaration"
