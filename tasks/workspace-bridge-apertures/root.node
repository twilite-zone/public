    {
      "id": "workspace-bridge-apertures-landing-surface",
      "type": "content",
      "label": "Bridge Aperture Implementation Contract",
      "position": {
        "x": 120,
        "y": -1250
      },
      "width": 820,
      "height": 760,
      "ports": [
        {
          "id": "root",
