      "data": {
        "goal": "Every concept needed to explain Twilite has one canonical specification, separating meaning, representation and implementation evidence",
        "status": "done",
        "taskProgress": {
          "completed": 17,
          "total": 17
        },
        "questionProgress": {
          "answered": 6,
          "total": 6
        },
        "taskTitles": [
          "1. Specify the eight-section form and evidence policy",
          "2. Restore Declaration Behavior and reconcile evidence",
          "3. Reconcile Surface meaning and the View/Glyph boundary",
          "4. Bridge",
          "5. Content",
          "6. Specify View with Content and fixed workspace geometry",
          "7. Specify Glyph and review the Surface boundary",
          "8. Port",
          "9. Portal",
          "10. Field",
          "11. Write separate Edge and Edge Class specifications",
          "12. Event Handler (and Events)",
          "13. Method",
          "14. Script",
          "15. Specify Membrane meaning separately from control nodes",
          "16. Maintain the index incrementally and retire stale lists",
          "17. Verify structure and evidence without claiming runtime completeness"
        ],
        "questionTitles": [
          "1. Is Surface a primitive, or a concept that lives beside them?",
          "2. Are Edge, Event Handler, Method and Membrane primitives?",
          "3. Are Property, Node Class, Template, Collection, Workspace and Minimap primitives?",
          "4. How do Method and Script relate?",
          "5. Where do the specs live and publish?",
          "6. What do we say about the legacy and utility node types?"
        ],
        "taskListText": "1. 1. Specify the eight-section form and evidence policy\n2. 2. Restore Declaration Behavior and reconcile evidence\n3. 3. Reconcile Surface meaning and the View/Glyph boundary\n4. 4. Bridge\n5. 5. Content\n6. 6. Specify View with Content and fixed workspace geometry\n7. 7. Specify Glyph and review the Surface boundary\n8. 8. Port\n9. 9. Portal\n10. 10. Field\n11. 11. Write separate Edge and Edge Class specifications\n12. 12. Event Handler (and Events)\n13. 13. Method\n14. 14. Script\n15. 15. Specify Membrane meaning separately from control nodes\n16. 16. Maintain the index incrementally and retire stale lists\n17. 17. Verify structure and evidence without claiming runtime completeness",
        "questionListText": "1. 1. Is Surface a primitive, or a concept that lives beside them?\n2. 2. Are Edge, Event Handler, Method and Membrane primitives?\n3. 3. Are Property, Node Class, Template, Collection, Workspace and Minimap primitives?\n4. 4. How do Method and Script relate?",
