        "taskTitles": [
          "1. Write down the form of a primitive spec",
          "2. Declaration",
          "3. Surface",
          "4. Bridge",
          "5. Content",
          "6. View",
          "7. Glyph",
          "8. Port",
          "9. Portal",
          "10. Field",
          "11. Edge and Edge Class",
          "12. Event Handler (and Events)",
          "13. Method",
          "14. Script",
          "15. Membrane (Boundary)",
          "16. The index and the stale lists",
          "17. A test that keeps every spec honest"
        ],
        "questionTitles": [
          "1. Is Surface a primitive, or a concept that lives beside them?",
          "2. Are Edge, Event Handler, Method and Membrane primitives?",
          "3. Are Property, Node Class, Template, Collection, Workspace and Minimap primitives?",
          "4. How do Method and Script relate?",
          "5. Where do the specs live and publish?",
          "6. What do we say about the legacy and utility node types?"
        ],
