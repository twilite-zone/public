        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "body": "Make the same abstraction work recursively. A border handle exposes a typed capability. Dropping it into the deepest accepting container instantiates the appropriate primitive: a node inside a graph, or a graph document with a declaration on the workspace surface. Identity, representation, and relationship policies remain explicit and independent of scale.",
        "priority": "critical",
        "status": "in-progress",
        "owner": "Michael",
        "targetDate": "",
        "successMetrics": [
          "One instantiate capability resolves consistently at graph and workspace scale.",
          "Blank graph space creates a graph-owned node; blank workspace creates a workspace-owned graph instance backed by a graph document and declaration.",
          "Dropping on an existing compatible endpoint performs relationship behavior instead of empty-space instantiation.",
          "The deepest accepting container owns the result and only its persistent document becomes dirty.",
          "Identity, representation, relationship, and authority remain explicit capability dimensions rather than UI guesses.",
          "Workspace and graph zoom preserve the same ports, handles, and capability meaning."
        ],
        "definitionKey": "goal",
        "_classBinding": {
          "key": "goal",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node",
