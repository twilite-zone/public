      "data": {
        "title": "Instantiate a capability on blank workspace space",
        "body": "Treat blank workspace space as an active workspace container, not null. Dropping an instantiable capability there creates a graph instance backed by a new or selected graph document, a valid declaration, a root port, workspace placement, and initial focus.",
        "priority": "critical",
        "status": "todo",
        "owner": "",
        "estimateHours": "",
        "acceptanceCriteria": [
          "The workspace resolves the drop as graph-scale instantiation.",
          "The result has a graph document, declaration, root port, address lifecycle, and workspace instance ID.",
          "The declaration applies the capability identity policy rather than automatically sharing source identity.",
          "Existing workspace graphs remain open and unchanged."
        ],
