      "data": {
        "title": "Define the graph-to-workspace projection contract",
        "body": "Specify the derived workspace model: graph document to macro-node/frame; declared view to macro-node presentation; exposed port to border port; handle to draggable affordance; bridge to incoming adjacency; portal to outgoing adjacency. Keep graph documents authoritative and mark the model experimental.",
        "priority": "critical",
        "status": "in-progress",
        "owner": "",
        "estimateHours": "",
        "acceptanceCriteria": [
          "One projection function produces a deterministic workspace representation from loaded graph data.",
          "The contract distinguishes graph-local semantic data from workspace-only frame geometry and focus state.",
          "Bridge, portal, port, view, and handle each have one stated workspace responsibility."
        ],
        "definitionKey": "task",
