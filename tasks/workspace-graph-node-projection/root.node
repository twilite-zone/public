      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "body": "Make graphs legible and operable as workspace-scale nodes. A user can create or paste a graph into the workspace, see eligible interfaces from neighboring graphs on their borders, and drag one into the new graph to instantiate a node owned by the receiving graph.",
        "priority": "critical",
        "status": "in-progress",
        "owner": "Michael",
        "targetDate": "",
        "successMetrics": [
          "Creating or pasting a graph adds it alongside existing graphs and makes it the active drop target.",
          "Every open source graph projects only declared, eligible interfaces as stable border handles.",
          "Dropping a handle inside the receiving graph creates a valid node with a new graph-local ID and source provenance.",
          "The source graph remains unchanged and the target graph is the only graph dirtied by instantiation.",
          "Workspace zoom, graph zoom, minimap, focus, undo, save, close, and reopen preserve a coherent result."
        ],
        "definitionKey": "goal",
        "_classBinding": {
          "key": "goal",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node",
