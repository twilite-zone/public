      "data": {
        "title": "Project exposed port capabilities onto graph borders",
        "body": "Resolve public interfaces through the declaration-first chain. A graph border displays its declared ports as source handles, target sockets, or both. Views, declarations, node classes, portals, content, and glyphs reach the border only through a port capability.",
        "priority": "high",
        "status": "todo",
        "owner": "",
        "estimateHours": "",
        "acceptanceCriteria": [
          "Only declared public ports appear on the workspace border.",
          "Output capabilities render as draggable handles; input capabilities render as accepting sockets.",
          "Each projection retains its source graph, workspace instance, port, surface or view, type, authority, and capability contract.",
          "Bridge apertures remain incoming adjacency projections and are not silently converted into creation capabilities."
        ],
