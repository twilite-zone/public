      "data": {
        "title": "Normalize legacy authority and behavior contracts",
        "body": "Introduce one capability resolver that prefers explicit grants and policies, then derives a conservative compatibility capability from existing authority values, port roles, allowedEdgeTypes, and drag-create/create-node behaviors. Legacy fields remain readable inputs during migration, not the new semantic authority.",
        "priority": "high",
        "status": "in-progress",
        "owner": "",
        "estimateHours": "",
        "acceptanceCriteria": [
          "Existing navigate, consume-view, bridge, runtime, and drag-create graphs retain their current behavior.",
          "Legacy normalization never grants a mutation more powerful than the current behavior.",
          "The resolver emits one normalized capability shape to graph and workspace interactions.",
          "Diagnostics identify authored ports that still depend on legacy inference."
        ],
        "definitionKey": "task",
