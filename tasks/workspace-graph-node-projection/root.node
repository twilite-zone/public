    {
      "id": "workspace-graph-node-projection-landing-surface",
      "type": "content",
      "label": "Workspace Graph-Node Projection Draft",
      "position": {
        "x": 120,
        "y": -1250
      },
      "width": 520,
      "height": 320,
      "ports": [
        {
          "id": "root",
          "key": "root",
