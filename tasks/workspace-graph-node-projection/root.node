          "angle": 270,
          "portId": "root"
        },
        {
          "id": "left",
          "label": "left",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 180,
          "portId": "root"
        },
        {
          "id": "bottom",
          "label": "bottom",
