    {
      "id": "workspace-graph-node-projection-goal",
      "type": "goal",
      "label": "Instantiate typed capabilities at graph and workspace scale",
      "root": false,
      "position": {
        "x": -240,
        "y": 100
      },
      "width": 420,
      "height": 260,
      "color": "linear-gradient(135deg, #f8e18a, #d19a00)",
      "handles": [
