      "data": {
        "title": "Define the recursive container and capability contract",
        "body": "Define one scale-independent model: containers own members; ports expose typed capabilities; handles render capabilities; and instantiate resolves according to the receiving container. A graph contains nodes, while a workspace contains graph instances backed by graph documents and declarations.",
        "priority": "critical",
        "status": "in-progress",
        "owner": "",
        "estimateHours": "",
        "acceptanceCriteria": [
          "The contract names graph and workspace as container scopes.",
          "The same capability shape is valid at both scopes.",
          "Identity, representation, relationship, authority, and result type are independent fields.",
          "No primitive is inferred from handle appearance or canvas coordinates alone."
        ],
        "definitionKey": "task",
