    {
      "id": "workspace-graph-node-projection-task-define-projection",
      "type": "task",
      "label": "Define the recursive container and capability contract",
      "root": false,
      "position": {
        "x": -1100,
        "y": 500
      },
      "width": 380,
      "height": 260,
      "color": "linear-gradient(135deg, #9be7c4, #1f9d67)",
      "handles": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210,
          "portId": "root"
        },
        {
          "id": "top",
