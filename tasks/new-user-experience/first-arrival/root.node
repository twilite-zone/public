      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Make the first screen legible and calm",
        "body": "The landing state should present one dominant next action and avoid presenting several equally plausible paths at once.",
        "status": "in-progress",
        "priority": "high",
        "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node"
