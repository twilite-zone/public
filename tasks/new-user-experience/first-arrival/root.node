      "showLabel": true,
      "data": {
        "title": "Choose the dominant first action",
        "body": "Decide whether the first move is explore, edit, or start from a guided example. The screen should visibly privilege one of them.",
        "status": "todo",
        "priority": "high",
        "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"
