      },
      "width": 340,
      "height": 170,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Make the result unmistakable",
        "body": "The user should see what changed, why it changed, and how to undo or continue. Success cannot depend on hidden state.",
        "status": "todo",
        "priority": "high",
        "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"
