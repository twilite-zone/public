      "type": "content",
      "label": "First Success",
      "position": {
        "x": -260,
        "y": -10
      },
      "width": 420,
      "height": 240,
      "visible": true,
      "showLabel": true,
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# First Success\n\nThis graph defines the first interaction that should make a new user say: yes, this works.\n\nThe success needs to be visible, understandable, and reversible."
        }
      }
    },
