      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Pick the canonical first success",
        "body": "Choose the simplest meaningful action: edit a node, traverse through a port, or create a primitive from the derived legend panel. Then optimize the surface around that one move.",
        "status": "todo",
        "priority": "high",
        "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"
      }
    },
    {
