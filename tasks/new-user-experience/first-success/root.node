      },
      "width": 380,
      "height": 200,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Deliver one obvious successful interaction",
        "body": "A new user should be able to do one thing on-canvas and see a clear result without ambiguity about whether the app obeyed them.",
        "status": "in-progress",
        "priority": "high",
        "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node"
      }
    },
