    {
      "id": "windowed-collection-task-goal",
      "type": "goal",
      "label": "Deliver directory-discovered windowed collections",
      "position": {
        "x": 420,
        "y": -420
      },
      "visible": true,
      "showLabel": true,
      "width": 420,
      "height": 240,
      "data": {
        "body": "Implement and prove a browse-mode collection surface that discovers member graphs from repository structure, resolves ten root cards at a time, scrolls through temporary view state, and ships as a reusable Collection Template.",
        "priority": "high",
        "status": "todo",
        "owner": "Michael",
        "estimateHours": "12",
        "acceptanceCriteria": [
          "Directory membership follows the resolved one-level rule",
          "Only the visible member window resolves and renders root surfaces",
          "Scrolling does not rewrite member graphs or authored collection structure",
          "The Collection Template packages the working behavior and adjacent skill",
          "The Ideas collection proves automatic discovery, portal navigation, desktop scrolling, and touch browsing"
        ],
        "_classBinding": {
