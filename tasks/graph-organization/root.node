    {
      "id": "graph-organization-goal",
      "type": "goal",
      "label": "Make useful graph forms recognizable and reusable",
      "position": {
        "x": 360,
        "y": -500
      },
      "visible": true,
      "showLabel": true,
      "width": 420,
      "height": 240,
      "data": {
        "body": "Produce practical organization guidance that helps authors recognize the reusable form inside a graph, name the template it could become, and preserve local expression without expanding the invariant executable core.",
        "priority": "high",
        "status": "in-progress",
        "owner": "Michael",
        "estimateHours": "6",
        "acceptanceCriteria": [
          "The invariant core, reusable template shapes, and composition guidance have distinct authority",
          "Section and header grammar is explicit and demonstrated",
          "Operational and semantic edge guidance remains legible as graphs grow",
          "Useful graph forms can be named and promoted into templates without requiring a closed taxonomy",
          "Safe reorganization and scalable collection behavior are testable against real graphs"
        ],
        "_classBinding": {
          "key": "goal",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node",
