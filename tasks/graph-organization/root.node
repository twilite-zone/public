    {
      "id": "graph-organization-goal",
      "type": "goal",
      "label": "Define a practical composition law for Twilite graphs",
      "position": {
        "x": 360,
        "y": -500
      },
      "visible": true,
      "showLabel": true,
      "width": 420,
      "height": 240,
      "data": {
        "body": "Produce concrete organization rules for task graphs, libraries, galleries, and implementation boards so the system can scale without becoming visually arbitrary.",
        "priority": "high",
        "status": "todo",
        "owner": "Michael",
        "estimateHours": "6",
        "acceptanceCriteria": [
          "Section/header grammar is explicit",
          "Canonical graph shapes are named",
          "Edge meaning stays legible as graphs grow"
        ],
