    {
      "id": "script-presentation-summary-updater",
      "type": "script",
      "label": "Summary Updater",
      "position": {
        "x": -1100,
        "y": -180
      },
      "width": 420,
      "height": 300,
      "visible": true,
      "showLabel": true,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "top",
          "label": "top",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 270
        },
        {
          "id": "right",
          "label": "right",
