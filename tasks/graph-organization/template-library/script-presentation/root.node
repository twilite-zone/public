        "status": "in-progress",
        "owner": "Michael",
        "acceptanceCriteria": [
          "The canonical Script class exposes icon, summary, detail, and editor views",
          "Script detail identifies configuration, effects, permissions, multiplicity, and companion-node requirements",
          "Source editing remains available as an advanced surface",
          "Collection Window Controller and Workboard Reconciler prove representative placement behavior"
        ],
        "visibilityRole": "browser",
