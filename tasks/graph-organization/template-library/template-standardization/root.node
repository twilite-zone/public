        "source": "const SUMMARY_NODE_ID = 'template-standardization-derivation-summary';\nconst DONE = new Set(['done','complete','completed','closed']);\nconst ANSWERED = new Set(['answered','done','resolved','closed']);\nconst norm = (v) => String(v || '').trim().toLowerCase();\nconst title = (n) => String(n?.data?.title || n?.label || n?.data?.body || '').trim();\nconst nodes = await api.getNodes();\nconst summary = nodes.find((n) => n?.id === SUMMARY_NODE_ID);\nif (!summary) return { success:false, error:'Summary node missing' };\nconst goal = nodes.find((n) => n?.type === 'goal');\nconst tasks = nodes.filter((n) => n?.type === 'task');\nconst questions = nodes.filter((n) => n?.type === 'open-question');\nconst completed = tasks.filter((n) => DONE.has(norm(n?.data?.status))).length;\nconst taskTitles = tasks.map(title).filter(Boolean);\nconst questionTitles = questions.map(title).filter(Boolean);\nconst nextData = {\n  ...(summary.data || {}),\n  goal: goal?.label || summary.data?.goal || 'Task graph',\n  status: norm(goal?.data?.status) === 'done' && completed === tasks.length ? 'done' : (completed > 0 || tasks.some((n) => norm(n?.data?.status) === 'in-progress') ? 'in-progress' : 'todo'),\n  taskProgress: { completed, total: tasks.length },\n  questionProgress: { answered: questions.filter((n) => ANSWERED.has(norm(n?.data?.status))).length, total: questions.length },\n  taskTitles,\n  questionTitles,\n  taskListText: taskTitles.map((v,i) => `${i+1}. ${v}`).join('\\n'),\n  questionListText: questionTitles.map((v,i) => `${i+1}. ${v}`).join('\\n'),\n  summarySource: 'node-updater',\n  updatedAt: new Date().toISOString()\n};\nawait api.updateNode(SUMMARY_NODE_ID, { data: nextData });\nreturn { success:true, summary:nextData };",
        "summaryNodeId": "template-standardization-derivation-summary",
        "visibilityRole": "editor"
      }
    },
