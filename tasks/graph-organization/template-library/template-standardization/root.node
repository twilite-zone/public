      "data": {
        "title": "Which templates are whole-graph versus installable?",
        "body": "Templates may support whole-graph derivation, selective placement, or both. The use case chooses the operation; Script presentation and dependency work is required before scripted behavior is fully placeable.",
        "status": "answered",
        "owner": "Michael",
        "visibilityRole": "browser",
        "_classBinding": {
          "key": "open-question",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node",
