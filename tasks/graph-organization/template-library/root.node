      "width": 420,
      "height": 240,
      "data": {
        "body": "A good template is a standards-compliant graph with a useful root and preview, clear whole-graph or installable-capability intent, automatic Templates collection membership, and a derivation contract that retargets graph-owned identity without corrupting library-owned authority.",
        "priority": "high",
        "status": "in-progress",
        "owner": "Michael",
        "estimateHours": "8",
        "acceptanceCriteria": [
          "Every intended template is reachable through the Templates collection",
          "Every template has a canonical declared root and useful preview",
          "Each template states whether it creates a graph or installs a capability",
          "Derivation retargets graph-owned identity, IDs, paths, and navigation while preserving library-owned class and edge references",
          "A Save-As-style smoke test produces a clean graph without manual reference repair"
        ],
