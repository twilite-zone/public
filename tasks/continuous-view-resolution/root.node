      "visible": true,
      "showLabel": true,
      "data": {
        "rationale": "An ordinal level or fixed payload name cannot select arbitrary authored views.",
        "status": "decided",
        "decidedAt": "",
        "owner": "",
        "supersededBy": "",
        "body": "Each View declares a numeric minimum resolution. The highest eligible View wins, with deterministic tie handling. Glyph is the smallest fallback (dot only if no glyph is defined). View payload and chrome policy describe rendering, not position in a fixed semantic ladder. Graph expansion remains its own transition. Ports, portals, handles, and membrane do not change with content resolution.",
        "definitionKey": "decision",
        "_classBinding": {
          "key": "decision",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
