      "data": {
        "title": "Define resolution and selection contract",
        "body": "Specify a continuous projected-size resolution measure, min-resolution semantics, deterministic ties, hysteresis, lower-bound fallback, and independent graph expansion threshold. Map legacy detail/summary/icon and minPercent values at read time.",
        "priority": "high",
        "status": "todo",
        "owner": "Michael",
        "estimateHours": "",
        "acceptanceCriteria": [
          "Shared contract supports fractional thresholds and any number of Views.",
          "Legacy graphs resolve to their prior intended views at representative zooms."
        ],
        "definitionKey": "task",
        "_classBinding": {
          "key": "task",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node",
