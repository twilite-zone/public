        "title": "Implement free-mode document hosting",
        "body": "Separate entitlement-based host behavior: paid mode hosts document frames in a workspace; free mode uses the whole environment for the focused graph. Audit single-slot workspace emulation, navigation, toolbar controls and resize affordances.",
        "priority": "high",
        "status": "todo",
        "owner": "",
        "estimateHours": "",
        "acceptanceCriteria": [
          "Free mode has no workspace frame arrangement or workspace-only controls",
          "The same combined document and deep links work in both modes",
          "Changing entitlement does not lose graph data or bypass access controls"
        ],
        "definitionKey": "task",
