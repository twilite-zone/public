      "type": "task",
      "label": "Define frame ownership and defaults",
      "root": false,
      "position": {
        "x": 0,
        "y": 600
      },
      "width": 580,
      "height": 440,
      "color": "linear-gradient(135deg, #9be7c4, #1f9d67)",
      "handles": [
