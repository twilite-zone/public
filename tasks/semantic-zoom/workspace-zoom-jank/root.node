      "data": {
        "title": "Apply the same fix to PassiveGraphSemanticView",
        "body": "PassiveGraphSemanticView (WorkspaceLayer.js, ~lines 128-186) independently computes bounds.width * zoom / bounds.height * zoom and receives the same transition prop from its caller (line 622-623). It needs whatever fix task 1 lands on, not a separate one — verify it actually goes through the same transition-decision path rather than being patched twice with diverging logic.",
        "status": "todo",
        "owner": "",
        "priority": "high",
        "estimateHours": "",
        "acceptanceCriteria": [
          "PassiveGraphSemanticView uses the same level-change-aware transition decision as the main instance box",
          "No separate/duplicate fix logic introduced"
        ],
        "_classBinding": {
          "key": "task",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node",
          "identity": {
            "graphId": "task-class",
            "name": "Task Class",
            "version": "0.1.0",
            "description": "Atomic executable unit of work for planning graphs.",
            "createdAt": "2026-03-15T20:30:00.000Z",
            "updatedAt": "2026-03-24T01:10:00.000Z"
          },
          "intent": "node-class",
          "meaning": "Atomic executable unit of work for planning graphs.",
          "description": "Atomic executable unit of work for planning graphs.",
