        "status": "todo",
        "owner": "",
        "estimateHours": "8",
        "acceptanceCriteria": [
          "Graph files do not acquire workspace-only frame coordinates.",
          "Reload restores open graph refs, region bounds, ordering, and the last active graph.",
          "Missing or inaccessible graphs restore as labeled error regions that can be removed or retried."
        ],
