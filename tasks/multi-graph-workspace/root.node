      "data": {
        "title": "Define graph activation and focus behavior",
        "body": "Clicking a node or empty space inside a graph activates that graph. Clicking empty graph space clears node focus and ends handle editing while retaining that graph as active. Clicking workspace space outside every graph clears node focus and keeps the last active graph for deterministic commands.",
        "priority": "high",
        "status": "todo",
        "owner": "",
        "estimateHours": "6",
        "acceptanceCriteria": [
          "Only one graph has active styling.",
          "Menus, keyboard actions, add-node, undo, redo, and Save target the active graph.",
          "Node focus and handle editing end when the pointer leaves the focused editing context by clicking elsewhere."
        ],
        "definitionKey": "task",
