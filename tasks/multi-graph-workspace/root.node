      "data": {
        "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 700\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Two bordered graph regions in a shared Twilite workspace, with the left graph active and a cross-graph edge connecting them\">\n  <defs>\n    <linearGradient id=\"bg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop stop-color=\"#111321\"/><stop offset=\"1\" stop-color=\"#1a1830\"/></linearGradient>\n    <filter id=\"glow\"><feGaussianBlur stdDeviation=\"7\" result=\"b\"/><feMerge><feMergeNode in=\"b\"/><feMergeNode in=\"SourceGraphic\"/></feMerge></filter>\n  </defs>\n  <rect width=\"1200\" height=\"700\" rx=\"28\" fill=\"url(#bg)\"/>\n  <text x=\"48\" y=\"54\" fill=\"#e9e7ff\" font-family=\"Inter, sans-serif\" font-size=\"22\" font-weight=\"700\">MULTI-GRAPH WORKSPACE</text>\n  <text x=\"1150\" y=\"54\" text-anchor=\"end\" fill=\"#8e91a8\" font-family=\"Inter, sans-serif\" font-size=\"15\">Fit workspace · 72%</text>\n  <g>\n    <rect x=\"48\" y=\"88\" width=\"560\" height=\"530\" rx=\"18\" fill=\"#171927\" stroke=\"#a970ff\" stroke-width=\"4\" filter=\"url(#glow)\"/>\n    <rect x=\"48\" y=\"88\" width=\"560\" height=\"58\" rx=\"18\" fill=\"#24203a\"/><path d=\"M48 128v18h560v-18\" fill=\"#24203a\"/>\n    <circle cx=\"76\" cy=\"117\" r=\"7\" fill=\"#b985ff\"/><text x=\"94\" y=\"123\" fill=\"#f5efff\" font-family=\"Inter, sans-serif\" font-size=\"18\" font-weight=\"700\">Research Graph</text>\n    <rect x=\"410\" y=\"103\" width=\"78\" height=\"28\" rx=\"14\" fill=\"#6f3bb4\"/><text x=\"449\" y=\"122\" text-anchor=\"middle\" fill=\"white\" font-family=\"Inter, sans-serif\" font-size=\"12\" font-weight=\"700\">ACTIVE</text>\n    <circle cx=\"514\" cy=\"117\" r=\"6\" fill=\"#ffbd4a\"/><text x=\"528\" y=\"122\" fill=\"#d6d3e4\" font-family=\"Inter, sans-serif\" font-size=\"12\">DIRTY</text>\n    <text x=\"72\" y=\"169\" fill=\"#777a90\" font-family=\"monospace\" font-size=\"12\">github://team/research/root.node</text>\n    <g fill=\"#2c2f45\" stroke=\"#666b88\" stroke-width=\"2\"><rect x=\"92\" y=\"220\" width=\"170\" height=\"92\" rx=\"14\"/><rect x=\"352\" y=\"350\" width=\"184\" height=\"100\" rx=\"14\"/><rect x=\"108\" y=\"470\" width=\"190\" height=\"92\" rx=\"14\"/></g>\n    <text x=\"177\" y=\"265\" text-anchor=\"middle\" fill=\"#f0eff8\" font-family=\"Inter, sans-serif\" font-size=\"15\" font-weight=\"700\">Customer evidence</text>\n    <text x=\"444\" y=\"395\" text-anchor=\"middle\" fill=\"#f0eff8\" font-family=\"Inter, sans-serif\" font-size=\"15\" font-weight=\"700\">Product insight</text>\n    <text x=\"203\" y=\"515\" text-anchor=\"middle\" fill=\"#f0eff8\" font-family=\"Inter, sans-serif\" font-size=\"15\" font-weight=\"700\">Open question</text>\n    <path d=\"M262 266 C330 266 315 398 352 398\" fill=\"none\" stroke=\"#858aa8\" stroke-width=\"3\"/>\n  </g>\n  <g>\n    <rect x=\"668\" y=\"128\" width=\"484\" height=\"450\" rx=\"18\" fill=\"#171927\" stroke=\"#5b6076\" stroke-width=\"2\"/>\n    <rect x=\"668\" y=\"128\" width=\"484\" height=\"58\" rx=\"18\" fill=\"#202230\"/><path d=\"M668 168v18h484v-18\" fill=\"#202230\"/>\n    <circle cx=\"696\" cy=\"157\" r=\"7\" fill=\"#73788f\"/><text x=\"714\" y=\"163\" fill=\"#d7d8e2\" font-family=\"Inter, sans-serif\" font-size=\"18\" font-weight=\"700\">Launch Plan</text>\n    <rect x=\"1018\" y=\"143\" width=\"108\" height=\"28\" rx=\"14\" fill=\"#303344\"/><text x=\"1072\" y=\"162\" text-anchor=\"middle\" fill=\"#c5c8d6\" font-family=\"Inter, sans-serif\" font-size=\"12\" font-weight=\"700\">READ ONLY</text>\n    <text x=\"692\" y=\"209\" fill=\"#777a90\" font-family=\"monospace\" font-size=\"12\">github://team/launch/root.node</text>\n    <g fill=\"#2c2f45\" stroke=\"#666b88\" stroke-width=\"2\"><rect x=\"730\" y=\"272\" width=\"172\" height=\"92\" rx=\"14\"/><rect x=\"914\" y=\"418\" width=\"174\" height=\"94\" rx=\"14\"/></g>\n    <text x=\"816\" y=\"318\" text-anchor=\"middle\" fill=\"#f0eff8\" font-family=\"Inter, sans-serif\" font-size=\"15\" font-weight=\"700\">Positioning</text>\n    <text x=\"1001\" y=\"465\" text-anchor=\"middle\" fill=\"#f0eff8\" font-family=\"Inter, sans-serif\" font-size=\"15\" font-weight=\"700\">Landing page</text>\n    <path d=\"M902 318 C960 318 940 418 970 418\" fill=\"none\" stroke=\"#858aa8\" stroke-width=\"3\"/>\n  </g>\n  <path d=\"M536 400 C650 400 657 318 730 318\" fill=\"none\" stroke=\"#55d9ff\" stroke-width=\"5\"/>\n  <circle cx=\"608\" cy=\"375\" r=\"8\" fill=\"#111321\" stroke=\"#55d9ff\" stroke-width=\"4\"/><circle cx=\"668\" cy=\"343\" r=\"8\" fill=\"#111321\" stroke=\"#55d9ff\" stroke-width=\"4\"/>\n  <text x=\"638\" y=\"331\" text-anchor=\"middle\" fill=\"#8ee8ff\" font-family=\"Inter, sans-serif\" font-size=\"12\" font-weight=\"700\">CROSS-GRAPH EDGE</text>\n  <g transform=\"translate(48 650)\"><rect width=\"18\" height=\"18\" rx=\"4\" fill=\"none\" stroke=\"#a970ff\" stroke-width=\"3\"/><text x=\"28\" y=\"14\" fill=\"#c9c7d6\" font-family=\"Inter, sans-serif\" font-size=\"13\">active graph</text><rect x=\"150\" width=\"18\" height=\"18\" rx=\"4\" fill=\"none\" stroke=\"#5b6076\" stroke-width=\"2\"/><text x=\"178\" y=\"14\" fill=\"#c9c7d6\" font-family=\"Inter, sans-serif\" font-size=\"13\">inactive graph</text><circle cx=\"322\" cy=\"9\" r=\"6\" fill=\"#ffbd4a\"/><text x=\"337\" y=\"14\" fill=\"#c9c7d6\" font-family=\"Inter, sans-serif\" font-size=\"13\">unsaved changes</text></g>\n</svg>",
        "altText": "Two bordered graph regions in a shared Twilite workspace. The left graph has a bright active border and dirty indicator; the right has a neutral inactive border and read-only badge. A cyan edge crosses between them with boundary markers.",
