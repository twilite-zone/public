      "data": {
        "body": "Let a person open, compare, connect, and edit two or more graphs at once while every graph keeps its own visible boundary, identity, coordinates, save authority, undo history, loading state, and provenance.",
        "priority": "critical",
        "status": "open",
        "owner": "Michael",
        "targetDate": "",
        "successMetrics": [
          "Two or more graph documents can be visible at the same time with unmistakable borders and headers.",
          "Exactly one graph is active, and all edit, save, undo, and keyboard commands resolve to it.",
          "Cross-graph edges remain visually continuous while persistence lands in the correct declaration-owned files.",
          "Opening one graph still works as a one-region workspace with no regression in the existing flow."
        ],
