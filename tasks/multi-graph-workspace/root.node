    {
      "id": "multi-graph-workspace-acceptance-contract",
      "type": "content",
      "label": "Workspace Acceptance Contract",
      "position": {
        "x": 900,
        "y": -760
      },
      "width": 720,
      "height": 520,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
