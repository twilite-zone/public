      "data": {
        "title": "Create the multi-document workspace state model",
        "body": "Represent each open graph as a workspace instance with instanceId, graphRef, graphId, bounds, transform, load state, dirty state, and authority. Keep activeGraphInstanceId separate from focusedNodeId so node focus can clear while command scope remains deterministic.",
        "priority": "high",
        "status": "todo",
        "owner": "",
        "estimateHours": "8",
        "acceptanceCriteria": [
          "The same graph may be opened twice without ID collision because workspace instance identity is distinct from semantic node and document identity.",
          "The active graph is explicit and never inferred from the last mutated node.",
          "A single loaded graph is represented by the same model as a one-region workspace."
        ],
        "definitionKey": "task",
