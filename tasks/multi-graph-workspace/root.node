      "data": {
        "title": "Render visible graph regions and headers",
        "body": "Draw every graph inside a bounded region behind its nodes. The region has a persistent border, title/address header, active state, dirty state, load state, and authority badge. It is workspace chrome, not a semantic group node.",
        "priority": "high",
        "status": "todo",
        "owner": "",
        "estimateHours": "12",
        "acceptanceCriteria": [
          "Borders remain visible at normal working zoom and have a simplified minimum-width treatment when zoomed out.",
          "Active uses a high-contrast 3px accent border plus a subtle glow; inactive uses a 1px neutral border.",
          "Headers show graph name, compact address, dirty indicator, and writable/read-only state.",
          "Region chrome does not clip cross-graph edges."
        ],
